@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject WebBackendOptions Backend
@inject NavigationManager Navigation
@inject UiErrorNotifier Errors

<button type="button" class="button button--secondary" @onclick="Open">Alterar senha</button>
@if (IsOpen)
{
    <div class="password-dialog-backdrop" @onclick="Close">
        <section class="password-dialog surface" role="dialog" aria-modal="true" aria-labelledby="password-dialog-title" @onclick:stopPropagation>
            <h2 id="password-dialog-title">Alterar senha</h2>
            <p>Para sua segurança, a sessão precisa ter sido iniciada nos últimos 30 minutos. Depois da alteração, todos os dispositivos serão desconectados.</p>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div class="field"><label for="password-change-new">Nova senha</label><input id="password-change-new" type="password" autocomplete="new-password" maxlength="128" @bind="NewPassword" @bind:event="oninput" class="@((Submitted || NewPassword.Length > 0) && !IsValidStrength ? "password-dialog-invalid" : null)" aria-invalid="@((Submitted || NewPassword.Length > 0) && !IsValidStrength)" required /></div>
                <div class="field"><label for="password-change-confirm">Confirme a nova senha</label><input id="password-change-confirm" type="password" autocomplete="new-password" maxlength="128" @bind="Confirmation" @bind:event="oninput" class="@((Submitted || Confirmation.Length > 0) && Confirmation != NewPassword ? "password-dialog-invalid" : null)" aria-invalid="@((Submitted || Confirmation.Length > 0) && Confirmation != NewPassword)" required /></div>
                <p class="password-dialog-strength" role="status">Segurança: <strong>@StrengthLabel</strong></p>
                <meter min="0" max="5" value="@Strength" aria-label="Nível de segurança da senha"></meter>
                <p class="field-hint">Mínimo de 8 caracteres, com maiúscula, minúscula, número e símbolo.</p>
                @if (Submitted && !IsValid) { <p class="notice notice--error" role="alert">Revise a senha e a confirmação para atender a todos os requisitos.</p> }
                <div class="patient-actions"><button class="button" disabled="@Busy">Salvar nova senha</button><button type="button" class="button button--secondary" @onclick="Close">Cancelar</button></div>
            </form>
        </section>
    </div>
}

@code {
    [Parameter] public string? Role { get; set; }
    private IJSObjectReference? module;
    private bool IsOpen, Submitted, Busy;
    private string NewPassword = "", Confirmation = "";
    private int Strength => (NewPassword.Length >= 8 ? 1 : 0) + (NewPassword.Any(char.IsUpper) ? 1 : 0)
        + (NewPassword.Any(char.IsLower) ? 1 : 0) + (NewPassword.Any(char.IsDigit) ? 1 : 0)
        + (NewPassword.Any(ch => !char.IsLetterOrDigit(ch)) ? 1 : 0);
    private bool IsValidStrength => Strength == 5 && NewPassword.Distinct().Count() >= 4 && NewPassword.Length <= 128;
    private bool IsValid => IsValidStrength && Confirmation == NewPassword;
    private string StrengthLabel => Strength switch { <= 1 => "Muito fraca", 2 => "Fraca", 3 => "Regular", 4 => "Boa", _ => "Forte" };
    private void Open() { NewPassword = Confirmation = ""; Submitted = false; IsOpen = true; }
    private void Close() { if (!Busy) IsOpen = false; }
    private async Task SaveAsync()
    {
        Submitted = true;
        if (!IsValid || Busy) return;
        Busy = true;
        try
        {
            module ??= await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/identity-access.js");
            var role = Role ?? (await module.InvokeAsync<WebCurrentAccount>("get", Backend.BaseUrl.ToString(), "api/v1/auth/me")).Role;
            var routeRole = role == "administrator" ? "admin" : role;
            await module.InvokeAsync<object?>("sendMethod", Backend.BaseUrl.ToString(), $"api/v1/{routeRole}/account/password", "POST", new { newPassword = NewPassword });
            Navigation.NavigateTo("/acesso", true);
        }
        catch (JSException error) { Errors.Show(UiErrorNotifier.Normalize(error.Message)); }
        catch (Exception) { Errors.Show(UiErrorNotifier.UnexpectedMessage); }
        finally { Busy = false; }
    }
    public async ValueTask DisposeAsync() { if (module is not null) try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
