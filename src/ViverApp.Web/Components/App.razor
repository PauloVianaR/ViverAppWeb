<!DOCTYPE html>
@using ViverApp.Security
@inject IHttpContextAccessor HttpContextAccessor

<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ViverApp.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" nonce="@CspNonce"></script>
</body>

</html>

@code {
    private string? CspNonce => SecurityHeadersMiddleware.GetCspNonce(HttpContextAccessor.HttpContext);
}
