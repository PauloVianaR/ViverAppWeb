<!DOCTYPE html>
@using ViverApp.Security
@inject IHttpContextAccessor HttpContextAccessor

<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b2340" />
    <base href="/" />
    <link rel="icon" type="image/png" href="@Assets["images/logo.png"]" />
    <link rel="apple-touch-icon" href="@Assets["images/logo.png"]" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["patient.css"]" />
    <link rel="stylesheet" href="@Assets["doctor.css"]" />
    <link rel="stylesheet" href="@Assets["manager.css"]" />
    <link rel="stylesheet" href="@Assets["administrator.css"]" />
    <link rel="stylesheet" href="@Assets["ViverApp.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" nonce="@CspNonce"></script>
</body>

</html>

@code {
    private string? CspNonce => SecurityHeadersMiddleware.GetCspNonce(HttpContextAccessor.HttpContext);
}
