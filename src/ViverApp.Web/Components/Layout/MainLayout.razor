@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject WebBackendOptions Backend
@inject IJSRuntime JavaScript

<a class="skip-link" href="#main-content">Ir para o conteúdo principal</a>
<GlobalErrorDialog />
<div class="app-shell @(IsWorkspace ? "app-shell--workspace" : "app-shell--public") app-shell--@Shell.Profile.ToString().ToLowerInvariant()">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Centro Médico Viver — início">
            <img class="brand-logo" src="/images/logo.png" alt="" />
            <span class="brand-copy"><strong>Viver</strong><small>Centro Médico</small></span>
        </a>
        @if (IsWorkspace)
        {
            <div class="workspace-context" aria-label="Contexto atual"><span>@Shell.Context</span><strong>@Shell.Label</strong></div>
        }
        else
        {
            <nav class="public-navigation" aria-label="Navegação principal">
                @foreach (var item in Shell.Items)
                {
                    <a class="@ActiveClass(item)" href="@item.Href" aria-current="@AriaCurrent(item)">@item.Label</a>
                }
            </nav>
        }
        @if (Account is not null && IsWorkspace)
        {
            @if (Account.Role == "doctor")
            {
                <details class="doctor-notification-center">
                    <summary class="topbar-action" aria-label="@NotificationLabel"><AppIcon Name="sparkles" /><span>Alertas</span>@if(UnreadCount>0){<strong class="notification-dot">@UnreadCount</strong>}</summary>
                    <div class="notification-panel">
                        <div class="section-heading"><h2>Chegadas</h2>@if(UnreadCount>0){<button class="button button--small button--secondary" @onclick="ReadAllAsync">Marcar todas como lidas</button>}</div>
                        <button class="button button--small button--secondary" @onclick="()=>SoundMuted=!SoundMuted">@(SoundMuted?"Ativar som nesta sessão":"Silenciar nesta sessão")</button>
                        @if(Notifications.Count==0)
                        {
                            <p class="muted">Nenhuma chegada notificada.</p>
                        }
                        else
                        {
                            @foreach(var item in Notifications.Take(10))
                            {
                                <div class="notification-entry">
                                    <button class="notification-item @(item.IsRead?"":"notification-item--unread")" @onclick="()=>OpenNotificationAsync(item)"><strong>Atendimento @item.AppointmentNumber</strong><span>@(item.QueueNumber.HasValue?$"Senha {item.QueueNumber} · ":"")@(item.StartsAtUtc?.ToLocalTime().ToString("HH:mm"))</span></button>
                                    @if(!item.IsRead)
                                    {
                                        <button class="notification-read" type="button" aria-label="Marcar atendimento @item.AppointmentNumber como lido" @onclick="()=>ReadNotificationAsync(item)">Marcar como lida</button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </details>
            }
            <button class="topbar-action" type="button" @onclick="LogoutAsync"><AppIcon Name="user" /><span>Sair</span></button>
        }
        else
        {
            <a class="topbar-action" href="@(Account?.Destination ?? "/acesso")"><AppIcon Name="shield" /><span>@(Account is null ? "Entrar" : "Minha área")</span></a>
        }
    </header>
    <div class="shell-body">
        @if (IsWorkspace)
        {
            <aside class="sidebar" aria-label="Navegação da área @Shell.Label">
                <p class="sidebar-label">@Shell.Context</p>
                <nav>
                    @foreach (var item in Shell.Items)
                    {
                        <a class="@ActiveClass(item)" href="@item.Href" aria-current="@AriaCurrent(item)"><AppIcon Name="@item.Icon" /><span>@item.Label</span></a>
                    }
                </nav>
                <a class="sidebar-security" href="/seguranca"><AppIcon Name="shield" /><div><strong>Segurança da conta</strong><span>Sessões, Google e passkeys.</span></div></a>
            </aside>
        }
        <main id="main-content" class="page-container" tabindex="-1">
            @if (IsProtectedPath && !IdentityResolved)
            {
                <InterfaceState Title="Validando acesso" Description="Aguarde enquanto confirmamos sua sessão e suas permissões." Icon="shield" />
            }
            else
            {
                <ApplicationErrorBoundary @ref="PageErrorBoundary">
                    <ChildContent>@Body</ChildContent>
                    <ErrorContent>
                        <InterfaceState Title="Não foi possível abrir esta tela" Description="Ocorreu um erro interno não classificado. Contate o administrador do sistema." Icon="shield" />
                    </ErrorContent>
                </ApplicationErrorBoundary>
            }
        </main>
    </div>
    @if (IsWorkspace)
    {
        <nav class="mobile-navigation" aria-label="Navegação móvel da área @Shell.Label">
            @foreach (var item in Shell.MobilePrimaryItems)
            {
                <a class="@ActiveClass(item)" href="@item.Href" aria-current="@AriaCurrent(item)"><AppIcon Name="@item.Icon" /><span>@item.Label</span></a>
            }
            @if (Shell.MobileOverflowItems.Count > 0)
            {
                <div class="mobile-navigation-more">
                    <button type="button" class="mobile-navigation-more__toggle @(OverflowIsActive ? "active" : null)" aria-expanded="@MobileMoreOpen" aria-controls="mobile-navigation-overflow" @onclick="ToggleMobileMore">
                        <AppIcon Name="more" /><span>Outros</span>
                    </button>
                    @if (MobileMoreOpen)
                    {
                        <div id="mobile-navigation-overflow" class="mobile-navigation-more__menu">
                            @foreach (var item in Shell.MobileOverflowItems)
                            {
                                <a class="@ActiveClass(item)" href="@item.Href" aria-current="@AriaCurrent(item)" @onclick="CloseMobileMore"><AppIcon Name="@item.Icon" /><span>@item.Label</span></a>
                            }
                        </div>
                    }
                </div>
            }
        </nav>
    }
</div>
@if(ArrivalToast is not null){<aside class="arrival-toast" role="status" aria-live="polite"><strong>Paciente chegou</strong><span>Atendimento @ArrivalToast.AppointmentNumber · senha @ArrivalToast.QueueNumber</span><button type="button" @onclick="()=>OpenRealtimeAsync(ArrivalToast)">Abrir atendimento</button></aside>}
<div id="blazor-error-ui" data-nosnippet>
    <div class="fatal-error-card" role="alertdialog" aria-modal="true" aria-labelledby="fatal-error-title">
        <span class="fatal-error-icon" aria-hidden="true">!</span>
        <div><p>Não foi possível concluir</p><h2 id="fatal-error-title">Erro interno</h2></div>
        <p>Ocorreu um erro interno não classificado. Contate o administrador do sistema.</p>
        <a href="." class="reload">Recarregar a página</a>
        <span class="dismiss" role="button" tabindex="0" aria-label="Fechar mensagem">🗙</span>
    </div>
</div>

@code {
    private ShellDefinition Shell { get; set; } = ShellNavigationCatalog.Resolve("/");
    private IJSObjectReference? module;
    private IJSObjectReference? notificationModule;
    private DotNetObjectReference<MainLayout>? selfReference;
    private WebCurrentAccount? Account;
    private readonly List<DoctorNotification> Notifications = [];
    private DoctorNotification? ArrivalToast;
    private bool NotificationConnected, PopupEnabled, SoundEnabled, SoundMuted, MarkReadOnOpen = true;
    private int SoundVolume = 60;
    private int UnreadCount => Notifications.Count(x => !x.IsRead);
    private string NotificationLabel => UnreadCount == 0 ? "Notificações de chegada" : $"Notificações de chegada: {UnreadCount} não lida(s)";
    private bool IdentityResolved;
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private bool IsProtectedPath => ShellNavigationCatalog.IsWorkspacePath(CurrentPath);
    private bool IsWorkspace => Shell.Profile != ShellProfile.Public;
    private bool OverflowIsActive => Shell.MobileOverflowItems.Any(IsActive);
    private bool MobileMoreOpen;
    private ApplicationErrorBoundary? PageErrorBoundary;

    protected override void OnInitialized() => Navigation.LocationChanged += HandleLocationChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/identity-access.js");
        await ResolveIdentityAsync();
    }
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        PageErrorBoundary?.Recover();
        MobileMoreOpen = false;
        IdentityResolved = !ShellNavigationCatalog.IsWorkspacePath(new Uri(args.Location).AbsolutePath);
        Shell = ShellNavigationCatalog.Resolve("/");
        _ = InvokeAsync(ResolveIdentityAsync);
    }
    private async Task ResolveIdentityAsync()
    {
        if (module is null) return;
        try { Account = await module.InvokeAsync<WebCurrentAccount?>("tryGetCurrent", Backend.BaseUrl.ToString()); }
        catch (JSException) { Account = null; }
        var path = CurrentPath;
        if (ShellNavigationCatalog.IsWorkspacePath(path))
        {
            if (Account is null) { Navigation.NavigateTo("/acesso?estado=sessao-expirada", true); return; }
            if (!ShellNavigationCatalog.OwnsPath(Account.Role, path)) { Navigation.NavigateTo(Account.Destination, true); return; }
            Shell = ShellNavigationCatalog.ResolveRole(Account.Role);
            if (Account.Role == "doctor" && !NotificationConnected) await ConnectNotificationsAsync();
        }
        else Shell = ShellNavigationCatalog.Resolve("/");
        IdentityResolved = true;
        await InvokeAsync(StateHasChanged);
    }
    private async Task ConnectNotificationsAsync()
    {
        notificationModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/doctor-notifications.js");
        selfReference = DotNetObjectReference.Create(this);
        var data = await notificationModule.InvokeAsync<DoctorNotificationsData>("connect", Backend.BaseUrl.ToString(), selfReference);
        Notifications.Clear(); Notifications.AddRange(data.Items); PopupEnabled = data.PopupEnabled; SoundEnabled = data.SoundEnabled; SoundVolume = data.SoundVolume; MarkReadOnOpen = data.MarkReadOnOpen; NotificationConnected = true;
    }
    [JSInvokable]
    public async Task ReceiveArrival(DoctorRealtimeNotification message)
    {
        var item = new DoctorNotification(message.Id, message.AppointmentId, message.AppointmentNumber, message.QueueNumber, message.StartsAtUtc, message.IsRead, message.CreatedAtUtc, message.RowVersion);
        if (Notifications.All(x => x.Id != item.Id)) Notifications.Insert(0, item);
        PopupEnabled = message.PopupEnabled; SoundEnabled = message.SoundEnabled; SoundVolume = message.SoundVolume;
        if (PopupEnabled) ArrivalToast = item;
        if (SoundEnabled && !SoundMuted && notificationModule is not null) await notificationModule.InvokeAsync<bool>("play", SoundVolume);
        await InvokeAsync(StateHasChanged);
    }
    private async Task OpenNotificationAsync(DoctorNotification item)
    {
        if (MarkReadOnOpen && !item.IsRead) await ReadNotificationAsync(item);
        Navigation.NavigateTo($"/medico/atendimentos/{item.AppointmentId}");
    }
    private async Task ReadNotificationAsync(DoctorNotification item)
    {
        if (item.IsRead || module is null) return;
        await module.InvokeAsync<object?>("send", Backend.BaseUrl.ToString(), $"api/v1/doctor/notifications/{item.Id}/read", new { rowVersion = item.RowVersion });
        var index = Notifications.FindIndex(x => x.Id == item.Id);
        if (index >= 0) Notifications[index] = item with { IsRead = true, RowVersion = item.RowVersion + 1 };
    }
    private Task OpenRealtimeAsync(DoctorNotification item) { ArrivalToast=null; return OpenNotificationAsync(item); }
    private async Task ReadAllAsync(){if(module is null)return;await module.InvokeAsync<object?>("send",Backend.BaseUrl.ToString(),"api/v1/doctor/notifications/read-all",new{});for(var i=0;i<Notifications.Count;i++)Notifications[i]=Notifications[i] with{IsRead=true};}
    private async Task LogoutAsync()
    {
        if (module is null) return;
        try { await module.InvokeAsync<object?>("send", Backend.BaseUrl.ToString(), "api/v1/auth/logout", new { }); } catch (JSException) { }
        Navigation.NavigateTo("/acesso", true);
    }
    private string? ActiveClass(ShellNavigationItem item) => IsActive(item) ? "active" : null;
    private void ToggleMobileMore() => MobileMoreOpen = !MobileMoreOpen;
    private void CloseMobileMore() => MobileMoreOpen = false;
    private string? AriaCurrent(ShellNavigationItem item) => IsActive(item) ? "page" : null;
    private bool IsActive(ShellNavigationItem item)
    {
        var current = new Uri(Navigation.Uri);
        var target = new Uri(new Uri(Navigation.BaseUri), item.Href);
        return string.Equals(current.AbsolutePath.TrimEnd('/'), target.AbsolutePath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
            && string.Equals(current.Fragment, target.Fragment, StringComparison.OrdinalIgnoreCase);
    }
    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        if (notificationModule is not null) { try { await notificationModule.InvokeVoidAsync("disconnect"); } catch (JSDisconnectedException) { } try { await notificationModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
        selfReference?.Dispose();
        if (module is not null) try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
