<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal"
        aria-labelledby="reconnect-title"
        aria-describedby="reconnect-description"
        data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <h2 id="reconnect-title">Conexão com o ViverApp</h2>
        <p id="reconnect-description" class="components-reconnect-first-attempt-visible">
            Restabelecendo a conexão com segurança…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Ainda não foi possível conectar. Nova tentativa em <span id="components-seconds-to-next-attempt"></span> segundos.
        </p>
        <p class="components-reconnect-failed-visible">
            A conexão não voltou. Tente novamente ou recarregue a página.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible" type="button">
            Tentar novamente
        </button>
        <p class="components-pause-visible">
            A sessão foi pausada para economizar recursos.
        </p>
        <p class="components-resume-failed-visible">
            Não foi possível retomar a sessão. Tente novamente ou recarregue a página.
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible" type="button">
            Retomar sessão
        </button>
    </div>
</dialog>
