<div class="appointment-view-toggle" role="group" aria-label="Modo de exibição dos atendimentos">
    <button type="button" class="button button--secondary button--small" aria-pressed="@(Mode == "cards")" disabled="@Disabled" @onclick='() => Changed.InvokeAsync("cards")'>Cards</button>
    <button type="button" class="button button--secondary button--small" aria-pressed="@(Mode == "compact")" disabled="@Disabled" @onclick='() => Changed.InvokeAsync("compact")'>Lista compacta</button>
</div>

@code {
    [Parameter, EditorRequired] public string Mode { get; set; } = "cards";
    [Parameter, EditorRequired] public EventCallback<string> Changed { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
