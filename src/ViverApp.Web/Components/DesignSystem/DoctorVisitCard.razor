@using static ViverApp.Web.DoctorLabels
<article class="surface patient-visit doctor-card appointment-card--@PatientLabels.StatusCss(Model.StatusCode)" aria-label="@($"{Model.Service}, {Model.StartsAtUtc:dd/MM/yyyy}")">
    <div class="patient-visit__top"><div><p class="eyebrow">Atendimento @Model.AppointmentNumber · @Category(Model.CategoryCode)</p><h2>@Model.PatientName</h2><p>@(Model.Services.Count>0?string.Join(" + ",Model.Services.Select(x=>x.Name)):Model.Service) · @(Model.PatientAge.HasValue ? $"{Model.PatientAge} anos" : "idade não informada")</p></div><span class="badge appointment-status" aria-label="Estado: @Status(Model.StatusCode)"><span aria-hidden="true">@PatientLabels.StatusFace(Model.StatusCode)</span> @Status(Model.StatusCode)</span></div>
    <div class="doctor-card__meta"><span class="badge">@Modality(Model.ModalityCode)</span><span class="badge">@(Model.RequiresPayment ? Status(Model.PaymentStatus) : "Sem cobrança")</span>@if(Model.RescheduleHistory.Count>0){<span class="badge badge--rescheduled">Reagendado @Model.RescheduleHistory.Count vez(es)</span>}@if(Model.DiscountPercent>0){<span class="badge">Premium -@Model.DiscountPercent%</span>}@if(Model.PointDiscountAmount>0){<span class="badge">Desconto pontual -@Money(Model.PointDiscountAmount)</span>}</div>
    <dl class="patient-facts"><div><dt>Data e horário</dt><dd>@Model.StartsAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Duração</dt><dd>@((int)(Model.EndsAtUtc-Model.StartsAtUtc).TotalMinutes) min</dd></div><div><dt>Valor</dt><dd>@if(!Model.RequiresPayment){<strong>Sem cobrança</strong>}else if(Model.DiscountPercent>0||Model.PointDiscountAmount>0){<s>@Money(Model.BasePriceAmount)</s> <strong>@Money(Model.PriceAmount)</strong>}else{@Money(Model.PriceAmount)}</dd></div><div><dt>Local</dt><dd>@(Model.ModalityCode=="online"?"Sala online":"Clínica")</dd></div>@if(Model.ArrivalQueueNumber.HasValue){<div><dt>Senha de chegada</dt><dd class="arrival-number">@Model.ArrivalQueueNumber</dd></div>}</dl>
    @if(Model.PatientNotes is not null){<p class="patient-notes"><strong>Observações autorizadas:</strong> @Model.PatientNotes</p>}
    @if(Model.CancellationReason is not null){<p><strong>Motivo:</strong> @Model.CancellationReason</p>}
    <AppointmentRescheduleTimeline Items="Model.RescheduleHistory" />
    <div class="patient-actions">@if(ShowDetailsLink){<a class="button button--secondary button--small" href="@BasePath/atendimentos/@Model.Id">Detalhes e ações</a>}@if(Model.CanJoinOnline){<a class="button button--small" href="@BasePath/online/@Model.Id">Entrar na chamada</a>}@if(Model.RescheduledToAppointmentId is ulong next){<a href="@BasePath/atendimentos/@next">Ver novo horário</a>}</div>
</article>
@code { [Parameter, EditorRequired] public DoctorAppointment Model { get; set; } = null!; [Parameter] public bool ShowDetailsLink { get; set; } = true; [Parameter] public string BasePath { get; set; } = "/medico"; }
