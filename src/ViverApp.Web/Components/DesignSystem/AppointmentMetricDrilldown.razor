@if (Numbers is not null)
{
    <section class="surface metric-drilldown" aria-live="polite" aria-label="Detalhamento do indicador">
        <div><p class="eyebrow">Origem do indicador</p><h2>@Title</h2></div>
        @if (Numbers.Count == 0)
        {
            <p>Nenhum atendimento compõe este total no período.</p>
        }
        else
        {
            <p>@Numbers.Count atendimento(s):</p>
            <div class="metric-drilldown__numbers">
                @foreach (var number in Numbers) { <span class="badge">#@number</span> }
            </div>
        }
        <button class="button button--secondary button--small" type="button" @onclick="Close">Fechar detalhamento</button>
    </section>
}

@code {
    [Parameter] public string Title { get; set; } = "Detalhamento";
    [Parameter] public IReadOnlyList<ulong>? Numbers { get; set; }
    [Parameter] public EventCallback Close { get; set; }
}
