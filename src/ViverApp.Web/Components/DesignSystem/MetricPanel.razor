@using ViverApp.Web
<section class="surface administrator-card"><h2>@Title</h2>@if(Items.Count==0){<p class="muted">Sem dados no período.</p>}else{<div class="administrator-bars">@foreach(var item in Items){<div class="administrator-bar"><strong>@AdministratorLabels.Metric(item.Label)</strong><span aria-hidden="true"><i style="width:@Width(item)%"></i></span><output>@(MoneyValues?ManagerLabels.Money(item.Value):item.Count.ToString())</output></div>}</div><div class="data-region"><table class="data-table"><thead><tr><th>Categoria</th><th>Quantidade</th><th>Valor</th></tr></thead><tbody>@foreach(var item in Items){<tr><td>@AdministratorLabels.Metric(item.Label)</td><td>@item.Count</td><td>@(MoneyValues?ManagerLabels.Money(item.Value):item.Value.ToString("0.##"))</td></tr>}</tbody></table></div>}</section>
@code{[Parameter,EditorRequired]public string Title{get;set;}="";[Parameter,EditorRequired]public IReadOnlyList<AdministratorMetric> Items{get;set;}=[];[Parameter]public bool MoneyValues{get;set;}private decimal Width(AdministratorMetric item){var max=Items.Select(x=>MoneyValues?x.Value:x.Count).DefaultIfEmpty(1).Max();var value=MoneyValues?item.Value:item.Count;return max<=0?0:Math.Clamp(value/max*100,2,100);}}
