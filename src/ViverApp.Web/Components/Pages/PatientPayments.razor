@page "/paciente/pagamentos"
@page "/paciente/pagamentos/retorno"
@inherits PatientPageBase
@using System.Globalization
@using static ViverApp.Web.PatientLabels
<PageTitle>Pagamentos | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Paciente</p><h1 class="page-title">Meus pagamentos</h1><p class="page-description">Confira valores, escolha como pagar e acompanhe a confirmação.</p></div><a class="button button--secondary" href="/paciente/agenda">Minha agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<div class="patient-tabs" aria-label="Visualização de pagamentos"><button class="button @(View=="pending"?null:"button--secondary")" aria-pressed="@(View=="pending")" disabled="@Busy" @onclick='()=>ChangeView("pending")'>Pagar</button><button class="button @(View=="history"?null:"button--secondary")" aria-pressed="@(View=="history")" disabled="@Busy" @onclick='()=>ChangeView("history")'>Histórico</button></div>
<MobileFilterPanel AriaLabel="Filtros de pagamentos"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid">
    <div class="field"><label for="payments-from">De</label><input id="payments-from" type="date" @bind="From" /></div><div class="field"><label for="payments-until">Até</label><input id="payments-until" type="date" @bind="Until" /></div>
    <div class="field"><label for="payments-min">Valor mínimo</label><input id="payments-min" type="number" min="0" step="0.01" @bind="Min" /></div><div class="field"><label for="payments-max">Valor máximo</label><input id="payments-max" type="number" min="0" step="0.01" @bind="Max" /></div>
    <div class="field"><label for="payments-method">Método</label><select id="payments-method" @bind="MethodFilter"><option value="">Todos</option>@foreach(var method in new[]{"PIX","CREDIT_CARD","DEBIT_CARD","BOLETO"}){<option value="@method">@Method(method)</option>}</select></div>
    <div class="field"><label for="payments-location">Local</label><select id="payments-location" @bind="Location"><option value="">Todos</option><option value="web">Pelo site</option><option value="clinic">Na clínica</option></select></div>
    <div class="field"><label for="payments-status">Estado</label><select id="payments-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var status in new[]{"unpaid","pending","authorized","paid","failed","canceled","refunded"}){<option value="@status">@Status(status)</option>}</select></div>
    </div><div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear" disabled="@Busy">Limpar filtros</button></div></form></MobileFilterPanel>
@if(Loading){<LoadingSkeleton Lines="4" />}
else if(PageData?.Items.Count>0){<p class="muted" role="status">@PageData.TotalCount registro(s)</p><div class="patient-grid">@foreach(var item in PageData.Items){<article class="surface patient-panel"><span class="badge">@Status(item.StatusCode)</span><h2>@item.Service</h2><p>@item.DoctorName · @AtClinic(item.StartsAtUtc)</p><strong>@Money(item.Amount)</strong><p>@(item.Location=="clinic"?"Na clínica":"Pelo site") · @Method(item.Method)</p>@if(item.ModalityCode=="online"){<p>Atendimento online: pagamento pelo site.</p>}<button class="button button--secondary" @onclick="()=>Select(item.AppointmentId)" disabled="@Busy">@(item.CanPay?"Escolher pagamento":"Ver detalhe / recibo")</button></article>}</div>}
else{<InterfaceState Title="Nenhum pagamento encontrado" Description="Quando houver uma cobrança, ela aparecerá aqui. Você também pode ajustar os filtros." Icon="card" />}
<nav class="patient-pagination" aria-label="Páginas de pagamentos"><button class="button button--secondary" @onclick="()=>PageChange(-1)" disabled="@(Busy||Page==1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="()=>PageChange(1)" disabled="@(Busy||Page*12>=(PageData?.TotalCount??0))">Próxima</button></nav>
@if(Selected is not null)
{
    <section id="payment-detail" class="surface patient-panel patient-section" tabindex="-1" aria-labelledby="payment-title"><p class="eyebrow">Atendimento @Selected.Appointment.AppointmentNumber</p><h2 id="payment-title">@(Payment?.StatusCode=="paid"?"Recibo de pagamento":"Pagamento seguro")</h2><p>@Selected.Appointment.AppointmentTypeName · @Selected.Appointment.DoctorName</p><h3>@Money(Payment?.Amount??Selected.Appointment.PriceAmount)</h3><p role="status">@Status(Payment?.StatusCode??Selected.PaymentStatus)</p>
        @if(Payment is not null){<dl class="patient-facts"><div><dt>Referência</dt><dd>#@Payment.Id</dd></div><div><dt>Atualizado em</dt><dd>@AtClinic(Payment.UpdatedAtUtc)</dd></div>@if(Payment.PaidAtUtc.HasValue){<div><dt>Pago em</dt><dd>@AtClinic(Payment.PaidAtUtc.Value)</dd></div>}@if(Payment.CheckoutExpiresAtUtc.HasValue){<div><dt>Checkout válido até</dt><dd>@AtClinic(Payment.CheckoutExpiresAtUtc.Value)</dd></div>}</dl>}
        @if(Selected.CanPay)
        {
            <div class="patient-actions">@if(Payment is null){<button class="button" @onclick="CreateCheckout" disabled="@Busy">Pagar pelo site com PagBank</button>@if(Selected.Appointment.ModalityCode=="in_person" && CanClinic){<button class="button button--secondary" @onclick="OpenClinicConfirmation" disabled="@Busy">Pagar na clínica</button>}}
                @if(Payment?.CheckoutUrl is not null && Payment.StatusCode is "pending" or "authorized" && Payment.CheckoutExpiresAtUtc > DateTime.UtcNow){<a class="button" href="@Payment.CheckoutUrl" rel="noreferrer">Continuar no PagBank ↗</a>}
            </div>
        }
        @if(Payment is not null){<button class="button button--secondary" @onclick="()=>Run(RefreshPayment)" disabled="@Busy">Atualizar situação</button>}
        @if(Payment?.CheckoutExpiresAtUtc<=DateTime.UtcNow && Payment.StatusCode=="pending"){<p>O checkout expirou. Atualize a situação antes de tentar pagar novamente ou fale com a clínica.</p>}
        <p class="field-hint">A situação é consultada automaticamente a cada 30 segundos enquanto houver pagamento em andamento, por até 10 minutos. Voltar do checkout não confirma o pagamento.</p>
    </section>
    <dialog id="clinic-payment" class="patient-dialog" aria-labelledby="clinic-payment-title"><h2 id="clinic-payment-title">Pagar na clínica?</h2><p>O valor de @Money(Selected.Appointment.PriceAmount) continuará pendente até a clínica registrar o recebimento.</p><div class="patient-actions"><button class="button" @onclick="ChooseClinic" disabled="@Busy">Confirmar escolha</button><button class="button button--secondary" @onclick="CloseClinic">Voltar</button></div></dialog>
}
@code {
    [SupplyParameterFromQuery(Name="appointmentId")] public string? AppointmentQuery {get;set;}
    private WebPage<PatientPayment>? PageData;
    private PatientAppointment? Selected;
    private PatientClinic? Clinic;
    private WebPayment? Payment;
    private bool CanClinic;
    private bool FocusPayment;
    private string View="pending", MethodFilter="", Location="", StatusFilter="";
    private string? CheckoutKey;
    private int Page=1;
    private DateTime? From,Until;
    private decimal? Min,Max;
    private readonly CancellationTokenSource PollCancellation=new();
    private Task? PollTask;
    protected override async Task OnAfterRenderAsync(bool firstRender) { await base.OnAfterRenderAsync(firstRender); if (!firstRender && FocusPayment && Module is not null) { FocusPayment = false; await Module.InvokeVoidAsync("focus", "payment-detail"); } }
    protected override async Task Load(){Clinic=await Get<PatientClinic>("api/v1/patient/experience/clinic");await LoadList();if(ulong.TryParse(AppointmentQuery,out var id))await SelectCore(id);PollTask??=Poll();}
    private async Task LoadList()=>PageData=await Get<WebPage<PatientPayment>>($"api/v1/patient/experience/payments?page={Page}&view={View}&from={From:yyyy-MM-dd}&until={Until:yyyy-MM-dd}&min={Min?.ToString(CultureInfo.InvariantCulture)}&max={Max?.ToString(CultureInfo.InvariantCulture)}&method={MethodFilter}&location={Location}&status={StatusFilter}");
    private Task Apply()=>Run(async()=>{Page=1;await LoadList();});
    private Task Clear()=>Run(async()=>{From=Until=null;Min=Max=null;MethodFilter=Location=StatusFilter="";Page=1;await LoadList();});
    private Task ChangeView(string view)=>Run(async()=>{View=view;Page=1;await LoadList();});
    private Task PageChange(int delta)=>Run(async()=>{Page+=delta;await LoadList();});
    private Task Select(ulong id)=>Run(async()=>{await SelectCore(id);StateHasChanged();});
    private async Task SelectCore(ulong id)
    {
        Selected=await Get<PatientAppointment>($"api/v1/patient/experience/appointments/{id}");Payment=null;CheckoutKey=$"checkout-{Guid.NewGuid():N}";FocusPayment=true;
        if (Selected?.Appointment.RescheduledToAppointmentId is ulong successor) { Navigation.NavigateTo($"/paciente/pagamentos?appointmentId={successor}", true); return; }
        CanClinic=Selected?.CanChooseClinic??false;
        if(Selected?.PaymentStatus!="unpaid")Payment=await Get<WebPayment>($"api/v1/patient/appointments/{id}/payment");
    }
    private Task CreateCheckout()=>Run(async()=>{Payment=await Request<WebPayment>($"api/v1/patient/appointments/{Selected!.Appointment.Id}/payment/checkout","POST",new{},CheckoutKey);Notice="Confira o valor e continue no ambiente do PagBank.";});
    private async Task RefreshPayment(){if(Selected is not null && Payment is not null){Payment=await Get<WebPayment>($"api/v1/patient/appointments/{Selected.Appointment.Id}/payment?refresh=true");Selected=await Get<PatientAppointment>($"api/v1/patient/experience/appointments/{Selected.Appointment.Id}");}}
    private async Task OpenClinicConfirmation()=>await Module!.InvokeVoidAsync("showDialog","clinic-payment");
    private async Task CloseClinic()=>await Module!.InvokeVoidAsync("closeDialog","clinic-payment");
    private Task ChooseClinic()=>Run(async()=>{await CloseClinic();await Request<object>($"api/v1/patient/experience/appointments/{Selected!.Appointment.Id}/pay-at-clinic","POST",new{});Selected=await Get<PatientAppointment>($"api/v1/patient/experience/appointments/{Selected.Appointment.Id}");await LoadList();Notice="Pagamento na clínica selecionado. O valor ainda está pendente.";});
    private async Task Poll(){using var timer=new PeriodicTimer(TimeSpan.FromSeconds(30));try{for(var i=0;i<20 && await timer.WaitForNextTickAsync(PollCancellation.Token);i++){await InvokeAsync(async()=>{if(!Busy && Payment?.StatusCode is "pending" or "authorized"){await Run(RefreshPayment);StateHasChanged();}});}}catch(OperationCanceledException){}}
    private string AtClinic(DateTime value)=>TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.SpecifyKind(value,DateTimeKind.Utc),Clinic?.Timezone??"America/Sao_Paulo").ToString("dd/MM/yyyy HH:mm");
    public override async ValueTask DisposeAsync(){await PollCancellation.CancelAsync();if(PollTask is not null)await PollTask;PollCancellation.Dispose();await base.DisposeAsync();}
}
