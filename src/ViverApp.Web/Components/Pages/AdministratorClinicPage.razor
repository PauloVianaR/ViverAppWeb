@page "/administracao/clinica"
@inherits AdministratorPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Clínica | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Clínica única</h1><p class="page-description">Informações, serviços, horários, feriados e configurações Web tipadas.</p></div><a class="button button--secondary" href="/acesso">Renovar sessão elevada</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="status">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="9"/>}else{
<section class="surface patient-panel"><div class="section-heading"><div><p class="eyebrow">Informações</p><h2>Dados institucionais</h2></div></div><form @onsubmit="SaveClinic" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="legal">Razão social</label><input id="legal" @bind="LegalName" required maxlength="200"/></div><div class="field"><label for="display">Nome fantasia</label><input id="display" @bind="DisplayName" required maxlength="120"/></div><div class="field"><label for="tax">CNPJ</label><input id="tax" @bind="TaxId" inputmode="numeric" maxlength="14"/></div><div class="field"><label for="clinic-email">E-mail</label><input id="clinic-email" type="email" @bind="Email"/></div><div class="field"><label for="clinic-phone">Telefone E.164</label><input id="clinic-phone" @bind="Phone" placeholder="+5531999999999"/></div><div class="field"><label for="clinic-cep">CEP</label><input id="clinic-cep" @bind="PostalCode" @bind:event="oninput" @onblur="LookupPostalCode" inputmode="numeric" maxlength="9" placeholder="00000-000"/></div><div class="field"><label for="street">Logradouro</label><input id="street" @bind="Street"/></div><div class="field"><label for="number">Número</label><input id="number" @bind="Number"/></div><div class="field"><label for="complement">Complemento</label><input id="complement" @bind="Complement"/></div><div class="field"><label for="district">Bairro</label><input id="district" @bind="District"/></div><div class="field"><label for="city">Cidade</label><input id="city" @bind="City"/></div><div class="field"><label for="state">UF</label><input id="state" @bind="State" maxlength="2"/></div></div><button class="button" disabled="@Busy">Salvar clínica</button></form></section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Serviços</p><h2>Consultas, exames, cirurgias e procedimentos</h2></div><button class="button" @onclick="NewService">Adicionar serviço</button></div><MobileFilterPanel AriaLabel="Filtros dos tipos de atendimento"><form @onsubmit="FilterServices" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="admin-service-search">Buscar por texto</label><input id="admin-service-search" @bind="ServiceSearch" maxlength="120" placeholder="Nome do serviço" /></div><div class="field"><label for="admin-service-filter-category">Tipo de atendimento</label><select id="admin-service-filter-category" @bind="ServiceCategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div></div><div class="administrator-actions"><button class="button">Filtrar</button><button type="button" class="button button--secondary" @onclick="ClearServiceFilters">Limpar</button></div></form></MobileFilterPanel><div class="administrator-grid">@foreach(var item in Services){<article class="surface administrator-card"><span class="badge @(item.IsActive?"badge--success":"badge--warning")">@(item.IsActive?"Ativo":"Inativo")</span><h3>@item.Name</h3><p>@item.Description</p><p><strong>@Money(item.PriceAmount)</strong> · @item.DurationMinutes min · @Category(item.CategoryCode)</p><div class="administrator-actions"><button class="button button--secondary" @onclick="()=>EditService(item)">Editar</button><button class="button button--secondary" @onclick="()=>ToggleService(item)">@(item.IsActive?"Desativar":"Ativar")</button></div></article>}</div></section>
<section class="administrator-grid patient-section"><div><div class="section-heading"><div><p class="eyebrow">Horários</p><h2>Grade semanal</h2></div><button class="button" @onclick="NewHour">Novo período</button></div>@foreach(var item in Hours){<article class="surface administrator-card"><strong>@Day(item.DayOfWeek)</strong><p>@item.StartTime.ToString("hh\\:mm")–@item.EndTime.ToString("hh\\:mm") · @(item.IsActive?"Aberto":"Fechado")</p><div class="administrator-actions"><button class="button button--secondary" @onclick="()=>EditHour(item)">Editar</button><button class="button button--danger" @onclick="()=>DeleteHour(item)">Remover</button></div></article>}</div><div><div class="section-heading"><div><p class="eyebrow">Bloqueios</p><h2>Feriados</h2></div><button class="button" @onclick="NewHoliday">Novo feriado</button></div>@foreach(var item in Holidays){<article class="surface administrator-card"><strong>@item.HolidayDate.ToString("dd/MM/yyyy") · @item.Name</strong><p>@(item.StartTime is null?"Dia inteiro":$"{item.StartTime:hh\\:mm}–{item.EndTime:hh\\:mm}") · @(item.IsAnnual?"recorrência anual":"somente este ano")</p><div class="administrator-actions"><button class="button button--secondary" @onclick="()=>EditHoliday(item)">Editar</button><button class="button button--danger" @onclick="()=>DeleteHoliday(item)">Remover</button></div></article>}</div></section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Sistema</p><h2>Configurações Web</h2></div></div><div class="administrator-grid">@foreach(var item in Settings){<article class="surface administrator-card administrator-setting"><label for="setting-@item.Key"><strong>@(item.Description??item.Key)</strong></label><small>@item.Key</small><textarea id="setting-@item.Key" value="@SettingValues[item.Key]" @onchange="e=>SettingValues[item.Key]=e.Value?.ToString()??string.Empty"></textarea><button class="button button--secondary" @onclick="()=>SaveSetting(item)">Salvar valor tipado</button></article>}</div></section>}
<dialog id="service-dialog"><form method="dialog"><button class="dialog-close" aria-label="Fechar">×</button></form><h2>@(EditingService is null?"Novo serviço":"Editar serviço")</h2><div class="field"><label for="service-name">Nome</label><input id="service-name" @bind="ServiceName"/></div><div class="field"><label for="service-description">Descrição</label><textarea id="service-description" @bind="ServiceDescription"></textarea></div><div class="administrator-filter-grid"><div class="field"><label for="service-category">Tipo</label><select id="service-category" @bind="ServiceCategory"><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div><div class="field"><label for="service-modality">Modalidade</label><select id="service-modality" @bind="ServiceModality"><option value="in_person">Presencial</option><option value="online">Online</option><option value="both">Ambas</option></select></div><div class="field"><label for="service-duration">Duração</label><input id="service-duration" type="number" min="5" max="480" @bind="ServiceDuration"/></div><div class="field"><label for="service-price">Preço</label><input id="service-price" type="number" min="0" step="0.01" @bind="ServicePrice"/></div></div><button class="button" @onclick="SaveService">@(EditingService is null?"Cadastrar":"Salvar alterações")</button></dialog>
<dialog id="hour-dialog"><form method="dialog"><button class="dialog-close" aria-label="Fechar">×</button></form><h2>@(EditingHour is null?"Novo horário":"Editar horário")</h2><div class="administrator-filter-grid"><div class="field"><label for="hour-day">Dia</label><select id="hour-day" @bind="HourDay">@for(byte i=0;i<7;i++){<option value="@i">@Day(i)</option>}</select></div><div class="field"><label for="hour-start">Início</label><input id="hour-start" type="time" @bind="HourStart"/></div><div class="field"><label for="hour-end">Fim</label><input id="hour-end" type="time" @bind="HourEnd"/></div></div><button class="button" @onclick="SaveHour">@(EditingHour is null?"Adicionar":"Salvar alterações")</button></dialog>
<dialog id="holiday-dialog"><form method="dialog"><button class="dialog-close" aria-label="Fechar">×</button></form><h2>@(EditingHoliday is null?"Novo feriado ou bloqueio":"Editar feriado ou bloqueio")</h2><div class="field"><label for="holiday-name">Nome</label><input id="holiday-name" @bind="HolidayName"/></div><div class="field"><label for="holiday-date">Data</label><input id="holiday-date" type="date" @bind="HolidayDate"/></div><label><input type="checkbox" @bind="HolidayAnnual"/> Repetir todos os anos</label><p class="muted">O bloqueio afeta os horários futuros que coincidirem com esta data.</p><button class="button" @onclick="SaveHoliday">@(EditingHoliday is null?"Adicionar dia inteiro":"Salvar alterações")</button></dialog>
@code{private AdministratorClinic? Clinic;private IReadOnlyList<AdministratorService> Services=[];private IReadOnlyList<AdministratorWeeklyHour> Hours=[];private IReadOnlyList<AdministratorHoliday> Holidays=[];private IReadOnlyList<AdministratorSetting> Settings=[];private readonly Dictionary<string,string> SettingValues=[];private string LegalName="",DisplayName="",TaxId="",Email="",Phone="",PostalCode="",Street="",Number="",Complement="",District="",City="",State="",ServiceSearch="",ServiceCategoryFilter="";private AdministratorService? EditingService;private string ServiceName="",ServiceDescription="",ServiceCategory="consultation",ServiceModality="in_person";private int ServiceDuration=30;private decimal ServicePrice;private AdministratorWeeklyHour? EditingHour;private byte HourDay=1;private TimeOnly HourStart=new(8,0),HourEnd=new(18,0);private AdministratorHoliday? EditingHoliday;private string HolidayName="";private DateTime HolidayDate=DateTime.Today;private bool HolidayAnnual;
protected override async Task Load(){Clinic=await Get<AdministratorClinic>("api/v1/clinic");await LoadServices();Hours=await Get<IReadOnlyList<AdministratorWeeklyHour>>("api/v1/clinic/weekly-hours")??[];var holidays=await Get<WebPage<AdministratorHoliday>>($"api/v1/clinic/holidays?page=1&pageSize=100&year={DateTime.Today.Year}");Holidays=holidays?.Items??[];Settings=await Get<IReadOnlyList<AdministratorSetting>>("api/v1/administrator/settings")??[];foreach(var s in Settings)SettingValues[s.Key]=s.ValueJson;if(Clinic is not null){LegalName=Clinic.LegalName;DisplayName=Clinic.DisplayName;TaxId=Clinic.TaxId??"";Email=Clinic.Email??"";Phone=Clinic.PhoneE164??"";PostalCode=Clinic.PostalCode??"";Street=Clinic.Street??"";Number=Clinic.Number??"";Complement=Clinic.Complement??"";District=Clinic.District??"";City=Clinic.City??"";State=Clinic.StateCode??"";}}
private async Task LoadServices(){var services=await Get<WebPage<AdministratorService>>($"api/v1/catalog/appointment-types?page=1&pageSize=100&includeInactive=true&search={Escape(ServiceSearch)}&category={ServiceCategoryFilter}");Services=services?.Items??[];}
private Task FilterServices()=>Run(LoadServices);private Task ClearServiceFilters()=>Run(async()=>{ServiceSearch=ServiceCategoryFilter="";await LoadServices();});
private Task SaveClinic()=>Run(async()=>{Clinic=await Request<AdministratorClinic>("api/v1/clinic","PUT",new{legalName=LegalName,displayName=DisplayName,taxId=Empty(Digits(TaxId)),email=Empty(Email),phoneE164=Empty(Phone),postalCode=Empty(Digits(PostalCode)),street=Empty(Street),number=Empty(Number),complement=Empty(Complement),district=Empty(District),city=Empty(City),stateCode=Empty(State)?.ToUpperInvariant(),timezoneName=Clinic!.TimezoneName,rowVersion=Clinic.RowVersion});Notice="Dados da clínica atualizados.";});
private Task LookupPostalCode()=>Run(async()=>{var digits=Digits(PostalCode);if(digits.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{digits}");if(address is null)return;PostalCode=$"{digits[..5]}-{digits[5..]}";Street=address.Street;Complement=address.Complement??Complement;District=address.District;City=address.City;State=address.StateCode;});
private Task NewService(){EditingService=null;ServiceName=ServiceDescription="";ServiceCategory="consultation";ServiceModality="in_person";ServiceDuration=30;ServicePrice=0;return Open("service-dialog");}
private Task EditService(AdministratorService item){EditingService=item;ServiceName=item.Name;ServiceDescription=item.Description??"";ServiceCategory=item.CategoryCode;ServiceModality=item.ModalityCode;ServiceDuration=item.DurationMinutes;ServicePrice=item.PriceAmount;return Open("service-dialog");}
private Task SaveService()=>Run(async()=>{var item=EditingService;var path=item is null?"api/v1/catalog/appointment-types":$"api/v1/catalog/appointment-types/{item.Id}";await Request<AdministratorService>(path,item is null?"POST":"PUT",new{name=ServiceName,description=Empty(ServiceDescription),categoryCode=ServiceCategory,modalityCode=ServiceModality,durationMinutes=ServiceDuration,priceAmount=ServicePrice,isActive=item?.IsActive??true,displayOrder=item?.DisplayOrder??Services.Count,rowVersion=item?.RowVersion??0});await Close("service-dialog");Notice=item is null?"Serviço criado.":"Serviço atualizado.";EditingService=null;await Load();});
private Task ToggleService(AdministratorService item)=>Run(async()=>{await Request<AdministratorService>($"api/v1/catalog/appointment-types/{item.Id}","PUT",new{name=item.Name,description=item.Description,categoryCode=item.CategoryCode,modalityCode=item.ModalityCode,durationMinutes=item.DurationMinutes,priceAmount=item.PriceAmount,isActive=!item.IsActive,displayOrder=item.DisplayOrder,rowVersion=item.RowVersion});Notice="Estado do serviço atualizado.";await Load();});
private Task NewHour(){EditingHour=null;HourDay=1;HourStart=new(8,0);HourEnd=new(18,0);return Open("hour-dialog");}private Task EditHour(AdministratorWeeklyHour item){EditingHour=item;HourDay=item.DayOfWeek;HourStart=TimeOnly.FromTimeSpan(item.StartTime);HourEnd=TimeOnly.FromTimeSpan(item.EndTime);return Open("hour-dialog");}
private Task SaveHour()=>Run(async()=>{var item=EditingHour;var path=item is null?"api/v1/clinic/weekly-hours":$"api/v1/clinic/weekly-hours/{item.Id}";await Request<AdministratorWeeklyHour>(path,item is null?"POST":"PUT",new{dayOfWeek=HourDay,startTime=HourStart.ToTimeSpan(),endTime=HourEnd.ToTimeSpan(),isActive=item?.IsActive??true,rowVersion=item?.RowVersion??0});await Close("hour-dialog");Notice=item is null?"Horário adicionado.":"Horário atualizado.";EditingHour=null;await Load();});private Task DeleteHour(AdministratorWeeklyHour item)=>Run(async()=>{await Request<object>($"api/v1/clinic/weekly-hours/{item.Id}?rowVersion={item.RowVersion}","DELETE",null);Notice="Horário removido.";await Load();});
private Task NewHoliday(){EditingHoliday=null;HolidayName="";HolidayDate=DateTime.Today;HolidayAnnual=false;return Open("holiday-dialog");}private Task EditHoliday(AdministratorHoliday item){EditingHoliday=item;HolidayName=item.Name;HolidayDate=item.HolidayDate.ToDateTime(TimeOnly.MinValue);HolidayAnnual=item.IsAnnual;return Open("holiday-dialog");}
private Task SaveHoliday()=>Run(async()=>{var item=EditingHoliday;var path=item is null?"api/v1/clinic/holidays":$"api/v1/clinic/holidays/{item.Id}";await Request<AdministratorHoliday>(path,item is null?"POST":"PUT",new{holidayDate=DateOnly.FromDateTime(HolidayDate),name=HolidayName,startTime=item?.StartTime,endTime=item?.EndTime,rowVersion=item?.RowVersion??0,isAnnual=HolidayAnnual});await Close("holiday-dialog");Notice=item is null?"Feriado adicionado.":"Feriado atualizado.";EditingHoliday=null;await Load();});private Task DeleteHoliday(AdministratorHoliday item)=>Run(async()=>{await Request<object>($"api/v1/clinic/holidays/{item.Id}?rowVersion={item.RowVersion}","DELETE",null);Notice="Feriado removido.";await Load();});
private Task SaveSetting(AdministratorSetting item)=>Run(async()=>{await Request<AdministratorSetting>($"api/v1/administrator/settings/{Escape(item.Key)}","PUT",new{valueJson=SettingValues[item.Key],rowVersion=item.RowVersion});Notice="Configuração atualizada.";await Load();});private static string Day(byte value)=>value switch{0=>"Domingo",1=>"Segunda-feira",2=>"Terça-feira",3=>"Quarta-feira",4=>"Quinta-feira",5=>"Sexta-feira",_=>"Sábado"};private static string Digits(string value)=>new(value.Where(char.IsAsciiDigit).ToArray());private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();}
