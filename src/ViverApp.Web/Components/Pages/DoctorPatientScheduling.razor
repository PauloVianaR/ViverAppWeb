@page "/medico/agendar"
@page "/medico/pacientes/{PatientId:long}/agendar"
@page "/psicologo/agendar"
@page "/psicologo/pacientes/{PatientId:long}/agendar"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pelo profissional</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">Escolha um paciente vinculado; o profissional autenticado permanece fixo.</p></div><a class="button button--secondary" href="@ProfessionalRoot/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else{
<section class="surface patient-panel doctor-summary"><div class="field"><label for="doctor-booking-patient">Paciente</label><select id="doctor-booking-patient" value="@SelectedPatientId" @onchange="PatientChanged"><option value="0">Selecione</option>@foreach(var patient in Patients){<option value="@patient.AccountId">@patient.FullName@(patient.IsPremium?" · Premium":"")</option>}</select></div>@if(Patient is not null){<p>@(Patient.IsPremium?$"Paciente Premium — {Patient.PremiumDiscountPercent:0.##}% de desconto aplicado automaticamente.":"Paciente sem benefício Premium ativo.")</p>}</section>
@if(Patient is not null){
<section class="surface patient-panel patient-section"><h2>1. Tipo e serviço</h2><p>Selecione um ou mais serviços do mesmo tipo base.</p><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(CategoryCode==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="field"><label for="doctor-service-search">Pesquisar serviço</label><input id="doctor-service-search" @bind="ServiceSearch" @bind:event="oninput" maxlength="100" placeholder="Digite parte do nome ou descrição" /></div><div class="doctor-service-list">@foreach(var service in VisibleServices){<label class="doctor-service"><input type="checkbox" checked="@(ServiceId==service.Id||AdditionalIds.Contains(service.Id))" disabled="@(ServiceId!=0&&service.ModalityCode!="both"&&service.ModalityCode!=ModalityCode)" @onchange="()=>ToggleService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @if(!service.RequiresPayment){<strong>Sem cobrança</strong>}else if(Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<s>@Money(service.PriceAmount)</s> <strong>@Money(Discounted(service.PriceAmount))</strong>}else{@Money(service.PriceAmount)}</small></span></label>}</div>@if(AdditionalIds.Count>0){<div class="field"><label for="doctor-booking-duration">Duração deste atendimento (minutos)</label><input id="doctor-booking-duration" type="number" min="5" max="720" step="1" @bind="CustomDurationMinutes" @bind:after="DurationChanged" /><p class="field-hint">Soma padrão dos serviços: @DefaultDuration min. A duração informada define os horários disponíveis.</p></div>}</section>
<section class="surface patient-panel patient-section"><h2>2. Modalidade, data e horário</h2><div class="field"><label for="booking-modality">Modalidade</label><select id="booking-modality" @bind="ModalityCode" @bind:after="ModalityChanged"><option value="in_person">Presencial</option><option value="online">Online</option></select></div>@if(CurrentService is not null&&DurationValid){<BookingAvailabilityCalendar @key="CalendarKey" SlotsApiPrefix="@CalendarApi" DateSelected="SelectDate" />}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="doctor-callout">O horário escolhido não está mais disponível. Escolha outro dia.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="booking-notes">Observações autorizadas</label><textarea id="booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviços</dt><dd>@string.Join(" + ",SelectedServices.Select(x=>x.Name))</dd></div><div><dt>Duração total</dt><dd>@EffectiveDuration min</dd></div><div><dt>Profissional</dt><dd>Você</dd></div><div><dt>Data e horário</dt><dd>@(Selected.HasValue?$"{Date:dd/MM/yyyy} às {Selected:HH:mm}":"Selecione um horário")</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor base</dt><dd>@(BaseTotal>0?Money(BaseTotal):"Sem cobrança")</dd></div>@if(BaseTotal>0&&Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<div><dt>Valor Premium</dt><dd><strong>@Money(Discounted(BaseTotal))</strong> · @Patient.PremiumDiscountPercent.ToString("0.##")% de desconto</dd></div>}<div><dt>Pagamento</dt><dd>@(BaseTotal>0?(ModalityCode=="online"?"Online":"Na clínica"):"Não necessário")</dd></div></dl>}<button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||!Selected.HasValue||!DurationValid)">Confirmar agendamento</button></section>}}
@code {
    [Parameter] public long PatientId { get; set; }
    [SupplyParameterFromQuery(Name="patient")] public long? PatientQuery { get; set; }
    private DoctorPatient? Patient; private IReadOnlyList<DoctorPatient> Patients=[]; private IReadOnlyList<ProfessionalService> Services=[]; private IReadOnlyList<WebAvailableSlot> Slots=[];
    private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia"),("procedure","Procedimento")];
    private string CategoryCode="consultation",ModalityCode="in_person",Notes="",ServiceSearch=""; private uint ServiceId; private readonly HashSet<uint> AdditionalIds=[]; private ulong SelectedPatientId; private DateTime Date=DateTime.Today.AddDays(1); private TimeOnly? Selected; private bool SlotsLoaded;
    private string AdditionalQuery=>string.Concat(AdditionalIds.Order().Select(id=>$"&additionalAppointmentTypeIds={id}"));
    private string CalendarKey=>$"{SelectedPatientId}-{ServiceId}-{string.Join("-",AdditionalIds.Order())}-{ModalityCode}-{CustomDurationMinutes}";
    private string CalendarApi=>$"api/v1/doctor/booking/slots?patientAccountId={SelectedPatientId}&appointmentTypeId={ServiceId}&modality={ModalityCode}{AdditionalQuery}{DurationQuery}";
    private ProfessionalService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId); private IEnumerable<ProfessionalService> VisibleServices=>Services.Where(x=>x.Offered&&x.IsActive&&x.CategoryCode==CategoryCode&&(string.IsNullOrWhiteSpace(ServiceSearch)||x.Name.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)||(x.Description?.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)??false))).OrderBy(x=>x.Name,StringComparer.CurrentCultureIgnoreCase);
    private IReadOnlyList<ProfessionalService> SelectedServices=>Services.Where(x=>x.Id==ServiceId||AdditionalIds.Contains(x.Id)).OrderBy(x=>x.Id==ServiceId?0:1).ThenBy(x=>x.Name).ToArray();
    private int? CustomDurationMinutes; private int DefaultDuration=>SelectedServices.Sum(x=>(int)x.DurationMinutes); private int EffectiveDuration=>AdditionalIds.Count>0?CustomDurationMinutes??0:DefaultDuration; private bool DurationValid=>AdditionalIds.Count==0||CustomDurationMinutes is >=5 and <=720; private string DurationQuery=>AdditionalIds.Count>0&&DurationValid?$"&durationMinutes={CustomDurationMinutes}":""; private void DurationChanged(){Slots=[];Selected=null;SlotsLoaded=false;} private void RefreshDuration(){CustomDurationMinutes=AdditionalIds.Count>0?DefaultDuration:null;DurationChanged();}
    private decimal BaseTotal=>SelectedServices.Sum(x=>x.RequiresPayment?x.PriceAmount:0);
    protected override async Task Load(){var patients=await Get<DoctorPatientsData>("api/v1/doctor/patients?page=1&pageSize=100");Patients=patients?.Page.Items??[];Services=await Get<IReadOnlyList<ProfessionalService>>("api/v1/doctor/services")??[];SelectedPatientId=(ulong)Math.Max(PatientId,PatientQuery??0);if(SelectedPatientId!=0)await LoadPatient();var first=Services.FirstOrDefault(x=>x.Offered&&x.IsActive);if(first is not null)ChooseService(first);}
    private Task PatientChanged(ChangeEventArgs args)=>Run(async()=>{SelectedPatientId=ulong.TryParse(args.Value?.ToString(),out var id)?id:0;await LoadPatient();}); private async Task LoadPatient(){Patient=SelectedPatientId==0?null:await Get<DoctorPatient>($"api/v1/doctor/patients/{SelectedPatientId}");Slots=[];Selected=null;SlotsLoaded=false;}
    private void ChooseCategory(string value){CategoryCode=value;ServiceSearch="";AdditionalIds.Clear();CustomDurationMinutes=null;var first=Services.FirstOrDefault(x=>x.Offered&&x.IsActive&&x.CategoryCode==value);if(first is not null)ChooseService(first);else{ServiceId=0;Slots=[];}}
    private void ChooseService(ProfessionalService service){ServiceId=service.Id;AdditionalIds.Clear();CustomDurationMinutes=null;ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;}
    private void ToggleService(ProfessionalService service){if(ServiceId==service.Id){if(AdditionalIds.Count>0){ServiceId=AdditionalIds.First();AdditionalIds.Remove(ServiceId);}else ServiceId=0;}else if(AdditionalIds.Contains(service.Id))AdditionalIds.Remove(service.Id);else if(ServiceId==0){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";}else AdditionalIds.Add(service.Id);RefreshDuration();}
    private void ModalityChanged(){AdditionalIds.RemoveWhere(id=>Services.Any(x=>x.Id==id&&x.ModalityCode!="both"&&x.ModalityCode!=ModalityCode));if(CurrentService is { } current&&current.ModalityCode!="both"&&current.ModalityCode!=ModalityCode)ServiceId=0;RefreshDuration();}
    private void SelectDate(BookingDaySelection selection){Selected=null;Slots=selection.Slots;SlotsLoaded=selection.Date!=default;if(SlotsLoaded)Date=selection.Date.ToDateTime(TimeOnly.MinValue);}
    private Task Confirm()=>Run(async()=>{var result=await Request<WebAppointment>("api/v1/doctor/appointments","POST",new{patientAccountId=SelectedPatientId,appointmentTypeId=ServiceId,additionalAppointmentTypeIds=AdditionalIds.Order().ToArray(),modalityCode=ModalityCode,localDate=DateOnly.FromDateTime(Date),localStartsAt=Selected,patientNotes=Notes,durationMinutes=AdditionalIds.Count>0?CustomDurationMinutes:null},Guid.NewGuid().ToString("N"));Navigation.NavigateTo($"{ProfessionalRoot}/atendimentos/{result!.Id}");});
    private decimal Discounted(decimal value)=>decimal.Round(value*(1-Patient!.PremiumDiscountPercent/100m),2,MidpointRounding.AwayFromZero);
}
