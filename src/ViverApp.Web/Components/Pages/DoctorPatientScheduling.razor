@page "/medico/pacientes/{PatientId:long}/agendar"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pelo médico</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">O paciente é fixo, o profissional autenticado não pode ser substituído e o preço é calculado pelo servidor.</p></div><a class="button button--secondary" href="/medico/pacientes">Voltar aos pacientes</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else if(Patient is not null){
<section class="surface patient-panel doctor-summary"><h2>@Patient.FullName</h2><p>@(Patient.IsPremium?"Paciente Premium — o desconto será aplicado automaticamente.":"Paciente sem benefício Premium ativo.")</p></section>
<section class="surface patient-panel patient-section"><h2>1. Tipo e serviço</h2><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(CategoryCode==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="doctor-service-list">@foreach(var service in Services.Where(x=>x.Offered&&x.IsActive&&x.CategoryCode==CategoryCode)){<label class="doctor-service"><input type="radio" name="service" checked="@(ServiceId==service.Id)" @onchange="()=>ChooseService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @Money(service.PriceAmount)</small></span></label>}</div></section>
<section class="surface patient-panel patient-section"><h2>2. Modalidade, data e horário</h2><div class="doctor-profile-grid"><div class="field"><label for="booking-modality">Modalidade</label><select id="booking-modality" @bind="ModalityCode"><option value="in_person">Presencial</option><option value="online">Online</option></select></div><div class="field"><label for="booking-date">Data</label><input id="booking-date" type="date" @bind="Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div></div><button class="button button--secondary" @onclick="LoadSlots">Ver horários disponíveis</button><div class="doctor-service-list">@foreach(var slot in Slots){<label class="doctor-service"><input type="radio" name="slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="doctor-callout">Nenhum horário atende simultaneamente à clínica, feriados, sua disponibilidade, limites e conflitos.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="booking-notes">Observações autorizadas</label><textarea id="booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviço</dt><dd>@CurrentService.Name</dd></div><div><dt>Profissional</dt><dd>Você</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor-base</dt><dd>@Money(CurrentService.PriceAmount)</dd></div><div><dt>Pagamento</dt><dd>@(ModalityCode=="online"?"Online":"Na clínica")</dd></div></dl>}<p class="field-hint">O valor final e eventual desconto Premium são recalculados no servidor no instante da confirmação.</p><button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||!Selected.HasValue)">Confirmar agendamento</button></section>}
@code { [Parameter]public long PatientId{get;set;}private DoctorPatient? Patient;private IReadOnlyList<DoctorService> Services=[];private IReadOnlyList<WebAvailableSlot> Slots=[];private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia")];private string CategoryCode="consultation",ModalityCode="in_person",Notes="";private uint ServiceId;private DateTime Date=DateTime.Today.AddDays(1);private TimeOnly? Selected;private bool SlotsLoaded;private DoctorService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId);
protected override async Task Load(){Patient=await Get<DoctorPatient>($"api/v1/doctor/patients/{PatientId}");Services=await Get<IReadOnlyList<DoctorService>>("api/v1/doctor/services")??[];var first=Services.FirstOrDefault(x=>x.Offered&&x.IsActive);if(first is not null)ChooseService(first);}
private void ChooseCategory(string value){CategoryCode=value;var first=Services.FirstOrDefault(x=>x.Offered&&x.IsActive&&x.CategoryCode==value);if(first is not null)ChooseService(first);else{ServiceId=0;Slots=[];}}
private void ChooseService(DoctorService service){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;}
private Task LoadSlots()=>Run(async()=>{if(CurrentService is null)throw new DoctorUiException("Escolha um serviço.");if(CurrentService.ModalityCode!="both"&&CurrentService.ModalityCode!=ModalityCode)throw new DoctorUiException("O serviço não oferece esta modalidade.");Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/doctor/booking/slots?patientAccountId={PatientId}&appointmentTypeId={ServiceId}&modality={ModalityCode}&from={Date:yyyy-MM-dd}&days=1")??[];Selected=null;SlotsLoaded=true;});
private Task Confirm()=>Run(async()=>{var result=await Request<WebAppointment>("api/v1/doctor/appointments","POST",new{patientAccountId=PatientId,appointmentTypeId=ServiceId,modalityCode=ModalityCode,localDate=DateOnly.FromDateTime(Date),localStartsAt=Selected,patientNotes=Notes},Guid.NewGuid().ToString("N"));Notice=$"Agendamento criado por {Money(result!.PriceAmount)}. O pagamento seguirá o fluxo definido para a modalidade.";Navigation.NavigateTo($"/medico/atendimentos/{result.Id}");});}
