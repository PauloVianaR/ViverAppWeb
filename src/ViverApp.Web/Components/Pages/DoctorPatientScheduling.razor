@page "/medico/agendar"
@page "/medico/pacientes/{PatientId:long}/agendar"
@page "/psicologo/agendar"
@page "/psicologo/pacientes/{PatientId:long}/agendar"
@inject NavigationManager Navigation
<PageTitle>Novo atendimento | ViverApp</PageTitle>
<header class="workspace-heading appointment-compact-heading"><div><p class="eyebrow">Agendamento pela clínica</p><h1 class="page-title">Novo atendimento</h1></div></header>
<StaffAppointmentBooking @key="Navigation.Uri" PatientId="@Math.Max(PatientId, PatientQuery ?? 0)" Root=@ProfessionalRoot DateQuery="@DateQuery" TimeQuery="@TimeQuery" ProfessionalQuery="ProfessionalQuery" ReturnQuery="@ReturnQuery" />
@code { [SupplyParameterFromQuery(Name="returnTo")] public string? ReturnQuery{get;set;}
    [Parameter] public long PatientId { get; set; }
    [SupplyParameterFromQuery(Name="patient")] public long? PatientQuery { get; set; }
    [SupplyParameterFromQuery(Name="date")] public string? DateQuery { get; set; }
    [SupplyParameterFromQuery(Name="time")] public string? TimeQuery { get; set; }
    [SupplyParameterFromQuery(Name="professional")] public string? ProfessionalQueryValue { get; set; }
    private ulong? ProfessionalQuery => ulong.TryParse(ProfessionalQueryValue, out var value) && value > 0 ? value : null;
    private string ProfessionalRoot => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("psicologo", StringComparison.OrdinalIgnoreCase) ? "/psicologo" : "/medico";
}
