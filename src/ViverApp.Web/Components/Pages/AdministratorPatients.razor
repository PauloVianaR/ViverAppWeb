@page "/administracao/pacientes"
@inherits AdministratorPageBase
<PageTitle>Pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Pacientes da clínica</h1><p class="page-description">Dados cadastrais e operacionais com confirmação segura dos contatos alterados.</p></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="status">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Load" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="admin-patient-search">Nome, CPF, e-mail ou telefone</label><input id="admin-patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="admin-patient-status">Estado</label><select id="admin-patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="pending_confirmation">Aguardando confirmação</option><option value="blocked">Bloqueados</option></select></div></div><button class="button">Aplicar</button></form></section>
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel patient-directory-card"><div class="patient-visit__top"><div><h2>@patient.FullName</h2><p>@(patient.PreferredName is null?"Nome preferido não informado":$"Prefere {patient.PreferredName}")</p></div>@if(patient.IsPremium){<span class="badge badge--brand">Premium</span>}</div><dl class="patient-facts"><div><dt>CPF</dt><dd>@Cpf(patient.TaxId)</dd></div><div><dt>E-mail</dt><dd>@(patient.Email??"Não informado")</dd></div><div><dt>Telefone</dt><dd>@FormatPhone(patient.Phone)</dd></div><div><dt>Endereço</dt><dd>@Address(patient.Address)</dd></div><div><dt>Estado</dt><dd>@PatientLabels.Status(patient.StatusCode)</dd></div><div><dt>Atendimentos</dt><dd>@patient.AppointmentCount</dd></div></dl><div class="patient-actions"><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar dados</button></div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Ajuste os filtros da consulta." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="admin-edit-patient" class="patient-dialog patient-dialog--wide"><h2>Editar dados do paciente</h2><p>Esta ação exige sessão administrativa elevada. Novos contatos ficam pendentes de confirmação.</p><form @onsubmit="Save" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="ap-name">Nome</label><input id="ap-name" @bind="Name" required maxlength="200" /></div><div class="field"><label for="ap-preferred">Nome preferido</label><input id="ap-preferred" @bind="Preferred" maxlength="120" /></div><div class="field"><label for="ap-cpf">CPF</label><input id="ap-cpf" value="@TaxIdMasked" @oninput="e=>TaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" /></div><div class="field"><label for="ap-email">E-mail</label><input id="ap-email" type="email" @bind="Email" /></div><div class="field"><label for="ap-phone">Telefone E.164</label><input id="ap-phone" @bind="Phone" /></div><div class="field"><label for="ap-birth">Nascimento</label><input id="ap-birth" type="date" @bind="Birth" /></div><div class="field"><label for="ap-postal">CEP</label><input id="ap-postal" value="@PostalMasked" @oninput="PostalInput" inputmode="numeric" maxlength="9" /></div><div class="field"><label for="ap-street">Logradouro</label><input id="ap-street" @bind="Street" /></div><div class="field"><label for="ap-number">Número</label><input id="ap-number" @bind="Number" /></div><div class="field"><label for="ap-complement">Complemento</label><input id="ap-complement" @bind="Complement" /></div><div class="field"><label for="ap-district">Bairro</label><input id="ap-district" @bind="District" /></div><div class="field"><label for="ap-city">Cidade</label><input id="ap-city" @bind="City" /></div><div class="field"><label for="ap-state">UF</label><input id="ap-state" @bind="State" maxlength="2" /></div></div><div class="patient-actions"><button class="button">Salvar alterações</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-edit-patient")'>Voltar</button></div></form></dialog>
@code{
private ManagerPatientsData? Data;private ManagerPatient? Selected;private string Search="",Status="",Name="",Preferred="",TaxId="",Email="",Phone="",Postal="",Street="",Number="",Complement="",District="",City="",State="";private DateTime? Birth;private int Page=1;private string TaxIdMasked=>Cpf(TaxId)=="Não informado"?TaxId:Cpf(TaxId);private string PostalMasked=>Postal.Length==8?$"{Postal[..5]}-{Postal[5..]}":Postal;
protected override async Task Load()=>Data=await Get<ManagerPatientsData>($"api/v1/administrator/patients?search={Escape(Search)}&status={Status}&page={Page}&pageSize=12");
private async Task Edit(ManagerPatient item){Selected=item;Name=item.FullName;Preferred=item.PreferredName??"";TaxId=item.TaxId??"";Email=item.Email??"";Phone=item.Phone??"";Birth=item.BirthDate?.ToDateTime(TimeOnly.MinValue);Postal=item.Address?.PostalCode??"";Street=item.Address?.Street??"";Number=item.Address?.Number??"";Complement=item.Address?.Complement??"";District=item.Address?.District??"";City=item.Address?.City??"";State=item.Address?.StateCode??"";await Open("admin-edit-patient");}
private Task PostalInput(ChangeEventArgs e)=>Run(async()=>{Postal=Digits(e.Value?.ToString());if(Postal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{Postal}");if(address is null)return;Street=address.Street;Complement=address.Complement??Complement;District=address.District;City=address.City;State=address.StateCode;});
private Task Save()=>Run(async()=>{var hasAddress=Postal.Length==8||!string.IsNullOrWhiteSpace(Street);object? address=hasAddress?new{postalCode=Postal,street=Street,number=Number,complement=Empty(Complement),district=District,city=City,stateCode=State.ToUpperInvariant()}:null;await Request<ManagerPatient>($"api/v1/administrator/patients/{Selected!.AccountId}","PUT",new{fullName=Name,preferredName=Empty(Preferred),taxId=Empty(TaxId),email=Empty(Email),phoneE164=Empty(Phone),birthDate=Birth.HasValue?(DateOnly?)DateOnly.FromDateTime(Birth.Value):null,address,rowVersion=Selected.RowVersion});await Close("admin-edit-patient");Notice="Dados atualizados; novos contatos aguardam confirmação.";await Load();});
private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});private static string Digits(string? value)=>new((value??"").Where(char.IsAsciiDigit).ToArray());private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();private static string Cpf(string? value)=>Digits(value) is var d&&d.Length==11?$"{d[..3]}.{d[3..6]}.{d[6..9]}-{d[9..]}":"Não informado";private static string FormatPhone(string? value){var d=Digits(value);return d.Length switch{13=>$"+{d[..2]} ({d[2..4]}) {d[4..9]}-{d[9..]}",12=>$"+{d[..2]} ({d[2..4]}) {d[4..8]}-{d[8..]}",_=>"Não informado"};}private static string Address(ManagerPatientAddress? value)=>value is null?"Não informado":$"{value.Street}, {value.Number} · {value.District} · {value.City}/{value.StateCode} · {value.PostalCode[..5]}-{value.PostalCode[5..]}";
}
