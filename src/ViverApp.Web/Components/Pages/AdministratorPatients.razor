@page "/administracao/pacientes"
@inherits AdministratorPageBase
<PageTitle>Pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Pacientes da clínica</h1><p class="page-description">Dados cadastrais e operacionais com acesso ao portal opcional.</p></div><div class="patient-actions"><a class="button button--secondary" href="/administracao/agendar">Agendar</a><button class="button" @onclick='()=>Open("admin-new-patient")'>Adicionar paciente</button></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="status">@Notice</p>}
<MobileFilterPanel AriaLabel="Filtros de pacientes da administração"><form @onsubmit="Load" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="admin-patient-search">Nome, CPF, e-mail ou telefone</label><input id="admin-patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="admin-patient-status">Estado</label><select id="admin-patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="pending_confirmation">Aguardando confirmação</option><option value="blocked">Bloqueados</option></select></div><div class="field"><label for="admin-patient-premium">Plano</label><select id="admin-patient-premium" @bind="Premium"><option value="">Todos</option><option value="true">Premium</option><option value="false">Sem Premium</option></select></div></div><button class="button">Aplicar</button></form></MobileFilterPanel>
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel patient-directory-card"><div class="patient-visit__top"><div><h2>@patient.FullName</h2>@if(Age(patient.BirthDate) is int age){<p class="muted">@age anos</p>}<p>@(patient.PreferredName is null?"Nome preferido não informado":$"Prefere {patient.PreferredName}")</p></div><div>@if(!patient.PortalAccessEnabled){<span class="badge">Sem acesso ao portal</span>}@if(patient.IsPremium){<span class="premium-star" title="Premium · @patient.PremiumDiscountPercent% de desconto" aria-label="Paciente Premium">★</span>}</div></div><dl class="patient-facts"><div><dt>CPF</dt><dd>@Cpf(patient.TaxId)</dd></div><div><dt>E-mail</dt><dd>@(patient.Email??"Não informado")</dd></div><div><dt>Telefone</dt><dd>@FormatPhone(patient.Phone)</dd></div><div><dt>Endereço</dt><dd>@Address(patient.Address)</dd></div><div><dt>Estado</dt><dd>@PatientLabels.Status(patient.StatusCode)</dd></div><div><dt>Atendimentos</dt><dd>@patient.AppointmentCount</dd></div></dl><div class="patient-actions"><a class="button button--small" href="/administracao/prontuario/@patient.AccountId">Abrir prontuário</a><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar dados</button>@if(patient.IsPremium&&patient.PremiumMembershipId.HasValue){<button class="button button--secondary button--small" @onclick="()=>DownloadProof(patient)">Abrir comprovante</button>}<button class="button @(patient.IsPremium?"button--danger":"button--secondary") button--small" @onclick="()=>OpenPremium(patient)">@(patient.IsPremium?"Desfazer Premium":"Tornar Premium")</button></div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Ajuste os filtros da consulta." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="admin-new-patient" class="patient-dialog patient-dialog--wide"><h2>Adicionar paciente</h2><p>O paciente pode existir apenas no cadastro interno. Marque o onboarding somente se ele desejar acesso ao portal.</p><form @onsubmit="Create" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="anp-name">Nome completo</label><input id="anp-name" @bind="NewName" required minlength="3" maxlength="200" /></div><div class="field"><label for="anp-preferred">Nome preferido</label><input id="anp-preferred" @bind="NewPreferred" maxlength="120" /></div><div class="field"><label for="anp-cpf">CPF</label><input id="anp-cpf" value="@NewTaxIdMasked" @oninput="e=>NewTaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required /></div><div class="field"><label for="anp-birth">Data de nascimento</label><input id="anp-birth" type="date" @bind="NewBirth" required /></div><div class="field"><label for="anp-email">E-mail (opcional)</label><input id="anp-email" type="email" @bind="NewEmail" maxlength="254" /></div><div class="field"><label for="anp-phone">Telefone (opcional)</label><input id="anp-phone" type="tel" inputmode="numeric" autocomplete="tel-national" value="@NewPhone" @oninput="e=>NewPhone=BrazilianPhoneInput.Mask(e.Value?.ToString())" placeholder="(31) 99999-9999" maxlength="15" /></div><div class="field"><label for="anp-postal">CEP</label><input id="anp-postal" value="@NewPostalMasked" @oninput="NewPostalInput" inputmode="numeric" maxlength="9" placeholder="00000-000" /></div><div class="field"><label for="anp-street">Logradouro</label><input id="anp-street" @bind="NewStreet" maxlength="200" /></div><div class="field"><label for="anp-number">Número</label><input id="anp-number" @bind="NewNumber" maxlength="20" /></div><div class="field"><label for="anp-complement">Complemento</label><input id="anp-complement" @bind="NewComplement" maxlength="100" /></div><div class="field"><label for="anp-district">Bairro</label><input id="anp-district" @bind="NewDistrict" maxlength="100" /></div><div class="field"><label for="anp-city">Cidade</label><input id="anp-city" @bind="NewCity" maxlength="100" /></div><div class="field"><label for="anp-state">UF</label><input id="anp-state" @bind="NewState" maxlength="2" /></div></div><label class="choice-card"><input type="checkbox" @bind="NewSendOnboarding" /><span><strong>Enviar onboarding agora</strong><small>Exige e-mail ou telefone. Desmarcado mantém o cadastro apenas para uso interno.</small></span></label><div class="administrator-actions"><button class="button">Cadastrar paciente</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-new-patient")'>Voltar</button></div></form></dialog>
<dialog id="admin-edit-patient" class="patient-dialog patient-dialog--wide"><h2>Editar dados do paciente</h2><p>Esta ação exige sessão administrativa elevada. Novos contatos ficam pendentes de confirmação.</p><form @onsubmit="Save" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="ap-name">Nome</label><input id="ap-name" @bind="Name" required maxlength="200" /></div><div class="field"><label for="ap-preferred">Nome preferido</label><input id="ap-preferred" @bind="Preferred" maxlength="120" /></div><div class="field"><label for="ap-cpf">CPF</label><input id="ap-cpf" value="@TaxIdMasked" @oninput="e=>TaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" /></div><div class="field"><label for="ap-email">E-mail</label><input id="ap-email" type="email" @bind="Email" /></div><div class="field"><label for="ap-phone">Telefone</label><input id="ap-phone" type="tel" inputmode="numeric" autocomplete="tel-national" value="@Phone" @oninput="e=>Phone=BrazilianPhoneInput.Mask(e.Value?.ToString())" placeholder="(31) 99999-9999" maxlength="15" /></div><div class="field"><label for="ap-birth">Nascimento</label><input id="ap-birth" type="date" @bind="Birth" /></div><div class="field"><label for="ap-postal">CEP</label><input id="ap-postal" value="@PostalMasked" @oninput="PostalInput" inputmode="numeric" maxlength="9" /></div><div class="field"><label for="ap-street">Logradouro</label><input id="ap-street" @bind="Street" /></div><div class="field"><label for="ap-number">Número</label><input id="ap-number" @bind="Number" /></div><div class="field"><label for="ap-complement">Complemento</label><input id="ap-complement" @bind="Complement" /></div><div class="field"><label for="ap-district">Bairro</label><input id="ap-district" @bind="District" /></div><div class="field"><label for="ap-city">Cidade</label><input id="ap-city" @bind="City" /></div><div class="field"><label for="ap-state">UF</label><input id="ap-state" @bind="State" maxlength="2" /></div></div><div class="patient-actions"><button class="button">Salvar alterações</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-edit-patient")'>Voltar</button></div></form></dialog>
<dialog id="admin-premium-patient" class="patient-dialog"><h2>@(Selected?.IsPremium==true?"Desfazer Premium":"Tornar paciente Premium")</h2>@if(Selected?.IsPremium==true){<div class="field"><label for="admin-premium-reason">Motivo</label><textarea id="admin-premium-reason" @bind="PremiumReason" minlength="5" maxlength="1000"></textarea></div><button class="button button--danger" @onclick="DeactivatePremium">Confirmar remoção</button>}else{<p>Anexe o plano de saúde ou outro comprovante válido.</p><div class="field"><label for="admin-premium-proof">Comprovante PDF, PNG ou JPEG</label><input id="admin-premium-proof" type="file" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" /></div><progress id="admin-premium-progress" max="100" value="0">0%</progress><button class="button" @onclick="ActivatePremium">Ativar Premium</button>}<button class="button button--secondary" @onclick='()=>Close("admin-premium-patient")'>Voltar</button></dialog>
@code{
private ManagerPatientsData? Data;private ManagerPatient? Selected;private string Search="",Status="",Premium="",PremiumReason="",NewName="",NewPreferred="",NewTaxId="",NewEmail="",NewPhone="",NewPostal="",NewStreet="",NewNumber="",NewComplement="",NewDistrict="",NewCity="",NewState="",Name="",Preferred="",TaxId="",Email="",Phone="",Postal="",Street="",Number="",Complement="",District="",City="",State="";private DateTime? NewBirth,Birth;private bool NewSendOnboarding;private int Page=1;private string NewTaxIdMasked=>Cpf(NewTaxId)=="Não informado"?NewTaxId:Cpf(NewTaxId);private string NewPostalMasked=>NewPostal.Length==8?$"{NewPostal[..5]}-{NewPostal[5..]}":NewPostal;private string TaxIdMasked=>Cpf(TaxId)=="Não informado"?TaxId:Cpf(TaxId);private string PostalMasked=>Postal.Length==8?$"{Postal[..5]}-{Postal[5..]}":Postal;
protected override async Task Load()=>Data=await Get<ManagerPatientsData>($"api/v1/administrator/patients?search={Escape(Search)}&status={Status}&premium={Premium}&page={Page}&pageSize=12");
private Task Create()=>Run(async()=>{if(NewBirth is null){Notice="Informe a data de nascimento.";NoticeError=true;return;}var hasAddress=HasAddress(NewPostal,NewStreet,NewNumber,NewComplement,NewDistrict,NewCity,NewState);object? address=hasAddress?new{postalCode=Empty(NewPostal),street=Empty(NewStreet),number=Empty(NewNumber),complement=Empty(NewComplement),district=Empty(NewDistrict),city=Empty(NewCity),stateCode=Empty(NewState)?.ToUpperInvariant()}:null;await Request<ManagerPatient>("api/v1/administrator/patients","POST",new{fullName=NewName,preferredName=Empty(NewPreferred),taxId=NewTaxId,birthDate=DateOnly.FromDateTime(NewBirth.Value),email=Empty(NewEmail),phoneE164=Empty(NewPhone),address,sendOnboarding=NewSendOnboarding});var sent=NewSendOnboarding;await Close("admin-new-patient");NewName=NewPreferred=NewTaxId=NewEmail=NewPhone=NewPostal=NewStreet=NewNumber=NewComplement=NewDistrict=NewCity=NewState="";NewBirth=null;NewSendOnboarding=false;await Load();Notice=sent?"Paciente cadastrado e onboarding enviado.":"Paciente cadastrado para uso interno, sem acesso ao portal.";});
private Task NewPostalInput(ChangeEventArgs e)=>Run(async()=>{NewPostal=Digits(e.Value?.ToString());if(NewPostal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{NewPostal}");if(address is null)return;NewStreet=address.Street;NewComplement=address.Complement??NewComplement;NewDistrict=address.District;NewCity=address.City;NewState=address.StateCode;});
private async Task Edit(ManagerPatient item){Selected=item;Name=item.FullName;Preferred=item.PreferredName??"";TaxId=item.TaxId??"";Email=item.Email??"";Phone=BrazilianPhoneInput.Mask(item.Phone);Birth=item.BirthDate?.ToDateTime(TimeOnly.MinValue);Postal=item.Address?.PostalCode??"";Street=item.Address?.Street??"";Number=item.Address?.Number??"";Complement=item.Address?.Complement??"";District=item.Address?.District??"";City=item.Address?.City??"";State=item.Address?.StateCode??"";await Open("admin-edit-patient");}
private Task PostalInput(ChangeEventArgs e)=>Run(async()=>{Postal=Digits(e.Value?.ToString());if(Postal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{Postal}");if(address is null)return;Street=address.Street;Complement=address.Complement??Complement;District=address.District;City=address.City;State=address.StateCode;});
private Task Save()=>Run(async()=>{var hasAddress=HasAddress(Postal,Street,Number,Complement,District,City,State);object? address=hasAddress?new{postalCode=Empty(Postal),street=Empty(Street),number=Empty(Number),complement=Empty(Complement),district=Empty(District),city=Empty(City),stateCode=Empty(State)?.ToUpperInvariant()}:null;await Request<ManagerPatient>($"api/v1/administrator/patients/{Selected!.AccountId}","PUT",new{fullName=Name,preferredName=Empty(Preferred),taxId=Empty(TaxId),email=Empty(Email),phoneE164=Empty(Phone),birthDate=Birth.HasValue?(DateOnly?)DateOnly.FromDateTime(Birth.Value):null,address,rowVersion=Selected.RowVersion});await Close("admin-edit-patient");Notice="Dados atualizados; novos contatos aguardam confirmação.";await Load();});
private Task OpenPremium(ManagerPatient patient){Selected=patient;PremiumReason="";return Open("admin-premium-patient");}
private Task ActivatePremium()=>Run(async()=>{var result=await Module!.InvokeAsync<PatientApiResult<ManagerPatient>>("uploadTo",Backend.BaseUrl.ToString(),$"api/v1/administrator/patients/{Selected!.AccountId}/premium","admin-premium-proof","admin-premium-progress");if(!result.Ok)throw new AdministratorUiException(result.Error??"Não foi possível ativar o Premium.");await Close("admin-premium-patient");await Load();Notice="Paciente Premium ativado.";});
private Task DeactivatePremium()=>Run(async()=>{if(PremiumReason.Trim().Length<5)throw new AdministratorUiException("Informe um motivo com pelo menos cinco caracteres.");await Request<ManagerPatient>($"api/v1/administrator/patients/{Selected!.AccountId}/premium/cancel","POST",new{reason=PremiumReason,rowVersion=Selected.PremiumMembershipRowVersion??0});await Close("admin-premium-patient");await Load();Notice="Premium removido; o comprovante não está mais disponível.";});
private Task DownloadProof(ManagerPatient patient)=>Run(async()=>{var ok=await Module!.InvokeAsync<bool>("download",Backend.BaseUrl.ToString(),$"api/v1/administrator/premium/{patient.PremiumMembershipId}/proof");if(!ok)throw new AdministratorUiException("Não foi possível abrir o comprovante Premium.");});
private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});private static string Digits(string? value)=>new((value??"").Where(char.IsAsciiDigit).ToArray());private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();private static bool HasAddress(params string?[] values)=>values.Any(value=>!string.IsNullOrWhiteSpace(value));private static string Cpf(string? value)=>Digits(value) is var d&&d.Length==11?$"{d[..3]}.{d[3..6]}.{d[6..9]}-{d[9..]}":"Não informado";private static string FormatPhone(string? value){var d=Digits(value);return d.Length switch{13=>$"+{d[..2]} ({d[2..4]}) {d[4..9]}-{d[9..]}",12=>$"+{d[..2]} ({d[2..4]}) {d[4..8]}-{d[8..]}",_=>"Não informado"};}private static string Address(ManagerPatientAddress? value){if(value is null)return "Não informado";var parts=new List<string>();var street=string.Join(", ",new[]{value.Street,value.Number}.Where(item=>!string.IsNullOrWhiteSpace(item)));if(street.Length>0)parts.Add(street);if(!string.IsNullOrWhiteSpace(value.Complement))parts.Add(value.Complement);if(!string.IsNullOrWhiteSpace(value.District))parts.Add(value.District);var city=string.Join("/",new[]{value.City,value.StateCode}.Where(item=>!string.IsNullOrWhiteSpace(item)));if(city.Length>0)parts.Add(city);var postal=Digits(value.PostalCode);if(postal.Length==8)parts.Add($"{postal[..5]}-{postal[5..]}");return parts.Count==0?"Não informado":string.Join(" · ",parts);}private static int? Age(DateOnly? birth){if(birth is null)return null;var today=DateOnly.FromDateTime(DateTime.Today);var age=today.Year-birth.Value.Year;return birth.Value>today.AddYears(-age)?age-1:age;}
}
