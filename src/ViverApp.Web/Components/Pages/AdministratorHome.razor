@page "/administracao"
@inherits AdministratorPageBase
@using static ViverApp.Web.AdministratorLabels
<PageTitle>Administração | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Central de administração</h1><p class="page-description">Governança da clínica, acessos, finanças e operação em uma visão segura.</p></div><span class="badge badge--danger">MFA obrigatório</span></header>
<p class="administrator-elevated"><strong>Sessão elevada:</strong> alterações críticas exigem login recente com MFA e ficam registradas na auditoria.</p>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7"/>}else if(Home is not null){
<section class="surface patient-panel administrator-hero"><p class="eyebrow">Clínica única</p><h2>Operação de hoje</h2><p>Os números são calculados no servidor e não expõem conteúdo clínico.</p></section>
<div class="mobile-metric-flow"><section class="administrator-kpis" aria-label="Indicadores"><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("users")'><strong>@Home.Counters.ActiveUsers</strong><span>Usuários ativos</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("today")'><strong>@Home.Counters.TodayAppointments</strong><span>Consultas hoje</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("premium")'><strong>@Home.Counters.ActivePremium</strong><span>Premium ativos</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("approvals")'><strong>@Home.Counters.PendingApprovals</strong><span>Aprovações</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("payments")'><strong>@Home.Counters.PendingPayments</strong><span>Pagamentos pendentes</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>Select("alerts")'><strong>@Home.Counters.UnreadNotifications</strong><span>Alertas recentes</span></button></section>
<MetricEvidenceDrilldown Title="@MetricTitle" Items="@MetricItems" TotalCount="@MetricCount" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>
<nav class="quick-actions" aria-label="Atalhos"><a class="quick-action surface" href="/administracao/clinica"><AppIcon Name="clinic"/><strong>Clínica e serviços</strong></a><a class="quick-action surface" href="/administracao/agenda"><AppIcon Name="calendar"/><strong>Agenda</strong></a><a class="quick-action surface" href="/administracao/analytics"><AppIcon Name="chart"/><strong>Analytics</strong></a><a class="quick-action surface" href="/administracao/notificacoes"><AppIcon Name="sparkles"/><strong>Notificações</strong></a><a class="quick-action surface" href="/administracao/usuarios"><AppIcon Name="users"/><strong>Usuários e Premium</strong></a></nav>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Decisões</p><h2>Cadastros aguardando análise</h2></div><a href="/administracao/usuarios?status=pending_approval">Ver todos →</a></div>
@if(Home.Pending.Count==0){<InterfaceState Title="Fila em dia" Description="Nenhum profissional aguarda aprovação." Icon="check" Tone="success"/>}else{<div class="administrator-grid">@foreach(var item in Home.Pending){<article class="surface administrator-card"><span class="badge badge--warning">@Role(item.RoleCode)</span><h3>@item.FullName</h3><p>@(item.Contact??"Contato não informado")</p>@if(item.License is not null){<p><strong>@item.License</strong> · @item.Specialty · @item.YearsExperience ano(s)</p>}<a class="button button--secondary" href="/administracao/usuarios?status=pending_approval">Analisar cadastro</a></article>}</div>}</section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Agenda</p><h2>Atendimentos de hoje</h2></div><a href="/administracao/agenda">Ver agenda →</a></div>@if(Home.Today.Count==0){<InterfaceState Title="Agenda livre" Description="Nenhum atendimento ativo hoje." Icon="calendar"/>}else{<AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in Home.Today){<ManagerVisitCard Model="item" BasePath="/administracao/atendimentos"/>}</div>}</section>}
@code{private AdministratorHomeData? Home;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "users" or "today"?2:SelectedMetric is "premium" or "approvals"?4:6;protected override async Task Load()=>Home=await Get<AdministratorHomeData>("api/v1/administrator/home");private void Select(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"users"=>"Usuários ativos","today"=>"Consultas de hoje","premium"=>"Premium ativos","approvals"=>"Cadastros aguardando aprovação","payments"=>"Pagamentos pendentes","alerts"=>"Alertas recentes",_=>"Detalhamento"};private int? MetricCount=>SelectedMetric switch{"users"=>Home?.Counters.ActiveUsers,"today"=>Home?.Counters.TodayAppointments,"premium"=>Home?.Counters.ActivePremium,"approvals"=>Home?.Counters.PendingApprovals,"payments"=>Home?.Counters.PendingPayments,"alerts"=>Home?.Counters.UnreadNotifications,_=>null};private IReadOnlyList<string>? MetricItems=>SelectedMetric switch{"users"=>Home?.Sources.ActiveUsers,"today"=>Appointments(Home?.Sources.TodayAppointments),"premium"=>Home?.Sources.ActivePremium,"approvals"=>Home?.Sources.PendingApprovals,"payments"=>Appointments(Home?.Sources.PendingPayments),"alerts"=>Home?.Sources.UnreadNotifications,_=>null};private static IReadOnlyList<string>? Appointments(IReadOnlyList<ulong>? values)=>values?.Select(x=>$"Atendimento #{x}").ToArray();}
