@page "/administracao"
@inherits AdministratorPageBase
@using static ViverApp.Web.AdministratorLabels
<PageTitle>Administração | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Central de administração</h1><p class="page-description">Governança da clínica, acessos, finanças e operação em uma visão segura.</p></div><span class="badge badge--danger">MFA obrigatório</span></header>
<p class="administrator-elevated"><strong>Sessão elevada:</strong> alterações críticas exigem login recente com MFA e ficam registradas na auditoria.</p>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7"/>}else if(Home is not null){
<section class="surface patient-panel administrator-hero"><p class="eyebrow">Clínica única</p><h2>Operação de hoje</h2><p>Os números são calculados no servidor e não expõem conteúdo clínico.</p></section>
<section class="administrator-kpis" aria-label="Indicadores"><article class="surface administrator-kpi"><strong>@Home.Counters.ActiveUsers</strong><span>Usuários ativos</span></article><article class="surface administrator-kpi"><strong>@Home.Counters.TodayAppointments</strong><span>Consultas hoje</span></article><article class="surface administrator-kpi"><strong>@Home.Counters.ActivePremium</strong><span>Premium ativos</span></article><article class="surface administrator-kpi"><strong>@Home.Counters.PendingApprovals</strong><span>Aprovações</span></article><article class="surface administrator-kpi"><strong>@Home.Counters.PendingPayments</strong><span>Pagamentos pendentes</span></article><article class="surface administrator-kpi"><strong>@Home.Counters.UnreadNotifications</strong><span>Alertas recentes</span></article></section>
<nav class="quick-actions" aria-label="Atalhos"><a class="quick-action surface" href="/administracao/clinica"><AppIcon Name="clinic"/><strong>Clínica e serviços</strong></a><a class="quick-action surface" href="/administracao/consultas"><AppIcon Name="calendar"/><strong>Consultas</strong></a><a class="quick-action surface" href="/administracao/analytics"><AppIcon Name="chart"/><strong>Analytics</strong></a><a class="quick-action surface" href="/administracao/notificacoes"><AppIcon Name="sparkles"/><strong>Notificações</strong></a><a class="quick-action surface" href="/administracao/usuarios"><AppIcon Name="users"/><strong>Usuários e Premium</strong></a></nav>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Decisões</p><h2>Cadastros aguardando análise</h2></div><a href="/administracao/usuarios?status=pending_approval">Ver todos →</a></div>
@if(Home.Pending.Count==0){<InterfaceState Title="Fila em dia" Description="Nenhum Médico ou Gestor aguarda aprovação." Icon="check" Tone="success"/>}else{<div class="administrator-grid">@foreach(var item in Home.Pending){<article class="surface administrator-card"><span class="badge badge--warning">@Role(item.RoleCode)</span><h3>@item.FullName</h3><p>@(item.Contact??"Contato não informado")</p>@if(item.License is not null){<p><strong>@item.License</strong> · @item.Specialty · @item.YearsExperience ano(s)</p>}<a class="button button--secondary" href="/administracao/usuarios?status=pending_approval">Analisar cadastro</a></article>}</div>}</section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Agenda</p><h2>Atendimentos de hoje</h2></div><a href="/administracao/consultas">Ver agenda →</a></div>@if(Home.Today.Count==0){<InterfaceState Title="Agenda livre" Description="Nenhum atendimento ativo hoje." Icon="calendar"/>}else{<div class="patient-grid">@foreach(var item in Home.Today){<ManagerVisitCard Model="item" BasePath="/administracao/atendimentos"/>}</div>}</section>}
@code{private AdministratorHomeData? Home;protected override async Task Load()=>Home=await Get<AdministratorHomeData>("api/v1/administrator/home");}
