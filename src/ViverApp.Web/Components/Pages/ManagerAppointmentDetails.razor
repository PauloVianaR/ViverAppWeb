@page "/gestao/atendimentos/{Id:long}"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Operação da clínica</p><h1 class="page-title">@(Item?.PatientName??"Detalhes do atendimento")</h1><p class="page-description">Ações administrativas, situação financeira e metadados clínicos permitidos.</p></div><a class="button button--secondary" href="/gestao/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="8" />}
else if(Item is not null){<ManagerVisitCard Model="Item" ShowDetailsLink="false" />
<section class="surface patient-panel patient-section"><h2>Ações operacionais</h2><div class="patient-actions">@if(Item.PatientPhone is not null){<a class="button button--secondary" href="tel:@Item.PatientPhone">Ligar para paciente</a>}@if(Item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed"){<a class="button button--secondary" href="/gestao/prontuario/@Item.PatientAccountId">Abrir prontuário</a>}@if(Item.CanRegisterArrival){<button class="button" @onclick="RegisterArrival">Registrar chegada</button>}@if(Item.CanCancelArrival){<button class="button button--danger" @onclick='()=>Open("manager-arrival-cancel")'>Cancelar chegada</button>}@if(Item.CanReschedule){<button class="button button--secondary" @onclick="ShowReschedule">Reagendar</button>}@if(Item.CanCancel){<button class="button button--danger" @onclick='()=>Open("manager-cancel")'>Cancelar atendimento</button>}@if(Item.CanComplete){<button class="button" @onclick='()=>Open("manager-complete")'>Finalizar atendimento</button>}@if((Item.StatusCode is "confirmed" or "arrived") && Item.StartsAtUtc <= DateTime.UtcNow){<button class="button button--secondary" @onclick='()=>Open("manager-no-show")'>Marcar como não compareceu</button>}@if(CanPointDiscount){<button class="button button--secondary" @onclick='()=>Open("manager-point-discount")'>Aplicar desconto pontual</button>}@if(Item.CanCancelPayment){<button class="button button--danger" @onclick='()=>Open("manager-reversal")'>@(Item.StatusCode=="no_show"?"Estornar valor ao paciente":"Cancelar pagamento")</button>}@if(Item.CanConfirmPayment){<button class="button" @onclick='()=>Open("manager-payment")'>Confirmar pagamento presencial</button>}</div></section>
<section class="surface patient-panel patient-section"><h2>Serviços e financeiro</h2><ul>@foreach(var service in Item.Services){<li>@service.Name · @service.DurationMinutes min · @(service.RequiresPayment?Money(service.BasePriceAmount):"Sem cobrança")</li>}</ul>@if(!Item.RequiresPayment){<p class="notice notice--success">Este atendimento não possui cobrança nem pagamento pendente.</p>}<dl class="patient-facts"><div><dt>Estado</dt><dd>@(Item.RequiresPayment ? Status(Item.Payment.StatusCode) : "Sem cobrança")</dd></div><div><dt>Valor base</dt><dd>@Money(Item.BasePriceAmount)</dd></div>@if(Item.DiscountPercent>0){<div><dt>Premium</dt><dd>@Item.DiscountPercent.ToString("0.##")%</dd></div>}@if(Item.PointDiscountAmount>0){<div><dt>Desconto pontual</dt><dd>-@Money(Item.PointDiscountAmount) (@(Item.PointDiscountKindCode=="percent"?$"{Item.PointDiscountValue:0.##}%":"valor em reais"))</dd></div>}<div><dt>Valor final</dt><dd><strong>@Money(Item.PriceAmount)</strong></dd></div>@if(Item.RequiresPayment){<div><dt>Forma</dt><dd>@Method(Item.Payment.MethodCode)</dd></div><div><dt>Pago em</dt><dd>@(Item.Payment.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</dd></div>}</dl>@if(Item.RequiresPayment && Item.Payment.CardLastFour is not null){<p>Cartão final <strong>@Item.Payment.CardLastFour</strong> · autorização @Item.Payment.AuthorizationReference</p>}</section>
<section class="surface patient-panel patient-section"><h2>Metadados clínicos</h2><p><strong>Laudo:</strong> @(Item.Report.Exists?$"{Item.Report.StatusCode}, {Item.Report.VersionCount} versão(ões), publicado em {Item.Report.PublishedAtUtc?.ToLocalTime():dd/MM/yyyy HH:mm}":"não registrado")</p><p><strong>Anexos disponíveis:</strong> @Item.AttachmentCount</p><p class="manager-boundary">O laudo clínico pode ser consultado e atualizado abaixo; cada versão identifica o responsável pela edição.</p></section>
<AppointmentReportEditor @key="Item.Id" AppointmentId="Id" />
<section class="surface patient-panel patient-section"><h2>Avaliação operacional</h2>@if(Item.Rating.HasValue){<p><strong>Nota:</strong> @Item.Rating de 5</p><p>@(Item.ReviewComment??"Sem comentário.")</p>}else{<p class="muted">O paciente ainda não avaliou este atendimento.</p>}</section>
<dialog id="manager-cancel" class="patient-dialog"><h2>Cancelar atendimento</h2><form @onsubmit="Cancel" @onsubmit:preventDefault><div class="field"><label for="manager-cancel-reason">Motivo</label><textarea id="manager-cancel-reason" @bind="CancelReason" required minlength="5" maxlength="500"></textarea></div><div class="patient-actions"><button class="button button--danger">Confirmar cancelamento</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-cancel")'>Voltar</button></div></form></dialog>
<dialog id="manager-no-show" class="patient-dialog"><h2>Confirmar ausência do paciente?</h2><p>Marque apenas após o horário de início. O atendimento sairá da Agenda e permanecerá no histórico como “Não compareceu”.</p><div class="patient-actions"><button class="button button--danger" @onclick="NoShow">Confirmar não comparecimento</button><button class="button button--secondary" @onclick='()=>Close("manager-no-show")'>Voltar</button></div></dialog>
<dialog id="manager-arrival-cancel" class="patient-dialog"><h2>Cancelar chegada</h2><p>A senha não será reutilizada e o atendimento voltará para confirmado.</p><form @onsubmit="CancelArrival" @onsubmit:preventDefault><div class="field"><label for="manager-arrival-cancel-reason">Motivo</label><textarea id="manager-arrival-cancel-reason" @bind="ArrivalCancelReason" required minlength="5" maxlength="500"></textarea></div><div class="patient-actions"><button class="button button--danger">Confirmar cancelamento da chegada</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-arrival-cancel")'>Voltar</button></div></form></dialog>
<dialog id="manager-reschedule" class="patient-dialog"><h2>Escolher novo horário</h2>@if(RescheduleOpen){<BookingAvailabilityCalendar @key="Item.Id" SlotsApiPrefix="@RescheduleCalendarApi" DateSelected="SelectRescheduleDate" />}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-slot" checked="@(SelectedSlot==slot.StartsAt)" @onchange="()=>SelectedSlot=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div><div class="field"><label for="manager-move-reason">Motivo</label><textarea id="manager-move-reason" @bind="MoveReason" maxlength="500"></textarea></div><div class="patient-actions"><button class="button" @onclick="Reschedule" disabled="@(!SelectedSlot.HasValue)">Reagendar</button><button class="button button--secondary" @onclick="CloseReschedule">Voltar</button></div></dialog>
<dialog id="manager-payment" class="patient-dialog"><h2>Confirmar pagamento presencial</h2><PaymentSplitEditor Portions="@PaymentRows" Total="@Item.PriceAmount" /><div class="field"><label for="manager-paid-at">Data e hora</label><input id="manager-paid-at" type="datetime-local" @bind="PaymentDate" /></div><div class="patient-actions"><button class="button" @onclick="ConfirmPayment">Confirmar uma única vez</button><button class="button button--secondary" @onclick='()=>Close("manager-payment")'>Voltar</button></div></dialog>
<dialog id="manager-point-discount" class="patient-dialog"><h2>Desconto pontual</h2><p>Limite: @Capabilities?.PointDiscountMaxPercent.ToString("0.##")% do valor após o Premium. O desconto só pode ser concedido antes do pagamento.</p><div class="field"><label>Tipo</label><select @bind="PointKind"><option value="percent">Porcentagem</option><option value="amount">Reais</option></select></div><div class="field"><label>Valor</label><input type="number" min="0.01" step="0.01" @bind="PointValue" /></div><div class="patient-actions"><button class="button" @onclick="ApplyPointDiscount">Confirmar desconto</button><button class="button button--secondary" @onclick='()=>Close("manager-point-discount")'>Voltar</button></div></dialog>
<dialog id="manager-complete" class="patient-dialog"><h2>Finalizar atendimento?</h2><p>O atendimento será marcado como concluído. O Gestor não poderá reabri-lo; somente o Administrador possui essa permissão.</p><div class="patient-actions"><button class="button" @onclick="Complete">Confirmar finalização</button><button class="button button--secondary" @onclick='()=>Close("manager-complete")'>Voltar</button></div></dialog>
<dialog id="manager-reversal" class="patient-dialog"><h2>@(Item.StatusCode=="no_show"?"Estornar valor ao paciente":"Cancelar pagamento")</h2><p>O recebimento original será preservado e uma saída vinculada será registrada somente no caixa do dia em que o estorno for realizado. @(Item.StatusCode=="no_show"?"O atendimento permanecerá como não compareceu.":"O atendimento voltará para pendente e poderá receber outro pagamento.")</p><div class="field"><label for="manager-reversal-reason">Motivo</label><textarea id="manager-reversal-reason" minlength="5" maxlength="500" @bind="ReversalReason"></textarea></div><div class="patient-actions"><button class="button button--danger" @onclick="ReversePayment">@(Item.StatusCode=="no_show"?"Confirmar estorno":"Confirmar cancelamento do pagamento")</button><button class="button button--secondary" @onclick='()=>Close("manager-reversal")'>Voltar</button></div></dialog>}
@code { [Parameter]public long Id{get;set;}private ManagerAppointment? Item;private ManagerCapabilities? Capabilities;private string CancelReason="",ArrivalCancelReason="",MoveReason="",ReversalReason="",PointKind="percent";private decimal PointValue;private List<PaymentPortionEditor> PaymentRows=[];private DateTime NewDate=DateTime.Today.AddDays(1),PaymentDate=DateTime.Now;private IReadOnlyList<WebAvailableSlot> Slots=[];private TimeOnly? SelectedSlot;private bool CanPointDiscount=>Capabilities?.PointDiscountsEnabled==true&&Item is {RequiresPayment:true,PointDiscountKindCode:null}&&Item.StatusCode is "pending" or "confirmed"&&Item.Payment.StatusCode!="paid";
private bool RescheduleOpen;
private Task ShowReschedule(){RescheduleOpen=true;return Open("manager-reschedule");}
private async Task CloseReschedule(){await Close("manager-reschedule");RescheduleOpen=false;Slots=[];SelectedSlot=null;}
private string RescheduleExtras=>string.Concat((Item?.Services??[]).Where(x=>x.AppointmentTypeId!=Item!.AppointmentTypeId).Select(x=>$"&additionalAppointmentTypeIds={x.AppointmentTypeId}"));
private string RescheduleCalendarApi=>$"api/v1/manager/booking/slots?patientAccountId={Item!.PatientAccountId}&doctorAccountId={Item.ProfessionalAccountId}&appointmentTypeId={Item.AppointmentTypeId}&modality={Item.ModalityCode}{RescheduleExtras}{RescheduleDurationQuery}";
private string RescheduleDurationQuery=>Item!.Services.Count>1?$"&durationMinutes={(int)(Item.EndsAtUtc-Item.StartsAtUtc).TotalMinutes}":"";
private void SelectRescheduleDate(BookingDaySelection selection){Slots=selection.Slots;SelectedSlot=null;if(selection.Date!=default)NewDate=selection.Date.ToDateTime(TimeOnly.MinValue);}
protected override async Task Load(){Item=await Get<ManagerAppointment>($"api/v1/manager/appointments/{Id}");Capabilities=await Get<ManagerCapabilities>("api/v1/manager/capabilities");if(Item is not null)PaymentRows=[new PaymentPortionEditor{Amount=Item.PriceAmount}];}
private Task Cancel()=>Run(async()=>{await Request<WebAppointment>($"api/v1/manager/appointments/{Id}/cancel","POST",new{reason=CancelReason,rowVersion=Item!.RowVersion});await Close("manager-cancel");await Load();Notice="Atendimento cancelado.";});
private Task NoShow()=>Run(async()=>{await Request<WebClinicalAppointment>($"api/v1/clinical/appointments/{Id}/no-show","POST",new{appointmentRowVersion=Item!.RowVersion});await Close("manager-no-show");await Load();Notice="Não comparecimento registrado. O atendimento saiu da Agenda.";});
private Task Reschedule()=>Run(async()=>{await Request<WebAppointment>($"api/v1/manager/appointments/{Id}/reschedule","POST",new{localDate=DateOnly.FromDateTime(NewDate),localStartsAt=SelectedSlot,reason=MoveReason,rowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await Close("manager-reschedule");Navigation.NavigateTo("/gestao/agenda");});
private Task ConfirmPayment()=>Run(async()=>{var error=PaymentPortionEditor.Validate(PaymentRows,Item!.PriceAmount);if(error is not null)throw new ManagerUiException(error);var portions=PaymentRows.Select(x=>new{methodCode=x.MethodCode,amount=x.Amount,cardLastFour=x.IsCard?x.CardLastFour:null,authorizationReference=x.IsCard?x.AuthorizationReference:null}).ToArray();await Request<ManagerPayment>($"api/v1/manager/appointments/{Id}/payment","POST",new{methodCode=portions[0].methodCode,paidAtUtc=PaymentDate.ToUniversalTime(),cardLastFour=portions.Length==1?portions[0].cardLastFour:null,authorizationReference=portions.Length==1?portions[0].authorizationReference:null,appointmentRowVersion=Item.RowVersion,allocations=portions},Guid.NewGuid().ToString("N"));await Close("manager-payment");await Load();Notice="Pagamento presencial confirmado e auditado.";});
private Task ApplyPointDiscount()=>Run(async()=>{await Request<WebAppointment>($"api/v1/manager/appointments/{Id}/point-discount","POST",new{kindCode=PointKind,value=PointValue,rowVersion=Item!.RowVersion});await Close("manager-point-discount");await Load();PaymentRows=[new PaymentPortionEditor{Amount=Item!.PriceAmount}];Notice="Desconto pontual registrado no atendimento.";});
private Task ReversePayment()=>Run(async()=>{var wasNoShow=Item!.StatusCode=="no_show";await Request<PaymentReversalResult>($"api/v1/management/cash/payments/{Item.Payment.Id}/reversal","POST",new{rowVersion=Item.Payment.RowVersion,reason=ReversalReason},Guid.NewGuid().ToString("N"));await Close("manager-reversal");await Load();Notice=wasNoShow?"Valor estornado e saída registrada no caixa de hoje. O atendimento permanece como não compareceu.":"Pagamento cancelado; o atendimento voltou para pendente e já aceita um novo pagamento.";});
private Task Complete()=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{Id}/complete","POST",new{rowVersion=Item!.RowVersion});await Close("manager-complete");await Load();Notice="Atendimento finalizado. Somente o Administrador poderá reabri-lo.";});
private Task RegisterArrival()=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{Id}/arrival","POST",new{rowVersion=Item!.RowVersion});await Load();Notice=$"Chegada registrada. Senha {Item!.ArrivalQueueNumber}.";});
private Task CancelArrival()=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{Id}/arrival/cancel","POST",new{rowVersion=Item!.RowVersion,reason=ArrivalCancelReason});await Close("manager-arrival-cancel");ArrivalCancelReason="";await Load();Notice="Chegada cancelada com motivo registrado. O atendimento voltou para confirmado.";});}
