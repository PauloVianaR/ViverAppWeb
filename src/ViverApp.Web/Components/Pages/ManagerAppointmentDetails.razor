@page "/gestao/atendimentos/{Id:long}"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Operação da clínica</p><h1 class="page-title">@(Item?.PatientName??"Detalhes do atendimento")</h1><p class="page-description">Ações administrativas, situação financeira e metadados clínicos permitidos.</p></div><a class="button button--secondary" href="/gestao/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="8" />}
else if(Item is not null){<ManagerVisitCard Model="Item" />
<section class="surface patient-panel patient-section"><h2>Ações operacionais</h2><div class="patient-actions">@if(Item.PatientPhone is not null){<a class="button button--secondary" href="tel:@Item.PatientPhone">Ligar para paciente</a>}@if(Item.CanRegisterArrival){<button class="button" @onclick="RegisterArrival">Registrar chegada</button>}@if(Item.CanCancelArrival){<button class="button button--danger" @onclick='()=>Open("manager-arrival-cancel")'>Cancelar chegada</button>}@if(Item.CanReschedule){<button class="button button--secondary" @onclick='()=>Open("manager-reschedule")'>Reagendar</button>}@if(Item.CanCancel){<button class="button button--danger" @onclick='()=>Open("manager-cancel")'>Cancelar atendimento</button>}@if(Item.Payment.StatusCode=="paid"){<button class="button button--danger" @onclick='()=>Open("manager-reversal")'>Cancelar pagamento</button>}@if(Item.CanConfirmPayment){<button class="button" @onclick='()=>Open("manager-payment")'>Confirmar pagamento presencial</button>}</div></section>
<section class="surface patient-panel patient-section"><h2>Financeiro</h2><dl class="patient-facts"><div><dt>Estado</dt><dd>@Status(Item.Payment.StatusCode)</dd></div><div><dt>Valor do servidor</dt><dd>@Money(Item.PriceAmount)</dd></div><div><dt>Forma</dt><dd>@Method(Item.Payment.MethodCode)</dd></div><div><dt>Pago em</dt><dd>@(Item.Payment.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</dd></div></dl>@if(Item.Payment.CardLastFour is not null){<p>Cartão final <strong>@Item.Payment.CardLastFour</strong> · autorização @Item.Payment.AuthorizationReference</p>}</section>
<section class="surface patient-panel patient-section"><h2>Metadados clínicos</h2><p><strong>Laudo:</strong> @(Item.Report.Exists?$"{Item.Report.StatusCode}, {Item.Report.VersionCount} versão(ões), publicado em {Item.Report.PublishedAtUtc?.ToLocalTime():dd/MM/yyyy HH:mm}":"não registrado")</p><p><strong>Anexos disponíveis:</strong> @Item.AttachmentCount</p><p class="manager-boundary">O Gestor visualiza somente existência, autoria implícita e datas. O conteúdo do laudo e os arquivos clínicos permanecem bloqueados pela API.</p></section>
<section class="surface patient-panel patient-section"><h2>Avaliação operacional</h2>@if(Item.Rating.HasValue){<p><strong>Nota:</strong> @Item.Rating de 5</p><p>@(Item.ReviewComment??"Sem comentário.")</p>}else{<p class="muted">O paciente ainda não avaliou este atendimento.</p>}</section>
<dialog id="manager-cancel" class="patient-dialog"><h2>Cancelar atendimento</h2><form @onsubmit="Cancel" @onsubmit:preventDefault><div class="field"><label for="manager-cancel-reason">Motivo</label><textarea id="manager-cancel-reason" @bind="CancelReason" required minlength="5" maxlength="500"></textarea></div><div class="patient-actions"><button class="button button--danger">Confirmar cancelamento</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-cancel")'>Voltar</button></div></form></dialog>
<dialog id="manager-arrival-cancel" class="patient-dialog"><h2>Cancelar chegada</h2><p>A senha não será reutilizada e o atendimento voltará para confirmado.</p><form @onsubmit="CancelArrival" @onsubmit:preventDefault><div class="field"><label for="manager-arrival-cancel-reason">Motivo</label><textarea id="manager-arrival-cancel-reason" @bind="ArrivalCancelReason" required minlength="5" maxlength="500"></textarea></div><div class="patient-actions"><button class="button button--danger">Confirmar cancelamento da chegada</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-arrival-cancel")'>Voltar</button></div></form></dialog>
<dialog id="manager-reschedule" class="patient-dialog"><h2>Escolher novo horário</h2><div class="field"><label for="manager-new-date">Data</label><input id="manager-new-date" type="date" @bind="NewDate" /></div><button class="button button--secondary" @onclick="LoadSlots">Buscar horários</button><div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-slot" checked="@(SelectedSlot==slot.StartsAt)" @onchange="()=>SelectedSlot=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div><div class="field"><label for="manager-move-reason">Motivo</label><textarea id="manager-move-reason" @bind="MoveReason" maxlength="500"></textarea></div><div class="patient-actions"><button class="button" @onclick="Reschedule" disabled="@(!SelectedSlot.HasValue)">Reagendar</button><button class="button button--secondary" @onclick='()=>Close("manager-reschedule")'>Voltar</button></div></dialog>
<dialog id="manager-payment" class="patient-dialog"><h2>Confirmar pagamento presencial</h2><p>Confirme explicitamente o pagamento de <strong>@Money(Item.PriceAmount)</strong>. Essa ação entra no ledger financeiro e não poderá duplicar um pagamento reconciliado.</p><div class="field"><label for="manager-method">Forma de pagamento</label><select id="manager-method" @bind="PaymentMethod"><option value="pix">Pix</option><option value="cash">Dinheiro</option><option value="credit_card">Cartão de crédito</option><option value="debit_card">Cartão de débito</option></select></div><div class="field"><label for="manager-paid-at">Data e hora</label><input id="manager-paid-at" type="datetime-local" @bind="PaymentDate" /></div>@if(IsCard){<div class="field"><label for="manager-last4">Últimos quatro dígitos</label><input id="manager-last4" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" @bind="CardLastFour" /></div><div class="field"><label for="manager-authorization">Número de autorização</label><input id="manager-authorization" maxlength="100" @bind="Authorization" /></div>}<div class="patient-actions"><button class="button" @onclick="ConfirmPayment">Confirmar uma única vez</button><button class="button button--secondary" @onclick='()=>Close("manager-payment")'>Voltar</button></div></dialog>
<dialog id="manager-reversal" class="patient-dialog"><h2>Cancelar pagamento</h2><p>O recebimento original será preservado e uma saída compensatória será registrada no caixa. O atendimento continuará existindo e aceitará um novo pagamento.</p><div class="field"><label for="manager-reversal-reason">Motivo</label><textarea id="manager-reversal-reason" minlength="5" maxlength="500" @bind="ReversalReason"></textarea></div><div class="patient-actions"><button class="button button--danger" @onclick="ReversePayment">Confirmar cancelamento do pagamento</button><button class="button button--secondary" @onclick='()=>Close("manager-reversal")'>Voltar</button></div></dialog>}
@code { [Parameter]public long Id{get;set;}private ManagerAppointment? Item;private string CancelReason="",ArrivalCancelReason="",MoveReason="",PaymentMethod="pix",CardLastFour="",Authorization="",ReversalReason="";private DateTime NewDate=DateTime.Today.AddDays(1),PaymentDate=DateTime.Now;private IReadOnlyList<WebAvailableSlot> Slots=[];private TimeOnly? SelectedSlot;private bool IsCard=>PaymentMethod is "credit_card" or "debit_card";
protected override async Task Load()=>Item=await Get<ManagerAppointment>($"api/v1/manager/appointments/{Id}");
private Task Cancel()=>Run(async()=>{await Request<WebAppointment>($"api/v1/manager/appointments/{Id}/cancel","POST",new{reason=CancelReason,rowVersion=Item!.RowVersion});await Close("manager-cancel");await Load();Notice="Atendimento cancelado.";});
private Task LoadSlots()=>Run(async()=>{Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/manager/booking/slots?patientAccountId={Item!.PatientAccountId}&doctorAccountId={Item.DoctorAccountId}&appointmentTypeId={Item.AppointmentTypeId}&modality={Item.ModalityCode}&from={NewDate:yyyy-MM-dd}&days=1")??[];SelectedSlot=null;});
private Task Reschedule()=>Run(async()=>{await Request<WebAppointment>($"api/v1/manager/appointments/{Id}/reschedule","POST",new{localDate=DateOnly.FromDateTime(NewDate),localStartsAt=SelectedSlot,reason=MoveReason,rowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await Close("manager-reschedule");Navigation.NavigateTo("/gestao/agenda");});
private Task ConfirmPayment()=>Run(async()=>{if(IsCard&&(CardLastFour.Length!=4||string.IsNullOrWhiteSpace(Authorization)))throw new ManagerUiException("Informe os quatro dígitos e a autorização do cartão.");await Request<ManagerPayment>($"api/v1/manager/appointments/{Id}/payment","POST",new{methodCode=PaymentMethod,paidAtUtc=PaymentDate.ToUniversalTime(),cardLastFour=IsCard?CardLastFour:null,authorizationReference=IsCard?Authorization:null,appointmentRowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await Close("manager-payment");await Load();Notice="Pagamento presencial confirmado e auditado.";});
private Task ReversePayment()=>Run(async()=>{await Request<PaymentReversalResult>($"api/v1/management/cash/payments/{Item!.Payment.Id}/reversal","POST",new{rowVersion=Item.Payment.RowVersion,reason=ReversalReason},Guid.NewGuid().ToString("N"));await Close("manager-reversal");await Load();Notice="Pagamento cancelado; o atendimento voltou para pendente e já aceita um novo pagamento.";});
private Task RegisterArrival()=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{Id}/arrival","POST",new{rowVersion=Item!.RowVersion});await Load();Notice=$"Chegada registrada. Senha {Item!.ArrivalQueueNumber}.";});
private Task CancelArrival()=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{Id}/arrival/cancel","POST",new{rowVersion=Item!.RowVersion,reason=ArrivalCancelReason});await Close("manager-arrival-cancel");ArrivalCancelReason="";await Load();Notice="Chegada cancelada com motivo registrado. O atendimento voltou para confirmado.";});}
