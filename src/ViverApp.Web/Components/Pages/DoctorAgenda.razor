@page "/medico/agenda"
@page "/medico/historico"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>@(History?"Histórico":"Agenda") | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Médico</p><h1 class="page-title">@(History?"Histórico de atendimentos":"Minha agenda")</h1><p class="page-description">@(History?"Laudos, anexos e avaliações dos seus atendimentos.":"Encontre, filtre e conduza somente os atendimentos atribuídos a você.")</p></div><a class="button" href="/medico/pacientes">Agendar para paciente</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="doctor-search">Paciente ou serviço</label><input id="doctor-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="doctor-from">De</label><input id="doctor-from" type="date" @bind="From" /></div><div class="field"><label for="doctor-to">Até</label><input id="doctor-to" type="date" @bind="To" /></div><div class="field"><label for="doctor-status">Estado</label><select id="doctor-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var s in Statuses){<option value="@s">@Status(s)</option>}</select></div><div class="field"><label for="doctor-category">Tipo</label><select id="doctor-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option></select></div><div class="field"><label for="doctor-modality">Modalidade</label><select id="doctor-modality" @bind="ModalityFilter"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div></div><div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Data is not null){<section class="doctor-kpis"><article class="surface doctor-kpi"><strong>@Data.Counters.Total</strong><span>Total</span></article><article class="surface doctor-kpi"><strong>@Data.Counters.Online</strong><span>Online</span></article><article class="surface doctor-kpi"><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></article><article class="surface doctor-kpi"><strong>@Data.Counters.Rescheduled</strong><span>Reagendados</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="doctor-results-heading"><p class="muted" role="status">@Data.Page.TotalCount atendimento(s) encontrado(s).</p><div class="doctor-view-toggle" role="group" aria-label="Modo de exibição"><button class="button button--secondary button--small" aria-pressed="@(!Compact)" @onclick="()=>Compact=false">Cards</button><button class="button button--secondary button--small" aria-pressed="@Compact" @onclick="()=>Compact=true">Lista compacta</button></div></div><div class="patient-grid @(Compact?"doctor-results--compact":"")">@foreach(var item in Data.Page.Items){<DoctorVisitCard Model="item" />}</div>}else{<InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou o período consultado." Icon="calendar" />}
<nav class="patient-pagination" aria-label="Paginação"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy||Page==1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))">Próxima</button></nav>
@code { private DoctorAgendaData? Data; private bool History=>new Uri(Navigation.Uri).AbsolutePath.EndsWith("/historico",StringComparison.OrdinalIgnoreCase); private DateTime From=DateTime.Today,To=DateTime.Today.AddDays(30); private string Search="",StatusFilter="",CategoryFilter="",ModalityFilter="";private int Page=1;private bool initialized,Compact;private static readonly string[] Statuses=["pending","confirmed","arrived","in_progress","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){if(!initialized&&History){From=DateTime.Today.AddYears(-1);To=DateTime.Today;initialized=true;}Data=await Get<DoctorAgendaData>($"api/v1/doctor/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&modality={ModalityFilter}&category={CategoryFilter}&search={Escape(Search)}&page={Page}&pageSize=12");}
private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=CategoryFilter=ModalityFilter="";From=History?DateTime.Today.AddYears(-1):DateTime.Today;To=History?DateTime.Today:DateTime.Today.AddDays(30);Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});}
