@page "/medico/agenda"
@page "/medico/historico"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>@(History?"Histórico":"Agenda") | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Médico</p><h1 class="page-title">@(History?"Histórico de atendimentos":"Minha agenda")</h1><p class="page-description">@(History?"Laudos, anexos e avaliações dos seus atendimentos.":"Encontre, filtre e conduza somente os atendimentos atribuídos a você.")</p></div>@if(Capabilities.PatientSchedulingEnabled){<a class="button" href="/medico/agendar">Agendar para paciente</a>}</header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<MobileFilterPanel AriaLabel="Filtros da agenda médica"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="doctor-search">Paciente ou serviço</label><input id="doctor-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="doctor-number">Número do atendimento</label><input id="doctor-number" type="number" min="100" @bind="AppointmentNumber" @bind:event="oninput" /></div><div class="field"><label for="doctor-from">De</label><input id="doctor-from" type="date" @bind="From" /></div><div class="field"><label for="doctor-to">Até</label><input id="doctor-to" type="date" @bind="To" /></div><div class="field"><label for="doctor-status">Estado</label><select id="doctor-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var s in Statuses){<option value="@s">@Status(s)</option>}</select></div><div class="field"><label for="doctor-category">Tipo</label><select id="doctor-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div><div class="field"><label for="doctor-modality">Modalidade</label><select id="doctor-modality" @bind="ModalityFilter"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div></div><div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Data is not null){<div class="mobile-metric-flow"><section class="doctor-kpis"><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>ShowMetric("total")'><strong>@Data.Counters.Total</strong><span>Total</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>ShowMetric("online")'><strong>@Data.Counters.Online</strong><span>Online</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>ShowMetric("in_person")'><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>ShowMetric("rescheduled")'><strong>@Data.Counters.Rescheduled</strong><span>Reagendados</span></button></section><AppointmentMetricDrilldown Title="@MetricTitle" Numbers="@MetricNumbers" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="appointment-results-heading"><p class="muted" role="status">@Data.Page.TotalCount atendimento(s) encontrado(s).</p><AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /></div><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in Data.Page.Items){<DoctorVisitCard Model="item" />}</div>}else{<InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou o período consultado." Icon="calendar" />}
<nav class="patient-pagination" aria-label="Paginação"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy||Page==1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))">Próxima</button></nav>
@code { private DoctorAgendaData? Data; private bool History=>new Uri(Navigation.Uri).AbsolutePath.EndsWith("/historico",StringComparison.OrdinalIgnoreCase); private DateTime From=DateTime.Today,To=DateTime.Today.AddDays(30); private string Search="",StatusFilter="",CategoryFilter="",ModalityFilter="";private ulong? AppointmentNumber;private int Page=1;private bool? LastHistory;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "total" or "online"?2:4;private static readonly string[] Statuses=["pending","confirmed","arrived","in_progress","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){await LoadAppointmentViewAsync();if(LastHistory!=History){From=History?DateTime.Today.AddYears(-1):DateTime.Today;To=History?DateTime.Today:DateTime.Today.AddDays(30);Page=1;SelectedMetric=null;LastHistory=History;}Data=await Get<DoctorAgendaData>($"api/v1/doctor/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&modality={ModalityFilter}&category={CategoryFilter}&appointmentNumber={AppointmentNumber}&search={Escape(Search)}&page={Page}&pageSize=12");}
private Task Apply()=>Run(async()=>{Page=1;SelectedMetric=null;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=CategoryFilter=ModalityFilter="";AppointmentNumber=null;From=History?DateTime.Today.AddYears(-1):DateTime.Today;To=History?DateTime.Today:DateTime.Today.AddDays(30);Page=1;SelectedMetric=null;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});private void ShowMetric(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"total"=>"Total filtrado","online"=>"Atendimentos online","in_person"=>"Atendimentos presenciais","rescheduled"=>"Atendimentos reagendados",_=>"Detalhamento"};private IReadOnlyList<ulong>? MetricNumbers=>SelectedMetric switch{"total"=>Data?.Sources.Total,"online"=>Data?.Sources.Online,"in_person"=>Data?.Sources.InPerson,"rescheduled"=>Data?.Sources.Rescheduled,_=>null};}
