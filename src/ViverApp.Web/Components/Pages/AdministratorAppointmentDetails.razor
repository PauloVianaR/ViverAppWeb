@page "/administracao/atendimentos/{Id:long}"
@inherits AdministratorPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimento administrativo | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">@(Item?.PatientName??"Detalhes do atendimento")</h1><p class="page-description">Ações operacionais e financeiras elevadas, sem abrir conteúdo clínico.</p></div><a class="button button--secondary" href="/administracao/atendimentos">Voltar aos atendimentos</a></header>
<p class="administrator-elevated">Cancelar, reagendar e confirmar pagamento exigem login recente com MFA.</p>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="8"/>}else if(Item is not null){<ManagerVisitCard Model="Item" BasePath="/administracao/atendimentos" ShowDetailsLink="false"/>
<section class="surface patient-panel patient-section"><h2>Ações operacionais</h2><div class="administrator-actions">@if(Item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed"){<a class="button button--secondary" href="/administracao/prontuario/@Item.PatientAccountId">Abrir prontuário</a>}@if(Item.CanRegisterArrival){<button class="button" @onclick="RegisterArrival">Registrar chegada</button>}@if(Item.CanCancelArrival){<button class="button button--danger" @onclick='()=>Open("admin-arrival-cancel")'>Cancelar chegada</button>}@if(Item.CanReschedule){<button class="button button--secondary" @onclick='()=>Open("admin-reschedule")'>Reagendar</button>}@if(Item.CanCancel){<button class="button button--danger" @onclick='()=>Open("admin-cancel")'>Cancelar atendimento</button>}@if(Item.CanComplete){<button class="button" @onclick='()=>Open("admin-complete")'>Finalizar atendimento</button>}@if(Item.CanReopen){<button class="button button--secondary" @onclick='()=>Open("admin-reopen")'>Reabrir atendimento</button>}@if(Item.CanCancelPayment){<button class="button button--danger" @onclick='()=>Open("admin-reversal")'>Cancelar pagamento</button>}@if(Item.CanConfirmPayment){<button class="button" @onclick='()=>Open("admin-payment")'>Confirmar pagamento presencial</button>}</div></section>
<section class="administrator-grid patient-section"><article class="surface administrator-card"><h2>Financeiro</h2><dl class="patient-facts"><div><dt>Estado</dt><dd>@Status(Item.Payment.StatusCode)</dd></div><div><dt>Valor do servidor</dt><dd>@Money(Item.PriceAmount)</dd></div><div><dt>Forma</dt><dd>@Method(Item.Payment.MethodCode)</dd></div><div><dt>Pago em</dt><dd>@(Item.Payment.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</dd></div></dl></article><article class="surface administrator-card"><h2>Metadados clínicos</h2><p><strong>Laudo:</strong> @(Item.Report.Exists?$"{Item.Report.StatusCode}, {Item.Report.VersionCount} versão(ões)":"não registrado")</p><p><strong>Anexos disponíveis:</strong> @Item.AttachmentCount</p><p class="manager-boundary">Conteúdo de laudo e anexos permanece inacessível ao Administrador por sigilo clínico.</p></article></section>
<dialog id="admin-cancel"><h2>Cancelar atendimento</h2><form @onsubmit="Cancel" @onsubmit:preventDefault><div class="field"><label for="admin-cancel-reason">Motivo</label><textarea id="admin-cancel-reason" @bind="CancelReason" required minlength="5" maxlength="500"></textarea></div><div class="administrator-actions"><button class="button button--danger">Confirmar</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-cancel")'>Voltar</button></div></form></dialog>
<dialog id="admin-arrival-cancel"><h2>Cancelar chegada</h2><p>A senha não será reutilizada e o atendimento voltará para confirmado.</p><form @onsubmit="CancelArrival" @onsubmit:preventDefault><div class="field"><label for="admin-arrival-cancel-reason">Motivo</label><textarea id="admin-arrival-cancel-reason" @bind="ArrivalCancelReason" required minlength="5" maxlength="500"></textarea></div><div class="administrator-actions"><button class="button button--danger">Confirmar cancelamento da chegada</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-arrival-cancel")'>Voltar</button></div></form></dialog>
<dialog id="admin-reschedule"><h2>Reagendar</h2><div class="field"><label for="admin-new-date">Data</label><input id="admin-new-date" type="date" @bind="NewDate"/></div><button class="button button--secondary" @onclick="LoadSlots">Buscar horários</button><div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="admin-slot" checked="@(SelectedSlot==slot.StartsAt)" @onchange="()=>SelectedSlot=slot.StartsAt"/> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div><div class="field"><label for="admin-move-reason">Motivo</label><textarea id="admin-move-reason" @bind="MoveReason" maxlength="500"></textarea></div><button class="button" @onclick="Reschedule" disabled="@(!SelectedSlot.HasValue)">Reagendar</button></dialog>
<dialog id="admin-payment"><h2>Confirmar pagamento presencial</h2><p>Valor autorizado pelo servidor: <strong>@Money(Item.PriceAmount)</strong>.</p><div class="field"><label for="admin-method">Forma</label><select id="admin-method" @bind="PaymentMethod"><option value="pix">Pix</option><option value="cash">Dinheiro</option><option value="credit_card">Cartão de crédito</option><option value="debit_card">Cartão de débito</option></select></div><div class="field"><label for="admin-paid-at">Data e hora</label><input id="admin-paid-at" type="datetime-local" @bind="PaymentDate"/></div>@if(IsCard){<div class="field"><label for="admin-last4">Últimos quatro dígitos</label><input id="admin-last4" inputmode="numeric" maxlength="4" @bind="CardLastFour"/></div><div class="field"><label for="admin-auth">Autorização</label><input id="admin-auth" maxlength="100" @bind="Authorization"/></div>}<button class="button" @onclick="ConfirmPayment">Confirmar uma única vez</button></dialog>
<dialog id="admin-complete"><h2>Finalizar atendimento?</h2><p>Confirme a conclusão. O Administrador poderá reabrir posteriormente, com motivo auditado.</p><div class="administrator-actions"><button class="button" @onclick="Complete">Confirmar finalização</button><button class="button button--secondary" @onclick='()=>Close("admin-complete")'>Voltar</button></div></dialog>
<dialog id="admin-reopen"><h2>Reabrir atendimento</h2><p>O atendimento voltará ao estado anterior à finalização.</p><div class="field"><label for="admin-reopen-reason">Motivo</label><textarea id="admin-reopen-reason" minlength="5" maxlength="500" @bind="ReopenReason"></textarea></div><div class="administrator-actions"><button class="button" @onclick="Reopen">Confirmar reabertura</button><button class="button button--secondary" @onclick='()=>Close("admin-reopen")'>Voltar</button></div></dialog>
<dialog id="admin-reversal"><h2>Cancelar pagamento</h2><p>A entrada original permanecerá no caixa e uma reversão vinculada será criada. A sessão administrativa exige MFA.</p><div class="field"><label for="admin-reversal-reason">Motivo</label><textarea id="admin-reversal-reason" minlength="5" maxlength="500" @bind="ReversalReason"></textarea></div><div class="administrator-actions"><button class="button button--danger" @onclick="ReversePayment">Confirmar cancelamento do pagamento</button><button class="button button--secondary" @onclick='()=>Close("admin-reversal")'>Voltar</button></div></dialog>}
@code {
    private string ReopenReason = "";
    private Task Complete() => Run(async () => { await Request<object>($"api/v1/administrator/appointments/{Id}/complete", "POST", new { rowVersion = Item!.RowVersion }); await Close("admin-complete"); await Load(); Notice = "Atendimento finalizado."; });
    private Task Reopen() => Run(async () => { await Request<object>($"api/v1/administrator/appointments/{Id}/reopen", "POST", new { rowVersion = Item!.RowVersion, reason = ReopenReason }); await Close("admin-reopen"); ReopenReason = ""; await Load(); Notice = "Atendimento reaberto no estado anterior."; });
}
@code{[Parameter]public long Id{get;set;}private ManagerAppointment? Item;private string CancelReason="",ArrivalCancelReason="",MoveReason="",PaymentMethod="pix",CardLastFour="",Authorization="",ReversalReason="";private DateTime NewDate=DateTime.Today.AddDays(1),PaymentDate=DateTime.Now;private IReadOnlyList<WebAvailableSlot> Slots=[];private TimeOnly? SelectedSlot;private bool IsCard=>PaymentMethod is "credit_card" or "debit_card";protected override async Task Load()=>Item=await Get<ManagerAppointment>($"api/v1/administrator/appointments/{Id}");
private Task RegisterArrival()=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{Id}/arrival","POST",new{rowVersion=Item!.RowVersion});await Load();Notice=$"Chegada registrada. Senha {Item!.ArrivalQueueNumber}.";});private Task CancelArrival()=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{Id}/arrival/cancel","POST",new{rowVersion=Item!.RowVersion,reason=ArrivalCancelReason});await Close("admin-arrival-cancel");ArrivalCancelReason="";await Load();Notice="Chegada cancelada com motivo registrado. O atendimento voltou para confirmado.";});private Task Cancel()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/cancel","POST",new{reason=CancelReason,rowVersion=Item!.RowVersion});await Close("admin-cancel");await Load();Notice="Atendimento cancelado.";});private Task LoadSlots()=>Run(async()=>{Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/administrator/booking/slots?patientAccountId={Item!.PatientAccountId}&doctorAccountId={Item.ProfessionalAccountId}&appointmentTypeId={Item.AppointmentTypeId}&modality={Item.ModalityCode}&from={NewDate:yyyy-MM-dd}&days=1")??[];SelectedSlot=null;});private Task Reschedule()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/reschedule","POST",new{localDate=DateOnly.FromDateTime(NewDate),localStartsAt=SelectedSlot,reason=MoveReason,rowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await Close("admin-reschedule");Navigation.NavigateTo("/administracao/atendimentos");});private Task ConfirmPayment()=>Run(async()=>{if(IsCard&&(CardLastFour.Length!=4||string.IsNullOrWhiteSpace(Authorization))){Notice="Informe os quatro dígitos e a autorização do cartão.";NoticeError=true;return;}await Request<ManagerPayment>($"api/v1/administrator/appointments/{Id}/payment","POST",new{methodCode=PaymentMethod,paidAtUtc=PaymentDate.ToUniversalTime(),cardLastFour=IsCard?CardLastFour:null,authorizationReference=IsCard?Authorization:null,appointmentRowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await Close("admin-payment");await Load();Notice="Pagamento presencial confirmado e auditado.";});private Task ReversePayment()=>Run(async()=>{await Request<PaymentReversalResult>($"api/v1/management/cash/payments/{Item!.Payment.Id}/reversal","POST",new{rowVersion=Item.Payment.RowVersion,reason=ReversalReason},Guid.NewGuid().ToString("N"));await Close("admin-reversal");await Load();Notice="Pagamento cancelado; o atendimento voltou para pendente e já aceita um novo pagamento.";});}
