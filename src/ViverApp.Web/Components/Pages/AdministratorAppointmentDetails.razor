@page "/administracao/atendimentos/{Id:long}"
@inherits AdministratorPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimento administrativo | ViverApp</PageTitle>
<header class="workspace-heading appointment-compact-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">@(Item?.PatientName??"Detalhes do atendimento")</h1><p class="page-description">Ações operacionais e financeiras elevadas, sem abrir conteúdo clínico.</p></div><a class="button button--secondary" href="@AgendaReturn" @onclick="BackToAgenda" @onclick:preventDefault>Voltar à agenda</a></header>
<p class="administrator-elevated">Cancelar, reagendar e confirmar pagamento exigem login recente com MFA.</p>
@if(Notice is not null){<UiNotice Message="@Notice" IsError="NoticeError" />}
@if(Loading){<LoadingSkeleton Lines="8"/>}else if(Item is not null){<AppointmentWorkspace PatientId="@((long)Item.PatientAccountId)" PatientSaved="Load"><div class="appointment-detail-grid"><AppointmentClassificationEditor @key="Item.RowVersion" AppointmentId="Id" Saved="Load" /><ManagerVisitCard Model="Item" BasePath="/administracao/atendimentos" ShowDetailsLink="false" ShowPhoneAction="false"/>
<section class="surface patient-panel patient-section appointment-operation-panel"><h2>Ações operacionais</h2><div class="administrator-actions">@if(Item.PatientPhone is not null){<a class="button button--secondary" href="tel:@Item.PatientPhone"><AppIcon Name="phone" /> Ligar para paciente</a>}@if(Item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed"){<a class="button button--secondary" href="/administracao/prontuario/@Item.PatientAccountId"><AppIcon Name="file" /> Abrir prontuário</a>}@if(Item.CanRegisterArrival){<button class="button" @onclick="RegisterArrival"><AppIcon Name="bell" /> Registrar chegada</button>}@if(Item.CanCancelArrival){<button class="button button--danger" @onclick='()=>Open("admin-arrival-cancel")'><AppIcon Name="close" /> Cancelar chegada</button>}@if(Item.CanReschedule){<button class="button button--secondary" @onclick="ShowReschedule"><AppIcon Name="calendar" /> Reagendar</button>}@if(Item.CanCancel){<button class="button button--danger" @onclick='()=>Open("admin-cancel")'><AppIcon Name="close" /> Cancelar atendimento</button>}@if(Item.CanComplete){<button class="button" @onclick='()=>Open("admin-complete")'><AppIcon Name="check" /> Finalizar atendimento</button>}@if((Item.StatusCode is "confirmed" or "arrived") && Item.StartsAtUtc <= DateTime.UtcNow){<button class="button button--secondary" @onclick='()=>Open("admin-no-show")'><AppIcon Name="close" /> Marcar como não compareceu</button>}@if(Item.CanReopen){<button class="button button--secondary" @onclick='()=>Open("admin-reopen")'><AppIcon Name="history" /> Reabrir atendimento</button>}@if(CanPointDiscount){<button class="button button--secondary" @onclick="ShowPointDiscount"><AppIcon Name="card" /> @(Item.PointDiscountKindCode is null?"Aplicar desconto pontual":"Alterar desconto pontual")</button>@if(Item.PointDiscountKindCode is not null){<button class="button button--secondary" @onclick="RemovePointDiscount"><AppIcon Name="card" /> Remover desconto pontual</button>}}@if(Item.CanCancelPayment){<button class="button button--danger" @onclick='()=>Open("admin-reversal")'><AppIcon Name="card" /> @(Item.StatusCode=="no_show"?"Estornar valor ao paciente":"Cancelar pagamento")</button>}@if(Item.CanConfirmPayment){<button class="button" @onclick='()=>Open("admin-payment")'><AppIcon Name="card" /> Confirmar pagamento presencial</button>}</div></section>
<details class="appointment-detail-extra"><summary>Serviços e financeiro</summary><section class="administrator-grid patient-section"><article class="surface administrator-card"><h2>Serviços e financeiro</h2><ul>@foreach(var service in Item.Services){<li>@service.Name · @service.DurationMinutes min · @(service.RequiresPayment?Money(service.BasePriceAmount):"Sem cobrança")</li>}</ul>@if(!Item.RequiresPayment){<p class="notice notice--success">Este atendimento não possui cobrança nem pagamento pendente.</p>}<dl class="patient-facts"><div><dt>Estado</dt><dd>@(Item.RequiresPayment ? Status(Item.Payment.StatusCode) : "Sem cobrança")</dd></div><div><dt>Valor base</dt><dd>@Money(Item.BasePriceAmount)</dd></div>@if(Item.DiscountPercent>0){<div><dt>Premium</dt><dd>@Item.DiscountPercent.ToString("0.##")%</dd></div>}@if(Item.PointDiscountAmount>0){<div><dt>Desconto pontual</dt><dd>-@Money(Item.PointDiscountAmount) (@(Item.PointDiscountKindCode=="percent"?$"{Item.PointDiscountValue:0.##}%":"valor em reais"))</dd></div>}<div><dt>Valor final</dt><dd><strong>@Money(Item.PriceAmount)</strong></dd></div>@if(Item.RequiresPayment){<div><dt>Forma</dt><dd>@Method(Item.Payment.MethodCode)</dd></div><div><dt>Pago em</dt><dd>@(Item.Payment.PaidAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</dd></div>}</dl></article></section></details>
<details class="appointment-report-expander"><summary>Laudo e anexos do atendimento</summary><AppointmentReportEditor @key="Id" AppointmentId="Id" RefreshVersion="Item.RowVersion" Saved="Load" Embedded="true" /><AppointmentAttachments @key='@($"{Id}-attachments")' AppointmentId="Id" CanUpload='@(Item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed")' /></details>
@if(Item.StatusCode=="completed"){<OperationalReviewEditor @key='@($"{Id}-operational")' AppointmentId="Id" />}
</div></AppointmentWorkspace>
<dialog id="admin-cancel"><h2>Cancelar atendimento</h2><form @onsubmit="Cancel" @onsubmit:preventDefault><div class="field"><label for="admin-cancel-reason">Motivo</label><textarea id="admin-cancel-reason" @bind="CancelReason" required minlength="5" maxlength="500"></textarea></div><div class="administrator-actions"><button class="button button--danger">Confirmar</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-cancel")'>Voltar</button></div></form></dialog>
<dialog id="admin-no-show"><h2>Confirmar ausência do paciente?</h2><p>Marque apenas após o horário de início. O atendimento sairá da Agenda e permanecerá no histórico como “Não compareceu”.</p><div class="administrator-actions"><button class="button button--danger" @onclick="NoShow">Confirmar não comparecimento</button><button class="button button--secondary" @onclick='()=>Close("admin-no-show")'>Voltar</button></div></dialog>
<dialog id="admin-arrival-cancel"><h2>Cancelar chegada</h2><p>A senha não será reutilizada e o atendimento voltará para confirmado.</p><form @onsubmit="CancelArrival" @onsubmit:preventDefault><div class="field"><label for="admin-arrival-cancel-reason">Motivo</label><textarea id="admin-arrival-cancel-reason" @bind="ArrivalCancelReason" required minlength="5" maxlength="500"></textarea></div><div class="administrator-actions"><button class="button button--danger">Confirmar cancelamento da chegada</button><button type="button" class="button button--secondary" @onclick='()=>Close("admin-arrival-cancel")'>Voltar</button></div></form></dialog>
<dialog id="admin-reschedule"><h2>Reagendar</h2>@if(RescheduleOpen){<BookingAvailabilityCalendar @key="Item.Id" SlotsApiPrefix="@RescheduleCalendarApi" DateSelected="SelectRescheduleDate" />}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="admin-slot" checked="@(SelectedSlot==slot.StartsAt)" @onchange="()=>SelectedSlot=slot.StartsAt"/> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div><div class="field"><label for="admin-move-reason">Motivo</label><textarea id="admin-move-reason" @bind="MoveReason" maxlength="500"></textarea></div><button class="button" @onclick="Reschedule" disabled="@(!SelectedSlot.HasValue)">Reagendar</button><button class="button button--secondary" @onclick="CloseReschedule">Voltar</button></dialog>
<dialog id="admin-payment"><h2>Confirmar pagamento presencial</h2><PaymentSplitEditor Portions="@PaymentRows" Total="@Item.PriceAmount" /><div class="field"><label for="admin-paid-at">Data e hora</label><input id="admin-paid-at" type="datetime-local" @bind="PaymentDate"/></div><button class="button" @onclick="ConfirmPayment">Confirmar uma única vez</button></dialog>
<dialog id="admin-point-discount"><h2>Desconto pontual</h2><p>O limite máximo é configurado em Clínica. O desconto só pode ser concedido antes do pagamento.</p><div class="field"><label>Tipo</label><select @bind="PointKind"><option value="percent">Porcentagem</option><option value="amount">Reais</option></select></div><div class="field"><label>Valor</label><input type="number" min="0.01" step="0.01" @bind="PointValue" /></div><button class="button" @onclick="ApplyPointDiscount">Confirmar desconto</button><button class="button button--secondary" @onclick='()=>Close("admin-point-discount")'>Voltar</button></dialog>
<dialog id="admin-complete"><h2>Finalizar atendimento?</h2><p>Confirme a conclusão. O Administrador poderá reabrir posteriormente, com motivo auditado.</p><div class="administrator-actions"><button class="button" @onclick="Complete">Confirmar finalização</button><button class="button button--secondary" @onclick='()=>Close("admin-complete")'>Voltar</button></div></dialog>
<dialog id="admin-reopen"><h2>Reabrir atendimento</h2><p>O atendimento voltará ao estado anterior à finalização.</p><div class="field"><label for="admin-reopen-reason">Motivo</label><textarea id="admin-reopen-reason" minlength="5" maxlength="500" @bind="ReopenReason"></textarea></div><div class="administrator-actions"><button class="button" @onclick="Reopen">Confirmar reabertura</button><button class="button button--secondary" @onclick='()=>Close("admin-reopen")'>Voltar</button></div></dialog>
<dialog id="admin-reversal"><h2>@(Item.StatusCode=="no_show"?"Estornar valor ao paciente":"Cancelar pagamento")</h2><p>A entrada original permanecerá no caixa; a saída vinculada será lançada somente no caixa do dia do estorno. @(Item.StatusCode=="no_show"?"O atendimento permanecerá como não compareceu.":"O atendimento voltará para Aguardando Pagamento.") A sessão administrativa exige MFA.</p><div class="field"><label for="admin-reversal-reason">Motivo</label><textarea id="admin-reversal-reason" minlength="5" maxlength="500" @bind="ReversalReason"></textarea></div><div class="administrator-actions"><button class="button button--danger" @onclick="ReversePayment">@(Item.StatusCode=="no_show"?"Confirmar estorno":"Confirmar cancelamento do pagamento")</button><button class="button button--secondary" @onclick='()=>Close("admin-reversal")'>Voltar</button></div></dialog>}
@inject AppointmentNavigationStore AgendaContext

@code { [SupplyParameterFromQuery(Name="returnTo")]public string? ReturnQuery{get;set;}
private string AgendaReturn=>"/administracao" + "/agenda";
private async Task BackToAgenda() { var context=await AgendaContext.RestoreAsync("/administracao",ReturnQuery);if(context is not null)context=context with{Time=null};await AgendaContext.NavigateAsync(AgendaReturn,context); }

    private string ReopenReason = "";
    private Task Complete() => Run(async () => { await Request<object>($"api/v1/administrator/appointments/{Id}/complete", "POST", new { rowVersion = Item!.RowVersion }); await Close("admin-complete"); await Load(); Notice = "Atendimento finalizado."; });
    private Task Reopen() => Run(async () => { await Request<object>($"api/v1/administrator/appointments/{Id}/reopen", "POST", new { rowVersion = Item!.RowVersion, reason = ReopenReason }); await Close("admin-reopen"); ReopenReason = ""; await Load(); Notice = "Atendimento reaberto no estado anterior."; });
    private Task NoShow() => Run(async () => { await Request<WebClinicalAppointment>($"api/v1/clinical/appointments/{Id}/no-show", "POST", new { appointmentRowVersion = Item!.RowVersion }); await Close("admin-no-show"); await Load(); Notice = "Não comparecimento registrado. O atendimento saiu da Agenda."; });
}
@code{
[Parameter]public long Id{get;set;}private ManagerAppointment? Item;private string CancelReason="",ArrivalCancelReason="",MoveReason="",ReversalReason="",PointKind="percent";private decimal PointValue;private List<PaymentPortionEditor> PaymentRows=[];private DateTime NewDate=DateTime.Today.AddDays(1),PaymentDate=DateTime.Now;private IReadOnlyList<WebAvailableSlot> Slots=[];private TimeOnly? SelectedSlot;private bool CanPointDiscount=>Item is {RequiresPayment:true}&&(Item.StatusCode is "pending" or "confirmed")&&Item.Payment.StatusCode!="paid";protected override async Task Load(){Item=await Get<ManagerAppointment>($"api/v1/administrator/appointments/{Id}");if(Item is not null)PaymentRows=[new PaymentPortionEditor{Amount=Item.PriceAmount}];}
private bool RescheduleOpen;
private Task ShowReschedule(){RescheduleOpen=true;return Open("admin-reschedule");}
private async Task CloseReschedule(){await Close("admin-reschedule");RescheduleOpen=false;Slots=[];SelectedSlot=null;}
private string RescheduleExtras=>string.Concat((Item?.Services??[]).Where(x=>x.AppointmentTypeId!=Item!.AppointmentTypeId).Select(x=>$"&additionalAppointmentTypeIds={x.AppointmentTypeId}"));
private string RescheduleCalendarApi=>$"api/v1/administrator/booking/slots?patientAccountId={Item!.PatientAccountId}&doctorAccountId={Item.ProfessionalAccountId}&appointmentTypeId={Item.AppointmentTypeId}&modality={Item.ModalityCode}{RescheduleExtras}{RescheduleDurationQuery}";
private string RescheduleDurationQuery=>Item!.Services.Count>1?$"&durationMinutes={(int)(Item.EndsAtUtc-Item.StartsAtUtc).TotalMinutes}":"";
private void SelectRescheduleDate(BookingDaySelection selection){Slots=selection.Slots;SelectedSlot=null;if(selection.Date!=default)NewDate=selection.Date.ToDateTime(TimeOnly.MinValue);}
private Task RegisterArrival()=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{Id}/arrival","POST",new{rowVersion=Item!.RowVersion});await Load();Notice=$"Chegada registrada. Senha {Item!.ArrivalQueueNumber}.";});private Task CancelArrival()=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{Id}/arrival/cancel","POST",new{rowVersion=Item!.RowVersion,reason=ArrivalCancelReason});await Close("admin-arrival-cancel");ArrivalCancelReason="";await Load();Notice="Chegada cancelada com motivo registrado. O atendimento voltou para confirmado.";});private Task Cancel()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/cancel","POST",new{reason=CancelReason,rowVersion=Item!.RowVersion});await Close("admin-cancel");await Load();Notice="Atendimento cancelado.";});private Task LoadSlots()=>Run(async()=>{Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/administrator/booking/slots?patientAccountId={Item!.PatientAccountId}&doctorAccountId={Item.ProfessionalAccountId}&appointmentTypeId={Item.AppointmentTypeId}&modality={Item.ModalityCode}{RescheduleExtras}&from={NewDate:yyyy-MM-dd}&days=1")??[];SelectedSlot=null;});private Task Reschedule()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/reschedule","POST",new{localDate=DateOnly.FromDateTime(NewDate),localStartsAt=SelectedSlot,reason=MoveReason,rowVersion=Item!.RowVersion},Guid.NewGuid().ToString("N"));await CloseReschedule();await Load();MoveReason="";Notice="Atendimento reagendado. A data e o histórico foram atualizados.";});private Task ConfirmPayment()=>Run(async()=>{var error=PaymentPortionEditor.Validate(PaymentRows,Item!.PriceAmount);if(error is not null){Notice=error;NoticeError=true;return;}var portions=PaymentRows.Select(x=>new{methodCode=x.MethodCode,amount=x.Amount,cardLastFour=x.IsCard?x.CardLastFour:null,authorizationReference=x.IsCard?x.AuthorizationReference:null}).ToArray();await Request<ManagerPayment>($"api/v1/administrator/appointments/{Id}/payment","POST",new{methodCode=portions[0].methodCode,paidAtUtc=PaymentDate.ToUniversalTime(),cardLastFour=portions.Length==1?portions[0].cardLastFour:null,authorizationReference=portions.Length==1?portions[0].authorizationReference:null,appointmentRowVersion=Item.RowVersion,allocations=portions},Guid.NewGuid().ToString("N"));await Close("admin-payment");await Load();Notice="Pagamento presencial confirmado e auditado.";});private Task ShowPointDiscount(){PointKind=Item!.PointDiscountKindCode??"percent";PointValue=Item.PointDiscountValue??0;return Open("admin-point-discount");}
private Task RemovePointDiscount()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/point-discount","POST",new{kindCode="none",value=0,rowVersion=Item!.RowVersion});await Load();Notice="Desconto pontual removido.";});
private Task ApplyPointDiscount()=>Run(async()=>{await Request<WebAppointment>($"api/v1/administrator/appointments/{Id}/point-discount","POST",new{kindCode=PointKind,value=PointValue,rowVersion=Item!.RowVersion});await Close("admin-point-discount");await Load();PaymentRows=[new PaymentPortionEditor{Amount=Item!.PriceAmount}];Notice="Desconto pontual registrado no atendimento.";});private Task ReversePayment()=>Run(async()=>{var wasNoShow=Item!.StatusCode=="no_show";await Request<PaymentReversalResult>($"api/v1/management/cash/payments/{Item.Payment.Id}/reversal","POST",new{rowVersion=Item.Payment.RowVersion,reason=ReversalReason},Guid.NewGuid().ToString("N"));await Close("admin-reversal");await Load();Notice=wasNoShow?"Valor estornado e saída registrada no caixa de hoje. O atendimento permanece como não compareceu.":"Pagamento cancelado; o atendimento voltou para Aguardando Pagamento e já aceita um novo pagamento.";});}
