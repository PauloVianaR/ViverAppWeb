@page "/medico/pacientes"
@inherits DoctorPageBase
<PageTitle>Meus pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Médico</p><h1 class="page-title">Meus pacientes</h1><p class="page-description">Somente pacientes com vínculo explícito ou atendimento atribuído a você.</p></div><div class="patient-actions"><button class="button" @onclick='()=>Open("link-patient")'>Vincular paciente</button><button class="button button--secondary" @onclick='()=>Open("invite-patient")'>Convidar novo</button></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<MobileFilterPanel AriaLabel="Filtros de pacientes do médico"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="patient-search">Nome, e-mail ou telefone</label><input id="patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="patient-status">Estado</label><select id="patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="blocked">Bloqueados</option></select></div><div class="field"><label for="patient-premium">Plano</label><select id="patient-premium" @bind="Premium"><option value="">Todos</option><option value="true">Premium</option><option value="false">Sem Premium</option></select></div></div><div class="patient-actions"><button class="button">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Data is not null){<div class="mobile-metric-flow"><section class="doctor-kpis"><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>SelectMetric("total")'><strong>@Data.Counters.Total</strong><span>Total</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>SelectMetric("premium")'><strong>@Data.Counters.Premium</strong><span>Premium</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>SelectMetric("active")'><strong>@Data.Counters.Active</strong><span>Ativos</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>SelectMetric("blocked")'><strong>@Data.Counters.Blocked</strong><span>Bloqueados</span></button></section><MetricEvidenceDrilldown Title="@MetricTitle" Items="@MetricItems" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel"><div class="patient-visit__top"><div><h2>@patient.FullName</h2><p>@(patient.PreferredName is null?"":$"Prefere ser chamado(a) de {patient.PreferredName}")</p></div>@if(patient.IsPremium){<span class="badge badge--brand">Premium</span>}</div><p>@(patient.Email??"E-mail não informado")<br />@(patient.Phone??"Telefone não informado")</p><p>@(patient.BirthDate.HasValue?$"Nascimento: {patient.BirthDate:dd/MM/yyyy}":"Nascimento não informado") · @patient.AppointmentCount atendimento(s)</p><p>Último: @(patient.LastAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy")??"—") · Próximo: @(patient.NextAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</p><div class="patient-actions"><a class="button button--small" href="/medico/pacientes/@patient.AccountId/agendar">Agendar</a><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar nome preferido</button>@if(patient.Phone is not null){<a class="button button--secondary button--small" href="tel:@patient.Phone">Ligar</a>}</div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Vincule uma conta confirmada ou convide um novo paciente." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="link-patient" class="patient-dialog"><h2>Vincular paciente existente</h2><p>Informe o e-mail ou telefone completo e já confirmado pelo paciente. A busca exata evita expor a base da clínica.</p><form @onsubmit="Link" @onsubmit:preventDefault><div class="field"><label for="link-identifier">E-mail ou telefone</label><input id="link-identifier" @bind="Identifier" required maxlength="254" autocomplete="off" /></div><div class="patient-actions"><button class="button">Vincular</button><button type="button" class="button button--secondary" @onclick='()=>Close("link-patient")'>Voltar</button></div></form></dialog>
<dialog id="invite-patient" class="patient-dialog"><h2>Convidar novo paciente</h2><p>A conta ficará pendente até que a pessoa confirme o código enviado por e-mail ou SMS.</p><form @onsubmit="Invite" @onsubmit:preventDefault><div class="field"><label for="invite-name">Nome completo</label><input id="invite-name" @bind="InviteName" required minlength="3" maxlength="200" /></div><div class="field"><label for="invite-email">E-mail</label><input id="invite-email" type="email" @bind="InviteEmail" maxlength="254" /></div><div class="field"><label for="invite-phone">Telefone</label><input id="invite-phone" type="tel" @bind="InvitePhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="invite-birth">Nascimento</label><input id="invite-birth" type="date" @bind="InviteBirth" /></div><div class="patient-actions"><button class="button">Enviar convite</button><button type="button" class="button button--secondary" @onclick='()=>Close("invite-patient")'>Voltar</button></div></form></dialog>
<dialog id="edit-patient" class="patient-dialog"><h2>Dados operacionais</h2><p>Contatos e dados clínicos só podem ser alterados pelo próprio paciente ou por fluxo administrativo autorizado.</p><form @onsubmit="SavePatient" @onsubmit:preventDefault><div class="field"><label for="preferred-name">Nome preferido</label><input id="preferred-name" @bind="PreferredName" maxlength="200" /></div><div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("edit-patient")'>Voltar</button></div></form></dialog>
@code { private DoctorPatientsData? Data;private string Search="",Status="",Premium="",Identifier="",InviteName="",InviteEmail="",InvitePhone="",PreferredName="";private DateTime? InviteBirth;private int Page=1;private DoctorPatient? Selected;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "total" or "premium"?2:4;
protected override async Task Load()=>Data=await Get<DoctorPatientsData>($"api/v1/doctor/patients?search={Escape(Search)}&status={Status}&premium={Premium}&page={Page}&pageSize=12");private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=Status=Premium="";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private Task Link()=>Run(async()=>{await Request<DoctorPatient>("api/v1/doctor/patients/link","POST",new{identifier=Identifier});await Close("link-patient");Identifier="";await Load();Notice="Paciente vinculado com segurança.";});
private Task Invite()=>Run(async()=>{await Request<DoctorPatient>("api/v1/doctor/patients/invite","POST",new{fullName=InviteName,email=string.IsNullOrWhiteSpace(InviteEmail)?null:InviteEmail,phoneE164=string.IsNullOrWhiteSpace(InvitePhone)?null:InvitePhone,birthDate=InviteBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(InviteBirth.Value):null});await Close("invite-patient");InviteName=InviteEmail=InvitePhone="";InviteBirth=null;await Load();Notice="Convite enviado. O acesso depende da confirmação do contato.";});
private async Task Edit(DoctorPatient patient){Selected=patient;PreferredName=patient.PreferredName??"";await Open("edit-patient");}
private Task SavePatient()=>Run(async()=>{await Request<DoctorPatient>($"api/v1/doctor/patients/{Selected!.AccountId}","PUT",new{preferredName=PreferredName,rowVersion=Selected.RowVersion});await Close("edit-patient");await Load();Notice="Dado operacional atualizado.";});
private void SelectMetric(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"total"=>"Todos os pacientes vinculados","premium"=>"Pacientes Premium","active"=>"Pacientes ativos","blocked"=>"Pacientes bloqueados",_=>"Detalhamento"};private IReadOnlyList<string>? MetricItems=>SelectedMetric switch{"total"=>Data?.Sources.Total,"premium"=>Data?.Sources.Premium,"active"=>Data?.Sources.Active,"blocked"=>Data?.Sources.Blocked,_=>null};}
