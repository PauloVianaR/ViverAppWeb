@page "/paciente/agendar"
@inherits PatientPageBase
@using System.Globalization
@using static ViverApp.Web.PatientLabels
<PageTitle>Agendar | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Paciente</p><h1 class="page-title">@(Original is null ? "Novo agendamento" : "Reagendar atendimento")</h1><p class="page-description">Escolha seu cuidado, profissional e horário. Horários no fuso da clínica.</p></div><a class="button button--secondary" href="/paciente/agenda">Minha agenda</a></header>
@if (Notice is not null) { <p class="notice @(NoticeError ? "notice--error" : "notice--success")" role="alert">@Notice</p> }
@if (Loading) { <LoadingSkeleton Lines="5" /> }
<nav class="booking-steps" aria-label="Etapas do agendamento"><span class="booking-step booking-step--active"><b>1</b> Atendimento</span><span class="booking-step"><b>2</b> Profissional</span><span class="booking-step"><b>3</b> Horário</span><span class="booking-step"><b>4</b> Confirmar</span></nav>
<div class="booking-layout">
    <div class="booking-main">
        <section class="surface booking-panel"><h2>1. Escolha o atendimento</h2>
            @if (Original is null)
            {
                <div class="patient-tabs" aria-label="Tipo de atendimento">@foreach(var code in new[]{"consultation","examination","surgery","procedure"}){<button class="button @(CategoryCode == code ? null : "button--secondary")" aria-pressed="@(CategoryCode == code)" disabled="@Busy" @onclick="() => ChangeCategory(code)">@Category(code)</button>}</div>
                <form @onsubmit="SearchServices" @onsubmit:preventDefault><div class="field"><label for="service-search">Pesquisar serviço</label><input id="service-search" @bind="ServiceSearch" maxlength="100" /></div><button class="button button--secondary" disabled="@Busy">Pesquisar</button></form>
                <div class="field"><label for="service">Serviço</label><select id="service" @bind="ServiceId" @bind:after="ServiceChanged" disabled="@Busy"><option value="0">Selecione</option>@foreach(var item in Services?.Items ?? []){<option value="@item.Id">@item.Name — @Money(item.PriceAmount)</option>}</select></div>
                <nav class="patient-pagination" aria-label="Páginas de serviços"><button class="button button--secondary" disabled="@(Busy || ServicePage == 1)" @onclick="() => ServicePageChange(-1)">Anteriores</button><span>@ServicePage</span><button class="button button--secondary" disabled="@(Busy || ServicePage * 50 >= (Services?.TotalCount ?? 0))" @onclick="() => ServicePageChange(1)">Mais serviços</button></nav>
            }
            @if (SelectedService is not null)
            {
                <p>@SelectedService.Description</p><p>@SelectedService.DurationMinutes minutos · @Money(SelectedService.PriceAmount)</p>
                @if (SelectedService.DiscountPercent > 0) { <p class="badge badge--brand">Premium: @SelectedService.DiscountPercent% de desconto · antes @Money(SelectedService.BasePrice)</p> }
                <div class="field"><label for="modality">Modalidade</label><select id="modality" @bind="Modality" @bind:after="ModalityChanged" disabled="@(Busy || Original is not null)">@if(SelectedService.ModalityCode is "both" or "in_person"){<option value="in_person">Presencial</option>}@if(SelectedService.ModalityCode is "both" or "online"){<option value="online">Online</option>}</select></div>
            }
        </section>
        <section class="surface booking-panel"><h2>2. Escolha o profissional</h2>
            @if (Original is null)
            {
                <form @onsubmit="SearchDoctors" @onsubmit:preventDefault><div class="field"><label for="professional-search">Nome ou especialidade</label><input id="professional-search" @bind="DoctorSearch" maxlength="100" /></div><button class="button button--secondary" disabled="@(Busy || SelectedService is null)">Buscar profissionais</button></form>
                <div class="professional-list">@foreach(var doctor in Doctors?.Items ?? []){<button type="button" class="professional-card @(SelectedDoctor?.AccountId == doctor.AccountId ? "professional-card--selected" : null)" aria-pressed="@(SelectedDoctor?.AccountId == doctor.AccountId)" disabled="@Busy" @onclick="() => ChooseDoctor(doctor)"><span class="professional-copy"><strong>@doctor.FullName</strong><small>@string.Join(" • ", doctor.Specialties.Select(x => x.Name))</small><small>CRM @doctor.LicenseStateCode @doctor.LicenseNumber · @doctor.YearsExperience anos de experiência</small><small>@(doctor.AverageRating.HasValue ? $"{doctor.AverageRating:0.0} de 5 estrelas ({doctor.ReviewCount} avaliações)" : "Sem avaliações ainda") · @(Modality == "online" ? "Atendimento online" : "Presencial")</small><small>@doctor.Biography</small></span></button>}</div>
                @if (Doctors?.Items.Count == 0) { <p>Nenhum profissional disponível para os filtros. Tente outra busca.</p> }
                <nav class="patient-pagination" aria-label="Páginas de profissionais"><button class="button button--secondary" disabled="@(Busy || DoctorPage == 1)" @onclick="() => DoctorPageChange(-1)">Anteriores</button><span>@DoctorPage</span><button class="button button--secondary" disabled="@(Busy || DoctorPage * 20 >= (Doctors?.TotalCount ?? 0))" @onclick="() => DoctorPageChange(1)">Próximos</button></nav>
            }
            else { <p>@Original.DoctorName</p> }
        </section>
        <section class="surface booking-panel"><h2>3. Data e horário</h2><div class="field"><label for="slots-from">Buscar a partir de</label><input id="slots-from" type="date" @bind="From" disabled="@Busy" /></div><button class="button button--secondary" disabled="@(Busy || SelectedDoctor is null)" @onclick="() => Run(LoadSlots)">Atualizar horários</button>
            @if (Slots.Count == 0) { <p>Selecione um profissional ou outra data para consultar os horários disponíveis.</p> }
            <div class="slot-days">@foreach(var day in Slots.GroupBy(x => x.Date)){<fieldset class="slot-day"><legend>@day.Key.ToString("dddd, dd/MM", CultureInfo.GetCultureInfo("pt-BR"))</legend><div class="slot-grid appointment-slot-grid">@foreach(var slot in day){<button class="slot-button @(SelectedSlot?.StartsAtUtc == slot.StartsAtUtc ? "slot-button--selected" : null)" aria-pressed="@(SelectedSlot?.StartsAtUtc == slot.StartsAtUtc)" disabled="@Busy" @onclick="() => SelectedSlot = slot">@slot.StartsAt.ToString("HH:mm")</button>}</div></fieldset>}</div>
        </section>
    </div>
    <aside class="surface booking-summary"><h2>4. Revise e confirme</h2><dl><div><dt>Atendimento</dt><dd>@SelectedService?.Name</dd></div><div><dt>Profissional</dt><dd>@SelectedDoctor?.FullName</dd></div><div><dt>Modalidade</dt><dd>@(Modality == "online" ? "Online" : "Presencial")</dd></div><div><dt>Horário</dt><dd>@(SelectedSlot is null ? "Não selecionado" : $"{SelectedSlot.Date:dd/MM/yyyy} às {SelectedSlot.StartsAt:HH:mm}")</dd></div><div><dt>Duração</dt><dd>@SelectedService?.DurationMinutes minutos</dd></div><div><dt>Valor</dt><dd>@Money(Original?.PriceAmount ?? SelectedService?.PriceAmount ?? 0)</dd></div>@if (Clinic is not null && Modality == "in_person") { <div><dt>Local</dt><dd>@Clinic.Name · @Clinic.Address</dd></div> }</dl>
        <div class="field"><label for="patient-notes">Observações</label><textarea id="patient-notes" @bind="Notes" maxlength="1000" disabled="@(Original is not null || Busy)"></textarea></div>
        @if(Original is not null){<div class="field"><label for="reschedule-reason">Motivo do reagendamento (opcional)</label><textarea id="reschedule-reason" @bind="Reason" maxlength="500"></textarea></div>}
        <button class="button summary-action" disabled="@(Busy || SelectedSlot is null || SelectedService is null || SelectedDoctor is null)" @onclick="Confirm">@(Original is null ? "Confirmar agendamento" : "Confirmar novo horário")</button><p class="summary-policy">Confira os dados antes de confirmar. O horário e o valor serão validados novamente no momento da reserva.</p>
    </aside>
</div>
@code {
    [SupplyParameterFromQuery(Name="service")] public string? ServiceQuery { get; set; }
    [SupplyParameterFromQuery(Name="reschedule")] public string? RescheduleQuery { get; set; }
    private WebPage<PatientService>? Services;
    private WebPage<WebBookingProfessional>? Doctors;
    private PatientService? SelectedService;
    private WebBookingProfessional? SelectedDoctor;
    private WebAvailableSlot? SelectedSlot;
    private WebAppointment? Original;
    private PatientClinic? Clinic;
    private IReadOnlyList<WebAvailableSlot> Slots = [];
    private uint ServiceId;
    private int ServicePage=1, DoctorPage=1;
    private string CategoryCode="consultation", ServiceSearch="", DoctorSearch="", Modality="in_person", Notes="", Reason="";
    private DateTime From=DateTime.Today;
    private string? SubmissionFingerprint, SubmissionKey;
    protected override async Task Load()
    {
        Original = null; ClearSelection(); Notes = Reason = ""; ServicePage = DoctorPage = 1;
        Clinic = await Get<PatientClinic>("api/v1/patient/experience/clinic");
        if (Clinic is not null) From = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTime.UtcNow, Clinic.Timezone).Date;
        if (ulong.TryParse(RescheduleQuery, out var id))
        {
            var visit=await Get<PatientAppointment>($"api/v1/patient/experience/appointments/{id}");
            if(visit?.CanReschedule != true) throw new PatientUiException("Este atendimento não está disponível para reagendamento.");
            Original=visit.Appointment; ServiceId=Original.AppointmentTypeId; CategoryCode=visit.CategoryCode;
            SelectedService=await Get<PatientService>($"api/v1/patient/experience/services/{ServiceId}"); Modality=Original.ModalityCode; Notes=Original.PatientNotes ?? "";
            SelectedDoctor=new(Original.DoctorAccountId,Original.DoctorName,null,"","",0,[]); await LoadSlots();
        }
        else if(uint.TryParse(ServiceQuery,out var serviceId))
        {
            SelectedService=await Get<PatientService>($"api/v1/patient/experience/services/{serviceId}");
            if(SelectedService is not null){CategoryCode=SelectedService.CategoryCode; ServiceId=SelectedService.Id; Modality=SelectedService.ModalityCode=="online"?"online":"in_person";}
            await LoadServices(); await LoadDoctors();
        }
        else await LoadServices();
    }
    private async Task LoadServices() { Services=await Get<WebPage<PatientService>>($"api/v1/patient/experience/services?page={ServicePage}&pageSize=50&category={CategoryCode}&search={Escape(ServiceSearch)}"); }
    private void ClearSelection() { SelectedService=null; ServiceId=0; SelectedDoctor=null; SelectedSlot=null; Slots=[]; Doctors=null; }
    private Task ChangeCategory(string category)=>Run(async()=>{CategoryCode=category;ServicePage=1;ClearSelection();await LoadServices();});
    private Task SearchServices()=>Run(async()=>{ServicePage=1;ClearSelection();await LoadServices();});
    private Task ServicePageChange(int delta)=>Run(async()=>{ServicePage+=delta;ClearSelection();await LoadServices();});
    private Task ServiceChanged()=>Run(async()=>{SelectedService=Services?.Items.SingleOrDefault(x=>x.Id==ServiceId);Modality=SelectedService?.ModalityCode=="online"?"online":"in_person";SelectedDoctor=null;SelectedSlot=null;Slots=[];DoctorPage=1;await LoadDoctors();});
    private Task ModalityChanged()=>Run(async()=>{SelectedDoctor=null;SelectedSlot=null;Slots=[];DoctorPage=1;await LoadDoctors();});
    private Task SearchDoctors()=>Run(async()=>{DoctorPage=1;SelectedDoctor=null;SelectedSlot=null;Slots=[];await LoadDoctors();});
    private Task DoctorPageChange(int delta)=>Run(async()=>{DoctorPage+=delta;await LoadDoctors();});
    private async Task LoadDoctors(){if(SelectedService is not null)Doctors=await Get<WebPage<WebBookingProfessional>>($"api/v1/patient/booking/professionals?page={DoctorPage}&pageSize=20&appointmentTypeId={ServiceId}&modality={Modality}&search={Escape(DoctorSearch)}");}
    private Task ChooseDoctor(WebBookingProfessional doctor)=>Run(async()=>{SelectedDoctor=doctor;await LoadSlots();});
    private async Task LoadSlots(){SelectedSlot=null;Slots=[];if(SelectedDoctor is not null)Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/patient/booking/slots?doctorAccountId={SelectedDoctor.AccountId}&appointmentTypeId={ServiceId}&modality={Modality}&from={From:yyyy-MM-dd}&days=14")??[];}
    private Task Confirm()=>Run(async()=>
    {
        if(SelectedSlot is null || SelectedDoctor is null || SelectedService is null)return;
        object body=Original is null?new WebAppointmentCreateRequest(SelectedDoctor.AccountId,ServiceId,Modality,SelectedSlot.Date,SelectedSlot.StartsAt,Notes):new WebAppointmentRescheduleRequest(SelectedSlot.Date,SelectedSlot.StartsAt,Reason,Original.RowVersion);
        var fingerprint=System.Text.Json.JsonSerializer.Serialize(body);
        if(SubmissionFingerprint!=fingerprint){SubmissionFingerprint=fingerprint;SubmissionKey=$"patient-{Guid.NewGuid():N}";}
        try{var created=await Request<WebAppointment>(Original is null?"api/v1/patient/appointments":$"api/v1/patient/appointments/{Original.Id}/reschedule","POST",body,SubmissionKey);Navigation.NavigateTo($"/paciente/atendimentos/{created!.Id}");}
        catch(PatientUiException){await LoadSlots();throw;}
    });
}
