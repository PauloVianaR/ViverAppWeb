@page "/gestao/agendar"
@page "/gestao/pacientes/{PatientId:long}/agendar"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pela clínica</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">Escolha o paciente e combine somente serviços, profissionais e horários realmente compatíveis.</p></div><a class="button button--secondary" href="/gestao/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else{
<section class="surface patient-panel manager-welcome"><div class="field"><label for="manager-booking-patient">Paciente</label><select id="manager-booking-patient" value="@SelectedPatientId" @onchange="PatientChanged"><option value="0">Selecione</option>@foreach(var patient in Patients){<option value="@patient.AccountId">@patient.FullName@(patient.IsPremium?" · Premium":"")</option>}</select></div>@if(Patient is not null){<p>@(Patient.IsPremium?$"Paciente Premium — {Patient.PremiumDiscountPercent:0.##}% de desconto aplicado automaticamente.":"Paciente sem benefício Premium ativo.")</p>}</section>
@if(Patient is not null){
<section class="surface patient-panel patient-section"><h2>1. Serviço e modalidade</h2><p>Você pode combinar vários serviços do mesmo tipo base.</p><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(Category==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="field"><label for="manager-service-search">Pesquisar serviço</label><input id="manager-service-search" @bind="ServiceSearch" @bind:event="oninput" maxlength="100" placeholder="Digite parte do nome" /></div><div class="manager-choice-list">@foreach(var service in VisibleServices){<label><input type="checkbox" checked="@(ServiceId==service.Id||AdditionalIds.Contains(service.Id))" disabled="@(ServiceId!=0&&service.ModalityCode!="both"&&service.ModalityCode!=ModalityCode)" @onchange="()=>ToggleService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @if(!service.RequiresPayment){<strong>Sem cobrança</strong>}else if(Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<s>@Money(service.BasePrice)</s> <strong>@Money(Discounted(service.BasePrice))</strong>}else{@Money(service.BasePrice)}</small></span></label>}</div><div class="field"><label for="manager-booking-modality">Modalidade</label><select id="manager-booking-modality" @bind="ModalityCode" @bind:after="ModalityChanged"><option value="in_person">Presencial</option><option value="online">Online</option></select></div></section>
<section class="surface patient-panel patient-section"><h2>2. Profissional, data e horário</h2><div class="field"><label for="manager-booking-doctor">Profissional</label><select id="manager-booking-doctor" @bind="DoctorId" @bind:after="ProfessionalChanged"><option value="0">Selecione</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName · @doctor.LicenseTypeCode @doctor.LicenseStateCode @doctor.LicenseNumber</option>}</select></div>@if(DoctorId != 0){<BookingAvailabilityCalendar @key="CalendarKey" SlotsApiPrefix="@CalendarApi" DateSelected="SelectDate" />}else{<p class="field-hint">Escolha um profissional para ver somente os dias disponíveis.</p>}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-booking-slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="manager-boundary">O horário escolhido não está mais disponível. Escolha outro dia.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="manager-booking-notes">Observações autorizadas</label><textarea id="manager-booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(Capabilities?.PointDiscountsEnabled==true&&BaseTotal>0){<div class="field"><label for="manager-discount-kind">Desconto pontual (limite de @Capabilities.PointDiscountMaxPercent.ToString("0.##")% após Premium)</label><select id="manager-discount-kind" @bind="PointKind"><option value="">Sem desconto</option><option value="percent">Porcentagem</option><option value="amount">Reais</option></select></div>@if(PointKind!=""){<div class="field"><label for="manager-discount-value">Valor do desconto</label><input id="manager-discount-value" type="number" min="0.01" step="0.01" @bind="PointValue" /></div>}}@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviços</dt><dd>@string.Join(" + ",SelectedServices.Select(x=>x.Name))</dd></div><div><dt>Duração total</dt><dd>@SelectedServices.Sum(x=>(int)x.DurationMinutes) min</dd></div><div><dt>Profissional</dt><dd>@(Doctors.SingleOrDefault(x=>x.AccountId==DoctorId)?.FullName??"Selecione")</dd></div><div><dt>Data e horário</dt><dd>@(Selected.HasValue?$"{Date:dd/MM/yyyy} às {Selected:HH:mm}":"Selecione um horário")</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor base</dt><dd>@(BaseTotal>0?Money(BaseTotal):"Sem cobrança")</dd></div>@if(BaseTotal>0&&Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<div><dt>Valor Premium</dt><dd><strong>@Money(PremiumTotal)</strong> · @Patient.PremiumDiscountPercent.ToString("0.##")% de desconto</dd></div>}@if(PointKind!=""&&PointValue>0){<div><dt>Desconto pontual</dt><dd>-@Money(PointPreview)</dd></div><div><dt>Valor final estimado</dt><dd><strong>@Money(PremiumTotal-PointPreview)</strong></dd></div>}<div><dt>Pagamento</dt><dd>@(BaseTotal>0?(ModalityCode=="online"?"Online":"Na clínica"):"Não necessário")</dd></div></dl>}<p class="field-hint">Preço e descontos são recalculados pelo servidor na confirmação.</p><button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||DoctorId==0||!Selected.HasValue)">Confirmar agendamento</button></section>}}
@code {
    [Parameter] public long PatientId { get; set; }
    [SupplyParameterFromQuery(Name="patient")] public long? PatientQuery { get; set; }
    private ManagerPatient? Patient; private IReadOnlyList<ManagerPatient> Patients=[]; private IReadOnlyList<ManagerService> Services=[];
    private IReadOnlyList<WebBookingProfessional> Doctors=[]; private IReadOnlyList<WebAvailableSlot> Slots=[];
    private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia"),("procedure","Procedimento")];
    private string Category="consultation",ModalityCode="in_person",Notes="",ServiceSearch="",PointKind=""; private decimal PointValue; private uint ServiceId; private readonly HashSet<uint> AdditionalIds=[]; private ulong SelectedPatientId,DoctorId;
    private ManagerCapabilities? Capabilities;
    private DateTime Date=DateTime.Today.AddDays(1); private TimeOnly? Selected; private bool SlotsLoaded;
    private string AdditionalQuery=>string.Concat(AdditionalIds.Order().Select(id=>$"&additionalAppointmentTypeIds={id}"));
    private string CalendarKey=>$"{SelectedPatientId}-{DoctorId}-{ServiceId}-{string.Join("-",AdditionalIds.Order())}-{ModalityCode}";
    private string CalendarApi=>$"api/v1/manager/booking/slots?patientAccountId={SelectedPatientId}&doctorAccountId={DoctorId}&appointmentTypeId={ServiceId}&modality={ModalityCode}{AdditionalQuery}";
    private ManagerService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId);
    private IReadOnlyList<ManagerService> SelectedServices=>Services.Where(x=>x.Id==ServiceId||AdditionalIds.Contains(x.Id)).OrderBy(x=>x.Id==ServiceId?0:1).ThenBy(x=>x.Name).ToArray();
    private decimal BaseTotal=>SelectedServices.Sum(x=>x.RequiresPayment?x.BasePrice:0);
    private decimal PremiumTotal=>Patient?.IsPremium==true?Discounted(BaseTotal):BaseTotal;
    private decimal PointPreview=>PointKind=="percent"?decimal.Round(PremiumTotal*PointValue/100m,2,MidpointRounding.AwayFromZero):PointKind=="amount"?PointValue:0;
    private IEnumerable<ManagerService> VisibleServices=>Services.Where(x=>x.CategoryCode==Category&&(string.IsNullOrWhiteSpace(ServiceSearch)||x.Name.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)||(x.Description?.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)??false))).OrderBy(x=>x.Name,StringComparer.CurrentCultureIgnoreCase);
    protected override async Task Load(){await LoadPatients();Capabilities=await Get<ManagerCapabilities>("api/v1/manager/capabilities");Services=await Get<IReadOnlyList<ManagerService>>("api/v1/manager/services")??[];SelectedPatientId=(ulong)Math.Max(PatientId,PatientQuery??0);if(SelectedPatientId!=0)await LoadPatient();var first=Services.FirstOrDefault(x=>x.CategoryCode==Category);if(first is not null)await ChooseServiceCore(first);}
    private async Task LoadPatients(){var items=new List<ManagerPatient>();var pageNumber=1;while(true){var response=await Get<ManagerPatientsData>($"api/v1/manager/patients?page={pageNumber}&pageSize=100");if(response is null)break;items.AddRange(response.Page.Items);if(items.Count>=response.Page.TotalCount||response.Page.Items.Count==0)break;pageNumber++;}Patients=items;}
    private Task PatientChanged(ChangeEventArgs args)=>Run(async()=>{SelectedPatientId=ulong.TryParse(args.Value?.ToString(),out var id)?id:0;await LoadPatient();});
    private async Task LoadPatient(){Patient=SelectedPatientId==0?null:await Get<ManagerPatient>($"api/v1/manager/patients/{SelectedPatientId}");Slots=[];Selected=null;SlotsLoaded=false;}
    private Task ChooseCategory(string value)=>Run(async()=>{Category=value;ServiceSearch="";AdditionalIds.Clear();var first=Services.FirstOrDefault(x=>x.CategoryCode==value);if(first is not null)await ChooseServiceCore(first);else{ServiceId=0;Doctors=[];Slots=[];}});
    private Task ToggleService(ManagerService service)=>Run(async()=>{if(ServiceId==service.Id){if(AdditionalIds.Count>0){ServiceId=AdditionalIds.First();AdditionalIds.Remove(ServiceId);}else ServiceId=0;}else if(AdditionalIds.Contains(service.Id))AdditionalIds.Remove(service.Id);else if(ServiceId==0){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";}else AdditionalIds.Add(service.Id);await LoadEligibleDoctorsCore();});
    private async Task ChooseServiceCore(ManagerService service){ServiceId=service.Id;AdditionalIds.Clear();ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;await LoadEligibleDoctorsCore();}
    private Task ModalityChanged()=>Run(async()=>{AdditionalIds.RemoveWhere(id=>Services.Any(x=>x.Id==id&&x.ModalityCode!="both"&&x.ModalityCode!=ModalityCode));if(CurrentService is { } current&&current.ModalityCode!="both"&&current.ModalityCode!=ModalityCode)ServiceId=0;await LoadEligibleDoctorsCore();});
    private async Task LoadEligibleDoctorsCore(){DoctorId=0;Slots=[];Selected=null;SlotsLoaded=false;if(ServiceId==0){Doctors=[];return;}var items=new List<WebBookingProfessional>();var pageNumber=1;while(true){var response=await Get<WebPage<WebBookingProfessional>>($"api/v1/manager/booking/professionals?appointmentTypeId={ServiceId}&modality={ModalityCode}{AdditionalQuery}&page={pageNumber}&pageSize=50");if(response is null)break;items.AddRange(response.Items);if(items.Count>=response.TotalCount||response.Items.Count==0)break;pageNumber++;}Doctors=items;}
    private void ProfessionalChanged(){Slots=[];Selected=null;SlotsLoaded=false;}
    private void SelectDate(BookingDaySelection selection){Selected=null;Slots=selection.Slots;SlotsLoaded=selection.Date!=default;if(SlotsLoaded)Date=selection.Date.ToDateTime(TimeOnly.MinValue);}
    private Task Confirm()=>Run(async()=>{var request=new ManagerAppointmentCreate(SelectedPatientId,DoctorId,ServiceId,ModalityCode,DateOnly.FromDateTime(Date),Selected!.Value,Notes,AdditionalIds.Order().ToArray(),PointKind==""?null:PointKind,PointKind==""?null:PointValue);var result=await Request<WebAppointment>("api/v1/manager/appointments","POST",request,Guid.NewGuid().ToString("N"));Navigation.NavigateTo($"/gestao/atendimentos/{result!.Id}");});
    private decimal Discounted(decimal value)=>decimal.Round(value*(1-Patient!.PremiumDiscountPercent/100m),2,MidpointRounding.AwayFromZero);
}
