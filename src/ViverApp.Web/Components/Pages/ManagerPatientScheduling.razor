@page "/gestao/pacientes/{PatientId:long}/agendar"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pela clínica</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">Paciente, serviço, modalidade, médico e slot são revalidados pela API.</p></div><a class="button button--secondary" href="/gestao/pacientes">Voltar aos pacientes</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else if(Patient is not null){
<section class="surface patient-panel manager-welcome"><h2>@Patient.FullName</h2><p>@(Patient.IsPremium?"Paciente Premium — o desconto será calculado automaticamente.":"Paciente sem benefício Premium ativo.")</p></section>
<section class="surface patient-panel patient-section"><h2>1. Serviço e modalidade</h2><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(Category==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="manager-choice-list">@foreach(var service in Services.Where(x=>x.CategoryCode==Category)){<label><input type="radio" name="manager-service" checked="@(ServiceId==service.Id)" @onchange="()=>ChooseService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @Money(service.BasePrice)</small></span></label>}</div><div class="field"><label for="manager-booking-modality">Modalidade</label><select id="manager-booking-modality" @bind="ModalityCode"><option value="in_person">Presencial</option><option value="online">Online</option></select></div></section>
<section class="surface patient-panel patient-section"><h2>2. Médico, data e horário</h2><div class="manager-profile-grid"><div class="field"><label for="manager-booking-doctor">Médico</label><select id="manager-booking-doctor" @bind="DoctorId"><option value="0">Selecione</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName · @doctor.LicenseLabel</option>}</select></div><div class="field"><label for="manager-booking-date">Data</label><input id="manager-booking-date" type="date" @bind="Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div></div><button class="button button--secondary" @onclick="LoadSlots">Ver horários disponíveis</button><div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-booking-slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="manager-boundary">Nenhum horário atende simultaneamente à clínica, feriados, disponibilidade, limites e conflitos.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="manager-booking-notes">Observações autorizadas</label><textarea id="manager-booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviço</dt><dd>@CurrentService.Name</dd></div><div><dt>Médico</dt><dd>@(Doctors.SingleOrDefault(x=>x.AccountId==DoctorId)?.FullName??"Selecione")</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor-base</dt><dd>@Money(CurrentService.BasePrice)</dd></div><div><dt>Pagamento</dt><dd>@(ModalityCode=="online"?"Online":"Na clínica")</dd></div></dl>}<p class="field-hint">Preço e desconto Premium são autoridade do servidor. A confirmação é idempotente.</p><button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||DoctorId==0||!Selected.HasValue)">Confirmar agendamento</button></section>}
@code { [Parameter]public long PatientId{get;set;}private ManagerPatient? Patient;private IReadOnlyList<ManagerService> Services=[];private IReadOnlyList<ManagerDoctor> Doctors=[];private IReadOnlyList<WebAvailableSlot> Slots=[];private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia")];private string Category="consultation",ModalityCode="in_person",Notes="";private uint ServiceId;private ulong DoctorId;private DateTime Date=DateTime.Today.AddDays(1);private TimeOnly? Selected;private bool SlotsLoaded;private ManagerService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId);
protected override async Task Load(){Patient=await Get<ManagerPatient>($"api/v1/manager/patients/{PatientId}");Services=await Get<IReadOnlyList<ManagerService>>("api/v1/manager/services")??[];Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/manager/doctors")??[];var first=Services.FirstOrDefault(x=>x.CategoryCode==Category);if(first is not null)ChooseService(first);}
private void ChooseCategory(string value){Category=value;var first=Services.FirstOrDefault(x=>x.CategoryCode==value);if(first is not null)ChooseService(first);else{ServiceId=0;Slots=[];}}
private void ChooseService(ManagerService service){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;}
private Task LoadSlots()=>Run(async()=>{if(CurrentService is null||DoctorId==0)throw new ManagerUiException("Escolha o serviço e o médico.");if(CurrentService.ModalityCode!="both"&&CurrentService.ModalityCode!=ModalityCode)throw new ManagerUiException("O serviço não oferece esta modalidade.");Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/manager/booking/slots?patientAccountId={PatientId}&doctorAccountId={DoctorId}&appointmentTypeId={ServiceId}&modality={ModalityCode}&from={Date:yyyy-MM-dd}&days=1")??[];Selected=null;SlotsLoaded=true;});
private Task Confirm()=>Run(async()=>{var result=await Request<WebAppointment>("api/v1/manager/appointments","POST",new{patientAccountId=PatientId,doctorAccountId=DoctorId,appointmentTypeId=ServiceId,modalityCode=ModalityCode,localDate=DateOnly.FromDateTime(Date),localStartsAt=Selected,patientNotes=Notes},Guid.NewGuid().ToString("N"));Navigation.NavigateTo($"/gestao/atendimentos/{result!.Id}");});}
