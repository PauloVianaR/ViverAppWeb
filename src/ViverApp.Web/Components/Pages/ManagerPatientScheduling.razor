@page "/gestao/agendar"
@page "/gestao/pacientes/{PatientId:long}/agendar"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pela clínica</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">Escolha o paciente e combine somente serviços, profissionais e horários realmente compatíveis.</p></div><a class="button button--secondary" href="/gestao/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else{
<section class="surface patient-panel manager-welcome"><div class="field"><label for="manager-booking-patient">Paciente</label><select id="manager-booking-patient" value="@SelectedPatientId" @onchange="PatientChanged"><option value="0">Selecione</option>@foreach(var patient in Patients){<option value="@patient.AccountId">@patient.FullName@(patient.IsPremium?" · Premium":"")</option>}</select></div>@if(Patient is not null){<p>@(Patient.IsPremium?$"Paciente Premium — {Patient.PremiumDiscountPercent:0.##}% de desconto aplicado automaticamente.":"Paciente sem benefício Premium ativo.")</p>}</section>
@if(Patient is not null){
<section class="surface patient-panel patient-section"><h2>1. Serviço e modalidade</h2><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(Category==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="field"><label for="manager-service-search">Pesquisar serviço</label><input id="manager-service-search" @bind="ServiceSearch" @bind:event="oninput" maxlength="100" placeholder="Digite parte do nome" /></div><div class="manager-choice-list">@foreach(var service in VisibleServices){<label><input type="radio" name="manager-service" checked="@(ServiceId==service.Id)" @onchange="()=>ChooseService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @if(!service.RequiresPayment){<strong>Sem cobrança</strong>}else if(Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<s>@Money(service.BasePrice)</s> <strong>@Money(Discounted(service.BasePrice))</strong>}else{@Money(service.BasePrice)}</small></span></label>}</div><div class="field"><label for="manager-booking-modality">Modalidade</label><select id="manager-booking-modality" @bind="ModalityCode" @bind:after="ModalityChanged"><option value="in_person">Presencial</option><option value="online">Online</option></select></div></section>
<section class="surface patient-panel patient-section"><h2>2. Profissional, data e horário</h2><div class="field"><label for="manager-booking-doctor">Profissional</label><select id="manager-booking-doctor" @bind="DoctorId" @bind:after="ProfessionalChanged"><option value="0">Selecione</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName · @doctor.LicenseTypeCode @doctor.LicenseStateCode @doctor.LicenseNumber</option>}</select></div>@if(DoctorId != 0){<BookingAvailabilityCalendar @key="CalendarKey" SlotsApiPrefix="@CalendarApi" DateSelected="SelectDate" />}else{<p class="field-hint">Escolha um profissional para ver somente os dias disponíveis.</p>}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-booking-slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="manager-boundary">O horário escolhido não está mais disponível. Escolha outro dia.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="manager-booking-notes">Observações autorizadas</label><textarea id="manager-booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviço</dt><dd>@CurrentService.Name</dd></div><div><dt>Profissional</dt><dd>@(Doctors.SingleOrDefault(x=>x.AccountId==DoctorId)?.FullName??"Selecione")</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor</dt><dd>@(CurrentService.RequiresPayment?Money(CurrentService.BasePrice):"Sem cobrança")</dd></div>@if(CurrentService.RequiresPayment&&Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<div><dt>Valor Premium</dt><dd><strong>@Money(Discounted(CurrentService.BasePrice))</strong> · @Patient.PremiumDiscountPercent.ToString("0.##")% de desconto</dd></div>}<div><dt>Pagamento</dt><dd>@(CurrentService.RequiresPayment?(ModalityCode=="online"?"Online":"Na clínica"):"Não necessário")</dd></div></dl>}<p class="field-hint">Preço e desconto Premium são recalculados pelo servidor na confirmação.</p><button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||DoctorId==0||!Selected.HasValue)">Confirmar agendamento</button></section>}}
@code {
    [Parameter] public long PatientId { get; set; }
    [SupplyParameterFromQuery(Name="patient")] public long? PatientQuery { get; set; }
    private ManagerPatient? Patient; private IReadOnlyList<ManagerPatient> Patients=[]; private IReadOnlyList<ManagerService> Services=[];
    private IReadOnlyList<WebBookingProfessional> Doctors=[]; private IReadOnlyList<WebAvailableSlot> Slots=[];
    private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia"),("procedure","Procedimento")];
    private string Category="consultation",ModalityCode="in_person",Notes="",ServiceSearch=""; private uint ServiceId; private ulong SelectedPatientId,DoctorId;
    private DateTime Date=DateTime.Today.AddDays(1); private TimeOnly? Selected; private bool SlotsLoaded;
    private string CalendarKey=>$"{SelectedPatientId}-{DoctorId}-{ServiceId}-{ModalityCode}";
    private string CalendarApi=>$"api/v1/manager/booking/slots?patientAccountId={SelectedPatientId}&doctorAccountId={DoctorId}&appointmentTypeId={ServiceId}&modality={ModalityCode}";
    private ManagerService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId);
    private IEnumerable<ManagerService> VisibleServices=>Services.Where(x=>x.CategoryCode==Category&&(string.IsNullOrWhiteSpace(ServiceSearch)||x.Name.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)||(x.Description?.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)??false)));
    protected override async Task Load(){await LoadPatients();Services=await Get<IReadOnlyList<ManagerService>>("api/v1/manager/services")??[];SelectedPatientId=(ulong)Math.Max(PatientId,PatientQuery??0);if(SelectedPatientId!=0)await LoadPatient();var first=Services.FirstOrDefault(x=>x.CategoryCode==Category);if(first is not null)await ChooseServiceCore(first);}
    private async Task LoadPatients(){var items=new List<ManagerPatient>();var pageNumber=1;while(true){var response=await Get<ManagerPatientsData>($"api/v1/manager/patients?page={pageNumber}&pageSize=100");if(response is null)break;items.AddRange(response.Page.Items);if(items.Count>=response.Page.TotalCount||response.Page.Items.Count==0)break;pageNumber++;}Patients=items;}
    private Task PatientChanged(ChangeEventArgs args)=>Run(async()=>{SelectedPatientId=ulong.TryParse(args.Value?.ToString(),out var id)?id:0;await LoadPatient();});
    private async Task LoadPatient(){Patient=SelectedPatientId==0?null:await Get<ManagerPatient>($"api/v1/manager/patients/{SelectedPatientId}");Slots=[];Selected=null;SlotsLoaded=false;}
    private Task ChooseCategory(string value)=>Run(async()=>{Category=value;ServiceSearch="";var first=Services.FirstOrDefault(x=>x.CategoryCode==value);if(first is not null)await ChooseServiceCore(first);else{ServiceId=0;Doctors=[];Slots=[];}});
    private Task ChooseService(ManagerService service)=>Run(()=>ChooseServiceCore(service));
    private async Task ChooseServiceCore(ManagerService service){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;await LoadEligibleDoctorsCore();}
    private Task ModalityChanged()=>Run(LoadEligibleDoctorsCore);
    private async Task LoadEligibleDoctorsCore(){DoctorId=0;Slots=[];if(ServiceId==0){Doctors=[];return;}var items=new List<WebBookingProfessional>();var pageNumber=1;while(true){var response=await Get<WebPage<WebBookingProfessional>>($"api/v1/manager/booking/professionals?appointmentTypeId={ServiceId}&modality={ModalityCode}&page={pageNumber}&pageSize=50");if(response is null)break;items.AddRange(response.Items);if(items.Count>=response.TotalCount||response.Items.Count==0)break;pageNumber++;}Doctors=items;}
    private void ProfessionalChanged(){Slots=[];Selected=null;SlotsLoaded=false;}
    private void SelectDate(BookingDaySelection selection){Selected=null;Slots=selection.Slots;SlotsLoaded=selection.Date!=default;if(SlotsLoaded)Date=selection.Date.ToDateTime(TimeOnly.MinValue);}
    private Task Confirm()=>Run(async()=>{var request=new ManagerAppointmentCreate(SelectedPatientId,DoctorId,ServiceId,ModalityCode,DateOnly.FromDateTime(Date),Selected!.Value,Notes);var result=await Request<WebAppointment>("api/v1/manager/appointments","POST",request,Guid.NewGuid().ToString("N"));Navigation.NavigateTo($"/gestao/atendimentos/{result!.Id}");});
    private decimal Discounted(decimal value)=>decimal.Round(value*(1-Patient!.PremiumDiscountPercent/100m),2,MidpointRounding.AwayFromZero);
}
