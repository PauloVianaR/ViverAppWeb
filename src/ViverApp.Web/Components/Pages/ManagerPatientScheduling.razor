@page "/gestao/agendar"
@page "/gestao/pacientes/{PatientId:long}/agendar"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Novo agendamento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Agendamento pela clínica</p><h1 class="page-title">Novo atendimento</h1><p class="page-description">Escolha o paciente e combine somente serviços, médicos e horários realmente compatíveis.</p></div><a class="button button--secondary" href="/gestao/agenda">Voltar à agenda</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="7" />}else{
<section class="surface patient-panel manager-welcome"><div class="field"><label for="manager-booking-patient">Paciente</label><select id="manager-booking-patient" value="@SelectedPatientId" @onchange="PatientChanged"><option value="0">Selecione</option>@foreach(var patient in Patients){<option value="@patient.AccountId">@patient.FullName@(patient.IsPremium?" · Premium":"")</option>}</select></div>@if(Patient is not null){<p>@(Patient.IsPremium?$"Paciente Premium — {Patient.PremiumDiscountPercent:0.##}% de desconto aplicado automaticamente.":"Paciente sem benefício Premium ativo.")</p>}</section>
@if(Patient is not null){
<section class="surface patient-panel patient-section"><h2>1. Serviço e modalidade</h2><div class="patient-tabs">@foreach(var category in Categories){<button class="button @(Category==category.Code?null:"button--secondary")" @onclick="()=>ChooseCategory(category.Code)">@category.Label</button>}</div><div class="field"><label for="manager-service-search">Pesquisar serviço</label><input id="manager-service-search" @bind="ServiceSearch" @bind:event="oninput" maxlength="100" placeholder="Digite parte do nome" /></div><div class="manager-choice-list">@foreach(var service in VisibleServices){<label><input type="radio" name="manager-service" checked="@(ServiceId==service.Id)" @onchange="()=>ChooseService(service)" /><span><strong>@service.Name</strong><br /><small>@Modality(service.ModalityCode) · @service.DurationMinutes min · @if(Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<s>@Money(service.BasePrice)</s> <strong>@Money(Discounted(service.BasePrice))</strong>}else{@Money(service.BasePrice)}</small></span></label>}</div><div class="field"><label for="manager-booking-modality">Modalidade</label><select id="manager-booking-modality" @bind="ModalityCode" @bind:after="ModalityChanged"><option value="in_person">Presencial</option><option value="online">Online</option></select></div></section>
<section class="surface patient-panel patient-section"><h2>2. Médico, data e horário</h2><div class="manager-profile-grid"><div class="field"><label for="manager-booking-doctor">Médico</label><select id="manager-booking-doctor" @bind="DoctorId"><option value="0">Selecione</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName · CRM @doctor.LicenseStateCode @doctor.LicenseNumber</option>}</select></div><div class="field"><label for="manager-booking-date">Data</label><input id="manager-booking-date" type="date" @bind="Date" min="@DateTime.Today.ToString("yyyy-MM-dd")" /></div></div><button class="button button--secondary" @onclick="LoadSlots">Ver horários disponíveis</button><div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="manager-booking-slot" checked="@(Selected==slot.StartsAt)" @onchange="()=>Selected=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</label>}</div>@if(SlotsLoaded&&Slots.Count==0){<p class="manager-boundary">Nenhum horário disponível para esta combinação. Escolha outro médico, serviço, modalidade ou data.</p>}</section>
<section class="surface patient-panel patient-section"><h2>3. Revisar e confirmar</h2><div class="field"><label for="manager-booking-notes">Observações autorizadas</label><textarea id="manager-booking-notes" @bind="Notes" maxlength="1000" rows="4"></textarea></div>@if(CurrentService is not null){<dl class="patient-facts"><div><dt>Paciente</dt><dd>@Patient.FullName</dd></div><div><dt>Serviço</dt><dd>@CurrentService.Name</dd></div><div><dt>Médico</dt><dd>@(Doctors.SingleOrDefault(x=>x.AccountId==DoctorId)?.FullName??"Selecione")</dd></div><div><dt>Modalidade</dt><dd>@Modality(ModalityCode)</dd></div><div><dt>Valor-base</dt><dd>@Money(CurrentService.BasePrice)</dd></div>@if(Patient.IsPremium&&Patient.PremiumDiscountPercent>0){<div><dt>Valor Premium</dt><dd><strong>@Money(Discounted(CurrentService.BasePrice))</strong> · @Patient.PremiumDiscountPercent.ToString("0.##")% de desconto</dd></div>}<div><dt>Pagamento</dt><dd>@(ModalityCode=="online"?"Online":"Na clínica")</dd></div></dl>}<p class="field-hint">Preço e desconto Premium são recalculados pelo servidor na confirmação.</p><button class="button" @onclick="Confirm" disabled="@(Busy||CurrentService is null||DoctorId==0||!Selected.HasValue)">Confirmar agendamento</button></section>}}
@code {
    [Parameter] public long PatientId { get; set; }
    [SupplyParameterFromQuery(Name="patient")] public long? PatientQuery { get; set; }
    private ManagerPatient? Patient; private IReadOnlyList<ManagerPatient> Patients=[]; private IReadOnlyList<ManagerService> Services=[];
    private IReadOnlyList<WebBookingProfessional> Doctors=[]; private IReadOnlyList<WebAvailableSlot> Slots=[];
    private static readonly (string Code,string Label)[] Categories=[("consultation","Consulta"),("examination","Exame"),("surgery","Cirurgia"),("procedure","Procedimento")];
    private string Category="consultation",ModalityCode="in_person",Notes="",ServiceSearch=""; private uint ServiceId; private ulong SelectedPatientId,DoctorId;
    private DateTime Date=DateTime.Today.AddDays(1); private TimeOnly? Selected; private bool SlotsLoaded;
    private ManagerService? CurrentService=>Services.SingleOrDefault(x=>x.Id==ServiceId);
    private IEnumerable<ManagerService> VisibleServices=>Services.Where(x=>x.CategoryCode==Category&&(string.IsNullOrWhiteSpace(ServiceSearch)||x.Name.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)||(x.Description?.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase)??false)));
    protected override async Task Load(){await LoadPatients();Services=await Get<IReadOnlyList<ManagerService>>("api/v1/manager/services")??[];SelectedPatientId=(ulong)Math.Max(PatientId,PatientQuery??0);if(SelectedPatientId!=0)await LoadPatient();var first=Services.FirstOrDefault(x=>x.CategoryCode==Category);if(first is not null)await ChooseServiceCore(first);}
    private async Task LoadPatients(){var items=new List<ManagerPatient>();var pageNumber=1;while(true){var response=await Get<ManagerPatientsData>($"api/v1/manager/patients?page={pageNumber}&pageSize=100");if(response is null)break;items.AddRange(response.Page.Items);if(items.Count>=response.Page.TotalCount||response.Page.Items.Count==0)break;pageNumber++;}Patients=items;}
    private Task PatientChanged(ChangeEventArgs args)=>Run(async()=>{SelectedPatientId=ulong.TryParse(args.Value?.ToString(),out var id)?id:0;await LoadPatient();});
    private async Task LoadPatient(){Patient=SelectedPatientId==0?null:await Get<ManagerPatient>($"api/v1/manager/patients/{SelectedPatientId}");Slots=[];Selected=null;SlotsLoaded=false;}
    private Task ChooseCategory(string value)=>Run(async()=>{Category=value;ServiceSearch="";var first=Services.FirstOrDefault(x=>x.CategoryCode==value);if(first is not null)await ChooseServiceCore(first);else{ServiceId=0;Doctors=[];Slots=[];}});
    private Task ChooseService(ManagerService service)=>Run(()=>ChooseServiceCore(service));
    private async Task ChooseServiceCore(ManagerService service){ServiceId=service.Id;ModalityCode=service.ModalityCode=="online"?"online":"in_person";Slots=[];Selected=null;SlotsLoaded=false;await LoadEligibleDoctorsCore();}
    private Task ModalityChanged()=>Run(LoadEligibleDoctorsCore);
    private async Task LoadEligibleDoctorsCore(){DoctorId=0;Slots=[];if(ServiceId==0){Doctors=[];return;}var items=new List<WebBookingProfessional>();var pageNumber=1;while(true){var response=await Get<WebPage<WebBookingProfessional>>($"api/v1/manager/booking/professionals?appointmentTypeId={ServiceId}&modality={ModalityCode}&page={pageNumber}&pageSize=50");if(response is null)break;items.AddRange(response.Items);if(items.Count>=response.TotalCount||response.Items.Count==0)break;pageNumber++;}Doctors=items;if(Doctors.Count==1)DoctorId=Doctors[0].AccountId;}
    private Task LoadSlots()=>Run(async()=>{if(Patient is null||CurrentService is null||DoctorId==0)throw new ManagerUiException("Escolha o paciente, o serviço e o médico.");Slots=await Get<IReadOnlyList<WebAvailableSlot>>($"api/v1/manager/booking/slots?patientAccountId={SelectedPatientId}&doctorAccountId={DoctorId}&appointmentTypeId={ServiceId}&modality={ModalityCode}&from={Date:yyyy-MM-dd}&days=1")??[];Selected=null;SlotsLoaded=true;});
    private Task Confirm()=>Run(async()=>{var result=await Request<WebAppointment>("api/v1/manager/appointments","POST",new{patientAccountId=SelectedPatientId,doctorAccountId=DoctorId,appointmentTypeId=ServiceId,modalityCode=ModalityCode,localDate=DateOnly.FromDateTime(Date),localStartsAt=Selected,patientNotes=Notes},Guid.NewGuid().ToString("N"));Navigation.NavigateTo($"/gestao/atendimentos/{result!.Id}");});
    private decimal Discounted(decimal value)=>decimal.Round(value*(1-Patient!.PremiumDiscountPercent/100m),2,MidpointRounding.AwayFromZero);
}
