@page "/administracao/atendimentos"
@inherits AdministratorPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimentos | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Atendimentos</h1><p class="page-description">Operação e metadados financeiros, sem acesso ao conteúdo clínico reservado.</p></div></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<AppointmentStatusLegend />
<MobileFilterPanel AriaLabel="Filtros da agenda administrativa"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="admin-agenda-search">Paciente, profissional ou serviço</label><input id="admin-agenda-search" @bind="Search" maxlength="120"/></div><div class="field"><label for="admin-number">Número do atendimento</label><input id="admin-number" type="number" min="100" @bind="AppointmentNumber" @bind:event="oninput"/></div><div class="field"><label for="admin-from">De</label><input id="admin-from" type="date" @bind="From"/></div><div class="field"><label for="admin-to">Até</label><input id="admin-to" type="date" @bind="To"/></div><div class="field"><label for="admin-status">Estado</label><select id="admin-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var value in Statuses){<option value="@value">@Status(value)</option>}</select></div><div class="field"><label for="admin-doctor">Profissional</label><select id="admin-doctor" @bind="Doctor"><option value="">Todos</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName</option>}</select></div><div class="field"><label for="admin-category">Tipo</label><select id="admin-category" @bind="Category"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div><div class="field"><label for="admin-modality">Modalidade</label><select id="admin-modality" @bind="Modality"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div><div class="field"><label for="admin-payment">Pagamento</label><select id="admin-payment" @bind="Payment"><option value="">Todos</option><option value="paid">Pago</option><option value="pending">Pendente</option></select></div><div class="field"><label for="admin-sort">Ordenar</label><select id="admin-sort" @bind="Sort"><option value="date_asc">Data crescente</option><option value="date_desc">Data decrescente</option><option value="patient">Paciente</option><option value="doctor">Profissional</option></select></div></div><div class="administrator-actions"><button class="button" disabled="@Busy">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Data is not null){<div class="mobile-metric-flow"><section class="administrator-kpis"><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("total")'><strong>@Data.Counters.Total</strong><span>Total</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("online")'><strong>@Data.Counters.Online</strong><span>Online</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("in_person")'><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("rescheduled")'><strong>@Data.Counters.Rescheduled</strong><span>Reagendadas</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("paid")'><strong>@Data.Counters.Paid</strong><span>Pagas</span></button><button type="button" class="surface administrator-kpi metric-card" @onclick='()=>ShowMetric("pending")'><strong>@Data.Counters.PendingPayment</strong><span>Pendentes</span></button></section><AppointmentMetricDrilldown Title="@MetricTitle" Numbers="@MetricNumbers" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>}
@if(Loading){<LoadingSkeleton Lines="7"/>}else if(Data?.Page.Items.Count>0){<div class="appointment-results-heading"><p class="muted" role="status">@Data.Page.TotalCount atendimento(s) encontrado(s).</p><AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /></div><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in Data.Page.Items){<ManagerVisitCard Model="item" BasePath="/administracao/atendimentos" RegisterArrival="RegisterArrival"/>}</div>}else{<InterfaceState Title="Nenhuma consulta encontrada" Description="Ajuste os filtros ou o período." Icon="calendar"/>}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Busy||Page==1)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
@code{private ManagerAgendaData? Data;private IReadOnlyList<ManagerDoctor> Doctors=[];private DateTime From=DateTime.Today,To=DateTime.Today;private string Search="",StatusFilter="",Doctor="",Category="",Modality="",Payment="",Sort="date_desc";private ulong? AppointmentNumber;private int Page=1;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "total" or "online"?2:SelectedMetric is "in_person" or "rescheduled"?4:6;private static readonly string[] Statuses=["pending","confirmed","arrived","in_progress","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){await LoadAppointmentViewAsync();if(Doctors.Count==0)Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/administrator/doctors")??[];Data=await Get<ManagerAgendaData>($"api/v1/administrator/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&doctorAccountId={Doctor}&appointmentNumber={AppointmentNumber}&category={Category}&modality={Modality}&payment={Payment}&search={Escape(Search)}&sort={Sort}&page={Page}&pageSize=12");}
private Task Apply()=>Run(async()=>{Page=1;SelectedMetric=null;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=Doctor=Category=Modality=Payment="";AppointmentNumber=null;From=To=DateTime.Today;Sort="date_desc";Page=1;SelectedMetric=null;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});private void ShowMetric(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"total"=>"Total filtrado","online"=>"Atendimentos online","in_person"=>"Atendimentos presenciais","rescheduled"=>"Atendimentos reagendados","paid"=>"Atendimentos pagos","pending"=>"Pagamentos pendentes",_=>"Detalhamento"};private IReadOnlyList<ulong>? MetricNumbers=>SelectedMetric switch{"total"=>Data?.Sources.Total,"online"=>Data?.Sources.Online,"in_person"=>Data?.Sources.InPerson,"rescheduled"=>Data?.Sources.Rescheduled,"paid"=>Data?.Sources.Paid,"pending"=>Data?.Sources.PendingPayment,_=>null};
private Task RegisterArrival(ManagerAppointment item)=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{item.Id}/arrival","POST",new{rowVersion=item.RowVersion});Notice=$"Chegada registrada para o atendimento {item.AppointmentNumber}.";await Load();});}
