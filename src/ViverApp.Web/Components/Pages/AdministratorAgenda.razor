@page "/administracao/consultas"
@page "/administracao/consultas/historico"
@inherits AdministratorPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Consultas administrativas | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">@(History?"Histórico de consultas":"Consultas planejadas")</h1><p class="page-description">Operação e metadados financeiros, sem acesso ao conteúdo clínico reservado.</p></div><div class="administrator-actions"><a class="button button--secondary" href="/administracao/consultas">Planejadas</a><a class="button button--secondary" href="/administracao/consultas/historico">Histórico</a></div></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="admin-agenda-search">Paciente, médico ou serviço</label><input id="admin-agenda-search" @bind="Search" maxlength="120"/></div><div class="field"><label for="admin-from">De</label><input id="admin-from" type="date" @bind="From"/></div><div class="field"><label for="admin-to">Até</label><input id="admin-to" type="date" @bind="To"/></div><div class="field"><label for="admin-status">Estado</label><select id="admin-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var value in Statuses){<option value="@value">@Status(value)</option>}</select></div><div class="field"><label for="admin-doctor">Médico</label><select id="admin-doctor" @bind="Doctor"><option value="">Todos</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName</option>}</select></div><div class="field"><label for="admin-category">Tipo</label><select id="admin-category" @bind="Category"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option></select></div><div class="field"><label for="admin-modality">Modalidade</label><select id="admin-modality" @bind="Modality"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div><div class="field"><label for="admin-payment">Pagamento</label><select id="admin-payment" @bind="Payment"><option value="">Todos</option><option value="paid">Pago</option><option value="pending">Pendente</option></select></div><div class="field"><label for="admin-sort">Ordenar</label><select id="admin-sort" @bind="Sort"><option value="date_asc">Data crescente</option><option value="date_desc">Data decrescente</option><option value="patient">Paciente</option><option value="doctor">Médico</option></select></div></div><div class="administrator-actions"><button class="button" disabled="@Busy">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Data is not null){<section class="administrator-kpis"><article class="surface administrator-kpi"><strong>@Data.Counters.Total</strong><span>Total</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.Online</strong><span>Online</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.Rescheduled</strong><span>Reagendadas</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.Paid</strong><span>Pagas</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.PendingPayment</strong><span>Pendentes</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="7"/>}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var item in Data.Page.Items){<ManagerVisitCard Model="item" BasePath="/administracao/atendimentos" RegisterArrival="RegisterArrival"/>}</div>}else{<InterfaceState Title="Nenhuma consulta encontrada" Description="Ajuste os filtros ou o período." Icon="calendar"/>}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Busy||Page==1)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
@code{private ManagerAgendaData? Data;private IReadOnlyList<ManagerDoctor> Doctors=[];private bool History=>new Uri(Navigation.Uri).AbsolutePath.EndsWith("historico",StringComparison.OrdinalIgnoreCase);private DateTime From=DateTime.Today,To=DateTime.Today.AddDays(30);private string Search="",StatusFilter="",Doctor="",Category="",Modality="",Payment="",Sort="date_asc";private int Page=1;private bool Initialized;private static readonly string[] Statuses=["pending","confirmed","arrived","in_progress","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){if(!Initialized){if(History){From=DateTime.Today.AddYears(-1);To=DateTime.Today;Sort="date_desc";}Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/administrator/doctors")??[];Initialized=true;}Data=await Get<ManagerAgendaData>($"api/v1/administrator/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&doctorAccountId={Doctor}&category={Category}&modality={Modality}&payment={Payment}&search={Escape(Search)}&sort={Sort}&page={Page}&pageSize=12");}
private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=Doctor=Category=Modality=Payment="";From=History?DateTime.Today.AddYears(-1):DateTime.Today;To=History?DateTime.Today:DateTime.Today.AddDays(30);Sort=History?"date_desc":"date_asc";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private Task RegisterArrival(ManagerAppointment item)=>Run(async()=>{await Request<object>($"api/v1/administrator/appointments/{item.Id}/arrival","POST",new{rowVersion=item.RowVersion});Notice=$"Chegada registrada para o atendimento {item.AppointmentNumber}.";await Load();});}
