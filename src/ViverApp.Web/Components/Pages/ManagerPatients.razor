@page "/gestao/pacientes"
@inherits ManagerPageBase
<PageTitle>Pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Pacientes da clínica</h1><p class="page-description">Cadastre, encontre e opere dados administrativos sem acessar conteúdo clínico reservado.</p></div><div class="patient-actions"><button class="button" @onclick='()=>Open("manager-new-patient")'>Adicionar paciente</button><a class="button button--secondary" href="/gestao/premium">Análises Premium</a></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-patient-search">Nome, CPF, e-mail ou telefone</label><input id="manager-patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="manager-patient-status">Estado</label><select id="manager-patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="pending_confirmation">Aguardando confirmação</option><option value="blocked">Bloqueados</option></select></div><div class="field"><label for="manager-patient-premium">Plano</label><select id="manager-patient-premium" @bind="Premium"><option value="">Todos</option><option value="true">Premium</option><option value="false">Sem Premium</option></select></div></div><div class="patient-actions"><button class="button">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Data is not null){<section class="manager-kpis"><article class="surface manager-kpi"><strong>@Data.Counters.Total</strong><span>Total</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Premium</strong><span>Premium</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Active</strong><span>Ativos</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Blocked</strong><span>Bloqueados</span></article><article class="surface manager-kpi"><strong>@Data.Counters.PremiumPending</strong><span>Premium pendente</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel patient-directory-card"><div class="patient-visit__top"><div><h2>@patient.FullName</h2><p>@(patient.PreferredName is null?"Nome preferido não informado":$"Prefere {patient.PreferredName}")</p></div>@if(patient.IsPremium){<span class="badge badge--brand">Premium</span>}else if(patient.PremiumStatus=="pending"){<span class="badge">Premium em análise</span>}</div><dl class="patient-facts"><div><dt>CPF</dt><dd>@Cpf(patient.TaxId)</dd></div><div><dt>E-mail</dt><dd>@(patient.Email??"Não informado") @if(patient.Email is not null&&!patient.EmailVerified){<small>· aguardando confirmação</small>}</dd></div><div><dt>Telefone</dt><dd>@Phone(patient.Phone) @if(patient.Phone is not null&&!patient.PhoneVerified){<small>· aguardando confirmação</small>}</dd></div><div><dt>Endereço</dt><dd>@Address(patient.Address)</dd></div><div><dt>Nascimento</dt><dd>@(patient.BirthDate.HasValue?$"{patient.BirthDate:dd/MM/yyyy}":"Não informado")</dd></div><div><dt>Atendimentos</dt><dd>@patient.AppointmentCount</dd></div></dl><p>Último: @(patient.LastAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy")??"—") · Próximo: @(patient.NextAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</p><div class="patient-actions"><a class="button button--small" href="/gestao/pacientes/@patient.AccountId/agendar">Agendar</a><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar dados</button>@if(patient.Phone is not null){<a class="button button--secondary button--small" href="tel:@patient.Phone">Ligar</a>}@if(patient.PremiumRequestId.HasValue){<a class="button button--secondary button--small" href="/gestao/premium?solicitacao=@patient.PremiumRequestId">Analisar Premium</a>}</div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Altere os filtros ou adicione um paciente com onboarding seguro." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="manager-new-patient" class="patient-dialog"><h2>Adicionar paciente</h2><p>A pessoa receberá um código no contato informado e definirá seu próprio acesso. O Gestor nunca escolhe uma senha conhecida.</p><form @onsubmit="Create" @onsubmit:preventDefault><div class="field"><label for="manager-new-name">Nome completo</label><input id="manager-new-name" @bind="NewName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-new-email">E-mail</label><input id="manager-new-email" type="email" @bind="NewEmail" maxlength="254" /></div><div class="field"><label for="manager-new-phone">Telefone</label><input id="manager-new-phone" type="tel" @bind="NewPhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="manager-new-birth">Nascimento</label><input id="manager-new-birth" type="date" @bind="NewBirth" /></div><div class="patient-actions"><button class="button">Enviar onboarding</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-new-patient")'>Voltar</button></div></form></dialog>
<dialog id="manager-edit-patient" class="patient-dialog patient-dialog--wide"><h2>Dados operacionais</h2><p>Ao alterar e-mail ou telefone, o novo contato precisará ser confirmado pelo paciente.</p><form @onsubmit="Save" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-edit-name">Nome completo</label><input id="manager-edit-name" @bind="EditName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-edit-preferred">Nome preferido</label><input id="manager-edit-preferred" @bind="EditPreferred" maxlength="120" /></div><div class="field"><label for="manager-edit-cpf">CPF</label><input id="manager-edit-cpf" value="@EditTaxIdMasked" @oninput="e=>EditTaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" /></div><div class="field"><label for="manager-edit-email">E-mail</label><input id="manager-edit-email" type="email" @bind="EditEmail" maxlength="254" /></div><div class="field"><label for="manager-edit-phone">Telefone</label><input id="manager-edit-phone" type="tel" @bind="EditPhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="manager-edit-birth">Nascimento</label><input id="manager-edit-birth" type="date" @bind="EditBirth" /></div><div class="field"><label for="manager-edit-postal">CEP</label><input id="manager-edit-postal" value="@PostalMasked" @oninput="PostalInput" inputmode="numeric" maxlength="9" placeholder="00000-000" /></div><div class="field"><label for="manager-edit-street">Logradouro</label><input id="manager-edit-street" @bind="EditStreet" maxlength="200" /></div><div class="field"><label for="manager-edit-number">Número</label><input id="manager-edit-number" @bind="EditNumber" maxlength="20" /></div><div class="field"><label for="manager-edit-complement">Complemento</label><input id="manager-edit-complement" @bind="EditComplement" maxlength="100" /></div><div class="field"><label for="manager-edit-district">Bairro</label><input id="manager-edit-district" @bind="EditDistrict" maxlength="100" /></div><div class="field"><label for="manager-edit-city">Cidade</label><input id="manager-edit-city" @bind="EditCity" maxlength="100" /></div><div class="field"><label for="manager-edit-state">UF</label><input id="manager-edit-state" @bind="EditState" maxlength="2" /></div></div><div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-edit-patient")'>Voltar</button></div></form></dialog>
@code { private ManagerPatientsData? Data;private string Search="",Status="",Premium="",NewName="",NewEmail="",NewPhone="",EditName="",EditPreferred="",EditTaxId="",EditEmail="",EditPhone="",EditPostal="",EditStreet="",EditNumber="",EditComplement="",EditDistrict="",EditCity="",EditState="";private DateTime? NewBirth,EditBirth;private int Page=1;private ManagerPatient? Selected;private string EditTaxIdMasked=>Cpf(EditTaxId)=="Não informado"?EditTaxId:Cpf(EditTaxId);private string PostalMasked=>EditPostal.Length==8?$"{EditPostal[..5]}-{EditPostal[5..]}":EditPostal;
protected override async Task Load()=>Data=await Get<ManagerPatientsData>($"api/v1/manager/patients?search={Escape(Search)}&status={Status}&premium={Premium}&page={Page}&pageSize=12");private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=Status=Premium="";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private Task Create()=>Run(async()=>{await Request<ManagerPatient>("api/v1/manager/patients","POST",new{fullName=NewName,email=string.IsNullOrWhiteSpace(NewEmail)?null:NewEmail,phoneE164=string.IsNullOrWhiteSpace(NewPhone)?null:NewPhone,birthDate=NewBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(NewBirth.Value):null});await Close("manager-new-patient");NewName=NewEmail=NewPhone="";NewBirth=null;await Load();Notice="Paciente criado. O acesso depende da confirmação do contato.";});
private async Task Edit(ManagerPatient patient){Selected=patient;EditName=patient.FullName;EditPreferred=patient.PreferredName??"";EditTaxId=patient.TaxId??"";EditEmail=patient.Email??"";EditPhone=patient.Phone??"";EditBirth=patient.BirthDate?.ToDateTime(TimeOnly.MinValue);EditPostal=patient.Address?.PostalCode??"";EditStreet=patient.Address?.Street??"";EditNumber=patient.Address?.Number??"";EditComplement=patient.Address?.Complement??"";EditDistrict=patient.Address?.District??"";EditCity=patient.Address?.City??"";EditState=patient.Address?.StateCode??"";await Open("manager-edit-patient");}
private Task PostalInput(ChangeEventArgs e)=>Run(async()=>{EditPostal=Digits(e.Value?.ToString());if(EditPostal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{EditPostal}");if(address is null)return;EditStreet=address.Street;EditComplement=address.Complement??EditComplement;EditDistrict=address.District;EditCity=address.City;EditState=address.StateCode;});
private Task Save()=>Run(async()=>{var hasAddress=EditPostal.Length==8||!string.IsNullOrWhiteSpace(EditStreet);object? address=hasAddress?new{postalCode=EditPostal,street=EditStreet,number=EditNumber,complement=Empty(EditComplement),district=EditDistrict,city=EditCity,stateCode=EditState.ToUpperInvariant()}:null;await Request<ManagerPatient>($"api/v1/manager/patients/{Selected!.AccountId}","PUT",new{fullName=EditName,preferredName=Empty(EditPreferred),taxId=Empty(EditTaxId),email=Empty(EditEmail),phoneE164=Empty(EditPhone),birthDate=EditBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(EditBirth.Value):null,address,rowVersion=Selected.RowVersion});await Close("manager-edit-patient");await Load();Notice="Dados operacionais atualizados; contatos alterados aguardam confirmação.";});
private static string Digits(string? value)=>new((value??"").Where(char.IsAsciiDigit).ToArray());private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
private static string Cpf(string? value)=>Digits(value) is var d&&d.Length==11?$"{d[..3]}.{d[3..6]}.{d[6..9]}-{d[9..]}":"Não informado";
private static string Phone(string? value){var d=Digits(value);return d.Length switch{13=>$"+{d[..2]} ({d[2..4]}) {d[4..9]}-{d[9..]}",12=>$"+{d[..2]} ({d[2..4]}) {d[4..8]}-{d[8..]}",_=>"Não informado"};}
private static string Address(ManagerPatientAddress? value)=>value is null?"Não informado":$"{value.Street}, {value.Number}{(string.IsNullOrWhiteSpace(value.Complement)?"":$" · {value.Complement}")} · {value.District} · {value.City}/{value.StateCode} · {value.PostalCode[..5]}-{value.PostalCode[5..]}";}
