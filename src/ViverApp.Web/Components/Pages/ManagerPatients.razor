@page "/gestao/pacientes"
@inherits ManagerPageBase
<PageTitle>Pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Pacientes da clínica</h1><p class="page-description">Cadastre, encontre e opere dados administrativos sem acessar conteúdo clínico reservado.</p></div><div class="patient-actions"><button class="button" @onclick='()=>Open("manager-new-patient")'>Adicionar paciente</button><a class="button button--secondary" href="/gestao/premium">Análises Premium</a></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<MobileFilterPanel AriaLabel="Filtros de pacientes da gestão"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-patient-search">Nome, CPF, e-mail ou telefone</label><input id="manager-patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="manager-patient-status">Estado</label><select id="manager-patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="pending_confirmation">Aguardando confirmação</option><option value="blocked">Bloqueados</option></select></div><div class="field"><label for="manager-patient-premium">Plano</label><select id="manager-patient-premium" @bind="Premium"><option value="">Todos</option><option value="true">Premium</option><option value="false">Sem Premium</option></select></div></div><div class="patient-actions"><button class="button">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Data is not null){<div class="mobile-metric-flow"><section class="manager-kpis"><button type="button" class="surface manager-kpi metric-card" @onclick='()=>SelectMetric("total")'><strong>@Data.Counters.Total</strong><span>Total</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>SelectMetric("premium")'><strong>@Data.Counters.Premium</strong><span>Premium</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>SelectMetric("active")'><strong>@Data.Counters.Active</strong><span>Ativos</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>SelectMetric("blocked")'><strong>@Data.Counters.Blocked</strong><span>Bloqueados</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>SelectMetric("pending")'><strong>@Data.Counters.PremiumPending</strong><span>Premium pendente</span></button></section><MetricEvidenceDrilldown Title="@MetricTitle" Items="@MetricItems" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel patient-directory-card"><div class="patient-visit__top"><div><h2>@patient.FullName</h2>@if(Age(patient.BirthDate) is int age){<p class="muted">@age anos</p>}<p>@(patient.PreferredName is null?"Nome preferido não informado":$"Prefere {patient.PreferredName}")</p></div><div>@if(!patient.PortalAccessEnabled){<span class="badge">Sem acesso ao portal</span>}@if(patient.IsPremium){<span class="premium-star" title="Premium · @patient.PremiumDiscountPercent% de desconto" aria-label="Paciente Premium">★</span>}else if(patient.PremiumStatus=="pending"){<span class="badge">Premium em análise</span>}</div></div><dl class="patient-facts"><div><dt>CPF</dt><dd>@Cpf(patient.TaxId)</dd></div><div><dt>E-mail</dt><dd>@(patient.Email??"Não informado") @if(patient.PortalAccessEnabled&&patient.Email is not null&&!patient.EmailVerified){<small>· aguardando confirmação</small>}</dd></div><div><dt>Telefone</dt><dd>@Phone(patient.Phone) @if(patient.PortalAccessEnabled&&patient.Phone is not null&&!patient.PhoneVerified){<small>· aguardando confirmação</small>}</dd></div><div><dt>Endereço</dt><dd>@Address(patient.Address)</dd></div><div><dt>Nascimento</dt><dd>@(patient.BirthDate.HasValue?$"{patient.BirthDate:dd/MM/yyyy}":"Não informado")</dd></div><div><dt>Atendimentos</dt><dd>@patient.AppointmentCount</dd></div></dl><p>Último: @(patient.LastAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy")??"—") · Próximo: @(patient.NextAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</p><div class="patient-actions"><a class="button button--small" href="/gestao/prontuario/@patient.AccountId">Abrir prontuário</a><a class="button button--secondary button--small" href="/gestao/pacientes/@patient.AccountId/agendar">Agendar</a><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar dados</button>@if(patient.Phone is not null){<a class="button button--secondary button--small" href="tel:@patient.Phone">Ligar</a>}@if(patient.PremiumRequestId.HasValue){<a class="button button--secondary button--small" href="/gestao/premium?solicitacao=@patient.PremiumRequestId">Analisar Premium</a>}@if(patient.IsPremium&&patient.PremiumMembershipId.HasValue){<button class="button button--secondary button--small" @onclick="()=>DownloadProof(patient)">Abrir comprovante</button>}@if(Capabilities?.PremiumManagementEnabled==true){<button class="button @(patient.IsPremium?"button--danger":"button--secondary") button--small" @onclick="()=>OpenPremium(patient)">@(patient.IsPremium?"Desfazer Premium":"Tornar Premium")</button>}</div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Altere os filtros ou adicione um paciente." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="manager-new-patient" class="patient-dialog patient-dialog--wide"><h2>Adicionar paciente</h2><p>Cadastre primeiro o paciente da clínica. O acesso ao portal e o envio do onboarding são opcionais.</p><form @onsubmit="Create" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-new-name">Nome completo</label><input id="manager-new-name" @bind="NewName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-new-preferred">Nome preferido</label><input id="manager-new-preferred" @bind="NewPreferred" maxlength="120" /></div><div class="field"><label for="manager-new-cpf">CPF</label><input id="manager-new-cpf" value="@NewTaxIdMasked" @oninput="e=>NewTaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required /></div><div class="field"><label for="manager-new-birth">Data de nascimento</label><input id="manager-new-birth" type="date" @bind="NewBirth" required /></div><div class="field"><label for="manager-new-email">E-mail (opcional)</label><input id="manager-new-email" type="email" @bind="NewEmail" maxlength="254" /></div><div class="field"><label for="manager-new-phone">Telefone (opcional)</label><input id="manager-new-phone" type="tel" @bind="NewPhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="manager-new-postal">CEP</label><input id="manager-new-postal" value="@NewPostalMasked" @oninput="NewPostalInput" inputmode="numeric" maxlength="9" placeholder="00000-000" /></div><div class="field"><label for="manager-new-street">Logradouro</label><input id="manager-new-street" @bind="NewStreet" maxlength="200" /></div><div class="field"><label for="manager-new-number">Número</label><input id="manager-new-number" @bind="NewNumber" maxlength="20" /></div><div class="field"><label for="manager-new-complement">Complemento</label><input id="manager-new-complement" @bind="NewComplement" maxlength="100" /></div><div class="field"><label for="manager-new-district">Bairro</label><input id="manager-new-district" @bind="NewDistrict" maxlength="100" /></div><div class="field"><label for="manager-new-city">Cidade</label><input id="manager-new-city" @bind="NewCity" maxlength="100" /></div><div class="field"><label for="manager-new-state">UF</label><input id="manager-new-state" @bind="NewState" maxlength="2" /></div></div><label class="choice-card"><input type="checkbox" @bind="NewSendOnboarding" /><span><strong>Enviar onboarding agora</strong><small>Exige e-mail ou telefone. Sem esta opção, o paciente fica cadastrado somente para uso interno da clínica.</small></span></label><div class="patient-actions"><button class="button">Cadastrar paciente</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-new-patient")'>Voltar</button></div></form></dialog>
<dialog id="manager-edit-patient" class="patient-dialog patient-dialog--wide"><h2>Dados operacionais</h2><p>Ao alterar e-mail ou telefone, o novo contato precisará ser confirmado pelo paciente.</p><form @onsubmit="Save" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-edit-name">Nome completo</label><input id="manager-edit-name" @bind="EditName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-edit-preferred">Nome preferido</label><input id="manager-edit-preferred" @bind="EditPreferred" maxlength="120" /></div><div class="field"><label for="manager-edit-cpf">CPF</label><input id="manager-edit-cpf" value="@EditTaxIdMasked" @oninput="e=>EditTaxId=Digits(e.Value?.ToString())" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" /></div><div class="field"><label for="manager-edit-email">E-mail</label><input id="manager-edit-email" type="email" @bind="EditEmail" maxlength="254" /></div><div class="field"><label for="manager-edit-phone">Telefone</label><input id="manager-edit-phone" type="tel" @bind="EditPhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="manager-edit-birth">Nascimento</label><input id="manager-edit-birth" type="date" @bind="EditBirth" /></div><div class="field"><label for="manager-edit-postal">CEP</label><input id="manager-edit-postal" value="@PostalMasked" @oninput="PostalInput" inputmode="numeric" maxlength="9" placeholder="00000-000" /></div><div class="field"><label for="manager-edit-street">Logradouro</label><input id="manager-edit-street" @bind="EditStreet" maxlength="200" /></div><div class="field"><label for="manager-edit-number">Número</label><input id="manager-edit-number" @bind="EditNumber" maxlength="20" /></div><div class="field"><label for="manager-edit-complement">Complemento</label><input id="manager-edit-complement" @bind="EditComplement" maxlength="100" /></div><div class="field"><label for="manager-edit-district">Bairro</label><input id="manager-edit-district" @bind="EditDistrict" maxlength="100" /></div><div class="field"><label for="manager-edit-city">Cidade</label><input id="manager-edit-city" @bind="EditCity" maxlength="100" /></div><div class="field"><label for="manager-edit-state">UF</label><input id="manager-edit-state" @bind="EditState" maxlength="2" /></div></div><div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-edit-patient")'>Voltar</button></div></form></dialog>
<dialog id="manager-premium-patient" class="patient-dialog"><h2>@(Selected?.IsPremium==true?"Desfazer Premium":"Tornar paciente Premium")</h2>@if(Selected?.IsPremium==true){<p>O comprovante deixará de ficar disponível e o desconto será removido.</p><div class="field"><label for="manager-premium-reason">Motivo</label><textarea id="manager-premium-reason" @bind="PremiumReason" minlength="5" maxlength="1000"></textarea></div><button class="button button--danger" @onclick="DeactivatePremium">Confirmar remoção</button>}else{<p>Anexe o plano de saúde ou outro comprovante válido. O arquivo ficará privado.</p><div class="field"><label for="manager-premium-proof">Comprovante PDF, PNG ou JPEG</label><input id="manager-premium-proof" type="file" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" /></div><progress id="manager-premium-progress" max="100" value="0">0%</progress><button class="button" @onclick="ActivatePremium">Ativar Premium</button>}<button class="button button--secondary" @onclick='()=>Close("manager-premium-patient")'>Voltar</button></dialog>
@code { private ManagerPatientsData? Data;private ManagerCapabilities? Capabilities;private string Search="",Status="",Premium="",PremiumReason="",NewName="",NewPreferred="",NewTaxId="",NewEmail="",NewPhone="",NewPostal="",NewStreet="",NewNumber="",NewComplement="",NewDistrict="",NewCity="",NewState="",EditName="",EditPreferred="",EditTaxId="",EditEmail="",EditPhone="",EditPostal="",EditStreet="",EditNumber="",EditComplement="",EditDistrict="",EditCity="",EditState="";private DateTime? NewBirth,EditBirth;private bool NewSendOnboarding;private int Page=1;private ManagerPatient? Selected;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "total" or "premium"?2:SelectedMetric is "active" or "blocked"?4:6;private string NewTaxIdMasked=>Cpf(NewTaxId)=="Não informado"?NewTaxId:Cpf(NewTaxId);private string NewPostalMasked=>NewPostal.Length==8?$"{NewPostal[..5]}-{NewPostal[5..]}":NewPostal;private string EditTaxIdMasked=>Cpf(EditTaxId)=="Não informado"?EditTaxId:Cpf(EditTaxId);private string PostalMasked=>EditPostal.Length==8?$"{EditPostal[..5]}-{EditPostal[5..]}":EditPostal;
protected override async Task Load(){Capabilities=await Get<ManagerCapabilities>("api/v1/manager/capabilities");Data=await Get<ManagerPatientsData>($"api/v1/manager/patients?search={Escape(Search)}&status={Status}&premium={Premium}&page={Page}&pageSize=12");}private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=Status=Premium="";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private Task Create()=>Run(async()=>{if(NewBirth is null)throw new ManagerUiException("Informe a data de nascimento.");var hasAddress=HasAddress(NewPostal,NewStreet,NewNumber,NewComplement,NewDistrict,NewCity,NewState);object? address=hasAddress?new{postalCode=Empty(NewPostal),street=Empty(NewStreet),number=Empty(NewNumber),complement=Empty(NewComplement),district=Empty(NewDistrict),city=Empty(NewCity),stateCode=Empty(NewState)?.ToUpperInvariant()}:null;await Request<ManagerPatient>("api/v1/manager/patients","POST",new{fullName=NewName,preferredName=Empty(NewPreferred),taxId=NewTaxId,birthDate=DateOnly.FromDateTime(NewBirth.Value),email=Empty(NewEmail),phoneE164=Empty(NewPhone),address,sendOnboarding=NewSendOnboarding});var sent=NewSendOnboarding;await Close("manager-new-patient");NewName=NewPreferred=NewTaxId=NewEmail=NewPhone=NewPostal=NewStreet=NewNumber=NewComplement=NewDistrict=NewCity=NewState="";NewBirth=null;NewSendOnboarding=false;await Load();Notice=sent?"Paciente cadastrado e onboarding enviado.":"Paciente cadastrado para uso interno, sem acesso ao portal.";});
private Task NewPostalInput(ChangeEventArgs e)=>Run(async()=>{NewPostal=Digits(e.Value?.ToString());if(NewPostal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{NewPostal}");if(address is null)return;NewStreet=address.Street;NewComplement=address.Complement??NewComplement;NewDistrict=address.District;NewCity=address.City;NewState=address.StateCode;});
private async Task Edit(ManagerPatient patient){Selected=patient;EditName=patient.FullName;EditPreferred=patient.PreferredName??"";EditTaxId=patient.TaxId??"";EditEmail=patient.Email??"";EditPhone=patient.Phone??"";EditBirth=patient.BirthDate?.ToDateTime(TimeOnly.MinValue);EditPostal=patient.Address?.PostalCode??"";EditStreet=patient.Address?.Street??"";EditNumber=patient.Address?.Number??"";EditComplement=patient.Address?.Complement??"";EditDistrict=patient.Address?.District??"";EditCity=patient.Address?.City??"";EditState=patient.Address?.StateCode??"";await Open("manager-edit-patient");}
private Task PostalInput(ChangeEventArgs e)=>Run(async()=>{EditPostal=Digits(e.Value?.ToString());if(EditPostal.Length!=8)return;var address=await Get<WebPostalCode>($"api/v1/registration/postal-code/{EditPostal}");if(address is null)return;EditStreet=address.Street;EditComplement=address.Complement??EditComplement;EditDistrict=address.District;EditCity=address.City;EditState=address.StateCode;});
private Task Save()=>Run(async()=>{var hasAddress=HasAddress(EditPostal,EditStreet,EditNumber,EditComplement,EditDistrict,EditCity,EditState);object? address=hasAddress?new{postalCode=Empty(EditPostal),street=Empty(EditStreet),number=Empty(EditNumber),complement=Empty(EditComplement),district=Empty(EditDistrict),city=Empty(EditCity),stateCode=Empty(EditState)?.ToUpperInvariant()}:null;await Request<ManagerPatient>($"api/v1/manager/patients/{Selected!.AccountId}","PUT",new{fullName=EditName,preferredName=Empty(EditPreferred),taxId=Empty(EditTaxId),email=Empty(EditEmail),phoneE164=Empty(EditPhone),birthDate=EditBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(EditBirth.Value):null,address,rowVersion=Selected.RowVersion});await Close("manager-edit-patient");await Load();Notice="Dados operacionais atualizados; contatos alterados aguardam confirmação.";});
private Task OpenPremium(ManagerPatient patient){Selected=patient;PremiumReason="";return Open("manager-premium-patient");}
private Task ActivatePremium()=>Run(async()=>{var result=await Module!.InvokeAsync<PatientApiResult<ManagerPatient>>("uploadTo",Backend.BaseUrl.ToString(),$"api/v1/manager/patients/{Selected!.AccountId}/premium","manager-premium-proof","manager-premium-progress");if(!result.Ok)throw new ManagerUiException(result.Error??"Não foi possível ativar o Premium.");await Close("manager-premium-patient");await Load();Notice="Paciente Premium ativado com comprovante privado.";});
private Task DeactivatePremium()=>Run(async()=>{if(PremiumReason.Trim().Length<5)throw new ManagerUiException("Informe um motivo com pelo menos cinco caracteres.");await Request<ManagerPatient>($"api/v1/manager/patients/{Selected!.AccountId}/premium/cancel","POST",new{reason=PremiumReason,rowVersion=Selected.PremiumMembershipRowVersion??0});await Close("manager-premium-patient");await Load();Notice="Premium removido; o comprovante não está mais disponível.";});
private Task DownloadProof(ManagerPatient patient)=>Run(async()=>{var ok=await Module!.InvokeAsync<bool>("download",Backend.BaseUrl.ToString(),$"api/v1/manager/premium/{patient.PremiumMembershipId}/proof");if(!ok)throw new ManagerUiException("Não foi possível abrir o comprovante Premium.");});
private static string Digits(string? value)=>new((value??"").Where(char.IsAsciiDigit).ToArray());private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
private static string Cpf(string? value)=>Digits(value) is var d&&d.Length==11?$"{d[..3]}.{d[3..6]}.{d[6..9]}-{d[9..]}":"Não informado";
private static string Phone(string? value){var d=Digits(value);return d.Length switch{13=>$"+{d[..2]} ({d[2..4]}) {d[4..9]}-{d[9..]}",12=>$"+{d[..2]} ({d[2..4]}) {d[4..8]}-{d[8..]}",_=>"Não informado"};}
private static bool HasAddress(params string?[] values)=>values.Any(value=>!string.IsNullOrWhiteSpace(value));
private static string Address(ManagerPatientAddress? value){if(value is null)return "Não informado";var parts=new List<string>();var street=string.Join(", ",new[]{value.Street,value.Number}.Where(item=>!string.IsNullOrWhiteSpace(item)));if(street.Length>0)parts.Add(street);if(!string.IsNullOrWhiteSpace(value.Complement))parts.Add(value.Complement);if(!string.IsNullOrWhiteSpace(value.District))parts.Add(value.District);var city=string.Join("/",new[]{value.City,value.StateCode}.Where(item=>!string.IsNullOrWhiteSpace(item)));if(city.Length>0)parts.Add(city);var postal=Digits(value.PostalCode);if(postal.Length==8)parts.Add($"{postal[..5]}-{postal[5..]}");return parts.Count==0?"Não informado":string.Join(" · ",parts);}
private static int? Age(DateOnly? birth){if(birth is null)return null;var today=DateOnly.FromDateTime(DateTime.Today);var age=today.Year-birth.Value.Year;return birth.Value>today.AddYears(-age)?age-1:age;}
private void SelectMetric(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"total"=>"Todos os pacientes","premium"=>"Pacientes Premium","active"=>"Pacientes ativos","blocked"=>"Pacientes bloqueados","pending"=>"Premium pendente",_=>"Detalhamento"};private IReadOnlyList<string>? MetricItems=>SelectedMetric switch{"total"=>Data?.Sources.Total,"premium"=>Data?.Sources.Premium,"active"=>Data?.Sources.Active,"blocked"=>Data?.Sources.Blocked,"pending"=>Data?.Sources.PremiumPending,_=>null};}
