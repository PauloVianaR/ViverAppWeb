@page "/gestao/pacientes"
@inherits ManagerPageBase
<PageTitle>Pacientes | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Pacientes da clínica</h1><p class="page-description">Cadastre, encontre e opere dados administrativos sem acessar conteúdo clínico reservado.</p></div><div class="patient-actions"><button class="button" @onclick='()=>Open("manager-new-patient")'>Adicionar paciente</button><a class="button button--secondary" href="/gestao/premium">Análises Premium</a></div></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="manager-patient-search">Nome, e-mail ou telefone</label><input id="manager-patient-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="manager-patient-status">Estado</label><select id="manager-patient-status" @bind="Status"><option value="">Todos</option><option value="active">Ativos</option><option value="pending_confirmation">Aguardando confirmação</option><option value="blocked">Bloqueados</option></select></div><div class="field"><label for="manager-patient-premium">Plano</label><select id="manager-patient-premium" @bind="Premium"><option value="">Todos</option><option value="true">Premium</option><option value="false">Sem Premium</option></select></div></div><div class="patient-actions"><button class="button">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Data is not null){<section class="manager-kpis"><article class="surface manager-kpi"><strong>@Data.Counters.Total</strong><span>Total</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Premium</strong><span>Premium</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Active</strong><span>Ativos</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Blocked</strong><span>Bloqueados</span></article><article class="surface manager-kpi"><strong>@Data.Counters.PremiumPending</strong><span>Premium pendente</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Page.Items.Count>0){<div class="patient-grid">@foreach(var patient in Data.Page.Items){<article class="surface patient-panel"><div class="patient-visit__top"><div><h2>@patient.FullName</h2><p>@(patient.PreferredName is null?"":$"Prefere {patient.PreferredName}")</p></div>@if(patient.IsPremium){<span class="badge badge--brand">Premium</span>}else if(patient.PremiumStatus=="pending"){<span class="badge">Premium em análise</span>}</div><p>@(patient.Email??"E-mail não informado")<br />@(patient.Phone??"Telefone não informado")</p><p>@(patient.BirthDate.HasValue?$"Nascimento: {patient.BirthDate:dd/MM/yyyy}":"Nascimento não informado") · @patient.AppointmentCount atendimento(s)</p><p>Último: @(patient.LastAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy")??"—") · Próximo: @(patient.NextAppointmentAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"—")</p><div class="patient-actions"><a class="button button--small" href="/gestao/pacientes/@patient.AccountId/agendar">Agendar</a><button class="button button--secondary button--small" @onclick="()=>Edit(patient)">Editar</button>@if(patient.Phone is not null){<a class="button button--secondary button--small" href="tel:@patient.Phone">Ligar</a>}@if(patient.PremiumRequestId.HasValue){<a class="button button--secondary button--small" href="/gestao/premium?solicitacao=@patient.PremiumRequestId">Analisar Premium</a>}</div></article>}</div>}else{<InterfaceState Title="Nenhum paciente encontrado" Description="Altere os filtros ou adicione um paciente com onboarding seguro." Icon="users" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="manager-new-patient" class="patient-dialog"><h2>Adicionar paciente</h2><p>A pessoa receberá um código no contato informado e definirá seu próprio acesso. O Gestor nunca escolhe uma senha conhecida.</p><form @onsubmit="Create" @onsubmit:preventDefault><div class="field"><label for="manager-new-name">Nome completo</label><input id="manager-new-name" @bind="NewName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-new-email">E-mail</label><input id="manager-new-email" type="email" @bind="NewEmail" maxlength="254" /></div><div class="field"><label for="manager-new-phone">Telefone</label><input id="manager-new-phone" type="tel" @bind="NewPhone" placeholder="+5531999999999" maxlength="20" /></div><div class="field"><label for="manager-new-birth">Nascimento</label><input id="manager-new-birth" type="date" @bind="NewBirth" /></div><div class="patient-actions"><button class="button">Enviar onboarding</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-new-patient")'>Voltar</button></div></form></dialog>
<dialog id="manager-edit-patient" class="patient-dialog"><h2>Dados operacionais</h2><p>CPF e contatos não são alterados aqui para impedir tomada de conta.</p><form @onsubmit="Save" @onsubmit:preventDefault><div class="field"><label for="manager-edit-name">Nome completo</label><input id="manager-edit-name" @bind="EditName" required minlength="3" maxlength="200" /></div><div class="field"><label for="manager-edit-preferred">Nome preferido</label><input id="manager-edit-preferred" @bind="EditPreferred" maxlength="120" /></div><div class="field"><label for="manager-edit-birth">Nascimento</label><input id="manager-edit-birth" type="date" @bind="EditBirth" /></div><div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("manager-edit-patient")'>Voltar</button></div></form></dialog>
@code { private ManagerPatientsData? Data;private string Search="",Status="",Premium="",NewName="",NewEmail="",NewPhone="",EditName="",EditPreferred="";private DateTime? NewBirth,EditBirth;private int Page=1;private ManagerPatient? Selected;
protected override async Task Load()=>Data=await Get<ManagerPatientsData>($"api/v1/manager/patients?search={Escape(Search)}&status={Status}&premium={Premium}&page={Page}&pageSize=12");private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=Status=Premium="";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private Task Create()=>Run(async()=>{await Request<ManagerPatient>("api/v1/manager/patients","POST",new{fullName=NewName,email=string.IsNullOrWhiteSpace(NewEmail)?null:NewEmail,phoneE164=string.IsNullOrWhiteSpace(NewPhone)?null:NewPhone,birthDate=NewBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(NewBirth.Value):null});await Close("manager-new-patient");NewName=NewEmail=NewPhone="";NewBirth=null;await Load();Notice="Paciente criado. O acesso depende da confirmação do contato.";});
private async Task Edit(ManagerPatient patient){Selected=patient;EditName=patient.FullName;EditPreferred=patient.PreferredName??"";EditBirth=patient.BirthDate?.ToDateTime(TimeOnly.MinValue);await Open("manager-edit-patient");}
private Task Save()=>Run(async()=>{await Request<ManagerPatient>($"api/v1/manager/patients/{Selected!.AccountId}","PUT",new{fullName=EditName,preferredName=EditPreferred,birthDate=EditBirth.HasValue?(DateOnly?)DateOnly.FromDateTime(EditBirth.Value):null,rowVersion=Selected.RowVersion});await Close("manager-edit-patient");await Load();Notice="Dados operacionais atualizados.";});}
