@page "/gestao/perfil"
@inherits ManagerPageBase
<PageTitle>Meu perfil gerencial | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Meu perfil gerencial</h1><p class="page-description">Dados pessoais, contatos, preferências e segurança da conta.</p></div><a class="button button--secondary" href="/gestao">Voltar ao início</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="8" />}else if(Profile is not null){
<section class="surface patient-panel"><h2>Informações pessoais</h2><form @onsubmit="SaveProfile" @onsubmit:preventDefault><div class="manager-profile-grid"><div class="field"><label for="manager-profile-name">Nome completo</label><input id="manager-profile-name" @bind="FullName" required minlength="3" maxlength="200" /></div><div class="field"><label>E-mail</label><input value="@Profile.Email" disabled /></div><div class="field"><label>Telefone</label><input value="@Profile.Phone" disabled /></div><div class="field"><label>CPF</label><input value="@Profile.TaxId" disabled /></div></div><fieldset><legend>Preferências</legend><label class="patient-check"><input type="checkbox" @bind="EmailEnabled" /> Receber comunicações por e-mail</label>@if (Backend.SmsEnabled) { <label class="patient-check"><input type="checkbox" @bind="SmsEnabled" /> Receber comunicações por SMS</label> }<p class="field-hint">Push não é utilizado neste sistema.</p></fieldset><button class="button" disabled="@Busy">Salvar perfil</button></form></section>
<section class="surface patient-panel patient-section"><h2>Alterar contato confirmado</h2><p>O contato atual permanece válido até a confirmação do código. A alteração encerra as sessões por segurança.</p><div class="manager-profile-grid"><div class="field"><label for="manager-contact-channel">Canal</label><select id="manager-contact-channel" @bind="ContactChannel"><option value="email">E-mail</option>@if (Backend.SmsEnabled) { <option value="sms">SMS</option> }</select></div><div class="field"><label for="manager-contact-value">Novo contato</label><input id="manager-contact-value" @bind="ContactDestination" maxlength="254" /></div></div><button class="button button--secondary" @onclick="RequestContact">Enviar código</button>@if(ContactRequest.HasValue){<div class="field"><label for="manager-contact-code">Código de seis dígitos</label><input id="manager-contact-code" @bind="ContactCode" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" /></div><button class="button" @onclick="ConfirmContact">Confirmar alteração</button>}</section>
<section class="surface patient-panel patient-section"><h2>Segurança</h2><p>Google: <strong>@(Security?.GoogleLinked==true?"vinculado":"não vinculado")</strong> · Senha: <strong>@(Security?.HasPassword==true?"configurada":"não configurada")</strong></p><div class="patient-actions"><PasswordChangeButton Role="manager" /><a class="button button--secondary" href="/seguranca">Segurança e sessões</a><button class="button button--secondary" @onclick="RevokeOthers">Encerrar outras sessões</button>@if(Security?.GoogleLinked==true){<button class="button button--danger" @onclick='()=>Open("manager-unlink-google")'>Desvincular Google</button>}</div></section>
<dialog id="manager-unlink-google" class="patient-dialog"><h2>Desvincular Google?</h2><p>Você precisará de outro método confirmado para entrar. As sessões serão encerradas.</p><div class="patient-actions"><button class="button button--danger" @onclick="UnlinkGoogle">Confirmar desvínculo</button><button class="button button--secondary" @onclick='()=>Close("manager-unlink-google")'>Manter vínculo</button></div></dialog>}
@code { private ManagerProfileData? Profile;private PatientSecurity? Security;private string FullName="",ContactChannel="email",ContactDestination="",ContactCode="";private bool EmailEnabled,SmsEnabled;private Guid? ContactRequest;
protected override async Task Load(){Profile=await Get<ManagerProfileData>("api/v1/manager/profile");Security=await Get<PatientSecurity>("api/v1/manager/account/security");if(Profile is not null){FullName=Profile.FullName;EmailEnabled=Profile.EmailEnabled;SmsEnabled=Profile.SmsEnabled;}}
private Task SaveProfile()=>Run(async()=>{Profile=await Request<ManagerProfileData>("api/v1/manager/profile","PUT",new{fullName=FullName,emailEnabled=EmailEnabled,smsEnabled=Backend.SmsEnabled && SmsEnabled,accountRowVersion=Profile!.AccountRowVersion,preferenceRowVersion=Profile.PreferenceRowVersion});Notice="Perfil gerencial atualizado.";});
private Task RequestContact()=>Run(async()=>{var result=await Request<WebChallengeResult>("api/v1/manager/account/contact/request","POST",new{channel=ContactChannel,destination=ContactDestination});ContactRequest=result!.RequestId;Notice=result.Message;});
private Task ConfirmContact()=>Run(async()=>{await Request<object>("api/v1/manager/account/contact/confirm","POST",new{requestId=ContactRequest,code=ContactCode});Navigation.NavigateTo("/acesso",true);});
private Task UnlinkGoogle()=>Run(async()=>{await Close("manager-unlink-google");await Request<object>("api/v1/manager/account/google/unlink","POST",new{});Navigation.NavigateTo("/acesso",true);});
private Task RevokeOthers()=>Run(async()=>{await Request<object>("api/v1/manager/account/sessions/revoke-others","POST",new{});Notice="Outras sessões foram encerradas.";});}
