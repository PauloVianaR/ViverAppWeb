@page "/administracao/notificacoes"
@inherits AdministratorPageBase
<PageTitle>Notificações | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Notificações operacionais</h1><p class="page-description">Fila durável, sem conteúdo clínico, preparada para entrega por e-mail e SMS na fase 16.</p></div><button class="button" disabled="@(Busy||Data?.Counters.Unread==0)" @onclick="ReadAll">Marcar todas como lidas</button></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="status">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="notification-type">Tipo</label><select id="notification-type" @bind="Type"><option value="">Todos</option><option value="approval_pending">Aprovação</option><option value="payment_pending">Pagamento</option><option value="premium_pending">Premium</option></select></div><div class="field"><label for="notification-severity">Severidade</label><select id="notification-severity" @bind="Severity"><option value="">Todas</option><option value="info">Informativa</option><option value="warning">Atenção</option><option value="high">Alta</option></select></div><div class="field"><label for="notification-read">Leitura</label><select id="notification-read" @bind="Read"><option value="">Todas</option><option value="unread">Não lidas</option><option value="read">Lidas</option></select></div></div><button class="button">Aplicar filtros</button></form></section>
@if(Data is not null){<section class="administrator-kpis"><article class="surface administrator-kpi"><strong>@Data.Counters.PendingPayments</strong><span>Pagamentos pendentes</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.Unread</strong><span>Não lidas</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.HighSeverity</strong><span>Alta severidade</span></article><article class="surface administrator-kpi"><strong>@Data.Counters.PendingApprovals</strong><span>Aprovações</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="7"/>}else if(Data?.Items.Count>0){<div class="administrator-grid">@foreach(var item in Data.Items){<article class="surface administrator-card"><div class="section-heading"><span class="badge @(item.SeverityCode=="high"?"badge--danger":item.SeverityCode=="warning"?"badge--warning":"badge--brand")">@(item.IsRead?"Lida":"Nova")</span><time>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div><h2>@item.Title</h2><p>@item.Message</p><div class="administrator-actions">@if(!item.IsRead){<button class="button button--secondary" @onclick="()=>MarkRead(item)">Marcar como lida</button>}<button class="button button--secondary" @onclick="()=>Dismiss(item)">Dispensar</button>@if(item.EntityType=="account"){<a class="button" href="/administracao/usuarios">Abrir usuários</a>}else if(item.EntityType=="appointment"){<a class="button" href="/administracao/consultas">Abrir consultas</a>}</div></article>}</div>}else{<InterfaceState Title="Nenhuma notificação" Description="Não há itens para os filtros escolhidos." Icon="check" Tone="success"/>}
@code{private AdministratorNotifications? Data;private string Type="",Severity="",Read="";protected override async Task Load()=>Data=await Get<AdministratorNotifications>($"api/v1/administrator/notifications?type={Type}&severity={Severity}&read={Read}");private Task Apply()=>Run(Load);private Task MarkRead(AdministratorNotification item)=>Run(async()=>{await Request<object>($"api/v1/administrator/notifications/{item.Id}/read","POST",new{rowVersion=item.RowVersion});Notice="Notificação marcada como lida.";await Load();});private Task Dismiss(AdministratorNotification item)=>Run(async()=>{await Request<object>($"api/v1/administrator/notifications/{item.Id}/dismiss","POST",new{rowVersion=item.RowVersion});Notice="Notificação dispensada.";await Load();});private Task ReadAll()=>Run(async()=>{await Request<object>("api/v1/administrator/notifications/read-all","POST",new{});Notice="Todas as notificações foram marcadas como lidas.";await Load();});}
