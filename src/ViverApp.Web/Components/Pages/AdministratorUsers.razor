@page "/administracao/usuarios"
@inherits AdministratorPageBase
@using static ViverApp.Web.AdministratorLabels
<PageTitle>Usuários e Premium | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Usuários e Premium</h1><p class="page-description">Aprovação, bloqueio, atendimento online e benefício Premium com trilha auditável.</p></div><a class="button button--secondary" href="/acesso">Reautenticar</a></header>
<p class="administrator-elevated">Aprovar, rejeitar, bloquear e decidir Premium exigem uma sessão iniciada há menos de cinco minutos.</p>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="status">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="user-search">Nome ou contato</label><input id="user-search" @bind="Search" maxlength="120"/></div><div class="field"><label for="user-role">Papel</label><select id="user-role" @bind="RoleFilter"><option value="">Todos</option><option value="patient">Pacientes</option><option value="doctor">Médicos</option><option value="manager">Gestores</option><option value="administrator">Administradores</option></select></div><div class="field"><label for="user-status">Estado</label><select id="user-status" @bind="StatusFilter"><option value="">Todos</option><option value="pending_approval">Pendentes</option><option value="active">Ativos</option><option value="rejected">Rejeitados</option><option value="blocked">Bloqueados</option></select></div></div><button class="button">Aplicar filtros</button></form></section>
@if(Loading){<LoadingSkeleton Lines="8"/>}else{
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Aprovações</p><h2>Médicos e Gestores</h2></div><span class="badge badge--warning">@Professionals.Count pendente(s)</span></div>@if(Professionals.Count==0){<InterfaceState Title="Fila em dia" Description="Nenhum profissional corresponde aos filtros." Icon="check" Tone="success"/>}else{<div class="administrator-grid">@foreach(var item in Professionals){<article class="surface administrator-card"><span class="badge badge--warning">@Role(item.RoleCode)</span><h3>@item.FullName</h3><p>@(item.Email??item.PhoneE164??"Sem contato")</p>@if(item.RoleCode=="doctor"){<p><strong>CRM @item.LicenseStateCode @item.LicenseNumber</strong><br/>@(item.Specialties.FirstOrDefault(x=>x.Id==item.PrimarySpecialtyId)?.Name??"Especialidade não informada") · @item.YearsExperience ano(s)</p>}<div class="field"><label for="reason-@item.AccountId">Motivo da decisão</label><textarea id="reason-@item.AccountId" @bind="Reasons[item.AccountId]" maxlength="500"></textarea></div><div class="administrator-actions"><button class="button" @onclick='()=>Review(item,"approved")'>Aprovar</button><button class="button button--danger" @onclick='()=>Review(item,"rejected")'>Rejeitar</button></div></article>}</div>}</section>
@if(Rejected.Count>0){<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Reanálise</p><h2>Cadastros rejeitados</h2></div></div><div class="administrator-grid">@foreach(var item in Rejected){<article class="surface administrator-card"><span class="badge badge--danger">@Role(item.RoleCode)</span><h3>@item.FullName</h3><p>@(item.Email??item.PhoneE164??"Sem contato")</p><button class="button button--secondary" @onclick="()=>Reopen(item)">Reabrir análise</button></article>}</div></section>}
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Contas</p><h2>Diretório da clínica</h2></div><span>@(Users?.TotalCount??0) registro(s)</span></div>@if(Users?.Items.Count>0){<div class="data-region"><table class="data-table"><thead><tr><th>Nome</th><th>Papel</th><th>Estado</th><th>Contato</th><th>Ações</th></tr></thead><tbody>@foreach(var item in Users.Items){<tr><td data-label="Nome"><strong>@item.FullName</strong></td><td data-label="Papel">@Role(item.RoleCode)</td><td data-label="Estado"><span class="badge">@Status(item.StatusCode)</span></td><td data-label="Contato">@(item.Email??item.PhoneE164??"—")</td><td data-label="Ações"><div class="administrator-table-actions">@if(item.StatusCode=="active"){<button class="button button--danger" @onclick='()=>AccountStatus(item,"blocked")'>Bloquear</button>}else if(item.StatusCode=="blocked"){<button class="button button--secondary" @onclick='()=>AccountStatus(item,"reactivated")'>Desbloquear</button>}</div></td></tr>}</tbody></table></div>}else{<InterfaceState Title="Nenhum usuário" Description="Altere os filtros da consulta." Icon="users"/>}</section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Teleatendimento</p><h2>Permissão online dos Médicos</h2></div></div><div class="administrator-grid">@foreach(var doctor in Doctors){<article class="surface administrator-card"><h3>@doctor.FullName</h3><p>@(doctor.OnlineEnabled?"Atendimento online permitido":"Atendimento online bloqueado")</p><button class="button button--secondary" @onclick="()=>ToggleOnline(doctor)">@(doctor.OnlineEnabled?"Bloquear online":"Permitir online")</button></article>}</div></section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Planos</p><h2>Regras do Premium</h2></div></div><div class="administrator-grid">@foreach(var plan in Plans){<article class="surface administrator-card"><h3>@plan.Name</h3><div class="field"><label for="plan-discount-@plan.Id">Desconto em atendimentos (%)</label><input id="plan-discount-@plan.Id" type="number" min="0" max="100" step="0.01" @bind="PlanDiscounts[plan.Id]"/></div><div class="field"><label for="plan-days-@plan.Id">Validade em dias (vazio = sem expiração)</label><input id="plan-days-@plan.Id" type="number" min="1" max="3650" value="@PlanValidity[plan.Id]" @onchange="e=>PlanValidity[plan.Id]=e.Value?.ToString()??string.Empty"/></div><label><input type="checkbox" checked="@plan.IsActive" @onchange="e=>PlanActive[plan.Id]=(bool)(e.Value??false)"/> Plano ativo</label><button class="button button--secondary" @onclick="()=>SavePlan(plan)">Salvar plano</button></article>}</div></section>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Premium</p><h2>Solicitações e benefícios</h2></div></div>@if(Premium?.Items.Count>0){<div class="administrator-grid">@foreach(var item in Premium.Items){<article class="surface administrator-card"><span class="badge badge--brand">@Status(item.StatusCode)</span><h3>@item.PatientName</h3><p>@item.PlanName · @item.DiscountPercent% de desconto</p>@if(item.ProofDocumentId is not null){<button class="button button--secondary" @onclick="()=>DownloadProof(item)">Abrir comprovante privado</button>}@if(item.StatusCode is "pending" or "active"){<div class="field"><label for="premium-reason-@item.Id">Observação/motivo</label><textarea id="premium-reason-@item.Id" @bind="PremiumReasons[item.Id]" maxlength="1000"></textarea></div>}@if(item.StatusCode=="pending"){<div class="administrator-actions"><button class="button" @onclick='()=>DecidePremium(item,true)'>Aprovar</button><button class="button button--danger" @onclick='()=>DecidePremium(item,false)'>Rejeitar</button></div>}else if(item.StatusCode=="active"){<button class="button button--danger" @onclick="()=>CancelPremium(item)">Cancelar benefício</button>}</article>}</div>}else{<InterfaceState Title="Sem solicitações Premium" Description="Nenhuma solicitação foi encontrada." Icon="check"/>}</section>}
@code{private WebPage<AdministratorUser>? Users;private WebPage<ManagerPremiumRequest>? Premium;private readonly List<WebProfessional> Professionals=[];private readonly List<WebProfessional> Rejected=[];private IReadOnlyList<AdministratorDoctorAccess> Doctors=[];private IReadOnlyList<AdministratorPremiumPlan> Plans=[];private readonly Dictionary<ulong,string> Reasons=[];private readonly Dictionary<ulong,string> PremiumReasons=[];private readonly Dictionary<uint,decimal> PlanDiscounts=[];private readonly Dictionary<uint,string> PlanValidity=[];private readonly Dictionary<uint,bool> PlanActive=[];private string Search="",RoleFilter="",StatusFilter="";
protected override async Task Load(){Users=await Get<WebPage<AdministratorUser>>($"api/v1/users?page=1&pageSize=100&search={Escape(Search)}&role={RoleFilter}&status={StatusFilter}");var p=await Get<WebPage<WebProfessional>>($"api/v1/professionals?page=1&pageSize=100&search={Escape(Search)}&status=pending_approval");var rejected=await Get<WebPage<WebProfessional>>($"api/v1/professionals?page=1&pageSize=100&search={Escape(Search)}&status=rejected");Professionals.Clear();Rejected.Clear();if(p is not null)Professionals.AddRange(p.Items);if(rejected is not null)Rejected.AddRange(rejected.Items);foreach(var item in Professionals)Reasons.TryAdd(item.AccountId,"");Doctors=await Get<IReadOnlyList<AdministratorDoctorAccess>>("api/v1/administrator/doctor-access")??[];Plans=await Get<IReadOnlyList<AdministratorPremiumPlan>>("api/v1/administrator/premium-plans")??[];foreach(var plan in Plans){PlanDiscounts[plan.Id]=plan.AppointmentDiscountPercent;PlanValidity[plan.Id]=plan.ValidityDays?.ToString()??"";PlanActive[plan.Id]=plan.IsActive;}Premium=await Get<WebPage<ManagerPremiumRequest>>($"api/v1/administrator/premium?page=1&pageSize=100&search={Escape(Search)}");if(Premium is not null)foreach(var item in Premium.Items)PremiumReasons.TryAdd(item.Id,"");}
private Task Apply()=>Run(Load);private Task Review(WebProfessional item,string decision)=>Run(async()=>{var reason=Reasons[item.AccountId].Trim();if(decision=="rejected"&&reason.Length<5){Notice="Informe um motivo com pelo menos cinco caracteres.";NoticeError=true;return;}await Request<WebProfessional>($"api/v1/professionals/{item.AccountId}/review","POST",new{decisionCode=decision,reason=string.IsNullOrWhiteSpace(reason)?null:reason,accountRowVersion=item.AccountRowVersion});Notice=decision=="approved"?"Cadastro aprovado.":"Cadastro rejeitado.";await Load();});
private Task AccountStatus(AdministratorUser item,string decision)=>Run(async()=>{await Request<object>($"api/v1/administrator/users/{item.Id}/status","POST",new{decisionCode=decision,reason=decision=="blocked"?"Bloqueio administrativo solicitado na gestão de usuários.":null,rowVersion=item.RowVersion});Notice="Estado da conta atualizado.";await Load();});
private Task ToggleOnline(AdministratorDoctorAccess item)=>Run(async()=>{await Request<object>($"api/v1/administrator/doctors/{item.AccountId}/online","POST",new{enabled=!item.OnlineEnabled,rowVersion=item.RowVersion});Notice="Permissão de teleatendimento atualizada.";await Load();});
private Task SavePlan(AdministratorPremiumPlan item)=>Run(async()=>{ushort? days=ushort.TryParse(PlanValidity[item.Id],out var value)?value:null;await Request<AdministratorPremiumPlan>($"api/v1/administrator/premium-plans/{item.Id}","PUT",new{appointmentDiscountPercent=PlanDiscounts[item.Id],validityDays=days,isActive=PlanActive[item.Id],rowVersion=item.RowVersion});Notice="Plano Premium atualizado.";await Load();});
private Task Reopen(WebProfessional item)=>Run(async()=>{await Request<object>($"api/v1/administrator/professionals/{item.AccountId}/reopen","POST",new{decisionCode="reactivated",reason="Cadastro reaberto para nova análise administrativa.",rowVersion=item.AccountRowVersion});Notice="Cadastro devolvido para análise.";await Load();});
private Task DecidePremium(ManagerPremiumRequest item,bool approve)=>Run(async()=>{var reason=PremiumReasons[item.Id].Trim();if(!approve&&reason.Length<5){Notice="Informe um motivo com pelo menos cinco caracteres.";NoticeError=true;return;}await Request<ManagerPremiumRequest>($"api/v1/administrator/premium/{item.Id}/decision","POST",new{approve,notes=approve?reason:null,rejectionReason=approve?null:reason,rowVersion=item.RowVersion});Notice=approve?"Premium aprovado.":"Premium rejeitado.";await Load();});private Task CancelPremium(ManagerPremiumRequest item)=>Run(async()=>{var reason=PremiumReasons[item.Id].Trim();if(reason.Length<5){Notice="Informe o motivo do cancelamento com pelo menos cinco caracteres.";NoticeError=true;return;}await Request<ManagerPremiumRequest>($"api/v1/administrator/premium/{item.Id}/cancel","POST",new{reason,rowVersion=item.RowVersion});Notice="Benefício Premium cancelado.";await Load();});private Task DownloadProof(ManagerPremiumRequest item)=>Run(async()=>{var ok=await Module!.InvokeAsync<bool>("download",Backend.BaseUrl.ToString(),$"api/v1/administrator/premium/{item.Id}/proof");Notice=ok?"Comprovante aberto com acesso auditado.":"Não foi possível abrir o comprovante.";NoticeError=!ok;});}
