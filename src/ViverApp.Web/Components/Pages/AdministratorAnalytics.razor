@page "/administracao/analytics"
@inherits AdministratorPageBase
@using static ViverApp.Web.AdministratorLabels
@using static ViverApp.Web.ManagerLabels
<PageTitle>Analytics | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Administrador</p><h1 class="page-title">Analytics da clínica</h1><p class="page-description">Métricas agregadas, comparação com o período anterior e tabelas acessíveis.</p></div></header>
@if(Notice is not null){<p class="notice notice--error">@Notice</p>}
<section class="surface patient-panel"><div class="administrator-actions" role="group" aria-label="Período"><button class="button button--secondary" @onclick="()=>Period(1)">1 mês</button><button class="button button--secondary" @onclick="()=>Period(3)">3 meses</button><button class="button button--secondary" @onclick="()=>Period(6)">6 meses</button><button class="button button--secondary" @onclick="()=>Period(12)">12 meses</button></div><form @onsubmit="Apply" @onsubmit:preventDefault><div class="administrator-filter-grid"><div class="field"><label for="analytics-from">De</label><input id="analytics-from" type="date" @bind="From"/></div><div class="field"><label for="analytics-to">Até</label><input id="analytics-to" type="date" @bind="To"/></div></div><button class="button">Aplicar intervalo</button></form></section>
@if(Loading){<LoadingSkeleton Lines="8"/>}else if(Data is not null){<section class="administrator-kpis"><article class="surface administrator-kpi"><strong>@Money(Data.Revenue)</strong><span>Receita · antes @Money(Data.PreviousRevenue)</span></article><article class="surface administrator-kpi"><strong>@Data.Appointments</strong><span>Consultas · antes @Data.PreviousAppointments</span></article><article class="surface administrator-kpi"><strong>@Money(Data.AverageTicket)</strong><span>Ticket médio</span></article><article class="surface administrator-kpi"><strong>@(Data.Satisfaction?.ToString("0.0")??"—")</strong><span>Satisfação / 5</span></article></section><div class="administrator-grid"><MetricPanel Title="Receita por mês" Items="Data.RevenueByMonth" MoneyValues="true"/><MetricPanel Title="Consultas por estado" Items="Data.AppointmentsByStatus"/><MetricPanel Title="Pagamentos por método" Items="Data.PaymentsByMethod" MoneyValues="true"/><MetricPanel Title="Desempenho médico agregado" Items="Data.DoctorPerformance"/></div>}
@code{private AdministratorAnalyticsData? Data;private DateTime From=DateTime.Today.AddMonths(-3),To=DateTime.Today;protected override async Task Load()=>Data=await Get<AdministratorAnalyticsData>($"api/v1/administrator/analytics?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}");private Task Apply()=>Run(Load);private Task Period(int months)=>Run(async()=>{To=DateTime.Today;From=To.AddMonths(-months);await Load();});}
