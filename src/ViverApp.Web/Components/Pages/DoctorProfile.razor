@page "/medico/perfil"
@page "/medico/disponibilidade"
@page "/psicologo/perfil"
@page "/psicologo/disponibilidade"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>Perfil profissional | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">@ProfessionalLabel</p><h1 class="page-title">Perfil profissional</h1><p class="page-description">Dados, especialidades, serviços e disponibilidade em uma única área.</p></div><a class="button button--secondary" href="/seguranca">Passkeys e sessões</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<nav class="patient-tabs" aria-label="Seções do perfil"><a class="button button--secondary" href="#dados">Dados</a><a class="button button--secondary" href="#servicos">Especialidades e serviços</a><a class="button button--secondary" href="#disponibilidade">Disponibilidade</a><a class="button button--secondary" href="#seguranca">Segurança</a></nav>
@if(Loading){<LoadingSkeleton Lines="8" />}
else if(Profile is not null){
<section id="dados" class="surface patient-panel patient-section"><h2>Dados profissionais</h2><form @onsubmit="SaveProfile" @onsubmit:preventDefault><div class="doctor-profile-grid"><div class="field"><label for="doctor-name">Nome completo</label><input id="doctor-name" @bind="FullName" required minlength="3" maxlength="200" autocomplete="name" /></div><div class="field"><label for="doctor-title">Título</label><input id="doctor-title" @bind="ProfessionalTitle" required maxlength="30" /></div><div class="field"><label>@Profile.LicenseTypeCode</label><input value="@($"{Profile.LicenseStateCode} {Profile.LicenseNumber}")" disabled /><p class="field-hint">Alterações de credenciamento dependem de nova análise administrativa.</p></div><div class="field"><label for="doctor-years">Anos de experiência</label><input id="doctor-years" type="number" min="0" max="80" @bind="Years" /></div><div class="field"><label for="doctor-duration">Duração padrão (minutos)</label><input id="doctor-duration" type="number" min="10" max="480" @bind="Duration" /></div><div class="field"><label>Contatos confirmados</label><p>@(Profile.Email??"E-mail não informado")<br />@(Profile.Phone??"Telefone não informado")</p></div></div><div class="field"><label for="doctor-bio">Apresentação profissional</label><textarea id="doctor-bio" @bind="Biography" maxlength="4000" rows="6"></textarea><p class="field-hint">@Biography.Length de 4.000 caracteres</p></div><fieldset><legend>Comunicações</legend><label class="patient-check"><input type="checkbox" @bind="EmailEnabled" /> Receber comunicações por e-mail</label><label class="patient-check"><input type="checkbox" @bind="SmsEnabled" /> Receber comunicações por SMS</label></fieldset><button class="button" disabled="@Busy">Salvar dados</button></form></section>
<section id="servicos" class="surface patient-panel patient-section"><h2>Especialidades e serviços</h2><p>Escolha uma especialidade principal e mantenha apenas serviços que você efetivamente oferece.</p><div class="field"><label for="primary-specialty">Especialidade principal</label><select id="primary-specialty" @bind="PrimarySpecialty">@foreach(var specialty in Specialties){<option value="@specialty.Id">@specialty.Name</option>}</select></div><div class="doctor-service-list">@foreach(var specialty in Specialties){<label class="doctor-service"><input type="checkbox" checked="@SelectedSpecialties.Contains(specialty.Id)" @onchange="e=>ToggleSpecialty(specialty.Id,e.Value as bool?==true)" /><span>@specialty.Name</span></label>}</div><hr /><div class="field"><label for="service-search">Pesquisar serviço</label><input id="service-search" @bind="ServiceSearch" placeholder="Consulta, exame ou cirurgia" /></div><div class="doctor-service-list">@foreach(var service in FilteredServices){<article class="doctor-service"><label><input type="checkbox" checked="@SelectedServices.Contains(service.Id)" disabled="@(!service.IsActive)" @onchange="e=>ToggleService(service.Id,e.Value as bool?==true)" /><span><strong>@service.Name</strong><br /><small>@Category(service.CategoryCode) · @Modality(service.ModalityCode) · @service.DurationMinutes min · @(service.RequiresPayment?Money(service.PriceAmount):"Sem cobrança")</small></span></label></article>}</div><div class="patient-actions"><button class="button" @onclick="SaveServices" disabled="@Busy">Salvar serviços</button><button class="button button--secondary" @onclick="SaveProfile" disabled="@Busy">Salvar especialidades</button></div></section>
<section id="disponibilidade" class="surface patient-panel patient-section"><h2>Disponibilidade</h2><form @onsubmit="SaveAvailability" @onsubmit:preventDefault><fieldset><legend>Limites e atendimento online</legend><label class="patient-check"><input type="checkbox" @bind="OnlineEnabled" /> Habilitar horários online quando a clínica permitir</label><div class="doctor-profile-grid"><div class="field"><label for="max-online">Máximo online por dia</label><input id="max-online" type="number" min="0" max="100" @bind="MaxOnline" /></div><div class="field"><label for="max-person">Máximo presencial por dia</label><input id="max-person" type="number" min="0" max="100" @bind="MaxInPerson" /></div></div></fieldset><button class="button">Salvar limites</button></form>
<h3>Grade semanal</h3><div class="patient-grid">@foreach(var hour in Availability?.WeeklyHours??[]){<article class="doctor-service"><strong>@Day(hour.DayOfWeek)</strong><p>@hour.StartsAt.ToString("HH:mm")–@hour.EndsAt.ToString("HH:mm") · @Modality(hour.ModalityCode) · @(hour.IsActive?"Ativo":"Inativo")</p><div class="patient-actions"><button class="button button--secondary button--small" @onclick="()=>EditHour(hour)">Editar</button><button class="button button--danger button--small" @onclick="()=>DeleteHour(hour)">Remover</button></div></article>}</div><button class="button button--secondary" @onclick="NewHour">Adicionar faixa semanal</button>
<h3>Exceções por data</h3><div class="patient-grid">@foreach(var item in Availability?.Exceptions??[]){<article class="doctor-service"><strong>@item.Date.ToString("dd/MM/yyyy")</strong><p>@FormatException(item) · @Modality(item.ModalityCode)</p><div class="patient-actions"><button class="button button--secondary button--small" @onclick="()=>EditException(item)">Editar</button><button class="button button--danger button--small" @onclick="()=>DeleteException(item)">Remover</button></div></article>}</div><button class="button button--secondary" @onclick="NewException">Adicionar exceção</button></section>
<section id="seguranca" class="surface patient-panel patient-section"><h2>Contatos e segurança</h2><p>E-mail: @(Profile.Email ?? "Não informado")</p><p>Telefone: @(Profile.Phone ?? "Não informado")</p>
@if(Security?.RecentAuthentication != true){<p>Para mudar contatos ou vínculos, confirme sua identidade entrando novamente. Depois, volte ao perfil.</p><a class="button button--secondary" href="/acesso">Confirmar minha identidade</a>}
<form @onsubmit="RequestContact" @onsubmit:preventDefault><h3>Confirmar um novo contato</h3><div class="doctor-profile-grid"><div class="field"><label for="doctor-contact-channel">Canal</label><select id="doctor-contact-channel" @bind="ContactChannel"><option value="email">E-mail</option><option value="sms">SMS</option></select></div><div class="field"><label for="doctor-contact-destination">Novo contato</label><input id="doctor-contact-destination" @bind="ContactDestination" type="@(ContactChannel=="email"?"email":"tel")" placeholder="@(ContactChannel=="email"?"voce@exemplo.com":"+5531999999999")" required maxlength="254" /></div></div><button class="button button--secondary" disabled="@(Busy||Security?.RecentAuthentication!=true)">Enviar código de confirmação</button></form>
@if(ContactRequest.HasValue){<form @onsubmit="ConfirmContact" @onsubmit:preventDefault><div class="field"><label for="doctor-contact-code">Código recebido no novo contato</label><input id="doctor-contact-code" @bind="ContactCode" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required /></div><button class="button" disabled="@Busy">Confirmar e substituir contato</button></form>}
<p class="field-hint">O contato atual só será substituído após a confirmação. Em seguida, entre novamente com o contato atualizado.</p>
<h3>Conta Google</h3><p>@(Security?.GoogleLinked==true?"Google vinculado à sua conta.":"Vincule sua conta Google para facilitar o acesso.")</p>@if(Security?.GoogleLinked==true){<button class="button button--danger" disabled="@(Busy||Security?.RecentAuthentication!=true)" @onclick='()=>Open("unlink-google")'>Desvincular Google</button>}else if(Security?.RecentAuthentication==true){<a class="button button--secondary" href="@Backend.GoogleLinkUrl">Vincular Google</a>}
<h3>Senha</h3>@if(Security?.HasPassword==true){<form @onsubmit="ChangePassword" @onsubmit:preventDefault><div class="doctor-profile-grid"><div class="field"><label for="doctor-current-password">Senha atual</label><input id="doctor-current-password" type="password" @bind="CurrentPassword" autocomplete="current-password" required maxlength="128" /></div><div class="field"><label for="doctor-new-password">Nova senha</label><input id="doctor-new-password" type="password" @bind="NewPassword" autocomplete="new-password" required minlength="12" maxlength="128" /></div><div class="field"><label for="doctor-confirm-password">Confirmar nova senha</label><input id="doctor-confirm-password" type="password" @bind="ConfirmPassword" autocomplete="new-password" required minlength="12" maxlength="128" /></div></div><p>Use pelo menos 12 caracteres, maiúsculas, minúsculas, números e símbolo.</p><button class="button button--secondary" disabled="@Busy">Alterar senha e encerrar sessões</button></form>}else{<p>Você usa Google ou códigos de acesso. Para configurar uma senha, use a recuperação com um contato confirmado.</p><a href="/acesso">Acessar recuperação de senha</a>}
<div class="patient-actions patient-section"><a class="button" href="/seguranca">Gerenciar passkeys e dispositivos</a><button class="button button--secondary" disabled="@Busy" @onclick="RevokeOthers">Encerrar outras sessões</button></div></section>
<dialog id="unlink-google" class="patient-dialog" aria-labelledby="doctor-unlink-title"><h2 id="doctor-unlink-title">Desvincular Google?</h2><p>Você precisará de outro método confirmado para entrar. Suas sessões serão encerradas.</p><div class="patient-actions"><button class="button button--danger" @onclick="UnlinkGoogle" disabled="@Busy">Confirmar desvínculo</button><button class="button button--secondary" @onclick='()=>Close("unlink-google")'>Manter vínculo</button></div></dialog>
<dialog id="hour-dialog" class="patient-dialog"><h2>@(HourId.HasValue?"Editar faixa semanal":"Nova faixa semanal")</h2><form @onsubmit="SaveHour" @onsubmit:preventDefault><div class="field"><label>Dia</label><select @bind="HourDay">@for(byte d=0;d<7;d++){<option value="@d">@Day(d)</option>}</select></div><div class="field"><label>Modalidade</label><select @bind="HourModality"><option value="both">Ambas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div><div class="field"><label>Início</label><input type="time" @bind="HourStart" /></div><div class="field"><label>Fim</label><input type="time" @bind="HourEnd" /></div><label class="patient-check"><input type="checkbox" @bind="HourActive" /> Faixa ativa</label><div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("hour-dialog")'>Voltar</button></div></form></dialog>
<dialog id="exception-dialog" class="patient-dialog"><h2>@(ExceptionId.HasValue?"Editar exceção":"Nova exceção")</h2><form @onsubmit="SaveException" @onsubmit:preventDefault><div class="field"><label>Data</label><input type="date" @bind="ExceptionDate" /></div><div class="field"><label>Modalidade</label><select @bind="ExceptionModality"><option value="both">Ambas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div><label class="patient-check"><input type="checkbox" @bind="ExceptionAvailable" /> Abrir uma faixa especial (desmarcado bloqueia o dia)</label>@if(ExceptionAvailable){<div class="doctor-profile-grid"><div class="field"><label>Início</label><input type="time" @bind="ExceptionStart" /></div><div class="field"><label>Fim</label><input type="time" @bind="ExceptionEnd" /></div></div>}<div class="patient-actions"><button class="button">Salvar</button><button type="button" class="button button--secondary" @onclick='()=>Close("exception-dialog")'>Voltar</button></div></form></dialog>}
@code { private ProfessionalProfileData? Profile;private DoctorAvailability? Availability;private PatientSecurity? Security;private IReadOnlyList<WebSpecialty> Specialties=[];private IReadOnlyList<ProfessionalService> Services=[];private HashSet<uint> SelectedSpecialties=[],SelectedServices=[];private string FullName="",ProfessionalTitle="",Biography="",ServiceSearch="",ContactChannel="email",ContactDestination="",ContactCode="",CurrentPassword="",NewPassword="",ConfirmPassword="";private Guid? ContactRequest;private ushort Years,Duration,MaxOnline,MaxInPerson;private uint PrimarySpecialty;private bool EmailEnabled,SmsEnabled,OnlineEnabled;
private ulong? HourId,ExceptionId;private ulong HourVersion,ExceptionVersion;private byte HourDay=1;private string HourModality="both";private TimeOnly HourStart=new(8,0),HourEnd=new(12,0);private bool HourActive=true;private DateTime ExceptionDate=DateTime.Today.AddDays(1);private string ExceptionModality="both";private bool ExceptionAvailable;private TimeOnly ExceptionStart=new(8,0),ExceptionEnd=new(12,0);
private IEnumerable<ProfessionalService> FilteredServices=>Services.Where(x=>string.IsNullOrWhiteSpace(ServiceSearch)||x.Name.Contains(ServiceSearch,StringComparison.OrdinalIgnoreCase));
protected override async Task Load(){Profile=await Get<ProfessionalProfileData>("api/v1/doctor/profile");Security=await Get<PatientSecurity>("api/v1/doctor/account/security");Services=await Get<IReadOnlyList<ProfessionalService>>("api/v1/doctor/services")??[];var page=await Get<WebPage<WebSpecialty>>("api/v1/catalog/specialties?page=1&pageSize=100");Specialties=page?.Items??[];var today=DateTime.Today;Availability=await Get<DoctorAvailability>($"api/v1/doctor/availability?from={today:yyyy-MM-dd}&to={today.AddYears(1):yyyy-MM-dd}");if(Profile is not null){FullName=Profile.FullName;ProfessionalTitle=Profile.ProfessionalTitle;Biography=Profile.Biography??"";Years=Profile.YearsExperience;Duration=Profile.DefaultAppointmentDurationMinutes;EmailEnabled=Profile.EmailEnabled;SmsEnabled=Profile.SmsEnabled;PrimarySpecialty=Profile.Specialties.FirstOrDefault(x=>x.IsPrimary)?.Id??0;SelectedSpecialties=Profile.Specialties.Select(x=>x.Id).ToHashSet();}if(Availability is not null){OnlineEnabled=Availability.OnlineEnabled;MaxOnline=Availability.MaxOnlineDaily;MaxInPerson=Availability.MaxInPersonDaily;}SelectedServices=Services.Where(x=>x.Offered).Select(x=>x.Id).ToHashSet();}
private void ToggleSpecialty(uint id,bool value){if(value)SelectedSpecialties.Add(id);else SelectedSpecialties.Remove(id);}private void ToggleService(uint id,bool value){if(value)SelectedServices.Add(id);else SelectedServices.Remove(id);}private Task SaveProfile()=>Run(async()=>{Profile=await Request<ProfessionalProfileData>("api/v1/doctor/profile","PUT",new{fullName=FullName,professionalTitle=ProfessionalTitle,biography=Biography,yearsExperience=Years,defaultAppointmentDurationMinutes=Duration,specialtyIds=SelectedSpecialties.ToArray(),primarySpecialtyId=PrimarySpecialty,emailEnabled=EmailEnabled,smsEnabled=SmsEnabled,accountRowVersion=Profile!.AccountRowVersion,profileRowVersion=Profile.ProfileRowVersion,preferenceRowVersion=Profile.PreferenceRowVersion});Notice="Perfil profissional atualizado.";});
private Task SaveServices()=>Run(async()=>{Services=await Request<IReadOnlyList<ProfessionalService>>("api/v1/doctor/services","PUT",new{appointmentTypeIds=SelectedServices.ToArray()})??[];Notice="Serviços atualizados.";});private Task SaveAvailability()=>Run(async()=>{if(Availability is null)throw new DoctorUiException("A disponibilidade profissional ainda não foi carregada. Recarregue a página.");Availability=await Request<DoctorAvailability>("api/v1/doctor/availability","PUT",new{onlineEnabled=OnlineEnabled,maxOnlineDaily=MaxOnline,maxInPersonDaily=MaxInPerson,rowVersion=Availability.PreferenceRowVersion});Notice="Limites atualizados.";});
private async Task NewHour(){HourId=null;HourVersion=0;HourDay=1;HourModality="both";HourStart=new(8,0);HourEnd=new(12,0);HourActive=true;await Open("hour-dialog");}private async Task EditHour(ProfessionalWeeklyHour x){HourId=x.Id;HourVersion=x.RowVersion;HourDay=x.DayOfWeek;HourModality=x.ModalityCode;HourStart=x.StartsAt;HourEnd=x.EndsAt;HourActive=x.IsActive;await Open("hour-dialog");}
private Task SaveHour()=>Run(async()=>{var path=$"api/v1/professionals/{Profile!.AccountId}/weekly-hours"+(HourId.HasValue?$"/{HourId}":"");await Request<ProfessionalWeeklyHour>(path,HourId.HasValue?"PUT":"POST",new{dayOfWeek=HourDay,startTime=HourStart,endTime=HourEnd,validFrom=(DateOnly?)null,validUntil=(DateOnly?)null,isActive=HourActive,rowVersion=HourVersion,modalityCode=HourModality});await Close("hour-dialog");await Load();Notice="Grade semanal atualizada.";});private Task DeleteHour(ProfessionalWeeklyHour x)=>Run(async()=>{await Request<object>($"api/v1/professionals/{Profile!.AccountId}/weekly-hours/{x.Id}?rowVersion={x.RowVersion}","DELETE",new{});await Load();Notice="Faixa removida.";});
private async Task NewException(){ExceptionId=null;ExceptionVersion=0;ExceptionDate=DateTime.Today.AddDays(1);ExceptionModality="both";ExceptionAvailable=false;await Open("exception-dialog");}private async Task EditException(ProfessionalAvailabilityException x){ExceptionId=x.Id;ExceptionVersion=x.RowVersion;ExceptionDate=x.Date.ToDateTime(TimeOnly.MinValue);ExceptionModality=x.ModalityCode;ExceptionAvailable=x.IsAvailable;ExceptionStart=x.StartsAt??new(8,0);ExceptionEnd=x.EndsAt??new(12,0);await Open("exception-dialog");}
private Task SaveException()=>Run(async()=>{var path="api/v1/doctor/availability/exceptions"+(ExceptionId.HasValue?$"/{ExceptionId}":"");await Request<ProfessionalAvailabilityException>(path,ExceptionId.HasValue?"PUT":"POST",new{date=DateOnly.FromDateTime(ExceptionDate),modalityCode=ExceptionModality,isAvailable=ExceptionAvailable,startsAt=ExceptionAvailable?ExceptionStart:(TimeOnly?)null,endsAt=ExceptionAvailable?ExceptionEnd:(TimeOnly?)null,rowVersion=ExceptionVersion});await Close("exception-dialog");await Load();Notice="Exceção atualizada.";});private Task DeleteException(ProfessionalAvailabilityException x)=>Run(async()=>{await Request<object>($"api/v1/doctor/availability/exceptions/{x.Id}?rowVersion={x.RowVersion}","DELETE",new{});await Load();Notice="Exceção removida.";});
private Task RequestContact()=>Run(async()=>{var result=await Request<WebChallengeResult>("api/v1/doctor/account/contact/request","POST",new{channel=ContactChannel,destination=ContactDestination});ContactRequest=result!.RequestId;Notice=result.Message;});private Task ConfirmContact()=>Run(async()=>{await Request<object>("api/v1/doctor/account/contact/confirm","POST",new{requestId=ContactRequest,code=ContactCode});Navigation.NavigateTo("/acesso",true);});private Task ChangePassword()=>Run(async()=>{if(NewPassword!=ConfirmPassword)throw new DoctorUiException("A confirmação da senha não corresponde.");await Request<object>("api/v1/doctor/account/password","POST",new{currentPassword=CurrentPassword,newPassword=NewPassword});Navigation.NavigateTo("/acesso",true);});private Task UnlinkGoogle()=>Run(async()=>{await Close("unlink-google");await Request<object>("api/v1/doctor/account/google/unlink","POST",new{});Navigation.NavigateTo("/acesso",true);});private Task RevokeOthers()=>Run(async()=>{await Request<object>("api/v1/doctor/account/sessions/revoke-others","POST",new{});Notice="Outras sessões foram encerradas.";});private static string FormatException(ProfessionalAvailabilityException item)=>item.IsAvailable?$"{item.StartsAt?.ToString("HH:mm")}–{item.EndsAt?.ToString("HH:mm")}":"Dia bloqueado";private static string Day(byte day)=>day switch{0=>"Domingo",1=>"Segunda",2=>"Terça",3=>"Quarta",4=>"Quinta",5=>"Sexta",_=>"Sábado"};}
