@page "/medico/online/{Id:long}"
@inherits DoctorPageBase
<PageTitle>Videoatendimento | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Médico</p><h1 class="page-title">Videoatendimento</h1><p class="page-description">Sala privada vinculada ao atendimento e ao profissional atribuído.</p></div><a class="button button--secondary" href="/medico/atendimentos/@Id">Voltar ao atendimento</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<section class="surface patient-panel"><p id="call-status" role="status" aria-live="polite">@StatusText</p><p id="call-quality">Qualidade: aguardando conexão.</p><div class="patient-video-grid"><figure><video id="remote-video" autoplay playsinline aria-label="Vídeo do paciente"></video><figcaption>Paciente</figcaption></figure><figure><video id="local-video" autoplay playsinline muted aria-label="Seu vídeo"></video><figcaption>Você</figcaption></figure></div><div class="patient-actions"><button class="button" disabled="@(Busy||Visit?.Appointment.CanJoinOnline!=true)" @onclick="Start">Entrar / reconectar</button><button id="call-microphone" class="button button--secondary" @onclick="ToggleMicrophone" disabled="@(!Started)" aria-pressed="@Microphone">@(Microphone?"Desligar microfone":"Ligar microfone")</button><button id="call-camera" class="button button--secondary" @onclick="ToggleCamera" disabled="@(!Started)" aria-pressed="@Camera">@(Camera?"Desligar câmera":"Ligar câmera")</button><button class="button button--danger" @onclick="Leave" disabled="@(!Started)">Sair</button></div><p class="doctor-callout">A chamada não é gravada. Permissão negada, dispositivo ausente e falhas de rede são informados sem expor detalhes internos.</p><details><summary>Resolver câmera, áudio ou conexão</summary><p>Autorize câmera e microfone nas permissões do navegador, feche outros aplicativos que estejam usando os dispositivos e tente reconectar. Em rede instável, desligue a câmera.</p></details></section>
@code { [Parameter]public long Id{get;set;}private DoctorAppointmentDetail? Visit;private IJSObjectReference? VideoModule;private bool Started,Microphone=true,Camera=true;private string StatusText="Validando acesso à sala…";protected override async Task Load(){Visit=await Get<DoctorAppointmentDetail>($"api/v1/doctor/appointments/{Id}");StatusText=Visit?.Appointment.CanJoinOnline==true?"Tudo pronto. Entre quando estiver em local reservado.":"A sala abre 15 minutos antes e durante um atendimento online confirmado e pago.";VideoModule??=await JavaScript.InvokeAsync<IJSObjectReference>("import","/js/teleconsultation.js");}private Task Start()=>Run(async()=>{Started=await VideoModule!.InvokeAsync<bool>("start",Backend.BaseUrl.ToString(),Id);Microphone=Camera=true;});private async Task ToggleMicrophone()=>Microphone=await VideoModule!.InvokeAsync<bool>("toggle","audio");private async Task ToggleCamera()=>Camera=await VideoModule!.InvokeAsync<bool>("toggle","video");private async Task Leave(){await VideoModule!.InvokeVoidAsync("stop");Started=false;}public override async ValueTask DisposeAsync(){if(VideoModule is not null)try{await VideoModule.InvokeVoidAsync("stop");await VideoModule.DisposeAsync();}catch(JSDisconnectedException){}await base.DisposeAsync();}}
