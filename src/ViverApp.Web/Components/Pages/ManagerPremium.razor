@page "/gestao/premium"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Análises Premium | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Solicitações Premium</h1><p class="page-description">Analise comprovantes privados com concorrência, auditoria e decisão explícita.</p></div><a class="button button--secondary" href="/gestao/pacientes">Voltar aos pacientes</a></header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success")" role="alert">@Notice</p>}
<MobileFilterPanel AriaLabel="Filtros de solicitações Premium"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="patient-filter-grid"><div class="field"><label for="premium-search">Paciente</label><input id="premium-search" @bind="Search" maxlength="120" /></div><div class="field"><label for="premium-status">Estado</label><select id="premium-status" @bind="StatusFilter"><option value="pending">Pendentes</option><option value="">Todos</option><option value="active">Aprovados</option><option value="rejected">Rejeitados</option><option value="canceled">Cancelados</option><option value="expired">Expirados</option></select></div></div><div class="patient-actions"><button class="button">Aplicar</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Loading){<LoadingSkeleton Lines="6" />}else if(Data?.Items.Count>0){<div class="patient-grid">@foreach(var item in Data.Items){<article class="surface patient-panel manager-premium-card"><div class="patient-visit__top"><div><p class="eyebrow">@item.PlanName</p><h2>@item.PatientName</h2></div><span class="badge">@Status(item.StatusCode)</span></div><p>Desconto: @item.DiscountPercent% · solicitado em @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>@if(item.ProofName is not null){<p><strong>Comprovante:</strong> @item.ProofName (@((item.ProofSizeBytes??0)/1024) KB)</p>}@if(item.ReviewNotes is not null){<p><strong>Observação:</strong> @item.ReviewNotes</p>}@if(item.RejectionReason is not null){<p><strong>Motivo:</strong> @item.RejectionReason</p>}<div class="patient-actions">@if(item.ProofDocumentId.HasValue){<button class="button button--secondary button--small" @onclick="()=>Download(item)">Inspecionar comprovante</button>}@if(item.StatusCode=="pending"){<button class="button button--small" @onclick="()=>Review(item)">Analisar</button>}</div></article>}</div>}else{<InterfaceState Title="Nenhuma solicitação encontrada" Description="Não há pedidos Premium para os filtros atuais." Icon="card" />}
<nav class="patient-pagination"><button class="button button--secondary" disabled="@(Page==1||Busy)" @onclick="Previous">Anterior</button><span>Página @Page</span><button class="button button--secondary" disabled="@(Busy||Page*12>=(Data?.TotalCount??0))" @onclick="Next">Próxima</button></nav>
<dialog id="manager-premium-review" class="patient-dialog"><h2>Analisar solicitação Premium</h2>@if(Selected is not null){<p><strong>@Selected.PatientName</strong> · @Selected.PlanName · @Selected.DiscountPercent%</p><div class="field"><label for="premium-notes">Observações internas</label><textarea id="premium-notes" @bind="Notes" maxlength="1000"></textarea></div><div class="field"><label for="premium-rejection">Motivo da rejeição</label><textarea id="premium-rejection" @bind="Rejection" minlength="5" maxlength="1000"></textarea><p class="field-hint">Obrigatório somente ao rejeitar.</p></div><div class="patient-actions"><button class="button" @onclick="Approve">Aprovar</button><button class="button button--danger" @onclick="Reject">Rejeitar</button><button class="button button--secondary" @onclick='()=>Close("manager-premium-review")'>Voltar</button></div>}</dialog>
@code { [SupplyParameterFromQuery(Name="solicitacao")]public long? RequestedId{get;set;}private WebPage<ManagerPremiumRequest>? Data;private ManagerPremiumRequest? Selected;private string Search="",StatusFilter="pending",Notes="",Rejection="";private int Page=1;private bool opened;
protected override async Task Load(){Data=await Get<WebPage<ManagerPremiumRequest>>($"api/v1/manager/premium?status={StatusFilter}&search={Escape(Search)}&page={Page}&pageSize=12");if(RequestedId.HasValue&&!opened){Selected=await Get<ManagerPremiumRequest>($"api/v1/manager/premium/{RequestedId}");opened=true;await Open("manager-premium-review");}}
private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search="";StatusFilter="pending";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});private async Task Review(ManagerPremiumRequest item){Selected=item;Notes=item.ReviewNotes??"";Rejection="";await Open("manager-premium-review");}
private Task Download(ManagerPremiumRequest item)=>Run(async()=>{if(!await Module!.InvokeAsync<bool>("download",Backend.BaseUrl.ToString(),$"api/v1/manager/premium/{item.Id}/proof"))throw new ManagerUiException("Comprovante indisponível.");});
private Task Approve()=>Decide(true);private Task Reject()=>Decide(false);private Task Decide(bool approve)=>Run(async()=>{if(!approve&&Rejection.Trim().Length<5)throw new ManagerUiException("Informe o motivo da rejeição.");await Request<ManagerPremiumRequest>($"api/v1/manager/premium/{Selected!.Id}/decision","POST",new{approve,notes=Notes,rejectionReason=approve?null:Rejection,rowVersion=Selected.RowVersion});await Close("manager-premium-review");await Load();Notice=approve?"Solicitação aprovada e notificação registrada.":"Solicitação rejeitada e notificação registrada.";});}
