@page "/gestao/clinica"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels

<PageTitle>Configuração da clínica | ViverApp</PageTitle>
<header class="workspace-heading">
    <div><p class="eyebrow">Gestor</p><h1 class="page-title">Serviços e horários profissionais</h1><p class="page-description">Permissões temporárias controladas pelo Administrador para catálogo, preços e grade semanal.</p></div>
    <a class="button button--secondary" href="/gestao">Voltar ao início</a>
</header>
@if(Notice is not null){<UiNotice Message="@Notice" IsError="NoticeError" />}
@if(Loading){<LoadingSkeleton Lines="8"/>}
else if(Capabilities is null || !Capabilities.AppointmentTypesEnabled && !Capabilities.DoctorSchedulesEnabled && !Capabilities.ProfessionalServicesEnabled)
{
    <InterfaceState Title="Gestão temporariamente desabilitada" Description="O Administrador desabilitou o cadastro de atendimentos e a gestão de horários para o perfil Gestor." Icon="shield" />
}
else
{
    @if(Capabilities.AppointmentTypesEnabled || Capabilities.ProfessionalServicesEnabled)
    {
        <ClinicSection Title="Tipos de atendimento e preços" Description="Cadastre serviços, preços e vínculos profissionais.">
        <section class="patient-section">
            <div class="section-heading"><div><p class="eyebrow">Catálogo</p><h2>Tipos de atendimento e preços</h2></div>@if(Capabilities.AppointmentTypesEnabled){<button class="button" @onclick="NewService">Adicionar tipo</button>}</div>
            <MobileFilterPanel AriaLabel="Filtros dos tipos de atendimento"><form @onsubmit="FilterServices" @onsubmit:preventDefault><div class="manager-filter-grid"><div class="field"><label for="manager-service-search">Buscar por texto</label><input id="manager-service-search" @bind="ServiceSearch" maxlength="120" placeholder="Nome do serviço" /></div><div class="field"><label for="manager-service-filter-category">Tipo de atendimento</label><select id="manager-service-filter-category" @bind="ServiceCategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div></div><div class="patient-actions"><button class="button">Filtrar</button><button type="button" class="button button--secondary" @onclick="ClearServiceFilters">Limpar</button></div></form></MobileFilterPanel>
            <div class="administrator-grid appointment-catalog-grid">@foreach(var item in Services.OrderBy(x=>x.Name,StringComparer.CurrentCultureIgnoreCase)){<article class="surface administrator-card appointment-catalog-card"><span class="badge @(item.IsActive?"badge--success":"badge--warning")">@(item.IsActive?"Ativo":"Inativo")</span><h3>@item.Name</h3>@if(!string.IsNullOrWhiteSpace(item.Description)){<p>@item.Description</p>}<p><strong>@(item.RequiresPayment?Money(item.PriceAmount):"Sem cobrança")</strong> · @item.DurationMinutes min · @Category(item.CategoryCode)</p><div class="administrator-actions">@if(Capabilities.AppointmentTypesEnabled){<button class="button button--secondary" @onclick="()=>EditService(item)">Editar</button><button class="button button--secondary" @onclick="()=>ToggleService(item)">@(item.IsActive?"Desativar":"Ativar")</button>@if(item.CanDelete){<button class="button button--danger" @onclick="()=>PrepareDeleteService(item)">Excluir</button>}}</div></article>}</div>
        </section>
        </ClinicSection>
    }
    @if(Capabilities.DoctorSchedulesEnabled)
    {
        <ClinicSection Title="Horários dos profissionais" Description="Disponibilidade recorrente ou variável de médicos e psicólogos.">
        <section class="surface patient-panel patient-section">
            <div class="section-heading"><div><p class="eyebrow">Disponibilidade</p><h2>Horários dos profissionais</h2></div>@if(AvailabilityMode == "recurring"){<button class="button" @onclick="NewHour" disabled="@(DoctorId==0)">Adicionar horário</button>}</div>
            <div class="field"><label for="schedule-doctor">Profissional</label><select id="schedule-doctor" value="@DoctorId" @onchange="DoctorChanged"><option value="0">Selecione</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName · @doctor.LicenseLabel</option>}</select></div>
            @if(DoctorId!=0){<ProfessionalDailyLimitsEditor @key="DoctorId" ProfessionalId="@DoctorId" /><ProfessionalAvailabilityPlanner ProfessionalId="@DoctorId" OnModeChanged="mode => AvailabilityMode = mode" />}
            @if(AvailabilityMode == "recurring")
            {
                @if(DoctorId!=0 && Hours.Count==0){<InterfaceState Title="Sem horários cadastrados" Description="Adicione a primeira faixa semanal para este profissional." Icon="calendar" />}
                <div class="administrator-grid">@foreach(var hour in Hours){<article class="surface administrator-card"><span class="badge @(hour.IsActive?"badge--success":"badge--warning")">@(hour.IsActive?"Ativo":"Inativo")</span><h3>@Day(hour.DayOfWeek)</h3><p>@TimeOnly.FromTimeSpan(hour.StartTime).ToString("HH:mm")–@TimeOnly.FromTimeSpan(hour.EndTime).ToString("HH:mm") · @Modality(hour.ModalityCode)</p><div class="administrator-actions"><button class="button button--secondary" @onclick="()=>EditHour(hour)">Editar</button><button class="button button--danger" @onclick="()=>DeleteHour(hour)">Remover</button></div></article>}</div>
            }
        </section>
        </ClinicSection>
    }
}

<dialog id="manager-service-dialog" class="patient-dialog"><h2>@(EditingService is null?"Novo tipo de atendimento":"Editar tipo de atendimento")</h2><div class="field"><label for="manager-service-name">Nome</label><input id="manager-service-name" @bind="ServiceName" required maxlength="120" /></div><div class="field"><label for="manager-service-description">Descrição</label><textarea id="manager-service-description" @bind="ServiceDescription" maxlength="500"></textarea></div><div class="field"><label for="manager-service-specialty">Especialidade</label><select id="manager-service-specialty" @bind="ServiceSpecialtyId"><option value="0">Selecione</option>@foreach(var specialty in ServiceSpecialties){<option value="@specialty.Id">@specialty.Name</option>}</select><p class="field-hint">Todos os profissionais dessa especialidade oferecem este serviço.</p></div><label class="patient-check"><input type="checkbox" @bind="ServiceRequiresPayment"/> Cobrar?</label><div class="manager-filter-grid"><div class="field"><label for="manager-service-category">Tipo</label><select id="manager-service-category" @bind="ServiceCategory"><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div><div class="field"><label for="manager-service-modality">Modalidade</label><select id="manager-service-modality" @bind="ServiceModality"><option value="in_person">Presencial</option><option value="online">Online</option><option value="both">Ambas</option></select></div><div class="field"><label for="manager-service-duration">Duração em minutos</label><input id="manager-service-duration" type="number" min="5" max="480" @bind="ServiceDuration" /></div>@if(ServiceRequiresPayment){<div class="field"><label for="manager-service-price">Preço</label><input id="manager-service-price" type="number" min="0.01" step="0.01" @bind="ServicePrice" /></div>}</div><div class="patient-actions"><button class="button" @onclick="SaveService">Salvar</button><button class="button button--secondary" @onclick='()=>Close("manager-service-dialog")'>Voltar</button></div></dialog>
<dialog id="manager-service-delete-dialog" class="patient-dialog"><h2>Excluir tipo de atendimento?</h2><p>@DeleteServiceTarget?.Name ainda não foi usado em agendamentos. A exclusão também remove seus vínculos com profissionais.</p><div class="patient-actions"><button class="button button--danger" @onclick="DeleteService">Excluir definitivamente</button><button class="button button--secondary" @onclick='()=>Close("manager-service-delete-dialog")'>Voltar</button></div></dialog>


<dialog id="manager-doctor-hour-dialog" class="patient-dialog"><h2>@(EditingHour is null?"Novo horário do profissional":"Editar horário do profissional")</h2><div class="manager-filter-grid"><div class="field"><label for="manager-hour-day">Dia</label><select id="manager-hour-day" @bind="HourDay">@for(byte day=0;day<7;day++){<option value="@day">@Day(day)</option>}</select></div><div class="field"><label for="manager-hour-start">Início</label><input id="manager-hour-start" type="time" @bind="HourStart" /></div><div class="field"><label for="manager-hour-end">Fim</label><input id="manager-hour-end" type="time" @bind="HourEnd" /></div><div class="field"><label for="manager-hour-modality">Modalidade</label><select id="manager-hour-modality" @bind="HourModality"><option value="both">Ambas</option><option value="in_person">Presencial</option><option value="online">Online</option></select></div></div><label class="patient-check"><input type="checkbox" @bind="HourActive" /> Horário ativo</label><div class="patient-actions"><button class="button" @onclick="SaveHour">Salvar</button><button class="button button--secondary" @onclick='()=>Close("manager-doctor-hour-dialog")'>Voltar</button></div></dialog>

@code {private uint ServiceSpecialtyId;
    private ManagerCapabilities? Capabilities;
    private IReadOnlyList<WebBookingWorkspaceSpecialty> ServiceSpecialties=[];
    private IReadOnlyList<AdministratorService> Services=[];
    private IReadOnlyList<ManagerDoctor> Doctors=[];
    private IReadOnlyList<ManagerProfessionalWeeklyHour> Hours=[];


    private AdministratorService? EditingService;
    private AdministratorService? DeleteServiceTarget;

    private ManagerProfessionalWeeklyHour? EditingHour;
    private ulong DoctorId;
    private string? AvailabilityMode;
    private string ServiceName="",ServiceDescription="",ServiceCategory="consultation",ServiceModality="in_person",HourModality="both",ServiceSearch="",ServiceCategoryFilter="";
    private int ServiceDuration=30;
    private decimal ServicePrice;
    private bool ServiceRequiresPayment=true;
    private byte HourDay=1;
    private TimeOnly HourStart=new(8,0),HourEnd=new(12,0);
    private bool HourActive=true;

    protected override async Task Load(){ServiceSpecialties=(await Get<WebBookingWorkspaceOptions>("api/v1/booking-workspace/options"))?.Specialties??[];Capabilities=await Get<ManagerCapabilities>("api/v1/manager/capabilities");if(Capabilities?.AppointmentTypesEnabled==true||Capabilities?.ProfessionalServicesEnabled==true)await LoadServices();if(Capabilities?.DoctorSchedulesEnabled==true){Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/manager/doctors")??[];if(DoctorId==0)DoctorId=Doctors.FirstOrDefault()?.AccountId??0;await LoadHours();}}
    private async Task LoadServices(){var page=await Get<WebPage<AdministratorService>>($"api/v1/catalog/appointment-types?page=1&pageSize=100&includeInactive=true&search={Escape(ServiceSearch)}&category={ServiceCategoryFilter}");Services=page?.Items??[];}
    private Task FilterServices()=>Run(LoadServices);private Task ClearServiceFilters()=>Run(async()=>{ServiceSearch=ServiceCategoryFilter="";await LoadServices();});
    private async Task LoadHours(){Hours=DoctorId==0?[]:await Get<IReadOnlyList<ManagerProfessionalWeeklyHour>>($"api/v1/professionals/{DoctorId}/weekly-hours")??[];}
    private Task DoctorChanged(ChangeEventArgs args)=>Run(async()=>{DoctorId=ulong.TryParse(args.Value?.ToString(),out var value)?value:0;AvailabilityMode=null;await LoadHours();});
    private Task NewService()=>Run(async()=>{EditingService=null;ServiceName=ServiceDescription="";ServiceCategory="consultation";ServiceModality="in_person";ServiceDuration=30;ServicePrice=0;ServiceRequiresPayment=true;ServiceSpecialtyId=ServiceSpecialties.FirstOrDefault(x=>PatientSearchKey.Normalize(x.Name)=="OFTALMOLOGIA")?.Id??ServiceSpecialties.FirstOrDefault()?.Id??0;await Open("manager-service-dialog");});
    private Task EditService(AdministratorService item){EditingService=item;ServiceSpecialtyId=item.SpecialtyId;ServiceName=item.Name;ServiceDescription=item.Description??"";ServiceCategory=item.CategoryCode;ServiceModality=item.ModalityCode;ServiceDuration=item.DurationMinutes;ServicePrice=item.PriceAmount;ServiceRequiresPayment=item.RequiresPayment;return Open("manager-service-dialog");}
    private Task SaveService()=>Run(async()=>{var item=EditingService;await Request<AdministratorService>(item is null?"api/v1/catalog/appointment-types":$"api/v1/catalog/appointment-types/{item.Id}",item is null?"POST":"PUT",new{name=ServiceName,description=Empty(ServiceDescription),categoryCode=ServiceCategory,modalityCode=ServiceModality,durationMinutes=ServiceDuration,priceAmount=ServiceRequiresPayment?ServicePrice:0,requiresPayment=ServiceRequiresPayment,isActive=item?.IsActive??true,displayOrder=item?.DisplayOrder??Services.Count,rowVersion=item?.RowVersion??0,specialtyId=ServiceSpecialtyId});await Close("manager-service-dialog");await Load();Notice=item is null?"Tipo de atendimento cadastrado por especialidade.":"Tipo de atendimento atualizado.";});
    private Task ToggleService(AdministratorService item)=>Run(async()=>{await Request<AdministratorService>($"api/v1/catalog/appointment-types/{item.Id}","PUT",new{name=item.Name,description=item.Description,categoryCode=item.CategoryCode,modalityCode=item.ModalityCode,durationMinutes=item.DurationMinutes,priceAmount=item.PriceAmount,requiresPayment=item.RequiresPayment,isActive=!item.IsActive,displayOrder=item.DisplayOrder,rowVersion=item.RowVersion});await Load();Notice="Estado do tipo de atendimento atualizado.";});
    private Task PrepareDeleteService(AdministratorService item){DeleteServiceTarget=item;return Open("manager-service-delete-dialog");}
    private Task DeleteService()=>Run(async()=>{if(DeleteServiceTarget is null)return;await Request<object>($"api/v1/catalog/appointment-types/{DeleteServiceTarget.Id}/permanent?rowVersion={DeleteServiceTarget.RowVersion}","DELETE",null);await Close("manager-service-delete-dialog");DeleteServiceTarget=null;await LoadServices();Notice="Tipo de atendimento excluído.";});
        private Task NewHour(){EditingHour=null;HourDay=1;HourStart=new(8,0);HourEnd=new(12,0);HourModality="both";HourActive=true;return Open("manager-doctor-hour-dialog");}
    private Task EditHour(ManagerProfessionalWeeklyHour item){EditingHour=item;HourDay=item.DayOfWeek;HourStart=TimeOnly.FromTimeSpan(item.StartTime);HourEnd=TimeOnly.FromTimeSpan(item.EndTime);HourModality=item.ModalityCode;HourActive=item.IsActive;return Open("manager-doctor-hour-dialog");}
    private Task SaveHour()=>Run(async()=>{var item=EditingHour;var path=$"api/v1/professionals/{DoctorId}/weekly-hours"+(item is null?"":$"/{item.Id}");await Request<ManagerProfessionalWeeklyHour>(path,item is null?"POST":"PUT",new{dayOfWeek=HourDay,startTime=HourStart.ToTimeSpan(),endTime=HourEnd.ToTimeSpan(),validFrom=(DateOnly?)null,validUntil=(DateOnly?)null,isActive=HourActive,rowVersion=item?.RowVersion??0,modalityCode=HourModality});await Close("manager-doctor-hour-dialog");await LoadHours();Notice="Grade semanal atualizada.";});
    private Task DeleteHour(ManagerProfessionalWeeklyHour item)=>Run(async()=>{await Request<object>($"api/v1/professionals/{DoctorId}/weekly-hours/{item.Id}?rowVersion={item.RowVersion}","DELETE",null);await LoadHours();Notice="Horário removido.";});
    private static string? Empty(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
    private static string Day(byte day)=>day switch{0=>"Domingo",1=>"Segunda-feira",2=>"Terça-feira",3=>"Quarta-feira",4=>"Quinta-feira",5=>"Sexta-feira",_=>"Sábado"};
}
