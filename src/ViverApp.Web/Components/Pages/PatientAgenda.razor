@page "/paciente/agenda"
@inherits PatientPageBase
@using static ViverApp.Web.PatientLabels
<PageTitle>Minha agenda | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Paciente</p><h1 class="page-title">Minha agenda</h1><p class="page-description">Próximos atendimentos, histórico e documentos do seu cuidado.</p></div><a class="button" href="/paciente/agendar">Novo agendamento</a></header>
@if (Notice is not null) { <p class="notice notice--error" role="alert">@Notice</p> }
<div class="patient-tabs" aria-label="Visualização da agenda"><button class="button @(View == "future" ? null : "button--secondary")" aria-pressed="@(View == "future")" disabled="@Busy" @onclick='() => ChangeView("future")'>Próximos</button><button class="button @(View == "history" ? null : "button--secondary")" aria-pressed="@(View == "history")" disabled="@Busy" @onclick='() => ChangeView("history")'>Histórico</button></div>
<MobileFilterPanel AriaLabel="Filtros da agenda">
    <form @onsubmit="Apply" @onsubmit:preventDefault>
        <div class="patient-filter-grid">
            <div class="field"><label for="agenda-search">Serviço ou médico</label><input id="agenda-search" @bind="Search" maxlength="100" /></div>
            <div class="field"><label for="agenda-number">Número do atendimento</label><input id="agenda-number" type="number" min="100" @bind="AppointmentNumber" @bind:event="oninput" /></div>
            <div class="field"><label for="agenda-from">De</label><input id="agenda-from" type="date" @bind="From" /></div>
            <div class="field"><label for="agenda-until">Até</label><input id="agenda-until" type="date" @bind="Until" /></div>
            <div class="field"><label for="agenda-status">Estado</label><select id="agenda-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var code in new[]{"pending","confirmed","completed","canceled","rescheduled","no_show"}){<option value="@(code)">@Status(code)</option>}</select></div>
            <div class="field"><label for="agenda-category">Tipo</label><select id="agenda-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option></select></div>
            <div class="field"><label for="agenda-modality">Modalidade</label><select id="agenda-modality" @bind="Modality"><option value="">Todas</option><option value="in_person">Presencial</option><option value="online">Online</option></select></div>
        </div><div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear" disabled="@Busy">Limpar filtros</button></div>
    </form>
</MobileFilterPanel>
@if (Loading) { <LoadingSkeleton Lines="5" /> }
else if (PageData?.Items.Count > 0) { <p class="muted" role="status">@PageData.TotalCount atendimento(s) · horários no fuso da clínica</p><div class="patient-grid">@foreach(var item in PageData.Items){<PatientVisitCard Model="item" Clinic="Clinic" />}</div> }
else { <InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou escolha um novo horário." Icon="calendar" ActionHref="/paciente/agendar" ActionLabel="Agendar" /> }
<nav class="patient-pagination" aria-label="Páginas da agenda"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy || Page == 1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy || Page * 12 >= (PageData?.TotalCount ?? 0))">Próxima</button></nav>
@code {
    private WebPage<PatientAppointment>? PageData;
    private PatientClinic? Clinic;
    private string View = "future", Search = "", StatusFilter = "", CategoryFilter = "", Modality = "";
    private DateTime? From, Until;
    private ulong? AppointmentNumber;
    private int Page = 1;
    protected override async Task Load() { Clinic ??= await Get<PatientClinic>("api/v1/patient/experience/clinic"); PageData = await Get<WebPage<PatientAppointment>>($"api/v1/patient/experience/agenda?page={Page}&view={View}&search={Escape(Search)}&appointmentNumber={AppointmentNumber}&status={StatusFilter}&category={CategoryFilter}&modality={Modality}&from={From:yyyy-MM-dd}&until={Until:yyyy-MM-dd}"); }
    private Task Apply() => Run(async () => { Page = 1; await Load(); });
    private Task ChangeView(string view) => Run(async () => { View = view; Page = 1; await Load(); });
    private Task Clear() => Run(async () => { Search = StatusFilter = CategoryFilter = Modality = ""; AppointmentNumber = null; From = Until = null; Page = 1; await Load(); });
    private Task Previous() => Run(async () => { Page--; await Load(); });
    private Task Next() => Run(async () => { Page++; await Load(); });
}
