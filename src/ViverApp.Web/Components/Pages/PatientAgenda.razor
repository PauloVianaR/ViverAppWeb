@page "/paciente/atendimentos"
@inherits PatientPageBase
@using static ViverApp.Web.PatientLabels
<PageTitle>Atendimentos | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Paciente</p><h1 class="page-title">Atendimentos</h1><p class="page-description">Consulte seus atendimentos e documentos do cuidado.</p></div><a class="button" href="/paciente/agendar">Novo agendamento</a></header>
@if (Notice is not null) { <UiNotice Message="@Notice" IsError="true" /> }
<AppointmentStatusLegend />
<MobileFilterPanel Class="mobile-filter-panel--all" AriaLabel="Filtros da agenda">
    <form @onsubmit="Apply" @onsubmit:preventDefault>
        <div class="patient-filter-grid">
            <div class="field"><label for="agenda-search">Serviço ou médico</label><input id="agenda-search" @bind="Search" @bind:event="oninput" maxlength="100" /></div>
            <div class="field"><label for="agenda-number">Número do atendimento</label><input id="agenda-number" type="number" min="100" @bind="AppointmentNumber" @bind:event="oninput" /></div>
            <div class="field"><label for="agenda-from">De</label><input id="agenda-from" type="date" @bind="From" /></div>
            <div class="field"><label for="agenda-until">Até</label><input id="agenda-until" type="date" @bind="Until" /></div>
            <div class="field"><label for="agenda-status">Estado</label><select id="agenda-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var code in new[]{"pending","confirmed","completed","canceled","rescheduled","no_show"}){<option value="@(code)">@Status(code)</option>}</select></div>
            <div class="field"><label for="agenda-specialty">Especialidade</label><select id="agenda-specialty" @bind="SpecialtyFilter"><option value="">Todos</option>@foreach (var specialty in Specialties ?? []) { <option value="@specialty.Id">@specialty.Name</option> }</select></div><div class="field"><label for="agenda-category">Tipo</label><select id="agenda-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div>
            <div class="field"><label for="agenda-modality">Modalidade</label><select id="agenda-modality" @bind="Modality"><option value="">Todas</option><option value="in_person">Presencial</option><option value="online">Online</option></select></div>
            <PaymentPendingFilter @bind-Value="PendingFilter" />
        </div><div class="patient-actions"><button type="button" class="button" @onclick="Apply" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear" disabled="@Busy">Limpar filtros</button></div>
    </form>
</MobileFilterPanel>
@if (Loading) { <LoadingSkeleton Lines="5" /> }
else if (PageData?.Items.Count > 0) { <div class="appointment-results-heading"><p class="muted" role="status">@PageData.TotalCount atendimento(s) · horários no fuso da clínica</p><AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /></div><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in PageData.Items){<PatientVisitCard Model="item" Clinic="Clinic" />}</div> }
else { <InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou escolha um novo horário." Icon="calendar" ActionHref="/paciente/agendar" ActionLabel="Agendar" /> }
<nav class="patient-pagination" aria-label="Páginas da agenda"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy || Page == 1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy || Page * 12 >= (PageData?.TotalCount ?? 0))">Próxima</button></nav>
<AppointmentListPrint ListPath="@ReportPath" />
@code {
    private WebPage<PatientAppointment>? PageData;
    private PatientClinic? Clinic;
    private bool? PendingFilter;
    private string ReportPath="";
    private uint? SpecialtyFilter;
    private IReadOnlyList<WebSpecialty>? Specialties;
    private string View = "all", Search = "", StatusFilter = "", CategoryFilter = "", Modality = "";
    private DateTime? From=AppointmentNavigation.WeekStart(DateTime.Today), Until=AppointmentNavigation.WeekEnd(DateTime.Today);
    private ulong? AppointmentNumber;
    private int Page = 1;
    protected override async Task Load() { await LoadAppointmentViewAsync(); Specialties ??= await AppointmentFilterOptions.SpecialtiesAsync(path => Get<WebPage<WebSpecialty>>(path)); Clinic ??= await Get<PatientClinic>("api/v1/patient/experience/clinic");var path=$"api/v1/patient/experience/agenda?page={Page}&view={View}&search={Escape(Search)}&appointmentNumber={AppointmentNumber}&status={StatusFilter}&specialtyId={SpecialtyFilter}&category={CategoryFilter}&modality={Modality}&pendingPayment={PendingFilter}&from={From:yyyy-MM-dd}&until={Until:yyyy-MM-dd}";PageData = await Get<WebPage<PatientAppointment>>(path);ReportPath=path; }
    private Task Apply() => Run(async () => { Page = 1; await Load(); });
    private Task Clear() => Run(async () => { Search = StatusFilter = CategoryFilter = Modality = "";PendingFilter=null; AppointmentNumber = null; SpecialtyFilter = null; From = AppointmentNavigation.WeekStart(DateTime.Today); Until = AppointmentNavigation.WeekEnd(DateTime.Today); Page = 1; await Load(); });
    private Task Previous() => Run(async () => { Page--; await Load(); });
    private Task Next() => Run(async () => { Page++; await Load(); });
}
