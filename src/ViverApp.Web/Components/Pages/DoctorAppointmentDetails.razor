@page "/medico/atendimentos/{Id:long}"
@page "/psicologo/atendimentos/{Id:long}"
@inherits DoctorPageBase
@using static ViverApp.Web.DoctorLabels
<PageTitle>Atendimento | ViverApp</PageTitle>
<header class="workspace-heading appointment-compact-heading"><div><p class="eyebrow">Atendimento</p><h1 class="page-title">@(Detail?.Appointment.PatientName??"Detalhes do atendimento")</h1><p class="page-description">Informações, ações, laudo, anexos e feedback em um espaço protegido.</p></div><a class="button button--secondary" href="@AgendaReturn" @onclick="BackToAgenda" @onclick:preventDefault>Voltar à agenda</a></header>
@if(Notice is not null){<UiNotice Message="@Notice" IsError="NoticeError" />}
@if(Loading){<LoadingSkeleton Lines="8" />}
else if(Detail is not null){var item=Detail.Appointment;<AppointmentWorkspace PatientId="@((long)item.PatientAccountId)" PatientSaved="Load"><div class="appointment-detail-grid"><AppointmentClassificationEditor @key="item.RowVersion" AppointmentId="Id" Saved="Load" /><DoctorVisitCard Model="item" ShowDetailsLink="false" />
<section class="surface patient-panel patient-section appointment-operation-panel"><h2>Ações do atendimento</h2><div class="patient-actions">@if(item.CanJoinOnline){<a class="button" href="@ProfessionalRoot/online/@item.Id"><AppIcon Name="video" /> Entrar na chamada</a>}@if(item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed"){<a class="button button--secondary" href="@ProfessionalRoot/prontuario/@item.PatientAccountId"><AppIcon Name="file" /> Abrir prontuário</a>}@if(item.CanStart){<button class="button" @onclick="Start"><AppIcon Name="play" /> Iniciar atendimento</button>}@if(item.CanUndoStart){<button class="button button--secondary" @onclick='()=>Open("undo-start-dialog")'><AppIcon Name="history" /> Desfazer início</button>}@if(item.CanReschedule){<button class="button button--secondary" @onclick="ShowReschedule"><AppIcon Name="calendar" /> Reagendar</button>}@if(item.CanCancel){<button class="button button--danger" @onclick='()=>Open("cancel-dialog")'><AppIcon Name="close" /> Cancelar</button>}@if(item.CanComplete){<button class="button" @onclick='()=>Open("complete-dialog")'><AppIcon Name="check" /> Finalizar atendimento</button>}@if((item.StatusCode is "confirmed" or "arrived") && item.StartsAtUtc <= DateTime.UtcNow){<button class="button button--secondary" @onclick='()=>Open("no-show-dialog")'><AppIcon Name="close" /> Marcar como não compareceu</button>}</div></section>
<details class="appointment-report-expander"><summary>Laudo e anexos do atendimento</summary><AppointmentReportEditor @key="Id" AppointmentId="Id" RefreshVersion="item.RowVersion" Saved="Load" Embedded="true" /><AppointmentAttachments @key='@($"{Id}-attachments")' AppointmentId="Id" CanUpload='@(item.StatusCode is "confirmed" or "arrived" or "in_progress" or "completed")' /></details>
@if(item.StatusCode=="completed"){<OperationalReviewEditor @key='@($"{Id}-operational")' AppointmentId="Id" />}

<details class="appointment-detail-extra"><summary>Feedback do paciente</summary><section class="surface patient-panel patient-section"><h2>Feedback do paciente</h2>@if(item.Rating.HasValue){<p><strong>Nota:</strong> @item.Rating de 5</p><p>@(item.ReviewComment??"Sem comentário.")</p>}else{<p class="muted">O paciente ainda não avaliou este atendimento.</p>}<p class="field-hint">O feedback é somente leitura e não pode ser alterado pelo profissional.</p></section></details>
</div></AppointmentWorkspace>
<dialog id="cancel-dialog" class="patient-dialog"><h2>Cancelar atendimento</h2><form @onsubmit="Cancel" @onsubmit:preventDefault><div class="field"><label for="cancel-reason">Motivo</label><textarea id="cancel-reason" @bind="CancelReason" required minlength="5" maxlength="500"></textarea></div><div class="patient-actions"><button class="button button--danger">Confirmar cancelamento</button><button type="button" class="button button--secondary" @onclick='()=>Close("cancel-dialog")'>Voltar</button></div></form></dialog>
<dialog id="no-show-dialog" class="patient-dialog"><h2>Confirmar ausência do paciente?</h2><p>Marque apenas após o horário de início. O atendimento sairá da Agenda e permanecerá no histórico como “Não compareceu”.</p><div class="patient-actions"><button class="button button--danger" @onclick="NoShow">Confirmar não comparecimento</button><button class="button button--secondary" @onclick='()=>Close("no-show-dialog")'>Voltar</button></div></dialog>
<dialog id="reschedule-dialog" class="patient-dialog"><h2>Escolher novo horário</h2>@if(RescheduleOpen){<BookingAvailabilityCalendar @key="item.Id" SlotsApiPrefix="@RescheduleCalendarApi" DateSelected="SelectRescheduleDate" />}<div class="appointment-slot-grid">@foreach(var slot in Slots){<label class="appointment-slot-option"><input type="radio" name="slot" value="@slot.StartsAt.ToString("HH:mm")" checked="@(SelectedSlot==slot.StartsAt)" @onchange="()=>SelectedSlot=slot.StartsAt" /> @slot.StartsAt.ToString("HH:mm")</label>}</div><div class="field"><label for="move-reason">Motivo</label><textarea id="move-reason" @bind="MoveReason" maxlength="500"></textarea></div><div class="patient-actions"><button class="button" @onclick="Reschedule" disabled="@(!SelectedSlot.HasValue)">Reagendar</button><button class="button button--secondary" @onclick="CloseReschedule">Voltar</button></div></dialog>
<dialog id="undo-start-dialog" class="patient-dialog"><h2>Desfazer início do atendimento?</h2><p>O atendimento voltará ao estado que possuía antes de ser iniciado.</p><div class="patient-actions"><button class="button" @onclick="UndoStart">Confirmar</button><button class="button button--secondary" @onclick='()=>Close("undo-start-dialog")'>Voltar</button></div></dialog>
<dialog id="complete-dialog" class="patient-dialog"><h2>Finalizar atendimento?</h2><p>Confirme paciente, serviço e data. @(Clinical?.IsOphthalmology == true ? "O laudo oftalmológico é opcional e o conteúdo já salvo será preservado." : "O laudo é opcional; se o resumo estiver preenchido, ele será publicado junto com a conclusão.") Somente o Administrador poderá reabrir o atendimento.</p><p><strong>@item.PatientName</strong> · @item.Service · @item.StartsAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><div class="patient-actions"><button class="button" @onclick="Complete">Confirmar finalização</button><button class="button button--secondary" @onclick='()=>Close("complete-dialog")'>Voltar</button></div></dialog>
<dialog id="rectify-dialog" class="patient-dialog"><h2>Retificar laudo</h2><p>A versão anterior será preservada integralmente.</p><div class="field"><label for="rectify-reason">Motivo da retificação</label><textarea id="rectify-reason" @bind="RectifyReason" required minlength="5" maxlength="1000"></textarea></div><div class="patient-actions"><button class="button" @onclick="Rectify">Criar nova versão</button><button class="button button--secondary" @onclick='()=>Close("rectify-dialog")'>Voltar</button></div></dialog>}
@inject AppointmentNavigationStore AgendaContext

@code { [SupplyParameterFromQuery(Name="returnTo")]public string? ReturnQuery{get;set;}
private string AgendaReturn=>ProfessionalRoot + "/agenda";
private async Task BackToAgenda() { var context=await AgendaContext.RestoreAsync(ProfessionalRoot,ReturnQuery);if(context is not null)context=context with{Time=null};await AgendaContext.NavigateAsync(AgendaReturn,context); }
 [Parameter]public long Id{get;set;}private DoctorAppointmentDetail? Detail;private WebClinicalAppointment? Clinical;private string Summary="",Recommendations="",CancelReason="",MoveReason="",RectifyReason="";private DateTime NewDate=DateTime.Today.AddDays(1);private IReadOnlyList<WebAvailableSlot> Slots=[];private TimeOnly? SelectedSlot;
private bool RescheduleOpen;
private Task ShowReschedule(){RescheduleOpen=true;return Open("reschedule-dialog");}
private async Task CloseReschedule(){await Close("reschedule-dialog");RescheduleOpen=false;Slots=[];SelectedSlot=null;}
private string RescheduleCalendarApi=>$"api/v1/doctor/booking/slots?patientAccountId={Detail!.Appointment.PatientAccountId}&appointmentTypeId={ClinicalAppointmentTypeId}&modality={Detail.Appointment.ModalityCode}"+string.Concat(Detail.Appointment.Services.Where(x=>x.AppointmentTypeId!=ClinicalAppointmentTypeId).Select(x=>$"&additionalAppointmentTypeIds={x.AppointmentTypeId}"))+$"&durationMinutes={(int)(Detail.Appointment.EndsAtUtc-Detail.Appointment.StartsAtUtc).TotalMinutes}";
private void SelectRescheduleDate(BookingDaySelection selection){Slots=selection.Slots;SelectedSlot=null;if(selection.Date!=default)NewDate=selection.Date.ToDateTime(TimeOnly.MinValue);}
protected override async Task Load(){Detail=await Get<DoctorAppointmentDetail>($"api/v1/doctor/appointments/{Id}");Clinical=await Get<WebClinicalAppointment>($"api/v1/clinical/appointments/{Id}");Summary=Clinical?.MedicalReport?.ClinicalSummary??Detail?.ReportVersions.FirstOrDefault()?.ClinicalSummary??"";Recommendations=Clinical?.MedicalReport?.Recommendations??Detail?.ReportVersions.FirstOrDefault()?.Recommendations??"";}
private Task SaveDraft()=>Run(async()=>{var report=await Request<WebClinicalReport>($"api/v1/doctor/appointments/{Id}/report","PUT",new{rowVersion=Clinical?.MedicalReport?.RowVersion??0,clinicalSummary=Summary,recommendations=Recommendations});if(Clinical is not null)Clinical=Clinical with{MedicalReport=report};await Load();Notice="Laudo salvo em uma nova versão auditada.";});
private Task Start()=>Run(async()=>{await Request<object>($"api/v1/doctor/appointments/{Id}/start","POST",new{rowVersion=Detail!.Appointment.RowVersion});await Load();Notice="Atendimento iniciado.";});
private Task UndoStart()=>Run(async()=>{await Request<object>($"api/v1/doctor/appointments/{Id}/start/revert","POST",new{rowVersion=Detail!.Appointment.RowVersion});await Close("undo-start-dialog");await Load();Notice="Início desfeito; o estado anterior foi restaurado.";});
private Task Complete()=>Run(async()=>{var ophthalmology=Clinical?.IsOphthalmology==true;await Request<WebClinicalAppointment>($"api/v1/doctor/appointments/{Id}/complete","POST",new{appointmentRowVersion=Detail!.Appointment.RowVersion,reportRowVersion=ophthalmology?0:Clinical?.MedicalReport?.RowVersion??0,clinicalSummary=ophthalmology||string.IsNullOrWhiteSpace(Summary)?null:Summary,recommendations=ophthalmology?null:Recommendations});await Close("complete-dialog");await Load();Notice=ophthalmology?"Atendimento finalizado. O laudo oftalmológico salvo foi preservado.":string.IsNullOrWhiteSpace(Summary)?"Atendimento finalizado sem laudo.":"Atendimento finalizado e laudo publicado.";});
private Task NoShow()=>Run(async()=>{await Request<WebClinicalAppointment>($"api/v1/doctor/appointments/{Id}/no-show","POST",new{appointmentRowVersion=Detail!.Appointment.RowVersion});await Close("no-show-dialog");await Load();Notice="Não comparecimento registrado. O atendimento saiu da Agenda.";});
private Task Cancel()=>Run(async()=>{await Request<WebAppointment>($"api/v1/doctor/appointments/{Id}/cancel","POST",new{reason=CancelReason,rowVersion=Detail!.Appointment.RowVersion});await Close("cancel-dialog");await Load();Notice="Atendimento cancelado.";});
private uint ClinicalAppointmentTypeId=>Detail?.Appointment.AppointmentTypeId??0;
private Task Reschedule()=>Run(async()=>{await Request<WebAppointment>($"api/v1/doctor/appointments/{Id}/reschedule","POST",new{localDate=DateOnly.FromDateTime(NewDate),localStartsAt=SelectedSlot,reason=MoveReason,rowVersion=Detail!.Appointment.RowVersion},Guid.NewGuid().ToString("N"));await CloseReschedule();await Load();MoveReason="";Notice="Atendimento reagendado. A data e o histórico foram atualizados.";});
private Task Rectify()=>Run(async()=>{await Request<IReadOnlyList<DoctorReportVersion>>($"api/v1/doctor/appointments/{Id}/report/rectify","POST",new{reportRowVersion=Clinical!.MedicalReport!.RowVersion,clinicalSummary=Summary,recommendations=Recommendations,reason=RectifyReason});await Close("rectify-dialog");await Load();Notice="Nova versão publicada; o conteúdo anterior foi preservado.";});
private Task Upload()=>Run(async()=>{var result=await Module!.InvokeAsync<PatientApiResult<DoctorDocument>>("upload",Backend.BaseUrl.ToString(),$"api/v1/doctor/appointments/{Id}/documents","doctor-document","doctor-document-progress");if(!result.Ok)throw new DoctorUiException(result.Error??"Não foi possível enviar o anexo.");await Load();Notice="Anexo verificado e publicado.";});
private Task Download(DoctorDocument d)=>Run(async()=>{if(!await Module!.InvokeAsync<bool>("download",Backend.BaseUrl.ToString(),$"api/v1/doctor/documents/{d.Id}"))throw new DoctorUiException("Anexo indisponível.");});
private Task Delete(DoctorDocument d)=>Run(async()=>{await Request<object>($"api/v1/doctor/documents/{d.Id}?rowVersion={d.RowVersion}","DELETE",new{});await Load();Notice="Anexo removido.";});}
