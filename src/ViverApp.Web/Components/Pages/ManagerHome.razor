@page "/gestao"
@inherits ManagerPageBase
<PageTitle>Gestão clínica | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">@(Home is null?"Operação da clínica":$"Olá, {Home.Profile.FullName}")</h1><p class="page-description">Acompanhe o dia, pagamentos e a agenda da clínica em um só lugar.</p></div><a class="button button--secondary" href="/gestao/perfil">Meu perfil</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="6" />}
else if(Home is not null){
<section class="surface patient-panel manager-welcome"><p class="eyebrow">Hoje</p><h2>Visão operacional</h2><p>Os indicadores são calculados no servidor e refletem toda a clínica.</p></section>
<div class="mobile-metric-flow"><section class="manager-kpis" aria-label="Indicadores de hoje"><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("today")'><strong>@Home.Counters.Today</strong><span>Atendimentos</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("doctors")'><strong>@Home.Counters.Doctors</strong><span>Médicos do dia</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("paid")'><strong>@Home.Counters.Paid</strong><span>Pagos</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("pending")'><strong>@Home.Counters.PendingPayment</strong><span>Pagamento pendente</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("online")'><strong>@Home.Counters.Online</strong><span>Online</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>Select("in_person")'><strong>@Home.Counters.InPerson</strong><span>Presenciais</span></button></section>
<MetricEvidenceDrilldown Title="@MetricTitle" Items="@MetricItems" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Agenda geral</p><h2>Atendimentos de hoje</h2></div><a href="/gestao/agenda">Ver agenda completa →</a></div>@if(Home.Today.Count>0){<AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in Home.Today){<ManagerVisitCard Model="item" />}</div>}else{<InterfaceState Title="Agenda livre hoje" Description="Nenhum atendimento foi encontrado para esta data." Icon="calendar" />}</section>
<nav class="patient-actions" aria-label="Atalhos"><a class="button" href="/gestao/agenda">Agenda</a><a class="button button--secondary" href="/gestao/pacientes">Pacientes</a><a class="button button--secondary" href="/gestao/historico">Histórico</a><a class="button button--secondary" href="/gestao/premium">Análises Premium</a></nav>}
@code { private ManagerHomeData? Home;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "today" or "doctors"?2:SelectedMetric is "paid" or "pending"?4:6;protected override async Task Load()=>Home=await Get<ManagerHomeData>("api/v1/manager/home");private void Select(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"today"=>"Atendimentos de hoje","doctors"=>"Médicos com agenda hoje","paid"=>"Atendimentos pagos","pending"=>"Pagamentos pendentes","online"=>"Atendimentos online","in_person"=>"Atendimentos presenciais",_=>"Detalhamento"};private IReadOnlyList<string>? MetricItems=>SelectedMetric switch{"today"=>Appointments(Home?.Sources.Today),"doctors"=>Home?.Sources.Doctors,"paid"=>Appointments(Home?.Sources.Paid),"pending"=>Appointments(Home?.Sources.PendingPayment),"online"=>Appointments(Home?.Sources.Online),"in_person"=>Appointments(Home?.Sources.InPerson),_=>null};private static IReadOnlyList<string>? Appointments(IReadOnlyList<ulong>? values)=>values?.Select(x=>$"Atendimento #{x}").ToArray(); }
