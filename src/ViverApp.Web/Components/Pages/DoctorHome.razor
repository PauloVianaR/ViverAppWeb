@page "/medico"
@inherits DoctorPageBase
<PageTitle>Rotina profissional | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Área médica</p><h1 class="page-title">@(Home is null?"Sua rotina clínica":$"Olá, {DisplayName(Home.Profile)}")</h1><p class="page-description">Agenda do dia, indicadores e atalhos para conduzir seus atendimentos.</p></div><a class="button button--secondary" href="/medico/perfil">Meu perfil</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
@if(Loading){<LoadingSkeleton Lines="6" />}
else if(Home is not null){
<section class="surface patient-panel doctor-summary"><p class="eyebrow">Perfil profissional</p><h2>@DisplayName(Home.Profile)</h2><p>CRM @Home.Profile.LicenseStateCode @Home.Profile.LicenseNumber · @(Home.Profile.Specialties.FirstOrDefault(x=>x.IsPrimary)?.Name??"Especialidade não definida") · @Home.Profile.YearsExperience anos de experiência</p><p>@(Home.Profile.AverageRating.HasValue?$"★ {Home.Profile.AverageRating:0.0} em {Home.Profile.ReviewCount} avaliações":"Ainda sem avaliações")</p></section>
<div class="mobile-metric-flow"><section class="doctor-kpis" aria-label="Indicadores da agenda"><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>Select("today")'><strong>@Home.Counters.Today</strong><span>Hoje</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>Select("week")'><strong>@Home.Counters.Week</strong><span>Próximos 7 dias</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>Select("online")'><strong>@Home.Counters.Online</strong><span>Online</span></button><button type="button" class="surface doctor-kpi metric-card" @onclick='()=>Select("in_person")'><strong>@Home.Counters.InPerson</strong><span>Presenciais</span></button></section>
<MetricEvidenceDrilldown Title="@MetricTitle" Items="@MetricItems" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>
<section class="patient-section"><div class="section-heading"><div><p class="eyebrow">Agenda do dia</p><h2>Próximos atendimentos</h2></div><a href="/medico/agenda">Ver agenda completa →</a></div>
@if(Home.Today.Count>0){<div class="patient-grid">@foreach(var item in Home.Today){<DoctorVisitCard Model="item" />}</div>}else{<InterfaceState Title="Agenda livre hoje" Description="Nenhum atendimento foi encontrado para o restante do dia." Icon="calendar" />}</section>
<nav class="patient-actions" aria-label="Atalhos"><a class="button" href="/medico/agenda">Agenda</a><a class="button button--secondary" href="/medico/pacientes">Pacientes</a><a class="button button--secondary" href="/medico/historico">Histórico</a><a class="button button--secondary" href="/medico/perfil#disponibilidade">Disponibilidade</a></nav>}
@code { private DoctorHomeData? Home;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "today" or "week"?2:4;protected override async Task Load()=>Home=await Get<DoctorHomeData>("api/v1/doctor/home");private static string DisplayName(DoctorProfileData profile)=>profile.FullName.StartsWith(profile.ProfessionalTitle+" ",StringComparison.OrdinalIgnoreCase)?profile.FullName:$"{profile.ProfessionalTitle} {profile.FullName}";private void Select(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"today"=>"Atendimentos de hoje","week"=>"Atendimentos dos próximos 7 dias","online"=>"Atendimentos online","in_person"=>"Atendimentos presenciais",_=>"Detalhamento"};private IReadOnlyList<string>? MetricItems=>SelectedMetric switch{"today"=>Appointments(Home?.Sources.Today),"week"=>Appointments(Home?.Sources.Week),"online"=>Appointments(Home?.Sources.Online),"in_person"=>Appointments(Home?.Sources.InPerson),_=>null};private static IReadOnlyList<string>? Appointments(IReadOnlyList<ulong>? values)=>values?.Select(x=>$"Atendimento #{x}").ToArray(); }
