@page "/gestao/caixa"
@page "/administracao/caixa"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Caixa | ViverApp</PageTitle>
<header class="workspace-heading cash-no-print"><div><p class="eyebrow">@(IsAdministrator?"Administrador":"Gestor")</p><h1 class="page-title">Caixa da clínica</h1><p class="page-description">Movimentações diárias, totais por forma de pagamento e fechamento auditável.</p></div>@if(Data?.Closure is not null){<span class="badge">Fechado por @Data.Closure.ResponsibleName</span>}</header>
@if(Notice is not null){<p class="notice @(NoticeError?"notice--error":"notice--success") cash-no-print" role="alert">@Notice</p>}
<section class="surface patient-panel cash-no-print"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="manager-filter-grid">
<div class="field"><label for="cash-date">Data do caixa</label><input id="cash-date" type="date" @bind="Date" /></div>
<div class="field"><label for="cash-method">Forma</label><select id="cash-method" @bind="MethodFilter"><option value="">Todas</option>@foreach(var value in Methods){<option value="@value">@CashMethod(value)</option>}</select></div>
<div class="field"><label for="cash-type">Movimento</label><select id="cash-type" @bind="TypeFilter"><option value="">Todos</option>@foreach(var value in Types){<option value="@value">@CashType(value)</option>}</select></div>
<div class="field"><label for="cash-number">Atendimento</label><input id="cash-number" type="number" min="100" @bind="AppointmentNumber" /></div>
<div class="field"><label for="cash-patient">Paciente</label><input id="cash-patient" maxlength="120" @bind="Patient" /></div>
<div class="field"><label for="cash-responsible">Responsável</label><input id="cash-responsible" maxlength="120" @bind="Responsible" /></div>
<div class="field"><label for="cash-card-last-four">Final do cartão</label><input id="cash-card-last-four" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4 dígitos" @bind="CardLastFourFilter" /></div>
<div class="field"><label for="cash-authorization">Nº da autorização</label><input id="cash-authorization" maxlength="100" @bind="AuthorizationFilter" /></div>
</div><div class="patient-actions"><button class="button">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Today">Hoje</button><button type="button" class="button button--secondary" @onclick="PreviousDay">Dia anterior</button><button type="button" class="button button--secondary" @onclick="NextDay">Dia seguinte</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Loading){<LoadingSkeleton Lines="8"/>}else if(Data is not null){
<section class="cash-summary" aria-label="Totais do caixa"><article class="surface manager-kpi"><span>Entradas de pagamentos</span><strong>@Money(Data.Summary.GrossEntries)</strong></article><article class="surface manager-kpi"><span>Reversões</span><strong>@Money(Data.Summary.PaymentReversals)</strong></article><article class="surface manager-kpi"><span>Suprimentos</span><strong>@Money(Data.Summary.Supplies)</strong></article><article class="surface manager-kpi"><span>Sangrias</span><strong>@Money(Data.Summary.Withdrawals)</strong></article><article class="surface manager-kpi"><span>Líquido</span><strong>@Money(Data.Summary.NetTotal)</strong></article></section>
<section class="surface patient-panel cash-no-print"><div class="section-heading"><div><p class="eyebrow">Operação</p><h2>Movimentações</h2></div><div class="patient-actions"><button class="button button--secondary" @onclick='()=>Open("cash-movement")'>Nova entrada/saída</button>@if(Data.Closure is null && !HasFilters){<button class="button" @onclick='()=>Open("cash-close")'>Fechar o dia</button>}</div></div>
@if(Data.Page.Items.Count==0){<InterfaceState Title="Nenhuma movimentação" Description="Não há fatos financeiros para os filtros deste dia." Icon="card"/>}else{<div class="cash-table-wrap"><table class="cash-table"><thead><tr><th>Horário</th><th>Descrição</th><th>Observação</th><th>Forma</th><th>Responsável</th><th>Valor</th></tr></thead><tbody>@foreach(var item in Data.Page.Items){<tr class="@(item.AfterClosure?"cash-after-close":null)"><td>@item.OccurredAtUtc.ToLocalTime().ToString("HH:mm")</td><td><strong>@CashType(item.TypeCode)</strong><br/><span>@item.Description</span>@if(item.RelatedMovementId.HasValue){<small>Vinculado ao movimento #@item.RelatedMovementId</small>}</td><td>@Observation(item)@if(item.AppointmentNumber.HasValue&&!string.IsNullOrWhiteSpace(item.PatientName)){<small>@item.PatientName</small>}</td><td>@CashMethod(item.MethodCode)@if(HasCardDetails(item)){<span class="cash-card-help" tabindex="0" aria-label="@CardDetails(item)" data-tooltip="@CardDetails(item)">?</span>}</td><td>@(item.ResponsibleName??"Automático")</td><td class="@(item.DirectionCode=="entry"?"cash-entry":"cash-outflow")">@(item.DirectionCode=="entry"?"+":"−") @Money(item.Amount)</td></tr>}</tbody></table></div>}
<nav class="patient-pagination" aria-label="Paginação"><button class="button button--secondary" @onclick="PreviousPage" disabled="@(Page==1)">Anterior</button><span>Página @Page · @Data.Page.TotalCount movimento(s)</span><button class="button button--secondary" @onclick="NextPage" disabled="@(Page*25>=Data.Page.TotalCount)">Próxima</button></nav></section>
<section class="surface patient-panel cash-print-area"><div class="section-heading"><div><p class="eyebrow">Totais por forma</p><h2>@Date.ToString("dd/MM/yyyy")</h2></div><span>@Data.Summary.MovementCount movimento(s)</span></div><div class="cash-method-grid">@foreach(var item in Data.Summary.ByMethod){<article><strong>@CashMethod(item.MethodCode)</strong><span>Entradas @Money(item.Entries)</span><span>Saídas @Money(item.Outflows)</span><b>Líquido @Money(item.Net)</b></article>}</div>@if(Data.Summary.ByMethod.Count==0){<p class="muted">Sem totais para exibir.</p>}</section>
<div class="patient-actions cash-no-print"><button class="button" @onclick="()=>Print(false)">Imprimir</button><button class="button button--secondary" @onclick="()=>Print(true)">Imprimir Totais</button></div>
@if(PrintData is not null){
<section class="cash-print-document @(PrintData.TotalsOnly?"cash-print-document--totals":"cash-print-document--movements")">
    <header class="cash-print-header">
        <div class="cash-print-brand"><img src="/images/logo.png" alt="ViverApp"/><div><strong>ViverApp</strong><span>@PrintData.ClinicName</span></div></div>
        <div class="cash-print-title"><p>@(PrintData.TotalsOnly?"Resumo financeiro":"Relatório financeiro")</p><h1>Fechamento diário do caixa</h1></div>
    </header>
    <div class="cash-print-metadata">
        <div><span>Data do caixa</span><strong>@PrintData.OperationalDate.ToString("dd/MM/yyyy")</strong></div>
        <div><span>Emitido em</span><strong>@PrintData.IssuedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        <div><span>Responsável</span><strong>@PrintData.IssuedBy</strong></div>
        <div><span>Situação</span><strong>@(PrintData.Closure is null?"Caixa aberto":$"Fechado por {PrintData.Closure.ResponsibleName}")</strong></div>
    </div>
    @if(!string.IsNullOrWhiteSpace(PrintData.FilterDescription)){<p class="cash-print-filter"><strong>Recorte:</strong> @PrintData.FilterDescription</p>}
    @if(!PrintData.TotalsOnly){
        <section class="cash-print-section">
            <div class="cash-print-section-title"><h2>Movimentações do dia</h2><span>@PrintData.Movements.Count registro(s)</span></div>
            @if(PrintData.Movements.Count==0){<p class="cash-print-empty">Nenhuma movimentação compõe este relatório.</p>}else{
            <table class="cash-print-table">
                <thead><tr><th>Hora</th><th>Descrição</th><th>Observação</th><th>Forma</th><th>Responsável</th><th class="cash-print-number">Entrada</th><th class="cash-print-number">Saída</th></tr></thead>
                <tbody>@foreach(var item in PrintData.Movements){<tr><td>@item.OccurredAtUtc.ToLocalTime().ToString("HH:mm")</td><td><strong>@CashType(item.TypeCode)</strong><small>@item.Description</small>@if(item.RelatedMovementId.HasValue){<small>Relacionado ao movimento #@item.RelatedMovementId</small>}</td><td>@Observation(item)@if(item.AppointmentNumber.HasValue&&!string.IsNullOrWhiteSpace(item.PatientName)){<small>@item.PatientName</small>}</td><td>@CashMethod(item.MethodCode)</td><td>@(item.ResponsibleName??"Automático")</td><td class="cash-print-number cash-print-positive">@(item.DirectionCode=="entry"?Money(item.Amount):"—")</td><td class="cash-print-number cash-print-negative">@(item.DirectionCode=="outflow"?Money(item.Amount):"—")</td></tr>}</tbody>
            </table>}
        </section>
    }
    <section class="cash-print-section cash-print-summary-section">
            <div class="cash-print-section-title"><h2>Totais por forma de pagamento</h2><span>@PrintData.Summary.MovementCount movimento(s)</span></div>
            <div class="cash-print-summary-layout">
                <div class="cash-print-methods">
                    @foreach(var item in PrintData.Summary.ByMethod){<article><strong>@CashMethod(item.MethodCode)</strong><span>Entradas <b>@Money(item.Entries)</b></span><span>Saídas <b>@Money(item.Outflows)</b></span><span class="cash-print-method-net">Líquido <b>@Money(item.Net)</b></span></article>}
                    @if(PrintData.Summary.ByMethod.Count==0){<p class="cash-print-empty">Sem totais por forma de pagamento.</p>}
                </div>
                <aside class="cash-print-grand-total">
                    <div><span>Entradas</span><strong>@Money(PrintData.Summary.ByMethod.Sum(item=>item.Entries))</strong></div>
                    <div><span>Saídas e estornos</span><strong>@Money(PrintData.Summary.ByMethod.Sum(item=>item.Outflows))</strong></div>
                    <div class="cash-print-balance"><span>Saldo líquido</span><strong>@Money(PrintData.Summary.NetTotal)</strong></div>
                </aside>
            </div>
    </section>
</section>}
<dialog id="cash-movement"><h2>Nova movimentação manual</h2><div class="field"><label for="movement-type">Tipo</label><select id="movement-type" @bind="ManualType"><option value="supply">Suprimento</option><option value="withdrawal">Sangria</option><option value="adjustment">Ajuste corretivo</option></select></div><div class="field"><label for="movement-direction">Direção</label><select id="movement-direction" @bind="ManualDirection" disabled="@(ManualType!="adjustment")"><option value="entry">Entrada</option><option value="outflow">Saída</option></select></div><div class="field"><label for="movement-method">Forma</label><select id="movement-method" @bind="ManualMethod">@foreach(var value in Methods){<option value="@value">@CashMethod(value)</option>}</select></div><div class="field"><label for="movement-amount">Valor</label><input id="movement-amount" type="number" min="0.01" step="0.01" @bind="ManualAmount"/></div>@if(ManualType=="adjustment"){<div class="field"><label for="movement-related">Número do movimento compensado</label><input id="movement-related" type="number" min="1" @bind="ManualRelatedMovementId"/></div>}<div class="field"><label for="movement-reason">Motivo</label><textarea id="movement-reason" minlength="5" maxlength="500" @bind="ManualReason"></textarea></div><div class="patient-actions"><button class="button" @onclick="AddMovement">Registrar</button><button class="button button--secondary" @onclick='()=>Close("cash-movement")'>Voltar</button></div></dialog>
<dialog id="cash-close"><h2>Fechar caixa de @Date.ToString("dd/MM/yyyy")</h2><p>O resumo será imutável. Movimentações administrativas posteriores continuarão visíveis como pós-fechamento.</p><div class="patient-actions"><button class="button" @onclick="CloseDay">Confirmar fechamento</button><button class="button button--secondary" @onclick='()=>Close("cash-close")'>Voltar</button></div></dialog>}
@code{
private CashDay? Data;private CashPrint? PrintData;private DateTime Date=DateTime.Today;private string MethodFilter="",TypeFilter="",Patient="",Responsible="",CardLastFourFilter="",AuthorizationFilter="";private ulong? AppointmentNumber;private int Page=1;private string manualType="supply",ManualDirection="entry",ManualMethod="cash",ManualReason="";private string ManualType{get=>manualType;set{manualType=value;ManualDirection=value switch{"supply"=>"entry","withdrawal"=>"outflow",_=>ManualDirection};}}private decimal ManualAmount;private ulong? ManualRelatedMovementId;private bool IsAdministrator=>new Uri(Navigation.Uri).AbsolutePath.StartsWith("/administracao",StringComparison.OrdinalIgnoreCase);private bool HasFilters=>!string.IsNullOrEmpty(MethodFilter)||!string.IsNullOrEmpty(TypeFilter)||AppointmentNumber.HasValue||!string.IsNullOrWhiteSpace(Patient)||!string.IsNullOrWhiteSpace(Responsible)||!string.IsNullOrWhiteSpace(CardLastFourFilter)||!string.IsNullOrWhiteSpace(AuthorizationFilter);private static readonly string[] Methods=["cash","pix","debit_card","credit_card","pagbank_online","other"];private static readonly string[] Types=["payment_received","payment_reversal","supply","withdrawal","adjustment","provider_fee"];
private static string CashMethod(string code)=>CashLabels.Method(code);private static string CashType(string code)=>CashLabels.Type(code);private static string Observation(CashMovement item)=>item.AppointmentNumber.HasValue?$"Atendimento #{item.AppointmentNumber}":string.IsNullOrWhiteSpace(item.Reason)?"—":$"Motivo: {item.Reason}";private static bool HasCardDetails(CashMovement item)=>!string.IsNullOrWhiteSpace(item.CardLastFour)||!string.IsNullOrWhiteSpace(item.AuthorizationReference);private static string CardDetails(CashMovement item)=>string.Join(" · ",new[]{string.IsNullOrWhiteSpace(item.CardLastFour)?null:$"Final •••• {item.CardLastFour}",string.IsNullOrWhiteSpace(item.AuthorizationReference)?null:$"Autorização {item.AuthorizationReference}"}.Where(value=>value is not null));
protected override async Task Load(){var path=$"api/v1/management/cash?date={Date:yyyy-MM-dd}&method={MethodFilter}&type={TypeFilter}&appointmentNumber={AppointmentNumber}&patient={Escape(Patient)}&responsible={Escape(Responsible)}&cardLastFour={Escape(CardLastFourFilter)}&authorizationReference={Escape(AuthorizationFilter)}&page={Page}&pageSize=25";Data=await Get<CashDay>(path);}
private Task Apply()=>Run(async()=>{Page=1;PrintData=null;await Load();});private Task Clear()=>Run(async()=>{MethodFilter=TypeFilter=Patient=Responsible=CardLastFourFilter=AuthorizationFilter="";AppointmentNumber=null;Page=1;PrintData=null;await Load();});private Task Today()=>MoveDate(DateTime.Today);private Task PreviousDay()=>MoveDate(Date.AddDays(-1));private Task NextDay()=>MoveDate(Date.AddDays(1));private Task MoveDate(DateTime value)=>Run(async()=>{Date=value;Page=1;PrintData=null;await Load();});private Task PreviousPage()=>Run(async()=>{Page--;await Load();});private Task NextPage()=>Run(async()=>{Page++;await Load();});
private Task AddMovement()=>Run(async()=>{var direction=ManualType=="supply"?"entry":ManualType=="withdrawal"?"outflow":ManualDirection;await Request<CashMovement>("api/v1/management/cash/movements","POST",new{typeCode=ManualType,directionCode=direction,methodCode=ManualMethod,amount=ManualAmount,relatedMovementId=ManualType=="adjustment"?ManualRelatedMovementId:null,reason=ManualReason},Guid.NewGuid().ToString("N"));await Close("cash-movement");await Load();Notice="Movimentação registrada sem alterar fatos anteriores.";});
private Task CloseDay()=>Run(async()=>{await Request<CashClosure>($"api/v1/management/cash/{Date:yyyy-MM-dd}/closure","POST",new{expectedLastMovementId=Data!.LastMovementId});await Close("cash-close");await Load();Notice="Caixa fechado com resumo imutável.";});
private Task Print(bool totalsOnly)=>Run(async()=>{var path=$"api/v1/management/cash/print?date={Date:yyyy-MM-dd}&totalsOnly={totalsOnly.ToString().ToLowerInvariant()}&method={MethodFilter}&type={TypeFilter}&appointmentNumber={AppointmentNumber}&patient={Escape(Patient)}&responsible={Escape(Responsible)}&cardLastFour={Escape(CardLastFourFilter)}&authorizationReference={Escape(AuthorizationFilter)}";PrintData=await Get<CashPrint>(path);StateHasChanged();await Task.Yield();await JavaScript.InvokeVoidAsync("print");});}
