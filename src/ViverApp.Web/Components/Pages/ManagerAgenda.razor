@page "/gestao/atendimentos"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>Atendimentos | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">Atendimentos</h1><p class="page-description">Consulte estados, finanças e metadados clínicos sem abrir conteúdo reservado.</p></div><a class="button" href="/gestao/agendar">Agendar para paciente</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<AppointmentStatusLegend />
<MobileFilterPanel AriaLabel="Filtros da agenda da clínica"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="manager-filter-grid">
<div class="field"><label for="manager-search">Paciente, profissional ou serviço</label><input id="manager-search" @bind="Search" maxlength="120" /></div>
<div class="field"><label for="manager-number">Número do atendimento</label><input id="manager-number" type="number" min="100" @bind="AppointmentNumber" @bind:event="oninput" /></div>
<div class="field"><label for="manager-from">De</label><input id="manager-from" type="date" @bind="From" /></div><div class="field"><label for="manager-to">Até</label><input id="manager-to" type="date" @bind="To" /></div>
<div class="field"><label for="manager-time-from">Horário inicial</label><input id="manager-time-from" type="time" @bind="StartTime" /></div><div class="field"><label for="manager-time-to">Horário final</label><input id="manager-time-to" type="time" @bind="EndTime" /></div>
<div class="field"><label for="manager-status">Estado</label><select id="manager-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var s in Statuses){<option value="@s">@Status(s)</option>}</select></div>
<div class="field"><label for="manager-category">Tipo</label><select id="manager-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option><option value="procedure">Procedimento</option></select></div>
<div class="field"><label for="manager-modality">Modalidade</label><select id="manager-modality" @bind="ModalityFilter"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div>
<div class="field"><label for="manager-doctor">Profissional</label><select id="manager-doctor" @bind="DoctorFilter"><option value="0">Todos</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName</option>}</select></div>
<div class="field"><label for="manager-payment">Pagamento</label><select id="manager-payment" @bind="PaymentFilter"><option value="">Todos</option><option value="paid">Pago</option><option value="pending">Pendente</option></select></div>
<div class="field"><label for="manager-sort">Ordenar</label><select id="manager-sort" @bind="Sort"><option value="date_asc">Data crescente</option><option value="date_desc">Data decrescente</option><option value="patient">Paciente</option><option value="doctor">Profissional</option></select></div></div>
<div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></MobileFilterPanel>
@if(Data is not null){<div class="mobile-metric-flow"><section class="manager-kpis"><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("total")'><strong>@Data.Counters.Total</strong><span>Total filtrado</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("online")'><strong>@Data.Counters.Online</strong><span>Online</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("in_person")'><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("rescheduled")'><strong>@Data.Counters.Rescheduled</strong><span>Reagendados</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("paid")'><strong>@Data.Counters.Paid</strong><span>Pagos</span></button><button type="button" class="surface manager-kpi metric-card" @onclick='()=>ShowMetric("pending")'><strong>@Data.Counters.PendingPayment</strong><span>Pendentes</span></button></section><AppointmentMetricDrilldown Title="@MetricTitle" Numbers="@MetricNumbers" MobileAfterCard="@MobileMetricAfterCard" Close="()=>SelectedMetric=null" /></div>}
@if(Loading){<LoadingSkeleton Lines="7" />}else if(Data?.Page.Items.Count>0){<div class="appointment-results-heading"><p class="muted" role="status">@Data.Page.TotalCount atendimento(s) encontrado(s).</p><AppointmentViewToggle Mode="AppointmentViewMode" Changed="ChangeAppointmentView" Disabled="Busy" /></div><div class="patient-grid appointment-results--@AppointmentViewMode">@foreach(var item in Data.Page.Items){<ManagerVisitCard Model="item" RegisterArrival="RegisterArrival" />}</div>}else{<InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou o período consultado." Icon="calendar" />}
<nav class="patient-pagination" aria-label="Paginação"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy||Page==1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))">Próxima</button></nav>
@code { private ManagerAgendaData? Data;private IReadOnlyList<ManagerDoctor> Doctors=[];private DateTime From=DateTime.Today,To=DateTime.Today;private TimeOnly? StartTime,EndTime;private string Search="",StatusFilter="",CategoryFilter="",ModalityFilter="",PaymentFilter="",Sort="date_desc";private ulong DoctorFilter;private ulong? AppointmentNumber;private int Page=1;private string? SelectedMetric;private int MobileMetricAfterCard=>SelectedMetric is "total" or "online"?2:SelectedMetric is "in_person" or "rescheduled"?4:6;private static readonly string[] Statuses=["pending","confirmed","arrived","in_progress","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){await LoadAppointmentViewAsync();if(Doctors.Count==0)Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/manager/doctors")??[];var times=StartTime.HasValue?$"&startTime={StartTime:HH\\:mm}&endTime={EndTime:HH\\:mm}":"";Data=await Get<ManagerAgendaData>($"api/v1/manager/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&modality={ModalityFilter}&category={CategoryFilter}&doctorAccountId={(DoctorFilter==0?"":DoctorFilter)}&appointmentNumber={AppointmentNumber}&payment={PaymentFilter}&search={Escape(Search)}&sort={Sort}&page={Page}&pageSize=12{times}");}
private Task Apply()=>Run(async()=>{Page=1;SelectedMetric=null;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=CategoryFilter=ModalityFilter=PaymentFilter="";DoctorFilter=0;AppointmentNumber=null;StartTime=EndTime=null;From=To=DateTime.Today;Sort="date_desc";Page=1;SelectedMetric=null;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});
private void ShowMetric(string value)=>SelectedMetric=SelectedMetric==value?null:value;private string MetricTitle=>SelectedMetric switch{"total"=>"Total filtrado","online"=>"Atendimentos online","in_person"=>"Atendimentos presenciais","rescheduled"=>"Atendimentos reagendados","paid"=>"Atendimentos pagos","pending"=>"Pagamentos pendentes",_=>"Detalhamento"};private IReadOnlyList<ulong>? MetricNumbers=>SelectedMetric switch{"total"=>Data?.Sources.Total,"online"=>Data?.Sources.Online,"in_person"=>Data?.Sources.InPerson,"rescheduled"=>Data?.Sources.Rescheduled,"paid"=>Data?.Sources.Paid,"pending"=>Data?.Sources.PendingPayment,_=>null};
private Task RegisterArrival(ManagerAppointment item)=>Run(async()=>{await Request<object>($"api/v1/manager/appointments/{item.Id}/arrival","POST",new{rowVersion=item.RowVersion});Notice=$"Chegada registrada. Senha atribuída ao atendimento {item.AppointmentNumber}.";await Load();});}
