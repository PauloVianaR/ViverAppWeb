@page "/gestao/agenda"
@page "/gestao/historico"
@inherits ManagerPageBase
@using static ViverApp.Web.ManagerLabels
<PageTitle>@(History?"Histórico":"Agenda") | ViverApp</PageTitle>
<header class="workspace-heading"><div><p class="eyebrow">Gestor</p><h1 class="page-title">@(History?"Histórico dos atendimentos":"Agenda da clínica")</h1><p class="page-description">@(History?"Consulte estados, finanças e metadados clínicos sem abrir conteúdo reservado.":"Filtre e opere os atendimentos de toda a clínica.")</p></div><a class="button" href="/gestao/pacientes">Agendar para paciente</a></header>
@if(Notice is not null){<p class="notice notice--error" role="alert">@Notice</p>}
<section class="surface patient-panel"><form @onsubmit="Apply" @onsubmit:preventDefault><div class="manager-filter-grid">
<div class="field"><label for="manager-search">Paciente, médico ou serviço</label><input id="manager-search" @bind="Search" maxlength="120" /></div>
<div class="field"><label for="manager-from">De</label><input id="manager-from" type="date" @bind="From" /></div><div class="field"><label for="manager-to">Até</label><input id="manager-to" type="date" @bind="To" /></div>
<div class="field"><label for="manager-time-from">Horário inicial</label><input id="manager-time-from" type="time" @bind="StartTime" /></div><div class="field"><label for="manager-time-to">Horário final</label><input id="manager-time-to" type="time" @bind="EndTime" /></div>
<div class="field"><label for="manager-status">Estado</label><select id="manager-status" @bind="StatusFilter"><option value="">Todos</option>@foreach(var s in Statuses){<option value="@s">@Status(s)</option>}</select></div>
<div class="field"><label for="manager-category">Tipo</label><select id="manager-category" @bind="CategoryFilter"><option value="">Todos</option><option value="consultation">Consulta</option><option value="examination">Exame</option><option value="surgery">Cirurgia</option></select></div>
<div class="field"><label for="manager-modality">Modalidade</label><select id="manager-modality" @bind="ModalityFilter"><option value="">Todas</option><option value="online">Online</option><option value="in_person">Presencial</option></select></div>
<div class="field"><label for="manager-doctor">Médico</label><select id="manager-doctor" @bind="DoctorFilter"><option value="0">Todos</option>@foreach(var doctor in Doctors){<option value="@doctor.AccountId">@doctor.FullName</option>}</select></div>
<div class="field"><label for="manager-payment">Pagamento</label><select id="manager-payment" @bind="PaymentFilter"><option value="">Todos</option><option value="paid">Pago</option><option value="pending">Pendente</option></select></div>
<div class="field"><label for="manager-sort">Ordenar</label><select id="manager-sort" @bind="Sort"><option value="date_asc">Data crescente</option><option value="date_desc">Data decrescente</option><option value="patient">Paciente</option><option value="doctor">Médico</option></select></div></div>
<div class="patient-actions"><button class="button" disabled="@Busy">Aplicar filtros</button><button type="button" class="button button--secondary" @onclick="Clear">Limpar</button></div></form></section>
@if(Data is not null){<section class="manager-kpis"><article class="surface manager-kpi"><strong>@Data.Counters.Total</strong><span>Total filtrado</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Online</strong><span>Online</span></article><article class="surface manager-kpi"><strong>@Data.Counters.InPerson</strong><span>Presenciais</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Rescheduled</strong><span>Reagendados</span></article><article class="surface manager-kpi"><strong>@Data.Counters.Paid</strong><span>Pagos</span></article><article class="surface manager-kpi"><strong>@Data.Counters.PendingPayment</strong><span>Pendentes</span></article></section>}
@if(Loading){<LoadingSkeleton Lines="7" />}else if(Data?.Page.Items.Count>0){<p class="muted" role="status">@Data.Page.TotalCount atendimento(s) encontrado(s).</p><div class="patient-grid">@foreach(var item in Data.Page.Items){<ManagerVisitCard Model="item" />}</div>}else{<InterfaceState Title="Nenhum atendimento encontrado" Description="Altere os filtros ou o período consultado." Icon="calendar" />}
<nav class="patient-pagination" aria-label="Paginação"><button class="button button--secondary" @onclick="Previous" disabled="@(Busy||Page==1)">Anterior</button><span>Página @Page</span><button class="button button--secondary" @onclick="Next" disabled="@(Busy||Page*12>=(Data?.Page.TotalCount??0))">Próxima</button></nav>
@code { private ManagerAgendaData? Data;private IReadOnlyList<ManagerDoctor> Doctors=[];private bool History=>new Uri(Navigation.Uri).AbsolutePath.EndsWith("/historico",StringComparison.OrdinalIgnoreCase);private DateTime From=DateTime.Today,To=DateTime.Today.AddDays(30);private TimeOnly? StartTime,EndTime;private string Search="",StatusFilter="",CategoryFilter="",ModalityFilter="",PaymentFilter="",Sort="date_asc";private ulong DoctorFilter;private int Page=1;private bool initialized;private static readonly string[] Statuses=["pending","confirmed","completed","canceled","rescheduled","no_show"];
protected override async Task Load(){if(!initialized){if(History){From=DateTime.Today.AddYears(-1);To=DateTime.Today;Sort="date_desc";}initialized=true;}Doctors=await Get<IReadOnlyList<ManagerDoctor>>("api/v1/manager/doctors")??[];var times=StartTime.HasValue?$"&startTime={StartTime:HH\\:mm}&endTime={EndTime:HH\\:mm}":"";Data=await Get<ManagerAgendaData>($"api/v1/manager/agenda?from={From:yyyy-MM-dd}&to={To:yyyy-MM-dd}&status={StatusFilter}&modality={ModalityFilter}&category={CategoryFilter}&doctorAccountId={(DoctorFilter==0?"":DoctorFilter)}&payment={PaymentFilter}&search={Escape(Search)}&sort={Sort}&page={Page}&pageSize=12{times}");}
private Task Apply()=>Run(async()=>{Page=1;await Load();});private Task Clear()=>Run(async()=>{Search=StatusFilter=CategoryFilter=ModalityFilter=PaymentFilter="";DoctorFilter=0;StartTime=EndTime=null;From=History?DateTime.Today.AddYears(-1):DateTime.Today;To=History?DateTime.Today:DateTime.Today.AddDays(30);Sort=History?"date_desc":"date_asc";Page=1;await Load();});private Task Previous()=>Run(async()=>{Page--;await Load();});private Task Next()=>Run(async()=>{Page++;await Load();});}
