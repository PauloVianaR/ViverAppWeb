@page "/seguranca"
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject WebBackendOptions Backend
@inject NavigationManager Navigation
@inject UiErrorNotifier Errors

<PageTitle>Segurança da conta | ViverApp</PageTitle>

<header class="workspace-heading"><div><p class="eyebrow">Conta</p><h1 class="page-title">Segurança e sessões</h1><p class="page-description">Revise onde sua conta está conectada e gerencie suas formas de acesso.</p></div><span class="badge badge--success">Sessão verificada</span></header>
@if (!string.IsNullOrWhiteSpace(Notice)) { <div class="notice @(NoticeIsError ? "notice--error" : "notice--success")" role="@(NoticeIsError ? "alert" : "status")">@Notice</div> }

<div class="security-grid">
    <section class="surface security-panel" aria-labelledby="methods-title">
        <h2 id="methods-title">Métodos de acesso</h2>
        <div class="security-method"><div><strong>Senha</strong><span>Altere sua senha em uma sessão recente.</span></div><PasswordChangeButton /></div>
        <div class="security-method"><div><strong>Google</strong><span>Vincule somente após entrar com um método já confirmado.</span></div><a class="button button--secondary button--small" href="@Backend.GoogleLinkUrl">Vincular Google</a></div>
    </section>
    <section class="surface security-panel" aria-labelledby="sessions-title">
        <div class="security-heading"><h2 id="sessions-title">Sessões ativas</h2><button class="button button--danger button--small" type="button" @onclick="RevokeAllAsync" disabled="@IsBusy">Sair de todos</button></div>
        @if (IsLoading) { <LoadingSkeleton Lines="4" /> }
        else if (Sessions.Count == 0) { <InterfaceState Title="Nenhuma sessão listada" Description="Atualize a página ou entre novamente." Icon="shield" /> }
        else
        {
            <div class="session-list">
                @foreach (var session in Sessions)
                {
                    <article><div><strong>@MethodLabel(session.AuthenticationMethod) @(session.IsCurrent ? "(esta sessão)" : null)</strong><span>Expira em @session.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>@if (!session.IsCurrent){<button class="button button--secondary button--small" type="button" @onclick="() => RevokeSessionAsync(session)" disabled="@IsBusy">Revogar</button>}</article>
                }
            </div>
        }
    </section>
    <section class="surface security-panel" aria-labelledby="notifications-title">
        <h2 id="notifications-title">Notificações e lembretes</h2>
        <p class="field-hint">Escolha os canais para lembretes de atendimento. Códigos de acesso e avisos essenciais de segurança não dependem destas preferências.</p>
        @if (Preferences is null) { <LoadingSkeleton Lines="3" /> }
        else
        {
            <form @onsubmit="SavePreferencesAsync" @onsubmit:preventDefault>
                <label class="patient-check"><input type="checkbox" @bind="ReminderEmailEnabled" /> Lembretes por e-mail</label>
                <label class="patient-check"><input type="checkbox" @bind="ReminderSmsEnabled" /> Lembretes por SMS</label>
                <label class="patient-check"><input type="checkbox" @bind="PremiumUpdatesEnabled" /> Atualizações do benefício Premium</label>
                <p class="field-hint">Envios exigem contato confirmado e respeitam as preferências de comunicação do perfil do paciente.</p>
                <button class="button button--secondary" disabled="@IsBusy">Salvar preferências</button>
            </form>
        }
    </section>
</div>

@code {
    private IJSObjectReference? module;
    private readonly List<WebSession> Sessions = [];
    private WebNotificationPreferences? Preferences;
    private bool ReminderEmailEnabled, ReminderSmsEnabled, PremiumUpdatesEnabled;
    private bool IsLoading = true;
    private bool IsBusy;
    private string? Notice;
    private bool NoticeIsError;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/identity-access.js"); await LoadAsync(); StateHasChanged(); }
    private async Task LoadAsync()
    {
        try
        {
            var client = module!;
            Sessions.Clear();
            Sessions.AddRange(await client.InvokeAsync<IReadOnlyList<WebSession>>("get", Backend.BaseUrl.ToString(), "api/v1/auth/sessions"));
            Preferences = await client.InvokeAsync<WebNotificationPreferences>("get", Backend.BaseUrl.ToString(), "api/v1/notifications/preferences");
            if (Preferences is not null)
            {
                ReminderEmailEnabled = Preferences.ReminderEmailEnabled;
                ReminderSmsEnabled = Preferences.ReminderSmsEnabled;
                PremiumUpdatesEnabled = Preferences.PremiumUpdatesEnabled;
            }
        }
        catch (Exception exception) { Error(exception is JSException ? exception.Message : UiErrorNotifier.UnexpectedMessage); }
        finally { IsLoading = false; }
    }
    private async Task RevokeSessionAsync(WebSession item) => await RunAsync(async () => { if (!await JavaScript.InvokeAsync<bool>("confirm", "Encerrar o acesso neste dispositivo?")) return; await module!.InvokeAsync<object?>("sendMethod", Backend.BaseUrl.ToString(), $"api/v1/auth/sessions/{item.Id}", "DELETE", null); Sessions.Remove(item); Notice = "Sessão revogada."; });
    private async Task RevokeAllAsync() => await RunAsync(async () => { if (!await JavaScript.InvokeAsync<bool>("confirm", "Sair de todos os dispositivos, incluindo este?")) return; await module!.InvokeAsync<object?>("send", Backend.BaseUrl.ToString(), "api/v1/auth/sessions/revoke-all", new { }); Navigation.NavigateTo("/acesso", true); });
    private async Task SavePreferencesAsync() => await RunAsync(async () =>
    {
        Preferences = await module!.InvokeAsync<WebNotificationPreferences>("sendMethod",
            Backend.BaseUrl.ToString(), "api/v1/notifications/preferences", "PUT",
            new { reminderEmailEnabled = ReminderEmailEnabled, reminderSmsEnabled = ReminderSmsEnabled,
                premiumUpdatesEnabled = PremiumUpdatesEnabled, rowVersion = Preferences!.RowVersion });
        Notice = "Preferências de notificações atualizadas.";
    });
    private async Task RunAsync(Func<Task> action) { if (IsBusy) return; IsBusy = true; Notice = null; NoticeIsError = false; try { await action(); } catch (JSException exception) { Error(exception.Message); } catch (Exception) { Error(UiErrorNotifier.UnexpectedMessage); } finally { IsBusy = false; } }
    private void Error(string value) { Notice = UiErrorNotifier.Normalize(value); NoticeIsError = true; Errors.Show(Notice); }
    private static string MethodLabel(string value) => value switch { "google" => "Google", "passkey" => "Acesso anterior", "sms_code" => "Código SMS", "email_code" => "Código por e-mail", _ => "Senha" };
    public async ValueTask DisposeAsync() { if (module is not null) try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
}
