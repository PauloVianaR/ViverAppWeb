@inherits ViverApp.Web.Components.Pages.ManagerPageBase
@using System.Globalization
@using static ViverApp.Web.ManagerLabels

@if (Notice is not null) { <UiNotice Message="@Notice" IsError="NoticeError" /> }
@if (Loading) { <LoadingSkeleton Lines="7" /> }
else
{
    <AppointmentWorkspace PatientId="@((long)PatientIdValue)" PatientSaved="ReloadSelectedPatient">
        <div class="appointment-booking-grid">
            <div class="appointment-booking-main">
                <div class="appointment-form-grid">
                    <div class="field appointment-patient-field">
                        <label id="booking-patient-label">Paciente</label>
                        <details class="appointment-patient-picker" @key="PatientPickerRevision">
                            <summary aria-labelledby="booking-patient-label">@(Patient?.FullName ?? "Selecione ou pesquise o paciente") <span aria-hidden="true">⌄</span></summary>
                            <div class="appointment-patient-options">
                                <input aria-label="Buscar paciente por nome ou CPF" placeholder="Digite nome ou CPF…" value="@PatientSearch" @oninput="SearchPatients" maxlength="120" />
                                <div role="listbox" aria-label="Pacientes encontrados">
                                    @foreach (var patient in MatchingPatients)
                                    {
                                        <button type="button" role="option" aria-selected="@(patient.AccountId == PatientIdValue)" @onclick="() => ChoosePatient(patient)">@patient.FullName @(patient.IsPremium ? "★" : "")</button>
                                    }
                                    @if (!MatchingPatients.Any()) { <p class="field-hint">Nenhum paciente encontrado.</p> }
                                </div>
                                <small>Até 50 correspondências. Continue digitando para refinar.</small>
                            </div>
                        </details>
                    </div>
                    <div class="field"><label for="booking-specialty">Especialidade</label><select id="booking-specialty" @bind="SpecialtyId" disabled="@Busy" @bind:after="SpecialtyChanged"><option value="0">Selecione</option>@foreach (var specialty in Options?.Specialties ?? []) { <option value="@specialty.Id">@specialty.Name</option> }</select></div>
                    <div class="field"><label for="booking-category">Tipo</label><select id="booking-category" @bind="Category" disabled="@Busy" @bind:after="CategoryChanged">@foreach (var category in Categories) { <option value="@category.Code">@category.Label</option> }</select></div>
                    <div class="field"><label for="booking-professional">Profissional</label><select id="booking-professional" @bind="ProfessionalId" @bind:after="ResetSlots" disabled="@(IsProfessional || Busy)"><option value="0">@(IsProfessional ? "Você" : "Selecione")</option>@foreach (var professional in Professionals) { <option value="@professional.AccountId">@professional.FullName</option> }</select></div>
                    <div class="field"><label for="booking-form">Forma</label><select id="booking-form" @bind="BillingForm" @bind:after="BillingChanged"><option value="private">Particular</option><option value="insurance">Convênio</option></select></div>
                    <div class="field"><label for="booking-modality">Modalidade</label><select id="booking-modality" @bind="ModalityCode" disabled="@Busy" @bind:after="ModalityChanged"><option value="in_person">Presencial</option><option value="online">Online</option></select></div>
                </div>
                <section class="appointment-services-section">
                    <div class="field"><label id="booking-service-label">Pesquisar serviço</label><button id="booking-service-trigger" type="button" class="appointment-service-trigger" aria-labelledby="booking-service-label" @onclick="OpenServices">Pesquisar e selecionar serviços <span aria-hidden="true">⌄</span></button></div>
                    <div id="booking-service-picker" popover="auto" class="appointment-service-dropdown">
                        <div class="appointment-service-picker-heading"><strong>Serviços · @Categories.First(x=>x.Code==Category).Label</strong><button type="button" popovertarget="booking-service-picker" popovertargetaction="hide" aria-label="Fechar lista de serviços">×</button></div>
                        <input aria-label="Pesquisar serviço por nome" @bind="ServiceSearch" @bind:event="oninput" placeholder="Digite para pesquisar…" maxlength="100" />
                        <div class="appointment-service-matches">
                            @foreach(var service in VisibleServices)
                            {
                                <label class="appointment-service-option @(SelectedIds.Contains(service.Id) ? "appointment-service-option--selected" : null)"><input type="checkbox" checked="@SelectedIds.Contains(service.Id)" disabled="@(Busy || SelectedIds.Count>0 && service.ModalityCode!="both" && service.ModalityCode!=ModalityCode)" @onchange="()=>ToggleService(service)" /><span><strong>@service.Name</strong><small>@service.DurationMinutes min · @if(BillingForm=="insurance" || !service.RequiresPayment){<strong>Sem cobrança</strong>}else if(Patient?.IsPremium==true){<s>@Money(service.BasePrice)</s> <b>@Money(Discounted(service.BasePrice))</b>}else{@Money(service.BasePrice)}</small></span></label>
                            }
                            @if(!VisibleServices.Any()){<p class="field-hint">Nenhum serviço ativo para este tipo e especialidade.</p>}
                        </div>
                    </div>
                    <ul class="appointment-selected-services" aria-label="Serviços selecionados">@foreach(var service in SelectedServices){<li>@service.Name</li>}</ul>
                </section>
                <div class="appointment-date-time-grid">
                    <div class="appointment-date-panel">
                        <strong>Data</strong>
                        @if (ProfessionalId != 0 && DurationValid)
                        {
                            <BookingAvailabilityCalendar @key="CalendarKey" SlotsApiPrefix="@CalendarApi" InitialDate="Date" ProfessionalId="ProfessionalId" PreviewOnly="@(PrimaryId==0)" Compact="true" DateSelected="SelectDate" />
                        }
                        else { <div class="appointment-calendar-placeholder"><p>Escolha serviço e profissional para consultar as datas disponíveis.</p><input type="date" aria-label="Data selecionada" value="@(InitialDate?.ToString("yyyy-MM-dd"))" disabled /></div> }
                    </div>
                    <div>
                        <div class="field"><label for="booking-time">Horário</label><select @key='@($"{CalendarKey}-{Slots.Count}")' id="booking-time" @bind="SelectedTime"><option value="">Selecione</option>@if(!string.IsNullOrEmpty(SelectedTime) && !Slots.Any(x=>x.StartsAt.ToString("HH:mm")==SelectedTime)){<option value="@SelectedTime">@SelectedTime (validar disponibilidade)</option>}@foreach (var slot in Slots) { <option value="@slot.StartsAt.ToString("HH:mm")">@slot.StartsAt.ToString("HH:mm")–@slot.EndsAt.ToString("HH:mm")</option> }</select></div>
                        <div class="field"><label for="booking-duration">Tempo (minutos)</label><input id="booking-duration" type="number" min="5" max="720" value="@Duration" disabled="@(SelectedIds.Count < 2)" @onchange="DurationChanged" /></div>
                        <div class="field"><label for="booking-notes">Observações</label><textarea id="booking-notes" @bind="Notes" maxlength="1000" rows="2"></textarea></div>

                    </div>
                </div>
            </div>
            <aside class="appointment-operation-panel">
                <h2>Resumo e ações</h2>
                <dl><div><dt>Paciente</dt><dd>@(Patient?.FullName ?? "Selecione")</dd></div><div><dt>Data e hora</dt><dd>@(SelectedTime is null or "" ? "Selecione" : $"{Date:dd/MM/yyyy} às {SelectedTime}")</dd></div><div><dt>Valor base</dt><dd>@Money(BaseTotal)</dd></div>
                    @if (Patient?.IsPremium == true && BaseTotal > 0 && BillingForm == "private") { <div><dt>Valor Premium</dt><dd>@Money(PremiumTotal)</dd></div> }
                    <div><dt>Total</dt><dd><strong>@Money(FinalPrice)</strong></dd></div><div><dt>Situação inicial</dt><dd>@(ChargeRequired ? "Aguardando Pagamento" : "Confirmado · sem cobrança")</dd></div></dl>
                @if (DiscountAllowed && ChargeRequired)
                {
                    <div class="field"><label for="booking-discount-kind">Desconto pontual (máx. @MaxDiscount%)</label><select id="booking-discount-kind" @bind="PointKind"><option value="">Sem desconto</option><option value="percent">Porcentagem</option><option value="amount">Reais</option></select></div>
                    @if (PointKind != "") { <div class="field"><label for="booking-discount-value">Valor</label><input id="booking-discount-value" type="number" min="0.01" step="0.01" @bind="PointValue" /></div> }
                }
                <button type="button" class="button" disabled="@(Busy || PatientIdValue == 0 || PrimaryId == 0 || (!IsProfessional && ProfessionalId == 0) || !Slots.Any(x=>x.StartsAt.ToString("HH:mm")==SelectedTime) || !DurationValid || SpecialtyId == 0)" @onclick="Confirm">Salvar agendamento</button>
                <a class="button button--secondary" href="@ReturnTo">Voltar à agenda</a>
                <p class="field-hint">Convênio não gera cobrança ao paciente. Particular respeita “Cobrar?” do catálogo. Valores e disponibilidade são validados no servidor.</p>
            </aside>
        </div>
    </AppointmentWorkspace>
}

@code {
    [Parameter] public long PatientId { get; set; }
    [Parameter] public string Root { get; set; } = "/gestao";
    [Parameter] public string? DateQuery { get; set; }
    [Parameter] public string? TimeQuery { get; set; }
    [Parameter] public string? ReturnQuery { get; set; }
    private string ReturnTo => AppointmentNavigation.AgendaReturn(Root,ReturnQuery);
    [Parameter] public ulong? ProfessionalQuery { get; set; }
    private bool IsProfessional => Root is "/medico" or "/psicologo";
    private string Api => IsProfessional ? "api/v1/doctor" : Root == "/administracao" ? "api/v1/administrator" : "api/v1/manager";
    private WebBookingWorkspaceOptions? Options;
    private IReadOnlyList<ManagerPatient> Patients = [];
    private readonly Dictionary<ulong, string> PatientKeys = [];
    private ManagerPatient? Patient;
    private IReadOnlyList<ManagerService> Services = [];
    private IReadOnlyList<WebBookingProfessional> Professionals = [];
    private IReadOnlyList<WebAvailableSlot> Slots = [];
    private readonly List<uint> SelectedIds = [];
    private ulong PatientIdValue, ProfessionalId;
    private uint SpecialtyId;
    private string Category = "consultation", ModalityCode = "in_person", BillingForm = "private", ServiceSearch = "", PatientSearch = "", PatientSearchNormalized = "", Notes = "", PointKind = "";
    private decimal PointValue, MaxDiscount = 30;
    private bool DiscountAllowed;
    private int PatientPickerRevision;
    private int Duration;
    private DateOnly Date = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? InitialDate;
    private string? SelectedTime;
    private static readonly (string Code, string Label)[] Categories = [("consultation", "Consulta"), ("examination", "Exame"), ("surgery", "Cirurgia"), ("procedure", "Procedimento")];
    private uint PrimaryId => SelectedIds.FirstOrDefault();
    private bool DurationValid => SelectedIds.Count <= 1 || Duration is >= 5 and <= 720;
    private IEnumerable<ManagerPatient> MatchingPatients => Patients.Where(x => PatientKeys[x.AccountId].Contains(PatientSearchNormalized, StringComparison.Ordinal)).Take(50);
    private IEnumerable<ManagerService> VisibleServices => Services.Where(x => x.CategoryCode == Category && x.SpecialtyId == SpecialtyId && (ServiceSearch == "" || PatientSearchKey.Normalize(x.Name).Contains(PatientSearchKey.Normalize(ServiceSearch), StringComparison.Ordinal))).OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase);
    private IEnumerable<ManagerService> SelectedServices => Services.Where(x => SelectedIds.Contains(x.Id));
    private decimal BaseTotal => SelectedServices.Sum(x => x.RequiresPayment ? x.BasePrice : 0);
    private bool ChargeRequired => BillingForm == "private" && SelectedServices.Any(x => x.RequiresPayment);
    private decimal Discounted(decimal value) => decimal.Round(value * (1 - (Patient?.IsPremium == true ? Patient.PremiumDiscountPercent : 0) / 100m), 2, MidpointRounding.AwayFromZero);
    private decimal PremiumTotal => Discounted(BaseTotal);
    private decimal PointAmount => PointKind == "percent" ? decimal.Round(PremiumTotal * PointValue / 100m, 2, MidpointRounding.AwayFromZero) : PointKind == "amount" ? PointValue : 0;
    private decimal FinalPrice => ChargeRequired ? PremiumTotal - PointAmount : 0;
    private bool IsOphthalmology => PatientSearchKey.Normalize(Options?.Specialties.FirstOrDefault(x => x.Id == SpecialtyId)?.Name ?? "") == "OFTALMOLOGIA";
    private string Extras => string.Concat(SelectedIds.Skip(1).Select(x => $"&additionalAppointmentTypeIds={x}")) + (SelectedIds.Count > 1 && DurationValid ? $"&durationMinutes={Duration}" : "");
    private string CalendarApi => $"{Api}/booking/slots?patientAccountId={PatientIdValue}&appointmentTypeId={PrimaryId}&modality={ModalityCode}{(IsProfessional ? "" : $"&doctorAccountId={ProfessionalId}")}{Extras}";
    private string CalendarKey => $"{PatientIdValue}-{ProfessionalId}-{PrimaryId}-{Extras}-{ModalityCode}";
    protected override async Task Load()
    {
        Options = await Get<WebBookingWorkspaceOptions>("api/v1/booking-workspace/options");
        SpecialtyId = Options?.DefaultSpecialtyId ?? 0;
        var people = new List<ManagerPatient>();
        for (var page = 1; ; page++)
        {
            var data = await Get<ManagerPatientsData>($"api/v1/booking-workspace/patients?page={page}&pageSize=100");
            if (data is null) break;
            people.AddRange(data.Page.Items);
            if (people.Count >= data.Page.TotalCount || data.Page.Items.Count == 0) break;
        }
        Patients = people.OrderBy(x => x.FullName, StringComparer.CurrentCultureIgnoreCase).ToArray();
        foreach (var patient in Patients) PatientKeys[patient.AccountId] = PatientSearchKey.Normalize(patient.FullName + patient.TaxId);
        PatientIdValue = (ulong)Math.Max(0, PatientId);
        Patient = Patients.FirstOrDefault(x => x.AccountId == PatientIdValue);
        if (IsProfessional)
        {
            var capabilities = await Get<DoctorCapabilities>("api/v1/doctor/capabilities");
            if (capabilities?.PatientSchedulingEnabled != true) { Navigation.NavigateTo($"{Root}/agenda"); return; }
            var catalog = await Get<IReadOnlyList<ProfessionalService>>($"{Api}/services") ?? [];
            Services = catalog.Where(x => x.IsActive && x.Offered).Select(x => new ManagerService(x.Id, x.Name, x.Description, x.CategoryCode, x.ModalityCode, x.DurationMinutes, x.PriceAmount, x.RequiresPayment,x.SpecialtyId)).ToArray();
        }
        else
        {
            Services = await Get<IReadOnlyList<ManagerService>>($"{Api}/services") ?? [];
            DiscountAllowed = true;
            if (Root == "/gestao") { var cap = await Get<ManagerCapabilities>("api/v1/manager/capabilities"); DiscountAllowed = cap?.PointDiscountsEnabled == true; MaxDiscount = cap?.PointDiscountMaxPercent ?? 30; }
            else { var settings = await Get<IReadOnlyList<AdministratorSetting>>($"{Api}/settings") ?? []; if (decimal.TryParse(settings.FirstOrDefault(x => x.Key == "appointments.point_discount_max_percent")?.ValueJson, CultureInfo.InvariantCulture, out var limit)) MaxDiscount = limit; }
        }
        if (DateOnly.TryParseExact(DateQuery, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var initial) && initial >= Date) InitialDate = initial;
        ProfessionalId = ProfessionalQuery ?? 0;
        if(IsProfessional){var me=await Get<WebCurrentAccount>("api/v1/auth/me");ProfessionalId=ulong.TryParse(me?.Id,out var ownId)?ownId:0;var selfProfile=await Get<ProfessionalProfileData>("api/v1/doctor/profile");Professionals=[new WebBookingProfessional(ProfessionalId,selfProfile?.FullName??"Você",null,"","",10,[])];}
        if(ProfessionalId!=0){var selected=await Get<WebBookingProfessionalSpecialties>($"api/v1/booking-workspace/professionals/{ProfessionalId}/specialties");SpecialtyId=selected?.PrimarySpecialtyId??SpecialtyId;}
        await LoadProfessionals();
        if (InitialDate.HasValue) Date = InitialDate.Value;
        if (TimeOnly.TryParse(TimeQuery, CultureInfo.InvariantCulture, out var initialTime)) SelectedTime = initialTime.ToString("HH:mm");
    }
    private async Task ReloadSelectedPatient()
    {
        Patient = await Get<ManagerPatient>($"api/v1/booking-workspace/patients/{PatientIdValue}");
        if (Patient is null) return;
        Patients = Patients.Select(x => x.AccountId == Patient.AccountId ? Patient : x).OrderBy(x => x.FullName, StringComparer.CurrentCultureIgnoreCase).ToArray();
        PatientKeys[Patient.AccountId] = PatientSearchKey.Normalize(Patient.FullName + Patient.TaxId);
    }
    private void SearchPatients(ChangeEventArgs e) { PatientSearch = e.Value?.ToString() ?? ""; PatientSearchNormalized = PatientSearchKey.Normalize(PatientSearch); }
    private void ChoosePatient(ManagerPatient patient) { Patient = patient; PatientIdValue = patient.AccountId; PatientPickerRevision++; ResetSlots(); }
    private Task OpenServices()=>Module!.InvokeVoidAsync("openServicePicker","booking-service-trigger","booking-service-picker").AsTask();
    private Task SpecialtyChanged()=>Run(async()=>{SelectedIds.Clear();Duration=0;await LoadProfessionals();});
    private Task CategoryChanged() => Run(async () => { SelectedIds.Clear(); ServiceSearch = ""; Duration = 0; await LoadProfessionals(); });
    private Task ToggleService(ManagerService service) => Run(async () =>
    {
        if (!SelectedIds.Remove(service.Id)) { if (SelectedIds.Count == 0) ModalityCode = service.ModalityCode == "online" ? "online" : "in_person"; SelectedIds.Add(service.Id); }
        Duration = SelectedServices.Sum(x => (int)x.DurationMinutes);
        await LoadProfessionals();
    });
    private Task ModalityChanged() => Run(async () => { SelectedIds.RemoveAll(id => Services.Any(x => x.Id == id && x.ModalityCode != "both" && x.ModalityCode != ModalityCode)); Duration = SelectedServices.Sum(x => (int)x.DurationMinutes); await LoadProfessionals(); });
    private void BillingChanged() { PointKind = ""; PointValue = 0; }
    private void ResetSlots() { Slots = []; }
    private void DurationChanged(ChangeEventArgs e) { Duration = int.TryParse(e.Value?.ToString(), out var value) ? value : 0; ResetSlots(); }
    private async Task LoadProfessionals()
    {
        ResetSlots();
        if (IsProfessional) return;
        var people = new List<WebBookingProfessional>();
        for (var page = 1; ; page++)
        {
            var data = await Get<WebPage<WebBookingProfessional>>($"api/v1/booking-workspace/professionals?specialtyId={SpecialtyId}&page={page}&pageSize=50");
            if (data is null) break;
            people.AddRange(data.Items);
            if (people.Count >= data.TotalCount || data.Items.Count == 0) break;
        }
        Professionals = people;
        if (!people.Any(x => x.AccountId == ProfessionalId)) ProfessionalId = 0;
    }
    private void SelectDate(BookingDaySelection selection)
    {
        Slots = selection.Slots;
        if (selection.Date == default) return;
        if(Date!=selection.Date)SelectedTime=null;
        Date = selection.Date;
        if (Date == InitialDate && TimeOnly.TryParse(TimeQuery, out var wanted) && Slots.Any(x => x.StartsAt == wanted)) SelectedTime = wanted.ToString("HH:mm");
    }
    private Task Confirm() => Run(async () =>
    {
        var common = new { patientAccountId = PatientIdValue, appointmentTypeId = PrimaryId, additionalAppointmentTypeIds = SelectedIds.Skip(1).ToArray(), modalityCode = ModalityCode, localDate = Date, localStartsAt = TimeOnly.Parse(SelectedTime!, CultureInfo.InvariantCulture), patientNotes = Notes, durationMinutes = SelectedIds.Count > 1 ? (int?)Duration : null, billingFormCode = BillingForm, specialtyId = SpecialtyId };
        var body = IsProfessional ? (object)common : new ManagerAppointmentCreate(PatientIdValue, ProfessionalId, PrimaryId, ModalityCode, Date, common.localStartsAt, Notes, common.additionalAppointmentTypeIds, ChargeRequired && PointKind != "" ? PointKind : null, ChargeRequired && PointKind != "" ? PointValue : null, common.durationMinutes, BillingForm, SpecialtyId);
        var result = await Request<WebAppointment>($"{Api}/appointments", "POST", body, Guid.NewGuid().ToString("N"));
        Navigation.NavigateTo($"{Root}/atendimentos/{result!.Id}?returnTo={Uri.EscapeDataString(ReturnTo)}");
    });
}
