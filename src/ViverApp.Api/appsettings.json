{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "AllowedCorsOrigins": [],
    "AllowedConnectSources": []
  },
  "OpenTelemetry": {
    "TraceSamplingRatio": 0.1
  },
  "Authentication": {
    "Delivery": {
      "Enabled": true
    },
    "Passkeys": {
      "ServerDomain": null
    }
  },
  "PagBank": {
    "Enabled": false,
    "Environment": "Sandbox",
    "ProductionEnabled": false,
    "RefundsEnabled": false,
    "SandboxUrl": "https://sandbox.api.pagseguro.com/",
    "ProductionUrl": "https://api.pagseguro.com/",
    "CheckoutLifetimeMinutes": 120,
    "ReconciliationIntervalMinutes": 5,
    "ReconciliationBatchSize": 20
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
