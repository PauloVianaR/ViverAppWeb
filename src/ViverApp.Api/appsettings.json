{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "AllowedCorsOrigins": [],
    "AllowedConnectSources": []
  },
  "OpenTelemetry": {
    "TraceSamplingRatio": 0.1
  },
  "Storage": {
    "Private": {
      "Provider": "Database"
    },
    "R2": {
      "AccountId": null,
      "BucketName": null,
      "AccessKeyId": null,
      "SecretAccessKey": null,
      "PresignedUrlLifetimeSeconds": 60,
      "RetainDatabaseFallbackDays": 30
    }
  },
  "Authentication": {
    "Delivery": {
      "Enabled": true
    }
  },
  "Notifications": {
    "BusinessDelivery": {
      "Enabled": false
    },
    "Scheduler": {
      "Enabled": false
    }
  },
  "PagBank": {
    "Enabled": false,
    "Environment": "Sandbox",
    "ProductionEnabled": false,
    "RefundsEnabled": false,
    "SandboxUrl": "https://sandbox.api.pagseguro.com/",
    "ProductionUrl": "https://api.pagseguro.com/",
    "CheckoutLifetimeMinutes": 120,
    "ReconciliationIntervalMinutes": 5,
    "ReconciliationBatchSize": 20
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
